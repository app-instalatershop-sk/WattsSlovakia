---
/**
 * Hlavička: horný pás s partnerstvom a jazykmi, pod ním lepkavá hlavička. Potrubia otvárajú panel
 * so všetkými piatimi systémami a ich rendermi, ostatné položky sú odkazy. Pod položkou, na ktorej je
 * myš alebo aktuálna stránka, sa posúva žltá značka. Hľadanie má skratku Ctrl K (⌘ K na Macu) a našepkávač
 * (lib/naseptavac.ts), na mobile lupu vedľa Menu, ktorá otvorí menu s poľom hľadania.
 */
import Obraz from './Obraz.astro';
import { getCollection } from 'astro:content';
import Ikona from './Ikona.astro';
import WattsLogo from './WattsLogo.astro';
import MicroflexLogo from './MicroflexLogo.astro';
import { kategorie, cestaKategorie, kKratky, rNazov, type Kategoria } from '../lib/katalog';
import { obrazPiktogramu, je3d } from '../lib/obrazky';
import { FIRMA } from '../content/firma';
import { type Lang, type Alternates, ESHOP, KATALOG_PDF, t, route, LANGS } from '../i18n/ui';

interface Props { lang: Lang; alternates: Alternates; aktivna?: 'potrubia' | 'vyber' | 'referencie' | 'stiahnut' | 'firmy' | 'poradna' | 'kontakt' }
const { lang, alternates, aktivna } = Astro.props;
const ui = t(lang);

const kats = await kategorie();
const rady = (await getCollection('rady')).map((r) => r.data);
const potrubia = kats.filter((k) => k.typ === 'potrubie');
const diely = kats.filter((k) => k.typ !== 'potrubie');
/** Rady kategórie bez značky a bez upresnenia: „UNO, DUO, UNO PRIMO, PRIMO DUO“. */
const radyKat = (k: Kategoria) => rady
  .filter((r) => r.kategoria === k.id)
  .sort((a, b) => a.poradie - b.poradie)
  .map((r) => rNazov(r, lang).split(',')[0].trim().replace(/^Microflex\s+/i, ''))
  .join(', ');

// Referencie sú v menu kvôli projektantom a dodávateľom veľkých stavieb (audit prvého dojmu, č. 6).
const polozky = [
  { id: 'vyber', text: ui.nav.vyber, href: route(lang, 'vyber') },
  { id: 'referencie', text: ui.nav.referencie, href: route(lang, 'referencie') },
  { id: 'firmy', text: ui.nav.firmy, href: route(lang, 'firmy') },
  { id: 'stiahnut', text: ui.nav.podklady, href: route(lang, 'stiahnut') },
  { id: 'poradna', text: ui.nav.poradna, href: route(lang, 'poradna') },
] as const;

// Našepkávač: index hľadania a texty pre skript.
const nasIndex = `${route(lang, 'hladat')}index.json`;
const nasTexty = JSON.stringify({ vsetky: ui.search.vsetky, nic: ui.search.nic, ciastocne: ui.search.ciastocne, sprievodca: ui.search.sprievodca, skupiny: ui.search.skupiny, sprievodcaUrl: route(lang, 'vyber') });
---
<!-- Horný pás nie je prilepený: odroluje prirodzene, hlavička pod ním ostáva. -->
<div class="topbar" role="region" aria-label={ui.partner.pas} transition:name="horny-pas" transition:animate="none">
  <div class="wrap topbar-in">
    {/* Juraj 4. 11. 2026: jediný partner pre Česko a Slovensko, na telefóne krátko (celá veta ostáva pre čítačky). */}
    <a class="partner" href={route(lang, 'kontakt')} aria-label={ui.partner.veta}>
      <span class="partner-plne">{ui.partner.veta}</span>
      <span class="partner-kratke" aria-hidden="true">{ui.partner.kratke}</span>
      <WattsLogo height={14} farba="biela" />
    </a>
    {/* Kontakt je vždy na očiach: telefón na jeden ťuk a stránka kontaktu (audit prvého dojmu, č. 5). */}
    <div class="topbar-kontakt">
      <a class="topbar-tel" href={FIRMA.telefonHref} aria-label={FIRMA.telefon}><Ikona nazov="phone" velkost={14} /><span class="topbar-tel-cislo">{FIRMA.telefon}</span></a>
      <a href={route(lang, 'kontakt')} aria-current={aktivna === 'kontakt' ? 'page' : undefined}>{ui.nav.kontakt}</a>
    </div>
    <nav class="langs" aria-label={ui.jazyk.prepnut}>
      {LANGS.map((l, i) => (
        <>
          {i > 0 && <span class="sep" aria-hidden="true"></span>}
          <a href={alternates[l]} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined} title={ui.jazyk[l]}>{l.toUpperCase()}</a>
        </>
      ))}
    </nav>
  </div>
</div>
<header class="hdr" id="hdr" transition:name="hlavicka" transition:animate="none">
  <div class="wrap hdr-in">
    <a class="brand" href={route(lang, 'domov')} aria-label={ui.site.name}>
      <MicroflexLogo height={21} popis={null} class="brand-logo" />
      <span class="brand-sub">{ui.site.sub}</span>
    </a>

    <nav class="nav" id="nav" aria-label={ui.nav.hlavna}>
      <button class="nav-link nav-mega" id="mega-btn" type="button" aria-expanded="false" aria-controls="mega" aria-current={aktivna === 'potrubia' ? 'page' : undefined}>
        {ui.nav.potrubia}<Ikona nazov="chevron-down" velkost={16} />
      </button>
      {polozky.map((p) => <a class="nav-link" href={p.href} aria-current={aktivna === p.id ? 'page' : undefined}>{p.text}</a>)}
      <span class="nav-ind" aria-hidden="true"></span>
    </nav>

    <form class="search" role="search" action={route(lang, 'hladat')} method="get" data-index={nasIndex} data-texty={nasTexty}>
      <Ikona nazov="search" velkost={18} />
      <input id="q" name="q" type="search" placeholder={ui.search.placeholder} aria-label={ui.search.label} autocomplete="off" aria-keyshortcuts="Control+K Meta+K" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="nas-d" />
      <kbd class="search-kbd" aria-hidden="true">Ctrl K</kbd>
      <button type="submit" class="vizualne-skryte">{ui.search.button}</button>
      <div class="nas" data-nas hidden><p class="nas-pozn" data-nas-pozn hidden></p><div role="listbox" id="nas-d" aria-label={ui.search.label}></div></div>
      <template data-nas-ext><Ikona nazov="external-link" velkost={14} /></template>
    </form>

    <a class="eshop" href={ESHOP} target="_blank" rel="noopener">{ui.nav.eshop}<Ikona nazov="external-link" velkost={16} /></a>
    <button class="hl-btn" type="button" id="hl-btn" aria-label={ui.search.label} aria-controls="mobile-nav"><Ikona nazov="search" velkost={20} /></button>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" id="menu-btn">
      <Ikona nazov="menu" velkost={20} class="i-menu" /><Ikona nazov="x" velkost={20} class="i-x" /><span data-open={ui.nav.menu} data-close={ui.nav.zavriet}>{ui.nav.menu}</span>
    </button>
  </div>

  {/* Panel Potrubia: päť systémov s rendermi, pod nimi diely a katalóg. */}
  <div class="mega" id="mega" hidden>
    <div class="wrap mega-in">
      <ul class="mega-kat">
        {potrubia.map((k) => { const img = obrazPiktogramu(k.piktogram); return (
          <li>
            <a class="mega-k" href={cestaKategorie(k, lang)}>
              <span class:list={['mega-obj', { je3d: je3d(img) }]}>{img && <Obraz src={img} alt="" widths={[240, 400]} sizes="200px" loading="lazy" class="mega-img" />}</span>
              <strong>{kKratky(k, lang)}</strong>
              <span>{radyKat(k)}</span>
            </a>
          </li>
        ); })}
      </ul>
      <div class="mega-pata">
        <div class="mega-diely">
          {diely.map((k) => <a href={cestaKategorie(k, lang)}>{kKratky(k, lang)}<Ikona nazov="chevron-right" velkost={16} /></a>)}
          <a href={route(lang, 'potrubia')}>{ui.nav.celyKatalog}<Ikona nazov="chevron-right" velkost={16} /></a>
        </div>
        <a class="mega-pdf" href={KATALOG_PDF} target="_blank" rel="noopener"><Ikona nazov="download" velkost={18} />{ui.nav.katalogPdf}</a>
      </div>
    </div>
  </div>

  {/* Mobilné menu: hľadanie, systémy s malými rendermi, ostatné odkazy, e-shop a jazyk. */}
  <div id="mobile-nav" class="mnav" hidden>
    <div class="wrap mnav-in">
      <form class="search search-m" role="search" action={route(lang, 'hladat')} method="get" data-index={nasIndex} data-texty={nasTexty}>
        <Ikona nazov="search" velkost={18} />
        <input name="q" type="search" placeholder={ui.search.placeholder} aria-label={ui.search.label} autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="nas-m" />
        <button type="submit" class="vizualne-skryte">{ui.search.button}</button>
        <div class="nas" data-nas hidden><p class="nas-pozn" data-nas-pozn hidden></p><div role="listbox" id="nas-m" aria-label={ui.search.label}></div></div>
        <template data-nas-ext><Ikona nazov="external-link" velkost={14} /></template>
      </form>
      <p class="mnav-nadpis">{ui.nav.potrubia}</p>
      <ul class="mnav-kat">
        {potrubia.map((k) => { const img = obrazPiktogramu(k.piktogram); return (
          <li><a href={cestaKategorie(k, lang)}>{img && <Obraz src={img} alt="" widths={[120, 200]} sizes="64px" loading="lazy" class:list={['mnav-img', { je3d: je3d(img) }]} />}<span>{kKratky(k, lang)}</span></a></li>
        ); })}
      </ul>
      <ul class="mnav-odkazy">
        {diely.map((k) => <li><a href={cestaKategorie(k, lang)}>{kKratky(k, lang)}</a></li>)}
        {polozky.map((p) => <li><a href={p.href}>{p.text}</a></li>)}
        <li><a href={route(lang, 'kontakt')}>{ui.nav.kontakt}</a></li>
      </ul>
      <a class="mnav-tel" href={FIRMA.telefonHref}><Ikona nazov="phone" velkost={18} />{FIRMA.telefon}</a>
      <a class="eshop eshop-m" href={ESHOP} target="_blank" rel="noopener">{ui.nav.eshop} instalatershop.sk<Ikona nazov="external-link" velkost={16} /></a>
      <div class="mnav-langs">{LANGS.map((l) => <a href={alternates[l]} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>{ui.jazyk[l]}</a>)}</div>
    </div>
  </div>
</header>

<style>
  .topbar { background: linear-gradient(90deg, #0b2f6b 0%, var(--color-blue-900) 60%, #0e3676 100%); color: #fff; font-size: 13px; }
  .topbar-in { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 36px; }
  .partner { display: inline-flex; align-items: center; gap: 12px; color: #fff; white-space: nowrap; }
  .partner:hover { color: var(--color-yellow-500); }
  .partner :global(svg) { display: block; }
  .partner-kratke { display: none; }
  .topbar-kontakt { margin-left: auto; display: inline-flex; align-items: center; gap: 20px; }
  .topbar-kontakt a { color: var(--color-on-dark-muted); font-weight: 500; white-space: nowrap; }
  .topbar-kontakt a:hover, .topbar-kontakt a[aria-current] { color: #fff; }
  .topbar-tel { display: inline-flex; align-items: center; gap: 8px; color: #fff !important; font-variant-numeric: tabular-nums; }
  .topbar-tel :global(svg) { opacity: .75; }
  .topbar-kontakt + .langs { padding-left: 20px; border-left: 1px solid rgb(255 255 255 / 0.22); }
  .langs { display: inline-flex; align-items: center; gap: 8px; }
  .langs a { color: var(--color-on-dark-muted); font-weight: 500; letter-spacing: .04em; padding: 2px 0; border-bottom: 1px solid transparent; }
  .langs a:hover { color: #fff; }
  .langs a[aria-current] { color: #fff; border-bottom-color: var(--color-yellow-500); }
  .langs .sep { width: 1px; height: 12px; background: rgb(255 255 255 / 0.3); }

  .hdr { position: sticky; top: 0; z-index: 20; background: var(--sklo-2); -webkit-backdrop-filter: saturate(1.6) blur(14px); backdrop-filter: saturate(1.6) blur(14px); box-shadow: 0 1px 0 rgb(10 42 94 / 0.08); transition: box-shadow 250ms var(--ease-soft), background-color 250ms var(--ease-soft), margin-bottom 250ms var(--ease-soft); }
  .hdr.is-scrolled, .hdr.is-open { background: var(--sklo-3); box-shadow: 0 1px 0 rgb(10 42 94 / 0.08), var(--elev-2); }
  .hdr-in { display: flex; align-items: center; gap: 28px; min-height: 76px; transition: min-height 250ms var(--ease-soft); }
  /* Pri rolovaní sa hlavička zmenší, ale miesto v stránke ostane rovnaké (o koľko ubudne výška, o toľko pribudne
     okraj pod ňou): obsah sa sám neposunie (Juraj 28. 10., plynulosť; predtým skočil o 14 px). */
  .hdr.is-scrolled { margin-bottom: 14px; }
  .hdr.is-scrolled .hdr-in { min-height: 62px; }

  /* Značka: oficiálne logo MICROFLEX® (vektor z katalógu Watts) a náš doplnok Slovensko za vlasovou
     čiarou. Pri rolovaní sa logo zmenší spolu s hlavičkou. */
  .brand { display: inline-flex; align-items: center; gap: 12px; color: var(--color-ink); flex: none; }
  .brand :global(.brand-logo) { transition: height 250ms var(--ease-soft); }
  .hdr.is-scrolled .brand { --logo-h: 19px; }
  .brand-sub { font-size: 14px; font-weight: 500; color: var(--color-ink-soft); border-left: var(--line); padding-left: 12px; line-height: 1; }

  /* Navigácia so žltou značkou, ktorá sa posúva pod položku. */
  .nav { position: relative; display: flex; align-items: center; gap: 2px; margin-left: 4px; flex: none; }
  .nav-link { position: relative; display: inline-flex; align-items: center; gap: 4px; height: 40px; padding: 0 12px; border: 0; border-radius: var(--radius-m); background: transparent; color: var(--color-ink); font: 500 15px/1 var(--font-text); white-space: nowrap; cursor: pointer; transition: color 150ms var(--ease-soft), background-color 150ms var(--ease-soft); }
  .nav-link:hover { color: var(--color-blue-700); background: rgb(0 93 185 / 0.06); }
  .nav-link[aria-current] { color: var(--color-blue-700); }
  .nav-mega :global(svg) { transition: transform 250ms var(--ease-soft); opacity: .7; }
  .nav-mega[aria-expanded="true"] { color: var(--color-blue-700); background: rgb(0 93 185 / 0.08); }
  .nav-mega[aria-expanded="true"] :global(svg) { transform: rotate(180deg); }
  .nav-ind { position: absolute; left: 0; bottom: -18px; height: 3px; width: var(--w, 0); border-radius: 2px; background: var(--color-yellow-500); transform: translateX(var(--x, 0)); opacity: var(--o, 0); transition: transform 320ms var(--ease-soft), width 320ms var(--ease-soft), opacity 200ms var(--ease-soft), bottom 250ms var(--ease-soft); pointer-events: none; }
  .hdr.is-scrolled .nav-ind { bottom: -11px; }

  /* Hľadanie: pole s ikonou a skratkou, bez ťažkého tlačidla. Enter odošle. */
  .search { position: relative; margin-left: auto; display: flex; align-items: center; height: 44px; min-width: 0; border-radius: 999px; background: #f1f5fa; box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.06); transition: box-shadow 150ms var(--ease-soft), background-color 150ms var(--ease-soft); }
  @media (hover: hover) and (pointer: fine) { .search:hover { box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.16); } }
  .search:focus-within { background: #fff; box-shadow: inset 0 0 0 1px var(--color-blue-700), 0 0 0 4px rgb(0 93 185 / 0.12); }
  .search > :global(.icon) { position: absolute; left: 14px; color: #6b7686; pointer-events: none; }
  .search input { width: 272px; max-width: 30vw; height: 100%; border: 0; padding: 0 56px 0 40px; background: transparent; font: inherit; font-size: 15px; color: var(--color-ink); outline: none; min-width: 0; transition: width 250ms var(--ease-soft); }
  .search input:focus { width: 320px; }
  .search input::placeholder { color: #7a8494; font-size: 15px; }
  .search input::-webkit-search-cancel-button { display: none; }
  .search-kbd { position: absolute; right: 10px; padding: 4px 8px; border-radius: var(--radius-s); background: #fff; box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.14), 0 1px 0 rgb(10 42 94 / 0.12); font: 500 12px/1.2 var(--font-text); color: #6b7686; letter-spacing: .02em; pointer-events: none; transition: opacity 150ms var(--ease-soft); }
  .search:focus-within .search-kbd { opacity: 0; }

  /* Našepkávač: biela karta pod poľom, šesť výsledkov a odkaz na všetky. Obsah vkladá skript, preto :global. */
  .nas { position: absolute; top: calc(100% + 10px); right: 0; z-index: 30; width: min(480px, calc(100vw - 32px)); max-height: min(70vh, 560px); overflow-y: auto; padding: 8px; border-radius: var(--radius-xl); background: #fff; box-shadow: 0 0 0 1px rgb(10 42 94 / 0.08), var(--elev-3); text-align: left; }
  .nas[hidden] { display: none; }
  .nas-pozn { padding: 8px 12px 8px; font-size: 14px; line-height: 1.45; color: var(--color-ink-soft); }
  .nas :global(.nas-o) { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: 2px 12px; padding: 8px 12px; border-radius: var(--radius-l); color: var(--color-ink); transition: background-color 120ms var(--ease-soft); }
  .nas :global(.nas-o:hover), .nas :global(.nas-o[aria-selected="true"]) { background: var(--color-blue-50); color: var(--color-ink); }
  .nas :global(.nas-n) { font-weight: 600; font-size: 15px; line-height: 1.35; }
  .nas :global(.nas-kod .nas-n) { font-family: var(--font-display); font-stretch: 112.5%; color: var(--color-blue-900); letter-spacing: 0.01em; }
  .nas :global(.nas-s) { font-size: 12px; color: var(--color-ink-soft); white-space: nowrap; }
  .nas :global(.nas-d) { grid-column: 1 / -1; font-size: 14px; line-height: 1.4; color: var(--color-ink-soft); }
  .nas :global(.nas-o > .icon) { grid-column: 2; grid-row: 1; justify-self: end; color: var(--color-blue-700); }
  .nas :global(.nas-o:has(> .icon) .nas-s) { display: none; }
  /* Výsledok s obrázkom: render radu alebo výrez dielu vľavo cez oba riadky textu. */
  .nas :global(.nas-obr) { grid-template-columns: 44px minmax(0, 1fr) auto; column-gap: 12px; align-items: center; }
  .nas :global(.nas-obr .nas-i) { grid-row: 1 / span 2; display: grid; place-items: center; width: 44px; height: 44px; }
  .nas :global(.nas-obr .nas-i img) { width: 44px; height: 44px; object-fit: contain; mix-blend-mode: multiply; }
  .nas :global(.nas-obr .nas-n) { grid-column: 2; align-self: end; }
  .nas :global(.nas-obr .nas-s) { grid-column: 3; grid-row: 1; align-self: end; }
  .nas :global(.nas-obr .nas-d) { grid-column: 2 / -1; align-self: start; }
  .nas :global(.nas-vsetky) { margin-top: 4px; border-top: 1px solid rgb(10 42 94 / 0.08); border-radius: 0 0 var(--radius-l) var(--radius-l); }
  .nas :global(.nas-vsetky .nas-n) { font-weight: 500; font-size: 15px; color: var(--color-blue-700); }
  .nas :global(mark) { background: rgb(247 201 0 / 0.35); color: inherit; border-radius: 3px; padding: 0 1px; }

  /* E-shop je cieľ webu, preto tlačidlo, nie odkaz. */
  .eshop { display: inline-flex; align-items: center; gap: 8px; height: 42px; padding: 0 16px; border-radius: 999px; background: linear-gradient(180deg, #123a7c 0%, var(--color-blue-900) 100%); color: #fff; font-weight: 500; font-size: 15px; white-space: nowrap; box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.14), var(--elev-1); transition: background-color 150ms var(--ease-soft), transform 120ms var(--ease-soft); flex: none; }
  .eshop:hover { color: #fff; background: linear-gradient(180deg, #1467c1 0%, var(--color-blue-700) 100%); }
  .eshop:active { transform: scale(0.98); }
  .eshop :global(svg) { width: 16px; height: 16px; opacity: .8; }

  .hl-btn { display: none; flex: none; align-items: center; justify-content: center; width: 42px; height: 42px; border: 0; border-radius: 999px; background: #f1f5fa; box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.08); color: var(--color-ink); cursor: pointer; }
  .menu-btn { display: none; margin-left: auto; height: 42px; padding: 0 16px; border: 0; border-radius: 999px; background: #f1f5fa; box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.08); color: var(--color-ink); font: 500 15px/1 var(--font-text); cursor: pointer; align-items: center; gap: 8px; }
  .menu-btn[aria-expanded="true"] { background: var(--color-blue-900); color: #fff; }
  .menu-btn :global(.i-x), .menu-btn[aria-expanded="true"] :global(.i-menu) { display: none; }
  .menu-btn[aria-expanded="true"] :global(.i-x) { display: inline-block; }

  .vizualne-skryte { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  /* Panel Potrubia */
  .mega { position: absolute; left: 0; right: 0; top: 100%; background: #fff; box-shadow: 0 1px 0 rgb(10 42 94 / 0.08) inset, var(--elev-3); }
  .mega:not([hidden]) { animation: mega 260ms var(--ease-soft) both; }
  @keyframes mega { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  .mega-in { padding-block: 28px 24px; }
  .mega-kat { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
  .mega-k { display: flex; flex-direction: column; gap: 4px; height: 100%; padding: 16px 16px 16px; border-radius: var(--radius-xl); color: var(--color-ink); background: linear-gradient(180deg, #f5f8fc 0%, #edf2f9 100%); transition: background-color 200ms var(--ease-soft), box-shadow 200ms var(--ease-soft); }
  @media (hover: hover) and (pointer: fine) { .mega-k:hover { color: var(--color-ink); background: linear-gradient(180deg, #eef4fc 0%, #e2ecf8 100%); box-shadow: inset 0 0 0 1px rgb(0 93 185 / 0.18); } }
  .mega-obj { display: block; height: 118px; margin: -4px 0 8px; filter: drop-shadow(0 14px 14px rgb(11 27 51 / 0.2)); transition: transform 350ms var(--ease-soft); }
  @media (hover: hover) and (pointer: fine) { .mega-k:hover .mega-obj { transform: translateY(-4px); } }
  .mega-obj :global(.mega-img) { width: 100%; height: 100%; object-fit: contain; object-position: center bottom; }
  /* Render 3D modelu má vlastný tieň. */
  .mega-obj.je3d { filter: none; }
  .mega-k strong { font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 17px; line-height: 1.25; letter-spacing: -0.01em; transition: color 150ms var(--ease-soft); }
  .mega-k:hover strong { color: var(--color-blue-700); }
  .mega-k > span:last-child { font-size: 13px; line-height: 1.45; color: var(--color-ink-soft); }
  .mega-pata { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; margin-top: 16px; padding-top: 16px; border-top: var(--line); }
  .mega-diely { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .mega-diely a { display: inline-flex; align-items: center; gap: 2px; font-weight: 500; font-size: 15px; }
  .mega-pdf { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; font-size: 15px; }

  /* Mobilné menu */
  .mnav { border-top: 1px solid rgb(10 42 94 / 0.08); background: #fff; max-height: calc(100dvh - 62px); overflow-y: auto; }
  .mnav:not([hidden]) { animation: mega 240ms var(--ease-soft) both; }
  .mnav-in { padding-block: 16px 24px; display: flex; flex-direction: column; gap: 16px; }
  .search-m { margin-left: 0; width: 100%; }
  .search-m input { width: 100%; max-width: none; padding-right: 16px; }
  .search-m input:focus { width: 100%; }
  .search-m .nas { left: 0; right: 0; width: auto; top: calc(100% + 8px); max-height: 60vh; }
  .mnav-nadpis { font-size: 13px; font-weight: 600; color: var(--color-ink-soft); margin-bottom: -8px; }
  .mnav-kat { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .mnav-kat a { display: flex; align-items: center; gap: 8px; padding: 8px 12px 8px 8px; border-radius: var(--radius-l); background: linear-gradient(180deg, #f5f8fc 0%, #edf2f9 100%); color: var(--color-ink); font-weight: 500; font-size: 15px; line-height: 1.25; min-height: 64px; }
  .mnav-kat :global(.mnav-img) { width: 56px; height: 48px; object-fit: contain; flex: none; filter: drop-shadow(0 6px 6px rgb(11 27 51 / 0.2)); }
  .mnav-kat :global(.mnav-img.je3d) { filter: none; }
  .mnav-odkazy a { display: block; padding: 12px 0; border-bottom: 1px solid rgb(10 42 94 / 0.08); color: var(--color-ink); font-weight: 500; }
  .mnav-tel { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 17px; color: var(--color-blue-900); font-variant-numeric: tabular-nums; }
  .eshop-m { justify-content: center; height: 48px; }
  .mnav-langs { display: flex; gap: 24px; }
  .mnav-langs a { color: var(--color-ink-soft); font-weight: 500; }
  .mnav-langs a[aria-current] { color: var(--color-blue-700); }

  /* Šesť položiek menu: pod 1 500 px skratka Ctrl K ustúpi, aby sa pole zmestilo celé. */
  @media (max-width: 1500px) { .search input { padding-right: 16px; } .search-kbd { display: none; } .nav-link { padding: 0 8px; } .hdr-in { gap: 24px; } }
  @media (max-width: 1240px) { .search input { width: 232px; } .search input:focus { width: 256px; } .hdr-in { gap: 16px; } .nav-link { padding: 0 8px; font-size: 15px; } }
  /* Pod 1 100 px navigácia do menu; hľadanie a e-shop ostávajú, kým je miesto. */
  @media (max-width: 1100px) {
    .nav, .mega { display: none; }
    .menu-btn { display: inline-flex; margin-left: 0; }
    .search { margin-left: auto; }
  }
  @media (max-width: 760px) {
    .hdr-in { gap: 12px; min-height: 64px; }
    .hdr.is-scrolled { margin-bottom: 2px; }
    .hdr-in > .search, .hdr-in > .eshop { display: none; }
    .hl-btn { display: inline-flex; margin-left: auto; }
    .menu-btn { margin-left: 0; }
    .brand { gap: 8px; }
    .brand, .hdr.is-scrolled .brand { --logo-h: 17px; }
    .brand-sub { font-size: 13px; padding-left: 8px; }
    .partner-plne { display: none; }
    .partner-kratke { display: inline; }
    /* Na telefóne ostáva v páse len číslo; stránka Kontakt je v menu. */
    .topbar-kontakt a:not(.topbar-tel) { display: none; }
    .topbar-kontakt + .langs { padding-left: 16px; }
  }
  /* Celá veta o partnerstve sa vedľa telefónu, kontaktu a jazykov zmestí od 1024 px; užšie krátka verzia. */
  @media (max-width: 1023px) { .partner-plne { display: none; } .partner-kratke { display: inline; } }
  /* Telefón: v hornom páse partnerstvo a ikona telefónu (číslo je v aria-label, ťuk stále volá). */
  @media (max-width: 520px) { .topbar-tel-cislo { display: none; } }
  /* Úzky telefón (360 px): menšie písmo a medzery, aby sa pás nezalomil ani nepretiekol. */
  @media (max-width: 400px) {
    .topbar { font-size: 12px; }
    .topbar-in { gap: 8px; }
    .partner { gap: 8px; }
    .topbar-kontakt + .langs { padding-left: 12px; }
  }
  /* Úzky telefón: logo, lupa a menu sa zmestia len s tlačidlom menu bez textu (text ostáva pre čítačky). */
  @media (max-width: 420px) {
    .menu-btn { width: 42px; padding: 0; justify-content: center; position: relative; }
    .menu-btn span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
</style>

<script>
  import { pripojNaseptavac } from '../lib/naseptavac';

  function initHlavicka() {
    const hdr = document.getElementById('hdr');
    if (!hdr) return;
    // Pri prechode stránok (ClientRouter) sa hlavička vymení; staré poslucháče na dokumente zrušíme.
    const w = window as unknown as { __hlavicka?: AbortController };
    w.__hlavicka?.abort();
    const ac = new AbortController();
    w.__hlavicka = ac;
    const signal = ac.signal;

    // Hysteréza: zmenšiť až po 72 px, vrátiť až pod 12 px. Zmena výšky tak nikdy neprekročí vlastnú hranicu.
    let scrolled = false;
    const onScroll = () => {
      const y = window.scrollY;
      if (!scrolled && y > 72) { scrolled = true; hdr.classList.add('is-scrolled'); }
      else if (scrolled && y < 12) { scrolled = false; hdr.classList.remove('is-scrolled'); }
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true, signal });

    // Žltá značka pod položkou: ide za myšou alebo fokusom, inak sa vráti k aktuálnej stránke.
    const nav = document.getElementById('nav');
    const ind = nav?.querySelector<HTMLElement>('.nav-ind');
    const odkazy = nav ? Array.from(nav.querySelectorAll<HTMLElement>('.nav-link')) : [];
    const aktualna = () => odkazy.find((a) => a.hasAttribute('aria-current') || a.getAttribute('aria-expanded') === 'true');
    const znacka = (el?: HTMLElement) => {
      if (!ind) return;
      if (!el) { ind.style.setProperty('--o', '0'); return; }
      ind.style.setProperty('--x', `${el.offsetLeft + 12}px`);
      ind.style.setProperty('--w', `${el.offsetWidth - 24}px`);
      ind.style.setProperty('--o', '1');
    };
    odkazy.forEach((a) => { a.addEventListener('pointerenter', () => znacka(a)); a.addEventListener('focus', () => znacka(a)); });
    nav?.addEventListener('pointerleave', () => znacka(aktualna()));
    znacka(aktualna());

    // Panel Potrubia: myšou sa otvorí pri prejdení, klikom a klávesnicou prepína, Esc zatvorí.
    const btn = document.getElementById('mega-btn');
    const mega = document.getElementById('mega');
    let casovac = 0;
    const nastav = (otvor: boolean) => {
      if (!btn || !mega) return;
      if (otvor === !mega.hidden) return;
      mega.hidden = !otvor;
      btn.setAttribute('aria-expanded', String(otvor));
      hdr.classList.toggle('is-open', otvor);
      znacka(otvor ? btn : aktualna());
    };
    if (btn && mega) {
      const mys = window.matchMedia('(pointer: fine)').matches;
      btn.addEventListener('click', () => nastav(mega.hidden));
      if (mys) {
        const otvorNeskor = () => { clearTimeout(casovac); casovac = window.setTimeout(() => nastav(true), 90); };
        const zatvorNeskor = () => { clearTimeout(casovac); casovac = window.setTimeout(() => nastav(false), 200); };
        btn.addEventListener('pointerenter', otvorNeskor);
        btn.addEventListener('pointerleave', zatvorNeskor);
        mega.addEventListener('pointerenter', () => clearTimeout(casovac));
        mega.addEventListener('pointerleave', zatvorNeskor);
      }
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !mega.hidden) { nastav(false); btn.focus(); } }, { signal });
      document.addEventListener('pointerdown', (e) => { if (!mega.hidden && !hdr.contains(e.target as Node)) nastav(false); }, { signal });
    }

    // Mobilné menu
    const menuBtn = document.getElementById('menu-btn');
    const mnav = document.getElementById('mobile-nav');
    if (menuBtn && mnav) {
      const popis = menuBtn.querySelector<HTMLElement>('span[data-open]');
      menuBtn.addEventListener('click', () => {
        const otvor = mnav.hidden;
        mnav.hidden = !otvor;
        menuBtn.setAttribute('aria-expanded', String(otvor));
        hdr.classList.toggle('is-open', otvor);
        if (popis) popis.textContent = otvor ? (popis.dataset.close ?? '') : (popis.dataset.open ?? '');
      });
    }

    // Našepkávač v hlavičke aj v mobilnom menu.
    hdr.querySelectorAll<HTMLFormElement>('form[data-index]').forEach(pripojNaseptavac);

    // Lupa na mobile: otvorí menu a dá fokus do poľa hľadania.
    const mInput = mnav?.querySelector<HTMLInputElement>('input[name="q"]');
    document.getElementById('hl-btn')?.addEventListener('click', () => {
      if (mnav?.hidden) menuBtn?.click();
      mInput?.focus();
    });

    // Ctrl K / ⌘ K: skok do hľadania. Na Macu sa ukáže ⌘.
    const q = document.getElementById('q') as HTMLInputElement | null;
    const kbd = hdr.querySelector<HTMLElement>('.search-kbd');
    if (kbd && /Mac|iPhone|iPad/.test(navigator.platform)) kbd.textContent = '⌘ K';
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        const viditelne = q && q.offsetParent !== null;
        if (!viditelne && menuBtn && mnav && mnav.hidden) menuBtn.click();
        const ciel = viditelne ? q : mnav?.querySelector<HTMLInputElement>('input');
        if (ciel) { e.preventDefault(); ciel.focus(); }
      }
    }, { signal });
  }
  initHlavicka();
  document.addEventListener('astro:after-swap', initHlavicka);
</script>
