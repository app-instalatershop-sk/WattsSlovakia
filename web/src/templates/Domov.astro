    .pokladka-text { grid-column: 1 / -1; max-width: 640px; }
  }

  /* ---------- Telefón ---------- */
  @media (max-width: 760px) {
    .hero { min-height: 0; }
    .hero-in { grid-template-columns: 1fr; grid-template-areas: "text" "obraz"; row-gap: 8px; }
    .hero-text { padding-block: 44px 0; max-width: none; }
    /* Na telefóne sa nadpis môže zalomiť, inak by na úzkom displeji pretiekol. */
    .hero h1 { font-size: clamp(30px, 8.2vw, 44px); text-wrap: wrap; }
    .hero .lead { margin-top: 18px; font-size: 17px; }
    .hero-actions { margin-top: 26px; }
    .hero-product { margin: 44px 0 0; margin-right: calc(-1 * var(--gutter)); margin-left: calc(-1 * var(--gutter)); justify-self: stretch; }
    .hero { padding-bottom: 28px; }
    /* Popisy na telefóne: kratšie čiary a menšie písmo, aby sa zmestili okolo renderu. */
    .rodina { padding-bottom: 16px; }
