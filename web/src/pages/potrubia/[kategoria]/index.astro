---
import Kategoria from '../../../templates/Kategoria.astro';
import { kategorie } from '../../../lib/katalog';
export async function getStaticPaths() {
  return (await kategorie()).filter((k) => k.typ === 'potrubie').map((k) => ({ params: { kategoria: k.slug }, props: { k } }));
}
const { k } = Astro.props;
---
<Kategoria lang="sk" k={k} />
