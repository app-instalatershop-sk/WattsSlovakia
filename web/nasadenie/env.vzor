# Prístup na FTP hostingu Websupport pre `npm run nasadit` (docs/NASADENIE.md, krok 4).
# Skopírujte ako .env v tomto priečinku (.env je v .gitignore, do gitu nesmie) a doplňte údaje z WebAdminu:
# Služby → microflex.sk → Pokročilá konfigurácia → FTP účty → Prihlasovacie údaje.
# Heslo s mriežkou (#), medzerou alebo úvodzovkami dajte do jednoduchých úvodzoviek: FTP_HESLO='ab#c d'

# Server: IP adresa uvedená pri FTP účte (funguje aj pred prepnutím domény), alebo názov servera.
FTP_SERVER=
FTP_POUZIVATEL=
FTP_HESLO=

# Nepovinné (predvolené hodnoty v zátvorke):
# FTP_PORT=21
# Odtlačok certifikátu FTP servera, keď certifikát nesedí s FTP_SERVER (napríklad pri IP adrese).
# Skript ho pri prvom pripojení vypíše; pred zapísaním ho porovnajte s údajmi vo WebAdmine.
# FTP_ODTLACOK=
# Koreň webu na FTP (/web) a priečinok mimo webu na konfiguráciu dopytu (/konfig).
# FTP_WEB=/web
# FTP_KONFIG=/konfig
# Adresa webu na skúšku nového .htaccess a na kontrolu (https://microflex.sk).
# WEB_ADRESA=https://microflex.sk
# Počet súčasných spojení pri nahrávaní (4).
# FTP_SPOJENIA=4
