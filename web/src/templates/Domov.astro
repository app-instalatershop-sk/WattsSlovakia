  .k-cislo { grid-row: 1 / span 2; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 20px; line-height: 1.3; color: var(--color-blue-700); font-variant-numeric: tabular-nums; transition: color 250ms var(--ease-soft); }
