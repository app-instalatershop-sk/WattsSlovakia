---
/**
 * Pracovná stránka: návrhy katalógovej sekcie domova. Nie je súčasťou webu (noindex, mimo sitemap,
 * bez českej verzie). Slúži Jurajovi na výber varianty. Po rozhodnutí sa víťaz prenesie do
 * templates/Domov.astro a táto stránka sa zmaže.
 */
import '../../styles/global.css';
import { getCollection } from 'astro:content';
import Hlavicka from '../../components/Hlavicka.astro';
import Ikona from '../../components/Ikona.astro';
import { kategorie, cestaKategorie, cestaRadu, kKratky, kPopis, rNazov, rMedium, cislo, type Kategoria, type Rad } from '../../lib/katalog';
import { staticAlternates } from '../../i18n/ui';

const lang = 'sk' as const;
const kats = await kategorie();
const rady = (await getCollection('rady')).map((r) => r.data);
const varianty = (await getCollection('varianty')).map((v) => v.data);
const potrubia = kats.filter((k) => k.typ === 'potrubie');
const diely = kats.filter((k) => k.typ !== 'potrubie');

/* ---------- Odvodené údaje o rade (všetko z katalógových dát) ---------- */

const PRIEMER = /(\d+)\s*[x×]\s*(\d{2})(?!\d)/g;

/** Priemery nosných rúr jedného variantu. Rady s viacerými rúrami ich majú v texte bunky. */
function ruryVariantu(v: { rura?: { d?: number | null } | null; rura_text?: string }): number[] {
  if (v.rura?.d) return [v.rura.d];
  if (!v.rura_text) return [];
  const out: number[] = [];
  for (const m of v.rura_text.matchAll(PRIEMER)) {
    const n = Number(m[1].slice(-1)) || 1;
    for (let i = 0; i < n; i++) out.push(Number(m[2]));
  }
  return out;
}
function priemeryRury(r: Rad): number[] {
  const t = new Set<number>();
  for (const v of varianty.filter((x) => x.rad === r.id)) for (const d of ruryVariantu(v)) t.add(d);
  return [...t].sort((a, b) => a - b);
}

interface Info {
  rad: Rad;
  kat: Kategoria;
  znacka: string;
  model: string;
  plaste: number[];
  priemery: number[];
  dimenzie: number;
  ohyb: number | null;
  /* na kreslenie rezu v skutočnej mierke: základná (najmenšia) veľkosť radu */
  plast: number;
  rury: { d: number; farba: string }[];
  odhad: boolean;
}

/* Farba jadra podľa média: žltá = vykurovacia voda, biela = pitná, tmavá = chlad. */
const FARBA: Record<string, string[]> = {
  vykurovanie: ['zlta'],
  sanita: ['biela', 'zlta'],
  'vykurovanie-a-sanita': ['zlta', 'zlta', 'biela', 'biela'],
  'studena-a-chladena-voda': ['tmava'],
  'tepelne-cerpadla': ['zlta', 'zlta'],
};

/** Základná veľkosť radu = variant s najmenším plášťom. Z neho kreslíme rez. */
function zakladny(r: Rad) {
  return varianty
    .filter((v) => v.rad === r.id && typeof v.plast_mm === 'number')
    .sort((a, b) => (a.plast_mm ?? 0) - (b.plast_mm ?? 0))[0];
}
function info(r: Rad): Info {
  const kat = kats.find((k) => k.id === r.kategoria)!;
  const vv = varianty.filter((v) => v.rad === r.id);
  const plaste = [...new Set(vv.map((v) => v.plast_mm).filter((x): x is number => typeof x === 'number'))].sort((a, b) => a - b);
  const priemery = priemeryRury(r);
  const ohyby = vv.map((v) => v.polomer_ohybu_m).filter((x): x is number => typeof x === 'number');
  const cely = rNazov(r, lang).split(',')[0].trim();
  const medzera = cely.indexOf(' ');
  const n = r.pocet_rur ?? 1;
  const paleta = FARBA[r.kategoria] ?? ['zlta'];
  const z = zakladny(r);
  // Rad bez stiahnutej tabuľky (PRIMO, COOL DUO): veľkosť podľa radu s rovnakým počtom rúr, kreslí sa čiarkovane.
  const odhad = !z;
  const nahrada = odhad
    ? rady.filter((x) => x.pocet_rur === n && zakladny(x)).map((x) => zakladny(x)).sort((a, b) => (a.plast_mm ?? 0) - (b.plast_mm ?? 0))[0]
    : z;
  const plast = nahrada?.plast_mm ?? 90;
  const dd = nahrada ? ruryVariantu(nahrada) : [];
  return {
    rad: r, kat,
    znacka: medzera > 0 ? cely.slice(0, medzera) : 'Microflex',
    model: medzera > 0 ? cely.slice(medzera + 1) : cely,
    plaste, priemery,
    dimenzie: r.pocet_variantov,
    ohyb: ohyby.length ? Math.min(...ohyby) : null,
    plast, odhad,
    rury: Array.from({ length: n }, (_, i) => ({ d: dd[i] ?? dd[0] ?? 25, farba: paleta[i % paleta.length] })),
  };
}

const info5 = potrubia.map((k) => ({
  kat: k,
  rady: rady.filter((r) => r.kategoria === k.id).sort((a, b) => a.poradie - b.poradie).map(info),
}));
const vsetky = info5.flatMap((s) => s.rady);

/* Mierka rezov: 1 jednotka = 1 mm, spoločná pre celú sadu, takže plášť 160 mm je na obrazovke
   naozaj dvakrát väčší než 80 mm. Najväčší plášť v katalógu je 200 mm, ten určuje plátno. */
const MIERKA = 208;
function rozlozenie(n: number, rr: number): [number, number][] {
  const c = MIERKA / 2;
  const o = rr * 1.08;
  if (n === 1) return [[c, c]];
  if (n === 2) return [[c - o, c], [c + o, c]];
  return [[c - o, c - o], [c + o, c - o], [c - o, c + o], [c + o, c + o]];
}
const rozsah = (x: number[], j = '') => (x.length === 0 ? '—' : x.length === 1 ? `${x[0]}${j}` : `${x[0]} až ${x[x.length - 1]}${j}`);
/** Kompaktný tvar do úzkeho stĺpca: 75–200 na jednom riadku. */
const rozsahK = (x: number[]) => (x.length === 0 ? '—' : x.length === 1 ? `${x[0]}` : `${x[0]}\u2013${x[x.length - 1]}`);
const tlakTxt = (r: Rad) => (r.tlak_bar ? `${r.tlak_bar} bar` : '');
/** Médium a tlak pod názvom kategórie. Ak sa médium volá rovnako ako kategória, neopakuje sa. */
function popisKat(kat: Kategoria, rr: Info[]): string {
  const m = rMedium(rr[0].rad, lang) ?? '';
  const t = tlakTxt(rr[0].rad);
  return [m.toLowerCase() === kKratky(kat, lang).toLowerCase() ? '' : m, t].filter(Boolean).join(', ');
}
---
<!doctype html>
<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Návrhy katalógovej sekcie | pracovná stránka</title>
  </head>
  <body>
    <Hlavicka lang={lang} alternates={staticAlternates('domov')} />

    <main id="obsah">
      <section class="uvod">
        <div class="wrap">
          <p class="stitok">Pracovná stránka, nie je súčasťou webu</p>
          <h1>Katalóg: štyri návrhy</h1>
          <p class="lead">
            Súčasná tabuľka má prázdne polia (sedem z pätnástich), slovo Microflex sa v nej opakuje
            dvanásťkrát a diely sú v nej natlačené s iným tvarom riadku. Štyri návrhy nižšie riešia
            to isté zadanie inak. Každý stojí na jednom z pravidiel z auditu a je postavený zo
            skutočných katalógových dát.
          </p>
          <ol class="obsahy">
            <li><a href="#a">A — Register</a><span>Müller-Brockmann: mriežka a rytmus</span></li>
            <li><a href="#b">B — Rezy v mierke</a><span>Tufte: kresba je údaj</span></li>
            <li><a href="#c">C — Médium a rady</a><span>Refactoring UI: dve úrovne</span></li>
            <li><a href="#d">D — Katalógový index</a><span>Tlačený katalóg: hustota</span></li>
          </ol>
        </div>
      </section>

      <!-- ============================== A ============================== -->
      <section class="navrh" id="a">
        <div class="wrap hlava">
          <h2><span class="pismeno">A</span> Register</h2>
          <p class="pravidlo">
            <strong>Josef Müller-Brockmann, Grid Systems.</strong> Žiadna matica, teda žiadne prázdne
            polia. Každý rad je jeden riadok na tej istej mriežke, stĺpce sú vždy na rovnakom mieste,
            takže oko ide zhora nadol a porovnáva. Značka je v nadpise sekcie, nie dvanásťkrát v tabuľke.
          </p>
        </div>
        <div class="ukazka band-soft">
          <div class="wrap">
            <div class="section-head">
              <h3 class="h-sekcia">Katalóg Microflex</h3>
              <p class="muted">Päť potrubných systémov a k nim spojky a príslušenstvo.</p>
            </div>
            <div class="reg">
              {info5.map((s) => (
                <div class="reg-skupina">
                  <div class="reg-kat">
                    <a href={cestaKategorie(s.kat, lang)}>{kKratky(s.kat, lang)}</a>
                    <span>{popisKat(s.kat, s.rady)}</span>
                  </div>
                  <ul class="reg-rady">
                    {s.rady.map((i) => (
                      <li>
                        <a href={cestaRadu(i.kat, i.rad, lang)} class="reg-riadok">
                          <span class="r-model">{i.model}</span>
                          <span class="r-rury num">{i.rad.pocet_rur ?? 1}</span>
                          <span class="r-pole">{rozsah(i.priemery, ' mm')}</span>
                          <span class="r-pole">{rozsah(i.plaste, ' mm')}</span>
                          <span class="r-pole">{tlakTxt(i.rad)}</span>
                          <span class="r-pole r-dim">{i.dimenzie > 0 ? `${i.dimenzie} dimenzií` : 'na dopyt'}</span>
                          <Ikona nazov="chevron-right" velkost={18} />
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
              <div class="reg-skupina">
                <div class="reg-kat"><span>Spojky a príslušenstvo</span></div>
                <ul class="reg-rady">
                  {diely.map((k) => (
                    <li>
                      <a href={cestaKategorie(k, lang)} class="reg-riadok reg-diel">
                        <span class="r-model">{kKratky(k, lang)}</span>
                        <span class="r-popis">{kPopis(k, lang)}</span>
                        <Ikona nazov="chevron-right" velkost={18} />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
            <p class="legenda"><span>rúry</span><span>nosná rúra</span><span>plášť</span><span>tlak</span><span>rozmery</span></p>
          </div>
        </div>
      </section>

      <!-- ============================== B ============================== -->
      <section class="navrh" id="b">
        <div class="wrap hlava">
          <h2><span class="pismeno">B</span> Rezy v mierke</h2>
          <p class="pravidlo">
            <strong>Edward Tufte, dátový atrament.</strong> Nie je to ikona ani fotka. Každý rez je
            nakreslený z katalógových čísel a všetky sú v jednej mierke, takže plášť 160 mm je na
            obrazovke naozaj dvakrát väčší než 75 mm. Počet rúr a médium vidno bez čítania. Obrázok
            tu nie je ozdoba, je to údaj.
          </p>
        </div>
        <div class="ukazka band-soft">
          <div class="wrap">
            <div class="section-head">
              <h3 class="h-sekcia">Katalóg Microflex</h3>
              <p class="muted">Rezy sú kreslené v jednej mierke zo základnej veľkosti každého radu. Čiarkovaný obrys znamená, že rad zatiaľ nemá stiahnutú tabuľku rozmerov.</p>
            </div>
            <div class="rezy">
              {vsetky.map((i) => (
                <a class="rez" href={cestaRadu(i.kat, i.rad, lang)}>
                  <svg class="rez-svg" viewBox={`0 0 ${MIERKA} ${MIERKA}`} role="img" aria-label={`Rez radom ${i.model}: plášť ${i.plast} mm, ${i.rury.length} rúry`}>
                    <circle cx={MIERKA / 2} cy={MIERKA / 2} r={i.plast / 2 - 1.5} class:list={['p-plast', { 'p-odhad': i.odhad }]} />
                    <circle cx={MIERKA / 2} cy={MIERKA / 2} r={i.plast / 2 - 4.5} class="p-pena" />
                    {rozlozenie(i.rury.length, i.rury[0].d / 2).map(([x, y], n) => (
                      <circle cx={x} cy={y} r={i.rury[n].d / 2} class={`p-rura p-${i.rury[n].farba}`} />
                    ))}
                  </svg>
                  <span class="rez-kat">{kKratky(i.kat, lang)}</span>
                  <span class="rez-model">{i.model}</span>
                  <span class="rez-fakt">{i.plaste.length ? `plášť ${rozsah(i.plaste, ' mm')}` : 'rozmery na dopyt'}</span>
                  <span class="rez-fakt muted">{i.dimenzie > 0 ? `${i.dimenzie} dimenzií` : 'na dopyt'}</span>
                </a>
              ))}
            </div>
            <div class="diely-riadok">
              {diely.map((k) => (
                <a class="diel" href={cestaKategorie(k, lang)}>
                  <strong>{kKratky(k, lang)}</strong>
                  <span class="muted">{kPopis(k, lang)}</span>
                  <Ikona nazov="chevron-right" velkost={18} />
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ============================== C ============================== -->
      <section class="navrh" id="c">
        <div class="wrap hlava">
          <h2><span class="pismeno">C</span> Médium a rady</h2>
          <p class="pravidlo">
            <strong>Refactoring UI, hierarchia.</strong> Návštevník vie, čo chce viesť, nie ako sa to
            volá. Vľavo je preto päť médií ako register s počtami, vpravo rady. Hierarchiu robí váha
            a veľkosť písma, nie rámčeky. Sekcia drží jedno ohnisko: zoznam médií.
          </p>
        </div>
        <div class="ukazka band-soft">
          <div class="wrap">
            <div class="section-head">
              <h3 class="h-sekcia">Katalóg Microflex</h3>
              <p class="muted">Vyberte, čo potrubím povediete.</p>
            </div>
            <div class="dve">
              <nav class="media" aria-label="Médiá">
                {info5.map((s) => (
                  <a href={cestaKategorie(s.kat, lang)}>
                    <strong>{kKratky(s.kat, lang)}</strong>
                    <span class="muted">{s.rady.length === 1 ? '1 rad' : `${s.rady.length} rady`}, {s.rady.reduce((a, b) => a + b.dimenzie, 0)} dimenzií</span>
                  </a>
                ))}
                <a href={cestaKategorie(diely[0], lang)} class="media-diely">
                  <strong>Spojky a príslušenstvo</strong>
                  <span class="muted">42 produktov</span>
                </a>
              </nav>
              <div class="zoznam">
                {info5.map((s) => (
                  <div class="zoz-skupina">
                    <h4>{kKratky(s.kat, lang)} <span class="muted">{popisKat(s.kat, s.rady)}</span></h4>
                    {s.rady.map((i) => (
                      <a class="zoz-rad" href={cestaRadu(i.kat, i.rad, lang)}>
                        <span class="z-model">{i.model}</span>
                        <span class="z-fakty muted">
                          {i.rad.pocet_rur === 1 ? '1 rúra' : `${i.rad.pocet_rur} rúry`}
                          {i.plaste.length ? ` · plášť ${rozsah(i.plaste, ' mm')}` : ' · rozmery na dopyt'}
                          {i.ohyb ? ` · ohyb od ${cislo(i.ohyb, 2)} m` : ''}
                        </span>
                        <span class="z-dim">{i.dimenzie > 0 ? i.dimenzie : '—'}</span>
                      </a>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============================== D ============================== -->
      <section class="navrh" id="d">
        <div class="wrap hlava">
          <h2><span class="pismeno">D</span> Katalógový index</h2>
          <p class="pravidlo">
            <strong>Tlačený katalóg a Tufte, hustota.</strong> Register ako na prvej strane katalógu:
            názov, vodiace bodky, čísla vpravo v jednom stĺpci. Celý sortiment, dvanásť radov aj sedem
            skupín dielov, sa zmestí na jednu obrazovku. Pre človeka, ktorý vie, čo hľadá, je to
            najrýchlejšia cesta.
          </p>
        </div>
        <div class="ukazka">
          <div class="wrap">
            <div class="section-head">
              <h3 class="h-sekcia">Katalóg Microflex</h3>
              <p class="muted">Celý sortiment na jednom mieste.</p>
            </div>
            <div class="index">
              {info5.map((s) => (
                <div class="idx-skupina">
                  <h4 class="idx-kat">
                    <a href={cestaKategorie(s.kat, lang)}>{kKratky(s.kat, lang)}</a>
                    <span class="muted">{popisKat(s.kat, s.rady)}</span>
                  </h4>
                  {s.rady.map((i) => (
                    <a class="idx" href={cestaRadu(i.kat, i.rad, lang)}>
                      <span class="i-model">{i.model}</span>
                      <span class="i-bodky" aria-hidden="true"></span>
                      <span class="i-c num">{i.rad.pocet_rur}</span>
                      <span class="i-c num">{rozsahK(i.plaste)}</span>
                      <span class="i-c num">{i.dimenzie > 0 ? i.dimenzie : '—'}</span>
                    </a>
                  ))}
                </div>
              ))}
              <div class="idx-skupina">
                <h4 class="idx-kat"><span>Spojky a príslušenstvo</span></h4>
                {diely.flatMap((k) => rady.filter((r) => r.kategoria === k.id).sort((a, b) => a.poradie - b.poradie).map((r) => (
                  <a class="idx" href={`${cestaKategorie(k, lang)}#h-${r.id}`}>
                    <span class="i-model i-tenky">{rNazov(r, lang)}</span>
                    <span class="i-bodky" aria-hidden="true"></span>
                    <span class="i-c num i-sirky">{r.produkty.length}</span>
                  </a>
                )))}
              </div>
            </div>
            <p class="legenda legenda-idx"><span></span><span></span><span>rúry</span><span>plášť mm</span><span>dimenzie</span></p>
          </div>
        </div>
      </section>

      <section class="uvod zaver">
        <div class="wrap">
          <h2>Odporúčanie</h2>
          <p class="lead">
            <strong>B pre domov, A pre stránku Potrubia.</strong> Rez v mierke je jediný spôsob, ako
            dať katalógu obraz bez toho, aby sa opakovala tá istá fotka rúry. Navyše ukazuje presne to,
            čím sa rady líšia: hrúbku plášťa a počet rúr. Na stránke Potrubia, kde už obraz nesie
            hlavička kategórie, je namieste pokojný register A. D je dobrý ako doplnok na stránku
            Na stiahnutie alebo do pätičky, C má zmysel, ak sa raz pridá filter.
          </p>
        </div>
      </section>
    </main>

    <style>
      .uvod { padding: 56px 0 40px; }
      .zaver { border-top: var(--line); margin-top: 64px; padding-bottom: 96px; }
      .stitok { display: inline-block; font-size: 12.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--color-ink-soft); border: var(--line); border-radius: var(--radius-s); padding: 4px 10px; margin-bottom: 16px; }
      .uvod h1 { font-size: clamp(32px, 3vw + 14px, 46px); margin-bottom: 16px; }
      .uvod .lead { max-width: 46em; }
      .obsahy { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: 32px; counter-reset: none; }
      .obsahy li { border-top: 2px solid var(--color-blue-700); padding-top: 10px; }
      .obsahy a { display: block; font-weight: 600; font-family: var(--font-display); font-stretch: 112.5%; font-size: 17px; }
      .obsahy span { display: block; font-size: 13.5px; color: var(--color-ink-soft); margin-top: 2px; }

      .navrh { scroll-margin-top: 90px; }
      .hlava { padding: 56px 0 28px; display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 32px; align-items: start; }
      .hlava h2 { font-size: 30px; display: flex; align-items: baseline; gap: 14px; }
      .pismeno { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 50%; background: var(--color-blue-900); color: #fff; font-size: 19px; flex: none; }
      .pravidlo { color: var(--color-ink-soft); max-width: 52em; }
      .pravidlo strong { color: var(--color-ink); font-weight: 600; }
      .ukazka { padding: 48px 0 56px; border-top: var(--line); border-bottom: var(--line); }
      .h-sekcia { font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 29px; letter-spacing: -0.01em; }
      .legenda { display: grid; grid-template-columns: minmax(0, 1fr) repeat(5, 92px) 18px; gap: 16px; margin-top: 12px; font-size: 12px; color: #7a8494; padding-left: 240px; }
      .legenda span { text-align: right; }

      /* ---------- A: register ---------- */
      .reg { border-top: var(--line); }
      .reg-skupina { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 0 24px; border-bottom: var(--line); }
      .reg-kat { padding: 22px 24px 22px 0; }
      .reg-kat a, .reg-kat > span:first-child { display: block; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 18px; color: var(--color-ink); letter-spacing: -0.01em; }
      .reg-kat a:hover { color: var(--color-blue-700); }
      .reg-kat span { display: block; font-size: 13px; color: var(--color-ink-soft); margin-top: 3px; }
      .reg-rady li + li { border-top: 1px solid rgb(11 27 51 / 0.08); }
      .reg-riadok { display: grid; grid-template-columns: minmax(0, 1fr) repeat(5, 92px) 18px; gap: 16px; align-items: center; padding: 14px 0; color: var(--color-ink); }
      .reg-riadok:hover { color: var(--color-blue-700); }
      .reg-riadok:hover .r-model { color: var(--color-blue-700); }
      .r-model { font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 17px; color: var(--color-blue-900); letter-spacing: -0.01em; }
      .r-rury, .r-pole { text-align: right; font-size: 14px; color: var(--color-ink-soft); font-variant-numeric: tabular-nums; white-space: nowrap; }
      .r-dim { color: var(--color-ink); }
      .reg-riadok :global(svg) { justify-self: end; color: var(--color-grey-300); }
      .reg-riadok:hover :global(svg) { color: var(--color-blue-700); }
      .reg-diel { grid-template-columns: 200px minmax(0, 1fr) 18px; }
      .r-popis { font-size: 14px; color: var(--color-ink-soft); }

      /* ---------- B: rezy v mierke ---------- */
      .rezy { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 28px 20px; }
      .rez { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; color: var(--color-ink); }
      .rez-svg { width: 100%; height: auto; display: block; margin-bottom: 10px; transition: transform 300ms var(--ease-soft); }
      .rez:hover .rez-svg { transform: translateY(-3px) scale(1.03); }
      .p-plast { fill: none; stroke: #1b4e9b; stroke-width: 3; }
      .p-odhad { stroke: var(--color-grey-300); stroke-dasharray: 5 4; }
      .p-pena { fill: #e6e9ee; }
      .p-rura { stroke: rgb(11 27 51 / 0.35); stroke-width: 1.2; }
      .p-zlta { fill: var(--color-yellow-500); }
      .p-biela { fill: #fdfdfb; }
      .p-tmava { fill: #2b3440; }
      .rez-kat { font-size: 11.5px; letter-spacing: .05em; text-transform: uppercase; color: var(--color-ink-soft); line-height: 1.3; }
      .rez-model { font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 16px; line-height: 1.2; color: var(--color-blue-900); letter-spacing: -0.01em; margin-bottom: 2px; }
      .rez:hover .rez-model { color: var(--color-blue-700); }
      .rez-fakt { font-size: 13px; color: var(--color-ink-soft); font-variant-numeric: tabular-nums; }
      .diely-riadok { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 44px; padding-top: 28px; border-top: var(--line); }
      .diel { display: grid; grid-template-columns: 200px minmax(0, 1fr) 18px; gap: 20px; align-items: center; color: var(--color-ink); padding: 6px 0; }
      .diel strong { font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 17px; }
      .diel span { font-size: 14px; }
      .diel:hover strong { color: var(--color-blue-700); }
      .diel :global(svg) { color: var(--color-grey-300); }

      /* ---------- C: médium a rady ---------- */
      .dve { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px; }
      .media { display: flex; flex-direction: column; border-top: var(--line); }
      .media a { display: block; padding: 16px 0; border-bottom: var(--line); color: var(--color-ink); }
      .media strong { display: block; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 19px; letter-spacing: -0.01em; }
      .media span { font-size: 13.5px; }
      .media a:hover strong { color: var(--color-blue-700); }
      .media-diely { margin-top: 20px; border-top: var(--line); }
      .zoz-skupina + .zoz-skupina { margin-top: 32px; }
      .zoz-skupina h4 { font-size: 14px; font-family: var(--font-text); font-stretch: 100%; font-weight: 600; letter-spacing: 0; padding-bottom: 8px; border-bottom: var(--line); }
      .zoz-skupina h4 .muted { font-weight: 400; }
      .zoz-rad { display: grid; grid-template-columns: 200px minmax(0, 1fr) 40px; gap: 20px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid rgb(11 27 51 / 0.08); color: var(--color-ink); }
      .z-model { font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 17px; color: var(--color-blue-900); letter-spacing: -0.01em; }
      .zoz-rad:hover .z-model { color: var(--color-blue-700); }
      .z-fakty { font-size: 14px; }
      .z-dim { text-align: right; font-variant-numeric: tabular-nums; font-size: 14px; color: var(--color-ink-soft); }

      /* ---------- D: index ---------- */
      .index { columns: 2; column-gap: 64px; }
      .idx-skupina { break-inside: avoid; margin-bottom: 28px; }
      .idx-kat { display: flex; align-items: baseline; gap: 10px; font-size: 14px; font-family: var(--font-text); font-stretch: 100%; font-weight: 600; letter-spacing: 0; padding-bottom: 6px; border-bottom: var(--line); margin-bottom: 4px; }
      .idx-kat .muted { font-weight: 400; font-size: 13px; }
      .idx { display: grid; grid-template-columns: auto minmax(20px, 1fr) 28px 62px 46px; gap: 10px; align-items: baseline; padding: 7px 0; color: var(--color-ink); }
      .i-model { font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 15.5px; color: var(--color-blue-900); letter-spacing: -0.01em; }
      .i-tenky { font-family: var(--font-text); font-stretch: 100%; font-weight: 500; font-size: 15px; color: var(--color-ink); }
      .idx:hover .i-model, .idx:hover .i-tenky { color: var(--color-blue-700); }
      .i-bodky { border-bottom: 1px dotted var(--color-grey-300); transform: translateY(-4px); }
      .i-c { text-align: right; font-size: 14px; color: var(--color-ink-soft); font-variant-numeric: tabular-nums; white-space: nowrap; }
      .i-sirky { grid-column: 3 / -1; }
      .legenda-idx { grid-template-columns: auto minmax(20px, 1fr) 28px 62px 46px; padding-left: 0; display: grid; gap: 10px; width: calc(50% - 32px); margin-top: 4px; }

      @media (max-width: 1100px) {
        .hlava, .dve { grid-template-columns: 1fr; gap: 16px; }
        .obsahy { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .rezy { grid-template-columns: repeat(4, minmax(0, 1fr)); }
        .index { columns: 1; }
        .legenda { display: none; }
      }
      @media (max-width: 760px) {
        .obsahy { grid-template-columns: 1fr; }
        .rezy { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .reg-skupina { grid-template-columns: 1fr; }
        .reg-kat { padding-bottom: 8px; }
        .reg-riadok { grid-template-columns: minmax(0, 1fr) auto; row-gap: 4px; }
        .r-rury, .r-pole { text-align: left; }
        .reg-riadok :global(svg) { display: none; }
        .diely-riadok, .zoz-rad { grid-template-columns: 1fr; }
      }
    </style>
  </body>
