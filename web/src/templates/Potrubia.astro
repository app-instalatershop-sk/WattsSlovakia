---
/**
 * Prehľad potrubí: päť systémov hadovito (render striedavo vľavo a vpravo), pod tým všetky rady
 * v jednej porovnávacej tabuľke a vstup do spojok a príslušenstva.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hlava from '../components/Hlava.astro';
import Zaver from '../components/Zaver.astro';
import Ikona from '../components/Ikona.astro';
import { kategorie, cestaKategorie, cestaRadu, kNazov, kKratky, kPopis, rNazov, rMedium, cislo, rozsah, rozsahRur, tlakyRadov, tlakText, type Kategoria, type Rad, type Variant } from '../lib/katalog';
import { piktogram, fotka } from '../lib/obrazky';
import { sadzba } from '../lib/sadzba';
import { stranky } from '../content/stranky';
import { type Lang, t, route, staticAlternates, KATALOG_PDF } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const tx = stranky(lang).potrubia;
const vsetky = await kategorie();
const potrubia = vsetky.filter((k) => k.typ === 'potrubie');
const diely = vsetky.filter((k) => k.typ !== 'potrubie');
const rady = (await getCollection('rady')).map((r) => r.data).sort((a, b) => a.poradie - b.poradie);
const varianty = (await getCollection('varianty')).map((v) => v.data);
const produkty = (await getCollection('produkty')).map((p) => p.data);
const rodina = fotka('rodina-potrubi.png')!;
const obrazDielov: Record<string, string> = { spojky: 'montaz-odbocka.jpg', prislusenstvo: 'montaz-koleno.jpg' };

const radyKat = (k: Kategoria) => rady.filter((r) => r.kategoria === k.id);
const variantyRadu = (r: Rad): Variant[] => varianty.filter((v) => v.rad === r.id);
const model = (r: Rad) => rNazov(r, lang).split(',')[0].trim();
const bezZnacky = (r: Rad) => model(r).replace(/^Microflex\s+/i, '');
const pk = ui.common.podlaKatalogu;
/** V tabuľke sa chýbajúci údaj nepíše slovami v každej bunke: pomlčka a vysvetlivka pod tabuľkou. */
const nic = '–';

function fakty(k: Kategoria) {
  const rr = radyKat(k);
  const vs = rr.flatMap(variantyRadu);
  const tlaky = tlakyRadov(rr);
  const pol = vs.map((v) => v.polomer_ohybu_m).filter((x): x is number => typeof x === 'number');
  return [
    [tx.tlak, tlaky.length ? `${tlaky.join(' / ')} bar` : pk],
    [tx.rura, rozsahRur(vs, lang) || pk],
    [tx.plast, vs.length ? rozsah(vs.map((v) => v.plast_mm), 'mm', lang) : pk],
    [tx.polomer, pol.length ? `${ui.common.od} ${cislo(Math.min(...pol), 2)} m` : pk],
  ];
}
function riadok(r: Rad) {
  const vs = variantyRadu(r);
  const pol = vs.map((v) => v.polomer_ohybu_m).filter((x): x is number => typeof x === 'number');
  return {
    medium: rMedium(r, lang) ?? '',
    rury: r.pocet_rur ? String(r.pocet_rur) : nic,
    tlak: tlakText(r) || nic,
    rura: rozsahRur(vs, lang) || nic,
    plast: vs.length ? rozsah(vs.map((v) => v.plast_mm), 'mm', lang) : nic,
    polomer: pol.length ? `${ui.common.od} ${cislo(Math.min(...pol), 2)} m` : nic,
    dim: vs.length ? String(vs.length) : nic,
  };
}
const produktySkupiny = (id: string) => produkty.filter((p) => p.skupina === id).length;
---
<Base lang={lang} alternates={staticAlternates('potrubia')} title={ui.potrubia.title} description={ui.potrubia.description} aktivna="potrubia" drobceky={[{ text: ui.nav.potrubia }]} vizualneDrobceky={false}>
  <Hlava lang={lang} nadpis={ui.potrubia.title} drobceky={[{ text: ui.nav.potrubia }]} lead={ui.potrubia.lead} obraz={rodina} obrazAlt={ui.potrubia.rodinaAlt} obrazMax={980}>
    <div class="hlava-akcie">
      <a class="btn btn-yellow" href={route(lang, 'vyber')}>{tx.sprievodca} <Ikona nazov="arrow-right" velkost={18} /></a>
      <a class="odkaz" href={KATALOG_PDF} target="_blank" rel="noopener">{tx.katalog} <Ikona nazov="download" velkost={16} /></a>
    </div>
  </Hlava>

  <div class="telo">
    <section class="wrap" aria-labelledby="h-sys">
      <div class="s-hlava"><h2 id="h-sys">{tx.systemyH2}</h2><p>{sadzba(tx.systemyP)}</p></div>
      <ol class="systemy">
        {potrubia.map((k, i) => { const img = piktogram(k.piktogram); const href = cestaKategorie(k, lang); return (
          <li class:list={['sys', { 'sys-vpravo': i % 2 === 1 }]}>
            <a class="sys-obraz" href={href} tabindex="-1" aria-hidden="true">
              {img && <Image src={img} alt="" widths={[420, 640, 900]} sizes="(max-width: 900px) 80vw, 40vw" />}
            </a>
            <div class="sys-text">
              <h3><a href={href}>{kNazov(k, lang)}</a></h3>
              <p>{sadzba(kPopis(k, lang))}</p>
              <dl class="sys-fakty">
                {fakty(k).map(([dt, dd]) => <div><dt>{dt}</dt><dd>{dd}</dd></div>)}
              </dl>
              <ul class="sys-rady">
                {radyKat(k).map((r) => <li><a href={cestaRadu(k, r, lang)}>{bezZnacky(r)}</a></li>)}
              </ul>
              <a class="odkaz" href={href}>{tx.rozmery} <Ikona nazov="arrow-right" velkost={16} /></a>
            </div>
          </li>
        ); })}
      </ol>
    </section>

    <section class="wrap" aria-labelledby="h-tab">
      <div class="s-hlava"><h2 id="h-tab">{tx.tabulkaH2}</h2><p>{sadzba(tx.tabulkaP)}</p></div>
      <div class="harok tab-obal">
        <table class="data prehlad">
          <thead><tr>{tx.stlpce.map((s, i) => <th class:list={{ right: i >= 2 }}>{s}</th>)}</tr></thead>
          {potrubia.map((k) => (
            <tbody>
              <tr class="skupina"><th colspan={tx.stlpce.length} scope="colgroup"><a href={cestaKategorie(k, lang)}>{kKratky(k, lang)}</a></th></tr>
              {radyKat(k).map((r) => { const d = riadok(r); return (
                <tr>
                  <td class="nazov"><a href={cestaRadu(k, r, lang)}>{model(r)}</a></td>
                  <td>{d.medium}</td>
                  <td class="right">{d.rury}</td>
                  <td class="right">{d.tlak}</td>
                  <td class="right">{d.rura}</td>
                  <td class="right">{d.plast}</td>
                  <td class="right">{d.polomer}</td>
                  <td class="right">{d.dim}</td>
                </tr>
              ); })}
            </tbody>
          ))}
        </table>
      </div>
      <p class="source">{tx.legenda} {ui.common.zdroj} {new Date(rady[0].stiahnute).toLocaleDateString(lang === 'cs' ? 'cs-CZ' : 'sk-SK')}.</p>
    </section>

    <section class="wrap" aria-labelledby="h-diely">
      <div class="s-hlava"><h2 id="h-diely">{tx.dielyH2}</h2><p>{sadzba(tx.dielyP)}</p></div>
      <div class="diely">
        {diely.map((k) => { const img = fotka(obrazDielov[k.id]); return (
          <article class="diel harok">
            <a class="diel-obraz" href={cestaKategorie(k, lang)} tabindex="-1" aria-hidden="true">{img && <Image src={img} alt="" widths={[360, 560]} sizes="(max-width: 760px) 80vw, 280px" />}</a>
            <div class="diel-text">
              <h3><a href={cestaKategorie(k, lang)}>{kKratky(k, lang)}</a></h3>
              <p>{sadzba(kPopis(k, lang))}</p>
              <ul>
                {radyKat(k).map((s) => <li><a href={`${cestaKategorie(k, lang)}#h-${s.id}`}><span>{rNazov(s, lang)}</span><span class="pocet">{tx.produktov(produktySkupiny(s.id))}</span></a></li>)}
              </ul>
            </div>
          </article>
        ); })}
      </div>
    </section>
  </div>
  <Zaver lang={lang} />
</Base>

<style>
  /* Systémy hadovito: render striedavo vľavo a vpravo, text na opačnej strane. */
  .systemy { display: flex; flex-direction: column; gap: 8px; }
  .sys { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 16px 64px; align-items: center; }
  .sys-vpravo { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .sys-obraz { position: relative; display: block; padding: 12px 0 28px; }
  /* Mäkké svetlo štúdia za výrobkom a tieň na podlahe. */
  .sys-obraz::before { content: ""; position: absolute; inset: -6% -4% 4%; background: radial-gradient(50% 50% at 50% 50%, #fff 0%, rgb(255 255 255 / 0.55) 45%, rgb(255 255 255 / 0) 72%); z-index: 0; }
  .sys-obraz::after { content: ""; position: absolute; left: 18%; right: 14%; bottom: 18px; height: 26px; border-radius: 50%; background: radial-gradient(closest-side, rgb(10 42 94 / 0.24), rgb(10 42 94 / 0)); }
  .sys-obraz :global(img) { position: relative; z-index: 1; width: 100%; max-width: 400px; height: auto; margin-inline: auto; filter: drop-shadow(0 22px 24px rgb(11 27 51 / 0.2)); transition: transform 450ms var(--ease-soft); }
  .sys:hover .sys-obraz :global(img) { transform: translateY(-6px); }
  .sys-vpravo .sys-obraz { order: 2; }
  .sys-text h3 { font-size: clamp(22px, 1vw + 16px, 28px); letter-spacing: -0.015em; }
  .sys-text h3 a { color: var(--color-ink); }
  .sys-text h3 a:hover { color: var(--color-blue-700); }
  .sys-text > p { margin-top: 10px; color: var(--color-ink-soft); max-width: 36em; }
  .sys-fakty { display: grid; grid-template-columns: repeat(4, minmax(0, auto)); justify-content: start; gap: 4px 28px; margin: 22px 0 0; }
  .sys-fakty dt { font-size: 13px; color: var(--color-ink-soft); }
  .sys-fakty dd { margin: 2px 0 0; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 17px; letter-spacing: -0.01em; color: var(--color-blue-900); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .sys-rady { display: flex; flex-wrap: wrap; gap: 8px; margin: 22px 0 20px; }
  .sys-rady a { display: inline-flex; align-items: center; height: 34px; padding: 0 14px; border-radius: 999px; background: rgb(255 255 255 / 0.8); box-shadow: inset 0 0 0 1px rgb(0 93 185 / 0.18); color: var(--color-blue-900); font-weight: 600; font-size: 14px; letter-spacing: .01em; transition: background-color 150ms var(--ease-soft), box-shadow 150ms var(--ease-soft); }
  .sys-rady a:hover { background: #fff; box-shadow: inset 0 0 0 1px var(--color-blue-700); color: var(--color-blue-700); }

  /* Tabuľka všetkých radov na bielom hárku; kategória je riadok nadpisu skupiny. */
  .tab-obal { overflow-x: auto; padding: 8px 20px 12px; }
  .prehlad { min-width: 820px; }
  .prehlad td, .prehlad th { white-space: nowrap; }
  .prehlad thead th { background: #fff; }
  .prehlad .skupina th { padding-top: 22px; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 15px; color: var(--color-blue-700); background: #fff; position: static; border-bottom: 2px solid var(--color-blue-100); }
  .prehlad .skupina a { color: inherit; }
  .prehlad td.nazov a { font-weight: 600; color: var(--color-ink); }
  .prehlad td.nazov a:hover { color: var(--color-blue-700); }
  .source { margin-top: 12px; }

  /* Spojky a príslušenstvo: dva hárky s renderom montáže. */
  .diely { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .diel { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 8px 24px; padding: 24px; align-items: start; }
  .diel-obraz { display: block; mix-blend-mode: multiply; }
  .diel-obraz :global(img) { width: 100%; height: auto; -webkit-mask-image: radial-gradient(70% 70% at 50% 50%, #000 60%, transparent 100%); mask-image: radial-gradient(70% 70% at 50% 50%, #000 60%, transparent 100%); }
  .diel h3 { font-size: 22px; }
  .diel h3 a { color: var(--color-ink); }
  .diel-text > p { margin-top: 8px; font-size: 15px; color: var(--color-ink-soft); }
  .diel ul { margin-top: 14px; }
  .diel li a { display: flex; justify-content: space-between; gap: 12px; padding: 9px 0; border-top: 1px solid rgb(10 42 94 / 0.1); font-size: 15px; font-weight: 500; }
  .diel .pocet { font-weight: 400; color: var(--color-ink-soft); white-space: nowrap; }

  @media (max-width: 1100px) { .diely { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 900px) {
    .sys, .sys-vpravo { grid-template-columns: minmax(0, 1fr); }
    .sys-vpravo .sys-obraz { order: 0; }
    .sys-obraz :global(img) { max-width: 420px; }
    .sys-fakty { grid-template-columns: repeat(2, minmax(0, auto)); gap: 10px 28px; }
  }
  @media (max-width: 560px) { .diel { grid-template-columns: minmax(0, 1fr); } .diel-obraz :global(img) { max-width: 260px; } }
</style>
