---
/**
 * Katalóg na domove: výber podľa použitia. Vľavo „štúdio“: rendery radov stoja na jednej podlahe ako
 * výrobky pri fotení, svetlo štúdia vybieha za ľavý okraj obrazovky (stránka je zložená hadovito,
 * obrázky sa striedajú vpravo a vľavo). Vpravo nadpis a register kategórií ako palcový register na okraji
 * tlačeného katalógu, pod ním popis vybranej kategórie. Záložky sú prepínače (radio + label), fungujú bez skriptu a obsah
 * všetkých panelov je v HTML kvôli vyhľadávačom. Rad dostane render len vtedy, keď má vlastný;
 * vyhotovenia, ktoré zdieľajú render so súrodencom (PRIMO), sú vymenované v popise.
 */
import Obraz from './Obraz.astro';
import { getCollection } from 'astro:content';
import Ikona from './Ikona.astro';
import { kategorie, cestaKategorie, cestaRadu, kKratky, kPopis, rNazov, rozsah, type Kategoria, type Rad } from '../lib/katalog';
import { obrazRadu, je3d, fotkaProduktu } from '../lib/obrazky';
import { sadzba } from '../lib/sadzba';
import { type Lang, t, route } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const h = ui.home;

const kats = await kategorie();
const rady = (await getCollection('rady')).map((r) => r.data);
const varianty = (await getCollection('varianty')).map((v) => v.data);
const potrubia = kats.filter((k) => k.typ === 'potrubie');
const diely = kats.filter((k) => k.typ !== 'potrubie');

/** Názov radu bez upresnenia za čiarkou: „Microflex UNO, vykurovanie 6 bar“ → „Microflex UNO“. */
const model = (r: Rad) => rNazov(r, lang).split(',')[0].trim();
/** Tichý riadok pod názvom: počet dimenzií a rozsah plášťa z dát, inak odkaz na katalóg. */
function udaje(r: Rad): string {
  const vv = varianty.filter((v) => v.rad === r.id);
  if (!vv.length) return ui.common.rozmeryVKatalogu;
  const plast = rozsah(vv.map((v) => v.plast_mm), 'mm', lang);
  return `${ui.sklonovanie.dimenzii(vv.length)}, ${h.plast} ${plast}`;
}
/** Čím sa vyhotovenie líši od základného radu. PRIMO je tá istá rúra v užšom plášti (katalóg s. 8 až 11). */
const odlisnost = (r: Rad) => (/PRIMO/i.test(model(r)) ? h.primo : h.rury(r.pocet_rur ?? 1));

/** Dlaždica = jeden render a všetky rady, ktoré ho zdieľajú. Počet radov v registri tak sedí
    s tým, čo je vidieť, a ten istý obrázok sa neopakuje dvakrát vedľa seba. */
type Dlazdica = { rad: Rad; vyhotovenia: Rad[] };
function panel(k: Kategoria) {
  const rr = rady.filter((r) => r.kategoria === k.id).sort((a, b) => a.poradie - b.poradie);
  const dlazdice: Dlazdica[] = [];
  for (const r of rr) {
    const spolocna = r.piktogram ? dlazdice.find((d) => d.rad.piktogram === r.piktogram) : undefined;
    if (spolocna) spolocna.vyhotovenia.push(r);
    else dlazdice.push({ rad: r, vyhotovenia: [] });
  }
  return { kat: k, pocet: rr.length, dlazdice };
}
const panely = potrubia.map(panel);
const skupiny = (k: Kategoria) => rady.filter((r) => r.kategoria === k.id).sort((a, b) => a.poradie - b.poradie);
// Skupina dielov dostane výrez jedného typického dielu (DOLADENIE kap. 2.5: riadok odkazov bez obrazu).
const TYPICKY: Record<string, string> = {
  'pe-x-spojky-vykurovanie-a-cool': 'pe-x-x-pe-x-spojka-kurenie', 'pe-x-spojky-sanita': 'sanitarne-spojky-microflex-pe-x',
  'prislusenstvo-spojok': 't-kus-z-bronzu', 'koncovky-a-redukcie': 'teplom-zmrstitelne-hlavice-pre-uno-rurku',
  'izolacne-sady': 'izolovana-suprava-t-kusu', 'opravne-a-vystrazne-pasky': 'vystrazna-paska', 'prestupy-stenou': 'tesnenie-na-prienik-na-stenu-micro-press',
};
const dielSkupiny = (r: Rad) => fotkaProduktu(TYPICKY[r.id] ?? '') ?? r.produkty.map(fotkaProduktu).find(Boolean);
---
<section id="vyber" class="section katalog" aria-labelledby="h-kat">
  <div class="wrap">
    <div class="kat-taby">
      <div class="kat-hlava">
        <h2 id="h-kat">{h.katalogH2}</h2>
      </div>
      <div class="t-list" role="radiogroup" aria-labelledby="h-kat">
        {panely.map((p, i) => (
          <label class="t-lbl">
            <input type="radio" name="katalog-tab" value={p.kat.id} aria-controls={`katalog-panel-${p.kat.id}`} checked={i === 0} />
            <span class="t-nazov">{kKratky(p.kat, lang)}</span>
            <span class="t-pocet">{ui.sklonovanie.radov(p.pocet)}</span>
          </label>
        ))}
      </div>

      <div class="t-panely">
        {panely.map((p) => (
          <div id={`katalog-panel-${p.kat.id}`} class="t-panel" role="group" aria-label={kKratky(p.kat, lang)}>
            <div class="t-info">
              <p>{sadzba(kPopis(p.kat, lang))}</p>
            </div>
            <div id={`katalog-rady-${p.kat.id}`} class="studio" data-pocet={p.dlazdice.length}>
              {p.dlazdice.map(({ rad: r, vyhotovenia }) => { const img = obrazRadu(r); const href = cestaRadu(p.kat, r, lang); return (
                <div class="rad">
                  <a class:list={['rad-obj', { je3d: je3d(img) }]} href={href} tabindex="-1" aria-hidden="true" style={`view-transition-name: rad-${r.id}`}>
                    {img && <Obraz src={img} alt="" widths={[420, 640, 900]} sizes="(max-width: 760px) 78vw, (max-width: 1100px) 44vw, 34vw" class="rad-img" />}
                  </a>
                  <div class="rad-txt">
                    <a class="rad-hlavny" href={href}>
                      <strong>{sadzba(model(r))}</strong>
                      <span class="rad-rury">{h.rury(r.pocet_rur ?? 1)}</span>
                      <span class="rad-data">{sadzba(udaje(r))}</span>
                    </a>
                    {vyhotovenia.map((v) => (
                      <a class="rad-vyh" href={cestaRadu(p.kat, v, lang)}>
                        <strong>{sadzba(model(v))}</strong>
                        <span>{sadzba(odlisnost(v))}</span>
                      </a>
                    ))}
                  </div>
                </div>
              ); })}
            </div>
            {/* Telefón: poloha v páse radov (Juraj 28. 10.: jeden posuvný pás, s viditeľnou polohou). */}
            {p.dlazdice.length > 1 && <div class="studio-bodky">{p.dlazdice.map(({ rad }, i) => <button type="button" class:list={{ 'je-tu': i === 0 }} aria-label={h.zobrazitRad(model(rad))} aria-controls={`katalog-rady-${p.kat.id}`} aria-pressed={i === 0}><span aria-hidden="true"></span></button>)}</div>}
          </div>
        ))}
      </div>

      <a class="vsetko" href={route(lang, 'potrubia')}>{h.celyKatalog} <Ikona nazov="arrow-up-right" velkost={16} /></a>
    </div>

    <div class="diely">
      <h3>{h.dielyH3}</h3>
      <ul class="diely-skupiny">
        {diely.flatMap((k) => skupiny(k).map((r) => { const img = dielSkupiny(r); return (
          <li><a href={`${cestaKategorie(k, lang)}#h-${r.id}`}>{img && <span class="diel-obr"><Obraz src={img} alt="" width={48} height={48} densities={[1, 2]} /></span>}<span>{rNazov(r, lang)}</span> <Ikona nazov="chevron-right" velkost={16} /></a></li>
        ); }))}
      </ul>
      {/* Telefón: jeden vstup (spojky a príslušenstvo) namiesto siedmich riadkov skupín (Juraj 28. 10.). */}
      <ul class="diely-vstup">
        {diely.map((k) => { const img = dielSkupiny(skupiny(k)[0]); return (
          <li><a href={cestaKategorie(k, lang)}>{img && <span class="diel-obr"><Obraz src={img} alt="" width={48} height={48} densities={[1, 2]} /></span>}<span>{kKratky(k, lang)}</span> <Ikona nazov="chevron-right" velkost={16} /></a></li>
        ); })}
      </ul>
    </div>
  </div>
</section>

<style>
  /* Pás sa podsunie pod spodok hero a má šikmú hornú hranu ako podzemie: vľavo začína pod textom hero,
     vpravo vyššie, takže ju spodok renderu pretína. Dole ostáva miesto pre render rodiny, ktorý
     zhora prechádza cez švík do bielej sekcie pod ním. */
  .katalog { position: relative; isolation: isolate; margin-top: calc(-1 * var(--presah-hero)); padding-top: calc(var(--presah-hero) + 84px); padding-bottom: 200px; scroll-margin-top: calc(72px - var(--presah-hero)); overflow-x: clip; }
  /* Pás siaha o 1 px pod sekciu: pri zlomkovej výške by medzi ním a rodinou ostala svetlá vlasová škára. */
  .katalog::before { content: ""; position: absolute; inset: 0 0 -1px; z-index: -1; background: linear-gradient(180deg, var(--zem-1) 0%, var(--zem-2) 100%);
    -webkit-mask: var(--hrana-ohyb) left top / 100% var(--presah-hero) no-repeat, linear-gradient(#000 0 0) left var(--presah-hero) / 100% 100% no-repeat;
    mask: var(--hrana-ohyb) left top / 100% var(--presah-hero) no-repeat, linear-gradient(#000 0 0) left var(--presah-hero) / 100% 100% no-repeat; }
  .katalog h2 { font-size: clamp(28px, 2.2vw + 14px, 42px); margin-bottom: 32px; }

  /* Dva stĺpce na mriežke 7 / 5. Panely sú podmriežka cez celú šírku, takže popis vybranej kategórie
     sedí vpravo pod registrom a rendery vľavo, hoci patria do toho istého panela. */
  .kat-taby { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); grid-template-rows: auto auto auto 1fr; column-gap: 56px; }
  .kat-hlava { grid-column: 2; grid-row: 1; position: relative; z-index: 2; }
  .t-list { grid-column: 2; grid-row: 2; position: relative; z-index: 2; border-top: var(--line); }
  .t-panely { grid-column: 1 / -1; grid-row: 1 / -1; display: grid; grid-template-columns: subgrid; grid-template-rows: subgrid; }
  .t-panel { grid-column: 1 / -1; grid-row: 1 / -1; display: none; grid-template-columns: subgrid; grid-template-rows: subgrid; }
  .vsetko { grid-column: 2; grid-row: 4; align-self: end; justify-self: start; position: relative; z-index: 2; display: inline-flex; align-items: center; gap: 8px; font-weight: 500; border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  .vsetko :global(svg) { width: 16px; height: 16px; }

  /* Register: riadok = kategória a počet radov. Vybraná má žltú značku, farbu jadra rúry. */
  .t-lbl { position: relative; display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding: 16px 0 16px 20px; border-bottom: var(--line); cursor: pointer; color: var(--color-ink-soft); transition: color 150ms var(--ease-soft); }
  .t-lbl::before { content: ""; position: absolute; left: 0; top: 50%; width: 4px; height: 0; border-radius: 2px; background: var(--color-yellow-500); transform: translateY(-50%); transition: height 250ms var(--ease-soft); }
  .t-lbl input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }
  .t-nazov { font-family: var(--font-display); font-stretch: 112.5%; font-weight: 500; font-size: 20px; line-height: 1.25; letter-spacing: -0.01em; }
  .t-pocet { font-size: 14px; font-variant-numeric: tabular-nums; white-space: nowrap; color: var(--color-ink-soft); }
  .t-lbl:hover { color: var(--color-ink); }
  .t-lbl:has(input:checked) { color: var(--color-ink); }
  .t-lbl:has(input:checked) .t-nazov { font-weight: 650; }
  .t-lbl:has(input:checked)::before { height: 26px; }
  .t-lbl:has(input:checked) .t-pocet { color: var(--color-ink-soft); }
  .t-lbl:has(input:focus-visible) { outline: 2px solid var(--color-blue-700); outline-offset: 2px; border-radius: 2px; }

  /* Pár záložka → panel. Kategórií je päť, šiesty pár je rezerva pri rozšírení katalógu. */
  .kat-taby:has(.t-lbl:nth-of-type(1) input:checked) .t-panel:nth-of-type(1),
  .kat-taby:has(.t-lbl:nth-of-type(2) input:checked) .t-panel:nth-of-type(2),
  .kat-taby:has(.t-lbl:nth-of-type(3) input:checked) .t-panel:nth-of-type(3),
  .kat-taby:has(.t-lbl:nth-of-type(4) input:checked) .t-panel:nth-of-type(4),
  .kat-taby:has(.t-lbl:nth-of-type(5) input:checked) .t-panel:nth-of-type(5),
  .kat-taby:has(.t-lbl:nth-of-type(6) input:checked) .t-panel:nth-of-type(6) { display: grid; }

  .t-info { grid-column: 2; grid-row: 3; padding: 24px 24px 32px 20px; color: var(--color-ink-soft); max-width: 30em; animation: panel 420ms var(--ease-soft) both; }

  /* Štúdio: mäkké svetlo za výrobkami. Podmriežka dáva všetkým radom dva spoločné riadky:
     rendery stoja na jednej podlahe a popisy začínajú na jednej linke, aj keď má názov dva riadky. */
  /* Rendery stoja na mriežke, za ľavý okraj obrazovky vybieha len svetlo štúdia. Telá rúr sú orezané
     už v samotných renderoch výrobcu, preto ich za okraj nepúšťame. */
  .studio { grid-column: 1; grid-row: 1 / -1; position: relative; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); grid-template-rows: 1fr auto; column-gap: 28px; align-content: end; min-height: 520px; }
  .studio::before { content: ""; position: absolute; inset: -40px -4% 36px calc(-1 * var(--bleed)); background: radial-gradient(52% 60% at 58% 50%, #ffffff 0%, rgb(255 255 255 / 0.6) 42%, rgb(255 255 255 / 0) 72%); pointer-events: none; }
  .rad { position: relative; grid-row: span 2; display: grid; grid-template-rows: subgrid; color: var(--color-ink); animation: panel 520ms var(--ease-soft) both; }
  .rad:nth-child(2) { animation-delay: 70ms; }
  .rad:nth-child(3) { animation-delay: 140ms; }
  /* Jeden rad: väčší render, popis pod ním ako pri ostatných. */
  .studio[data-pocet="1"] { grid-auto-columns: minmax(0, 72%); }
  /* Tieň nesie obal a masku obrázok. Maska a tieň na jednom prvku by tieň orezali na hranu boxu. */
  .rad-obj { position: relative; display: block; align-self: end; filter: drop-shadow(0 26px 26px rgb(11 27 51 / 0.2)); transition: transform 400ms var(--ease-soft); }
  .rad-obj::after { content: ""; position: absolute; left: 14%; right: 6%; bottom: -6px; height: 22px; border-radius: 50%; background: radial-gradient(closest-side, rgb(10 42 94 / 0.22), rgb(10 42 94 / 0)); z-index: -1; }
  /* Telo rúry pokračuje za ľavý okraj renderu: doznenie zľava a do horného ľavého rohu skryje rez obrázkom. */
  .rad-obj :global(.rad-img) { width: 100%; height: auto; aspect-ratio: 5 / 4; object-fit: contain; object-position: center bottom; display: block;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 22%), linear-gradient(to top left, #000 78%, transparent 99%); -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent 0%, #000 22%), linear-gradient(to top left, #000 78%, transparent 99%); mask-composite: intersect; }
  /* Render 3D modelu: celé telo a vlastný kontaktný tieň, bez doznenia, bez tieňa z CSS a bez elipsy podlahy. */
  .rad-obj.je3d { filter: none; }
  .rad-obj.je3d::after { display: none; }
  .rad-obj.je3d :global(.rad-img) { -webkit-mask-image: none; mask-image: none; }
  @media (hover: hover) and (pointer: fine) { .rad:has(a:hover) .rad-obj { transform: translateY(-6px); } }
  .rad-txt { display: flex; flex-direction: column; align-self: start; padding-top: 24px; border-top: 1px solid rgb(10 42 94 / 0.14); margin-top: 16px; }
  .rad-hlavny { display: flex; flex-direction: column; gap: 2px; color: var(--color-ink); }
  .rad-hlavny strong { font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 22px; line-height: 1.2; letter-spacing: -0.01em; color: var(--color-ink); transition: color 150ms var(--ease-soft); }
  .rad-hlavny:hover strong, .rad:has(.rad-obj:hover) .rad-hlavny strong { color: var(--color-blue-700); }
  .rad-rury { font-size: 15px; color: var(--color-ink-soft); }
  .rad-data { font-size: 14px; color: var(--color-ink-soft); font-variant-numeric: tabular-nums; }
  /* Vyhotovenie so spoločným renderom: vlastný riadok s názvom a tým, čím sa líši. */
  .rad-vyh { display: flex; flex-direction: column; gap: 1px; margin-top: 16px; padding-top: 12px; border-top: 1px solid rgb(10 42 94 / 0.1); color: var(--color-ink); }
  .rad-vyh strong { font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 17px; line-height: 1.25; letter-spacing: -0.005em; transition: color 150ms var(--ease-soft); }
  .rad-vyh span { font-size: 14px; color: var(--color-ink-soft); }
  .rad-vyh:hover strong { color: var(--color-blue-700); }
  @keyframes panel { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  /* Poloha v páse radov: len na telefóne, kde je pás posuvný. */
  .studio-bodky { display: none; }

  .diely { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px 28px; margin-top: 56px; padding-top: 28px; border-top: var(--line); }
  .diely h3 { font-family: var(--font-text); font-stretch: 100%; font-size: 16px; font-weight: 600; letter-spacing: 0; }
  .diely ul { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .diely .diely-vstup { display: none; }
  .diely li a { display: inline-flex; align-items: center; gap: 4px; font-size: 15px; font-weight: 500; }
  /* Výrez dielu stojí pri názve skupiny s tieňom dopadu, ako diely na podlahe štúdia. */
  .diel-obr { position: relative; flex: none; display: grid; place-items: center; width: 48px; height: 48px; margin-right: 8px; }
  .diel-obr::before { content: ""; position: absolute; left: 10%; right: 10%; bottom: 2px; height: 8px; border-radius: 50%; background: radial-gradient(closest-side, rgb(10 42 94 / 0.22), rgb(10 42 94 / 0)); }
  .diel-obr :global(img) { position: relative; width: 48px; height: 48px; object-fit: contain; transition: transform 300ms var(--ease-soft); }
  @media (hover: hover) and (pointer: fine) { .diely li a:hover .diel-obr :global(img) { transform: translateY(-3px); } }
  .diely li :global(svg) { width: 15px; height: 15px; }

  /* Tablet: všetky použitia viditeľné v mriežke, bez druhého vodorovného posuvníka. */
  @media (max-width: 1100px) {
    .katalog { padding-bottom: 140px; }
    .kat-taby { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto auto auto auto auto; }
    .studio-bodky { grid-column: 1; grid-row: 5; }
    .kat-hlava { grid-column: 1; grid-row: 1; }
    .t-list { grid-column: 1; grid-row: 2; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; border: 0; }
    .t-lbl { align-items: center; min-height: 56px; padding: 12px 16px; border: 1px solid rgb(10 42 94 / 0.16); border-radius: var(--radius-m); background: var(--sklo-1); }
    .t-lbl::before { display: none; }
    .t-lbl:has(input:checked) { background: var(--color-blue-900); color: #fff; border-color: var(--color-blue-900); }
    .t-nazov { font-size: 17px; }
    .t-pocet { display: none; }
    .t-panel { grid-row: 1 / -1; }
    .t-info { grid-column: 1; grid-row: 3; padding: 20px 0 8px; }
    .studio { grid-column: 1; grid-row: 4; margin-left: 0; padding: 24px 0 0; min-height: 0; }
    .vsetko { grid-column: 1; grid-row: 6; margin-top: 28px; }
  }
  @media (max-width: 760px) {
    .katalog { padding-top: calc(var(--presah-hero) + 52px); padding-bottom: 100px; }
    .katalog h2 { margin-bottom: 28px; }
    /* scroll-padding drží prvý render na okraji mriežky; bez neho by ho prichytávanie posunulo k hrane displeja. */
    .studio { grid-auto-columns: 78%; column-gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); scrollbar-width: none; margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); }
    .studio::-webkit-scrollbar { display: none; }
    .studio::before { display: none; }
    .rad { scroll-snap-align: start; }
    .studio[data-pocet="1"] { grid-auto-columns: 100%; }
    /* Päť plných názvov v troch riadkoch. Rady pod nimi ostávajú jediným posuvným pásom. */
    .t-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .t-lbl { min-height: 56px; padding: 8px 12px; }
    .t-lbl:last-child:nth-child(odd) { grid-column: 1 / -1; }
    .t-lbl:has(input:checked) .t-nazov { font-weight: 600; }
    .t-nazov { font-size: 15px; line-height: 1.35; }
    .studio-bodky { display: flex; justify-content: center; gap: 4px; margin-top: 8px; }
    .studio-bodky button { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: var(--radius-m); background: transparent; cursor: pointer; }
    .studio-bodky span { width: 8px; height: 8px; border-radius: 999px; background: var(--color-ink-soft); pointer-events: none; transition: width 250ms var(--ease-soft), background-color 250ms var(--ease-soft); }
    .studio-bodky .je-tu span { width: 22px; background: var(--color-blue-900); }
    .studio-bodky button:hover { background: var(--sklo-1); }
    .diely h3 { width: 100%; }
    .diely .diely-skupiny { display: none; }
    .diely .diely-vstup { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; width: 100%; }
    .diely-vstup a { display: flex; align-items: center; gap: 8px; min-width: 0; min-height: 60px; padding: 8px 16px 8px 8px; border-radius: var(--radius-l); background: var(--sklo-1); box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.12); font-size: 16px; font-weight: 600; }
    .diely-vstup a > span:not(.diel-obr) { flex: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .studio-bodky span { transition: none; } }
</style>

<script>
  // Poloha v páse radov na telefóne: bodka podľa rolovania, ťuknutie na bodku posunie pás na rad.
  function initKatalogBodky() {
    document.querySelectorAll<HTMLElement>('.katalog .studio:not([data-bodky])').forEach((pas) => {
      const bodky = pas.parentElement?.querySelector<HTMLElement>('.studio-bodky');
      if (!bodky) return;
      pas.dataset.bodky = '1';
      const body = [...bodky.querySelectorAll<HTMLButtonElement>('button')];
      const rady = [...pas.querySelectorAll<HTMLElement>('.rad')];
      let raf = 0;
      const obnov = () => {
        raf = 0;
        const krok = rady.length > 1 ? rady[1].offsetLeft - rady[0].offsetLeft : 1;
        const i = Math.min(body.length - 1, Math.max(0, Math.round(pas.scrollLeft / Math.max(1, krok))));
        body.forEach((b, j) => {
          b.classList.toggle('je-tu', j === i);
          b.setAttribute('aria-pressed', String(j === i));
        });
      };
      pas.addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(obnov); }, { passive: true });
      body.forEach((b, j) => b.addEventListener('click', () => {
        const krok = rady.length > 1 ? rady[1].offsetLeft - rady[0].offsetLeft : 0;
        pas.scrollTo({ left: j * krok, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      }));
    });
  }
  initKatalogBodky();
  document.addEventListener('astro:page-load', initKatalogBodky);
</script>
