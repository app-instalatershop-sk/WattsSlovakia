---
/**
 * Ovládanie animácie z 3D modelu vo vnútri obrazu (rez, ohyb, kotúč; lib/sekvencia.ts): po dohraní
 * „Prehrať znova“ a pri návrhu C pokyn na ťahanie. Obe ukáže až skript, bez neho a pri „obmedziť pohyb“
 * stojí hotový obraz bez ovládania. roh: kde je na konci pohybu na obraze voľno.
 */
import Ikona from './Ikona.astro';

interface Props { znova: string; tahaj: string; roh?: 'vlavo-dole' | 'vpravo-hore' }
const { znova, tahaj, roh = 'vlavo-dole' } = Astro.props;
---
<div class:list={['sq-ovl', `sq-${roh}`]}>
  <button type="button" class="sq-znova" hidden><Ikona nazov="rotate-ccw" velkost={16} /><span>{znova}</span></button>
  <p class="sq-tahaj" hidden><Ikona nazov="move-horizontal" velkost={16} /><span>{tahaj}</span></p>
</div>

<style>
  .sq-ovl { position: absolute; z-index: 4; display: flex; gap: 8px; pointer-events: none; }
  .sq-vlavo-dole { left: 12px; bottom: 12px; }
  .sq-vpravo-hore { right: 12px; top: 12px; }
  .sq-znova, .sq-tahaj { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; margin: 0; padding: 8px 16px 8px 12px;
    border: 0; border-radius: var(--radius-l); background: var(--sklo-3); box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.08), var(--elev-2);
    font: inherit; font-size: 14px; font-weight: 600; line-height: 1.2; color: var(--color-blue-900); white-space: nowrap; }
  .sq-znova { pointer-events: auto; cursor: pointer; transition: background-color 150ms var(--ease-soft), transform 120ms var(--ease-soft); }
  .sq-znova:active { transform: scale(0.98); }
  .sq-znova:focus-visible { outline: 2px solid var(--color-blue-700); outline-offset: 2px; }
  .sq-tahaj { font-weight: 500; color: var(--color-ink-soft); }
  .sq-znova:not([hidden]), .sq-tahaj:not([hidden]) { animation: sq-ukaz 250ms var(--ease-soft) both; }
  .sq-znova :global(svg), .sq-tahaj :global(svg) { flex: none; color: var(--color-blue-700); }
  @media (hover: hover) and (pointer: fine) { .sq-znova:hover { background: #fff; } }
  @keyframes sq-ukaz { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  @media (max-width: 760px) {
    .sq-znova, .sq-tahaj { padding: 8px 12px 8px 8px; font-size: 13px; }
  }
  /* Prst: hlavné ovládanie aspoň 44 px (POLISH O1). */
  @media (pointer: coarse) { .sq-znova { min-height: 44px; } }
</style>
