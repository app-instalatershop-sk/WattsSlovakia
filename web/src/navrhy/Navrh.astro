---
/**
 * Jeden variant na pracovnej stránke s návrhmi: štítok s písmenom, názvom, popisom a inšpiráciou,
 * pod ním plocha s variantom v plnej šírke. Plocha orezáva presahy do strán, aby sa varianty nemiešali.
 */
interface Props { pismeno: string; nazov: string; popis: string; inspiracia?: string; dnes?: boolean; odporucam?: boolean; pozadie?: string }
const { pismeno, nazov, popis, inspiracia, dnes = false, odporucam = false, pozadie = 'transparent' } = Astro.props;
---
<section class="nv" id={`v-${pismeno}`} aria-label={`Variant ${pismeno}: ${nazov}`}>
  <div class="nv-stitok">
    <div class="wrap nv-stitok-in">
      <span class="nv-pismeno">{pismeno}</span>
      <div class="nv-text">
        <p class="nv-nazov">{nazov}{dnes && <span class="nv-znak nv-dnes">dnes na webe</span>}{odporucam && <span class="nv-znak nv-odp">odporúčam</span>}</p>
        <p class="nv-opis">{popis}</p>
        {inspiracia && <p class="nv-insp">Inšpirácia: {inspiracia}</p>}
      </div>
    </div>
  </div>
  <div class="nv-plocha" style={`background: ${pozadie}`}><slot /></div>
</section>

<style>
  .nv { position: relative; }
  .nv + .nv { margin-top: 0; }
  .nv-stitok { position: sticky; top: 62px; z-index: 15; background: rgb(11 27 51 / 0.94); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); color: #fff; box-shadow: 0 10px 30px -18px rgb(0 0 0 / 0.6); }
  .nv-stitok-in { display: flex; align-items: flex-start; gap: 16px; padding-block: 14px; }
  .nv-pismeno { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--color-yellow-500); color: var(--color-ink); font-family: var(--font-display); font-stretch: 112.5%; font-weight: 700; font-size: 22px; }
  .nv-nazov { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 20px; line-height: 1.2; }
  .nv-znak { padding: 3px 10px; border-radius: 999px; font-family: var(--font-text); font-stretch: 100%; font-size: 12.5px; font-weight: 600; }
  .nv-dnes { background: rgb(255 255 255 / 0.14); color: #dfe8f5; }
  .nv-odp { background: #1b8a5a; color: #fff; }
  .nv-opis { margin-top: 4px; color: #c7d4e8; font-size: 15px; line-height: 1.5; max-width: 60em; }
  .nv-insp { margin-top: 2px; color: #8fb9ec; font-size: 14px; }
  .nv-plocha { position: relative; overflow-x: clip; isolation: isolate; }
  @media (max-width: 760px) { .nv-stitok { top: 56px; } .nv-opis { font-size: 14px; } .nv-insp { display: none; } }
</style>
