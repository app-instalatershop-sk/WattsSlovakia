---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Ikona from '../../../components/Ikona.astro';
import TabulkaVariantov from '../../../components/TabulkaVariantov.astro';
import Subory from '../../../components/Subory.astro';
import { kategorie, radyKategorie, variantyRadu, produktyPodlaId, cestaKategorie, cestaRadu, cislo, rozsah, skloňujDimenzie, type Kategoria } from '../../../lib/katalog';
import { fotkaRadu, piktogram } from '../../../lib/obrazky';

export async function getStaticPaths() {
  const kats = (await kategorie()).filter((k) => k.typ === 'potrubie');
  const out = [];
  for (const k of kats) {
    for (const r of await radyKategorie(k.id)) out.push({ params: { kategoria: k.slug, rad: r.slug }, props: { k, r } });
  }
  return out;
}
const { k, r } = Astro.props as { k: Kategoria; r: Awaited<ReturnType<typeof radyKategorie>>[number] };
const varianty = await variantyRadu(r.id);
const suvisiace = await produktyPodlaId(r.suvisiace);
const vsetky = await kategorie();
const kategoriaProduktu = (kid: string) => vsetky.find((x) => x.id === kid);
const img = fotkaRadu(r.fotka);
const pikto = piktogram(r.piktogram);
const polomery = varianty.map((v) => v.polomer_ohybu_m).filter((x): x is number => typeof x === 'number');
const zosilnene = varianty.filter((v) => v.izolacia === 'zosilnena').length;
const eshop = 'https://www.instalatershop.sk/vyhledavani/?string=' + encodeURIComponent(r.nazov.replace(/,.*$/, ''));
const popis = r.popis ?? '';
const meta = (r.kratky_popis ?? popis).slice(0, 155);
const productLd = [{
  '@context': 'https://schema.org', '@type': 'Product', name: r.nazov, description: meta,
  brand: { '@type': 'Brand', name: 'Microflex' }, manufacturer: { '@type': 'Organization', name: 'Watts' },
  url: new URL(cestaRadu(k, r), Astro.site).href,
}];
---
<Base title={r.nazov} description={meta} aktivna="potrubia" drobceky={[{ text: 'Potrubia', href: '/potrubia/' }, { text: k.kratky_nazov, href: cestaKategorie(k) }, { text: r.nazov }]} jsonLd={productLd}>
  <div class="wrap top">
    <div class="gallery">
      <figure class="plate main" transition:name={`rad-${r.id}`}>
        {img && <Image src={img} alt={`${r.nazov}: rez potrubím, plášť, izolácia a nosná rúra`} widths={[480, 720, 1000]} sizes="(max-width: 760px) 100vw, 45vw" loading="eager" />}
        <figcaption>Fotka výrobcu</figcaption>
      </figure>
    </div>
    <div class="summary">
      <span class="series-tag">{pikto && <Image src={pikto} alt="" width={64} height={48} />}{k.kratky_nazov}{r.pocet_rur ? `, ${r.pocet_rur === 1 ? 'jedna rúra' : r.pocet_rur === 2 ? 'dve rúry' : `${r.pocet_rur} rúry`}` : ''}</span>
      <h1>{r.nazov}</h1>
      {r.kratky_popis && <p class="lead">{r.kratky_popis}</p>}
      <dl class="spec spec-3">
        {r.medium && <div><dt>Médium</dt><dd>{r.medium}</dd></div>}
        {r.tlak_bar && <div><dt>Prevádzkový tlak</dt><dd>{r.tlak_bar} bar</dd></div>}
        {r.pocet_rur && <div><dt>Počet rúr</dt><dd>{r.pocet_rur}</dd></div>}
        {varianty.length > 0 && <div><dt>Nosná rúra</dt><dd>{rozsah(varianty.map((v) => v.rura?.d), 'mm')}</dd></div>}
        {varianty.length > 0 && <div><dt>Plášť HDPE</dt><dd>{rozsah(varianty.map((v) => v.plast_mm), 'mm')}</dd></div>}
        {polomery.length > 0 && <div><dt>Polomer ohybu</dt><dd>od {cislo(Math.min(...polomery), 2)} m</dd></div>}
      </dl>
      <div class="actions">
        {varianty.length > 0 && <a class="btn btn-primary" href="#varianty">Vybrať dimenziu</a>}
        <a class="btn btn-secondary" href={eshop} target="_blank" rel="noopener">Kúpiť v e-shope <Ikona nazov="external-link" velkost={18} /></a>
      </div>
      <p class="note">{varianty.length ? `${skloňujDimenzie(varianty.length)}${zosilnene ? `, z toho ${zosilnene} so zosilnenou izoláciou` : ''}. ` : ''}Cenu a dostupnosť každého variantu nájdete v e-shope instalatershop.sk.</p>
    </div>
  </div>

  <nav class="subnav" aria-label="Časti stránky">
    <div class="wrap"><ul>
      {varianty.length > 0 && <li><a href="#varianty">Varianty a obj. čísla</a></li>}
      {popis && <li><a href="#popis">Popis a materiály</a></li>}
      {r.subory.length > 0 && <li><a href="#stiahnut">Na stiahnutie</a></li>}
      {suvisiace.length > 0 && <li><a href="#suvisiace">Súvisiace produkty</a></li>}
    </ul></div>
  </nav>

  <div class="wrap">
    {varianty.length > 0 ? (
      <section class="block" id="varianty" aria-labelledby="h-var">
        <div class="block-head"><h2 id="h-var">Varianty a obj. čísla</h2><p>Obj. číslo vedie priamo na hľadanie v e-shope.</p></div>
        <TabulkaVariantov varianty={varianty} zdroj={r.zdroj_url} stiahnute={r.stiahnute} />
      </section>
    ) : (
      <section class="block" aria-labelledby="h-var">
        <div class="block-head"><h2 id="h-var">Varianty a obj. čísla</h2></div>
        <p class="muted">Rozmery a obj. čísla tohto radu sú v katalógu výrobcu, do webu ich doplníme. <a href="/na-stiahnutie/">Katalóg Microflex (PDF)</a>.</p>
      </section>
    )}

    {popis && (
      <section class="block" id="popis" aria-labelledby="h-popis">
        <div class="block-head"><h2 id="h-popis">Popis a materiály</h2><p>Podľa popisu výrobcu.</p></div>
        <p class="popis">{popis}</p>
      </section>
    )}

    {r.subory.length > 0 && (
      <section class="block" id="stiahnut" aria-labelledby="h-dl">
        <div class="block-head"><h2 id="h-dl">Na stiahnutie</h2><p>Podklady výrobcu k tomuto radu. Otvoria sa na watts.eu.</p></div>
        <Subory subory={r.subory} />
      </section>
    )}

    {suvisiace.length > 0 && (
      <section class="block" id="suvisiace" aria-labelledby="h-rel">
        <div class="block-head"><h2 id="h-rel">Čo budete potrebovať k potrubiu</h2><p>Spojky a príslušenstvo, ktoré výrobca odporúča k tomuto radu.</p></div>
        <ul class="related">
          {suvisiace.map((p) => { const kp = kategoriaProduktu(p.kategoria); return (
            <li><a href={kp ? cestaKategorie(kp) : '/spojky/'}><strong>{p.nazov}</strong><span class="muted">{kp?.kratky_nazov}{p.pocet_variantov ? `, ${skloňujDimenzie(p.pocet_variantov)}` : ''}</span></a></li>
          ); })}
        </ul>
      </section>
    )}
  </div>
</Base>

<style>
  .top { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 32px 24px; align-items: start; padding-block: 8px 48px; }
  .gallery { grid-column: 1 / 7; }
  .main { aspect-ratio: 1; border-radius: var(--radius-l); margin: 0; }
  .main :global(img) { position: absolute; left: 8%; top: 8%; width: 84%; height: 84%; object-fit: contain; mix-blend-mode: multiply; }
  .main figcaption { position: absolute; right: 16px; bottom: 12px; font-size: 12px; color: var(--color-ink-soft); }
  .summary { grid-column: 7 / 13; display: flex; flex-direction: column; gap: 24px; }
  .summary h1 { font-size: clamp(31px, 2vw + 16px, 44px); }
  .series-tag { display: inline-flex; align-items: center; gap: 10px; color: var(--color-ink-soft); font-size: 14px; }
  .series-tag :global(img) { width: 48px; height: 36px; object-fit: contain; }
  .spec-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .spec-3 > div:nth-child(3n) { border-right: 0; }
  .spec-3 > div:nth-last-child(-n + 3) { border-bottom: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .note { font-size: 14px; color: var(--color-ink-soft); }
  .subnav { position: sticky; top: 60px; z-index: 10; background: var(--color-white); border-top: var(--line); border-bottom: var(--line); }
  .subnav ul { display: flex; gap: 32px; overflow-x: auto; }
  .subnav a { display: inline-block; padding: 14px 0; color: var(--color-ink); font-weight: 500; border-bottom: 2px solid transparent; white-space: nowrap; transition: border-color 150ms var(--ease-soft); }
  .subnav a:hover { border-bottom-color: var(--color-blue-700); color: var(--color-ink); }
  .block { padding-block: 48px; border-bottom: var(--line); scroll-margin-top: 130px; }
  .block:last-child { border-bottom: 0; }
  .block-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; margin-bottom: 24px; }
  .block-head p { color: var(--color-ink-soft); }
  .popis { max-width: 70ch; font-size: 17px; line-height: 1.6; }
  .related { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .related a { display: flex; flex-direction: column; gap: 4px; padding: 16px 18px; border: var(--line); border-radius: var(--radius-s); color: var(--color-ink); transition: border-color 150ms var(--ease-soft); }
  .related a:hover { border-color: var(--color-blue-700); color: var(--color-ink); }
  .related strong { font-weight: 600; }
  .related .muted { font-size: 14px; }
  @media (max-width: 1000px) { .related { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .top > * { grid-column: 1 / -1; }
    .spec-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .spec-3 > div:nth-child(3n) { border-right: 1px solid rgb(0 93 185 / 0.16); }
    .spec-3 > div:nth-child(2n) { border-right: 0; }
    .related { grid-template-columns: 1fr; }
    .block { scroll-margin-top: 120px; }
  }
</style>
