---
/**
 * Rodina na ťuknutie (Juraj 28. 10. 2026): vrstva nad renderom rodiny systémov. Systém pod myšou, prstom
 * alebo v ohnisku klávesnice sa zvýrazní (ostatné stmavnú) a pri ňom sa objaví karta s tým hlavným; celá karta
 * je odkaz na rad. Masky systémov sú z toho istého záberu (render --maska, data/novinky_web.py rodina), malá mapa
 * indexov určuje, nad ktorým systémom je ukazovateľ. Rodič musí mať position: relative a rozmer obrazu.
 * Ovládanie (Juraj 28. 10.: „klik na model nič neurobí, tlačidlo zmizne pri pohybe myši“): myš klikom na potrubie
 * otvorí jeho rad a karta počká, kým k nej myš prejde; prst prvým ťuknutím ukáže kartu, druhým na to isté potrubie
 * alebo ťuknutím na kartu otvorí rad; klávesnica prejde odkazmi na rady (Enter otvorí).
 */
import type { SystemyData } from '../lib/obrazky';

export interface SystemRodiny { nazov: string; fakty: string[]; odkaz: string }
interface Props { data: SystemyData; obraz: string; systemy: SystemRodiny[]; label: string; pozriet: string }
const { data, obraz, systemy, label, pozriet } = Astro.props;
// „QUADRO, vykurovanie a sanita“: na telefóne len názov (médium je aj v prvom riadku faktov), pri „DUO, sanita 10 bar“
// ostane tlak, aby sa nepomýlil s DUO na vykurovanie
const nazvy = data.systemy.map((_, k) => {
  const n = systemy[k]?.nazov ?? '';
  const i = n.indexOf(', ');
  return i < 0 ? { meno: n, medium: '', tlak: '' } : { meno: n.slice(0, i), medium: n.slice(i), tlak: n.match(/ \d+ bar$/)?.[0] ?? '' };
});
---
<div class="rv" data-rodina-vyber data-cesta={data.cesta} data-krok={data.krok}>
  <div class="rv-svetlo" data-src={obraz} aria-hidden="true"></div>
  {data.systemy.map((s, k) => (
    <div class="rv-stitok" data-k={k} style={`--x: ${s.bod[0]}%; --y: ${s.bod[1]}%`} hidden>
      <span class="rv-bod" aria-hidden="true"></span>
      <a class="rv-karta" href={systemy[k]?.odkaz}>
        <strong>{nazvy[k].meno}<span class="rv-medium">{nazvy[k].medium}</span>{nazvy[k].tlak && <span class="rv-tlak">{nazvy[k].tlak}</span>}</strong>
        {systemy[k]?.fakty.map((f) => <span>{f}</span>)}
        <span class="rv-pozriet">{pozriet}</span>
      </a>
    </div>
  ))}
  <ul class="rv-tlacidla" aria-label={label}>
    {data.systemy.map((_, k) => <li><a href={systemy[k]?.odkaz} data-k={k}>{systemy[k]?.nazov}</a></li>)}
  </ul>
</div>

<style>
  .rv { position: absolute; inset: 0; z-index: 3; }
  .rv-svetlo { position: absolute; inset: 0; opacity: 0; pointer-events: none; transition: opacity 260ms var(--ease-soft);
    background: center / 100% 100% no-repeat; -webkit-mask-size: 100% 100%; mask-size: 100% 100%; }
  .rv.je-vyber .rv-svetlo { opacity: 1; }
  /* Ostatné systémy stmavnú: filter na samotnom renderi rodiča (obraz pod vrstvou). */
  :global(.rv-ztlm) { transition: filter 260ms var(--ease-soft); }
  :global(.rv-rodic.je-vyber .rv-ztlm) { filter: saturate(0.35) brightness(0.86) contrast(0.92); }
  .rv-stitok { --odstup: 26px; position: absolute; left: var(--x); top: var(--y); width: 0; height: 0; z-index: 2; }
  .rv-bod { position: absolute; left: -7px; top: -7px; width: 14px; height: 14px; border-radius: 50%; background: #fff; box-shadow: inset 0 0 0 3px var(--color-blue-900), 0 0 0 4px rgb(255 255 255 / 0.5), 0 3px 10px rgb(4 16 40 / 0.4); }
  /* Štítok vedľa bodu (vpravo, pri systémoch v pravej časti vľavo), zvisle na strede bodu. Skript ho posunie
     (--posun, --posun-x), aby ostal v okne a v páse systémov, nie nad textom a tlačidlami okolo obrazu. */
  .rv-karta { position: absolute; top: 0; left: var(--odstup); transform: translate(var(--posun-x, 0px), calc(-50% + var(--posun, 0px))); display: grid; gap: 3px; padding: 12px 16px 14px; border-radius: var(--radius-l); white-space: nowrap;
    background: rgb(255 255 255 / 0.93); -webkit-backdrop-filter: blur(10px) saturate(1.4); backdrop-filter: blur(10px) saturate(1.4); box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.08), var(--elev-2);
    animation: rv-prichod 220ms var(--ease-soft) both; }
  .rv-karta::before { content: ""; position: absolute; left: calc(-1 * var(--odstup)); top: clamp(12px, calc(50% - var(--posun, 0px)), calc(100% - 12px)); width: var(--odstup); height: 1.5px; background: var(--color-blue-900); }
  .rv-stitok.vlavo .rv-karta { left: auto; right: var(--odstup); }
  .rv-stitok.vlavo .rv-karta::before { left: auto; right: calc(-1 * var(--odstup)); }
  .rv-stitok.tesne .rv-karta::before { display: none; }
  .rv-karta { color: inherit; text-decoration: none; cursor: pointer; }
  .rv-karta strong { font-family: var(--font-display); font-stretch: 112%; font-weight: 600; font-size: 20px; color: var(--color-blue-900); }
  .rv-karta > span { font-size: 14px; line-height: 1.4; color: #3f4b5e; }
  .rv-tlak { display: none; }
  .rv-karta > .rv-pozriet { margin-top: 6px; font-weight: 600; font-size: 15px; color: var(--color-blue-700); }
  @media (hover: hover) and (pointer: fine) { .rv-karta:hover .rv-pozriet { text-decoration: underline; text-underline-offset: 3px; } }
  .rv-karta:focus-visible { outline: 3px solid var(--color-yellow-500); outline-offset: 2px; }
  @keyframes rv-prichod { from { opacity: 0; } to { opacity: 1; } }
  /* Odkazy na rady pre klávesnicu a čítačky obrazovky: neviditeľné, kým nie sú v ohnisku. */
  .rv-tlacidla { position: absolute; left: 0; bottom: 0; margin: 0; padding: 0; list-style: none; }
  .rv-tlacidla a { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .rv-tlacidla a:focus-visible { position: fixed; z-index: 50; left: 50%; bottom: 24px; width: auto; height: auto; clip-path: none; transform: translateX(-50%);
    padding: 10px 16px; border-radius: 999px; background: var(--color-blue-900); color: #fff; font: inherit; font-weight: 600; outline: 3px solid var(--color-yellow-500); }
  @media (max-width: 760px) {
    .rv-stitok { --odstup: 18px; }
    .rv-karta { gap: 2px; padding: 8px 12px 10px; white-space: normal; width: 180px; }
    .rv-karta strong { font-size: 16px; line-height: 1.25; }
    .rv-karta > span { font-size: 13px; line-height: 1.35; }
    .rv-medium { display: none; }
    .rv-tlak { display: inline; }
    .rv-karta > .rv-pozriet { margin-top: 4px; font-size: 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rv-svetlo, :global(.rv-ztlm) { transition: none; }
    .rv-karta { animation: none; }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';

  function initRodinaVyber() {
    document.querySelectorAll<HTMLElement>('[data-rodina-vyber]:not([data-on])').forEach((vrstva) => {
      vrstva.dataset.on = '1';
      const rodic = vrstva.parentElement!;
      rodic.classList.add('rv-rodic');
      // obraz rodiny pod vrstvou (prvý obrázok rodiča, ktorý nie je súčasťou vrstvy)
      const zaklad = [...rodic.querySelectorAll<HTMLImageElement>('img')].find((im) => !vrstva.contains(im));
      zaklad?.classList.add('rv-ztlm');
      const svetlo = vrstva.querySelector<HTMLElement>('.rv-svetlo')!;
      const stitky = [...vrstva.querySelectorAll<HTMLElement>('.rv-stitok')];
      const odkazy = stitky.map((s) => s.querySelector<HTMLAnchorElement>('.rv-karta')!.href);
      const tlacidla = [...vrstva.querySelectorAll<HTMLAnchorElement>('.rv-tlacidla a')];
      // Pás obrazu, v ktorom sú systémy (podiel výšky, z mapy); kým mapa nie je, celý obraz.
      let pas = [0, 1];
      // Štítok ide doprava od bodu, ak sa tam zmestí do okna (obraz rodiny na domove siaha po pravý okraj), inak doľava;
      // keď sa nezmestí ani jedným smerom (úzky telefón, systém v strede), ide na stranu s väčším miestom a posunie sa
      // do okna bez čiary. Zvisle ostane v páse systémov, aby nezakryl nadpis ani tlačidlá nad obrazom a pod ním.
      const smer = (s: HTMLElement) => {
        s.classList.remove('vlavo', 'tesne');
        s.style.removeProperty('--posun');
        s.style.removeProperty('--posun-x');
        const karta = s.querySelector<HTMLElement>('.rv-karta')!;
        const okraj = document.documentElement.clientWidth - 12;
        const vpravo = karta.getBoundingClientRect().right - okraj;
        if (vpravo > 0) {
          s.classList.add('vlavo');
          const vlavo = 12 - karta.getBoundingClientRect().left;
          if (vlavo > 0) {
            s.classList.add('tesne');
            if (vpravo < vlavo) { s.classList.remove('vlavo'); s.style.setProperty('--posun-x', `${-Math.ceil(vpravo)}px`); }
            else s.style.setProperty('--posun-x', `${Math.ceil(vlavo)}px`);
          }
        }
        const r = rodic.getBoundingClientRect();
        const k = karta.getBoundingClientRect();
        const hore = r.top + r.height * pas[0], dole = r.top + r.height * pas[1];
        let posun = k.bottom > dole ? dole - k.bottom : 0;
        if (k.top + posun < hore) posun = hore - k.top;
        if (posun) s.style.setProperty('--posun', `${Math.round(posun)}px`);
      };
      const cesta = vrstva.dataset.cesta!;
      const krok = Number(vrstva.dataset.krok);
      let aktivny = -1, pevny = -1;
      const ukaz = (k: number) => {
        if (k === aktivny) return;
        aktivny = k;
        if (k >= 0) {
          const maska = `url(${cesta}maska-${k}.webp)`;
          svetlo.style.setProperty('-webkit-mask-image', maska);
          svetlo.style.setProperty('mask-image', maska);
        }
        vrstva.classList.toggle('je-vyber', k >= 0);
        rodic.classList.toggle('je-vyber', k >= 0);
        stitky.forEach((s, i) => { s.hidden = i !== k; });
        if (k >= 0) smer(stitky[k]);
      };
      // Mapa indexov: odtieň sivej (k + 1) · krok, 0 = pozadie. Masky sa stiahnu pri prvom priblížení.
      const platno = document.createElement('canvas');
      let data: Uint8ClampedArray | undefined;
      let nacitanie: Promise<void> | undefined;
      // Mapa sa stiahne pri prvom priblížení; ťuknutie na telefóne na ňu počká (inak by prvé nereagovalo).
      // Svetlá vrstva je ten istý obrázok, aký prehliadač už zobrazil pod ňou (z vyrovnávacej pamäte, nič navyše).
      const pripravMapu = () => {
        if (!svetlo.style.backgroundImage) svetlo.style.backgroundImage = `url("${zaklad?.currentSrc || svetlo.dataset.src}")`;
        nacitanie ??= new Promise<void>((hotovo) => {
          const mapa = new Image();
          mapa.onload = () => {
            platno.width = mapa.naturalWidth; platno.height = mapa.naturalHeight;
            const ctx = platno.getContext('2d', { willReadFrequently: true })!;
            ctx.drawImage(mapa, 0, 0);
            data = ctx.getImageData(0, 0, platno.width, platno.height).data;
            let y0 = platno.height, y1 = 0;
            for (let i = 0; i < data.length; i += 4) if (data[i]) { const y = (i / 4 / platno.width) | 0; if (y < y0) y0 = y; y1 = y; }
            if (y1 > y0) pas = [Math.max(0, y0 / platno.height - 0.03), Math.min(1, y1 / platno.height + 0.03)];
            hotovo();
          };
          mapa.onerror = () => hotovo();
          mapa.src = `${cesta}mapa.png`;
          stitky.forEach((_, k) => { new Image().src = `${cesta}maska-${k}.webp`; });
        });
        return nacitanie;
      };
      const system = (e: MouseEvent) => {
        if (!data) return -1;
        const r = rodic.getBoundingClientRect();
        const x = Math.floor(((e.clientX - r.left) / r.width) * platno.width);
        const y = Math.floor(((e.clientY - r.top) / r.height) * platno.height);
        if (x < 0 || y < 0 || x >= platno.width || y >= platno.height) return -1;
        const v = data[(y * platno.width + x) * 4];
        return v ? Math.round(v / krok) - 1 : -1;
      };
      rodic.addEventListener('pointerenter', pripravMapu);
      rodic.addEventListener('touchstart', pripravMapu, { passive: true });
      // Typ posledného dotyku: myš otvorí rad hneď, prst najprv ukáže kartu.
      let posledny = 'mouse', cakaj = 0, ciel = -1, px = 0, py = 0;
      const zrus = () => { if (cakaj) { clearTimeout(cakaj); cakaj = 0; } };
      const neskor = (k: number, ms: number) => { ciel = k; zrus(); cakaj = window.setTimeout(() => { cakaj = 0; ukaz(ciel); }, ms); };
      // vzdialenosť ukazovateľa od otvorenej karty (0 = nad ňou)
      const odKarty = (x: number, y: number) => {
        const r = stitky[aktivny].querySelector('.rv-karta')!.getBoundingClientRect();
        return Math.hypot(Math.max(r.left - x, 0, x - r.right), Math.max(r.top - y, 0, y - r.bottom));
      };
      rodic.addEventListener('pointerdown', (e) => { posledny = e.pointerType; }, { passive: true });
      rodic.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        const x = e.clientX, y = e.clientY;
        const kuKarte = aktivny >= 0 && odKarty(x, y) < odKarty(px, py) - 0.5;
        px = x; py = y;
        // nad kartou ostáva otvorená, aby sa dalo kliknúť na ňu
        if ((e.target as HTMLElement).closest('.rv-karta')) { zrus(); rodic.style.cursor = ''; return; }
        const k = system(e);
        rodic.style.cursor = k >= 0 ? 'pointer' : '';
        const chce = k >= 0 ? k : pevny;
        if (chce === aktivny) { zrus(); return; }
        // Myš ide ku karte (cez prázdne miesto alebo cez iné potrubie): karta počká a prepne sa, až keď sa myš
        // zastaví. Inak sa nové potrubie ukáže hneď a prázdne miesto kartu skryje po chvíli.
        if (kuKarte) neskor(chce, 320);
        else if (k >= 0) { zrus(); ukaz(k); }
        else if (!cakaj) neskor(chce, 450);
      });
      rodic.addEventListener('pointerleave', () => { zrus(); ukaz(pevny); });
      const otvor = (url: string) => { navigate(url).catch(() => { location.href = url; }); };
      rodic.addEventListener('click', async (e) => {
        if ((e.target as HTMLElement).closest('a, button')) return;
        await pripravMapu();
        const k = system(e);
        if (k >= 0 && (posledny !== 'touch' || pevny === k)) { otvor(odkazy[k]); return; }
        pevny = k;
        ukaz(k);
      });
      tlacidla.forEach((b, i) => {
        b.addEventListener('focus', () => { pripravMapu(); ukaz(i); });
        b.addEventListener('blur', () => ukaz(pevny));
      });
    });
  }
  initRodinaVyber();
  document.addEventListener('astro:page-load', initRodinaVyber);
</script>
