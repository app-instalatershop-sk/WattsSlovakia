---
import { Image } from 'astro:assets';
import Strana from '../../navrhy/Strana.astro';
import Navrh from '../../navrhy/Navrh.astro';
import Koty from '../../components/Koty.astro';
import Ikona from '../../components/Ikona.astro';
import Scena from '../../components/Scena.astro';
import KartaReferencie from '../../components/KartaReferencie.astro';
import { radDuo } from '../../navrhy/data';
import { obsahRadu } from '../../content/rady';
import { stranky } from '../../content/stranky';
import { referencie } from '../../content/referencie';
import { fotkaRadu, detail, fotkaReferencie } from '../../lib/obrazky';
import { sadzba } from '../../lib/sadzba';
import { KATALOG_PDF, route } from '../../i18n/ui';
import type { Kota } from '../../lib/koty';

const d = await radDuo();
const obsah = obsahRadu(d.r.slug, 'sk')!;
const tx = stranky('sk').rad;
const foto = fotkaRadu(d.r.fotka)!;
// Kľúčové čísla vrstiev ako na stránke radu: plášť z rozsahu tabuľky, rúra s priemermi.
const vrstvy = (['rura', 'pena', 'plast'] as const).map((id) => {
  const v = obsah.vrstvy[id];
  const kluc = id === 'plast' ? `Ø ${d.c.plast}` : id === 'rura' ? `Ø ${d.c.rura.replace(/^2 × /, '')}, ${(v.kluc ?? '').replace(/^PE-Xa, /, '')}` : v.kluc ?? '';
  return { id, nazov: tx.vrstvy[id], kluc, text: v.text, img: detail(`vrstva-${id}.jpg`)! };
});
// B: kóty vrstiev na renderi DUO (bod peny je medián sivých pixelov vľavo od rúr).
const kotyVrstiev: Kota[] = [
  { x: 60.6, y: 24.5, l: 8, smer: 'hore-vpravo', hodnota: 'HDPE, dvojitá stena', text: 'plášť' },
  { x: 48.7, y: 61.4, l: 9, smer: 'dole-vlavo', smerM: 'dole-vpravo', hodnota: 'λ 0,0372 W/m·K', text: 'izolácia z PE-X peny' },
  { x: 87.1, y: 83.9, l: 6, smer: 'dole-vlavo', hodnota: 'PE-Xa do 95 °C', text: 'nosná rúra s kyslíkovou bariérou' },
];
const ref = referencie('sk').find((x) => x.id === 'povazska-bystrica')!;
const VARIANTY = [
  { pismeno: 'A', nazov: 'Stavba dnes: parametre a lupy v kartách' },
  { pismeno: 'B', nazov: 'Kóty na reze a lupy v rade' },
  { pismeno: 'C', nazov: 'Vrstvy ako tri pásy' },
  { pismeno: 'D', nazov: 'Referencia dnes: fotka a štítok' },
  { pismeno: 'E', nazov: 'Referencia ako scéna s kótou' },
];
---
<Strana cesta="/navrhy/rad/" nadpis="Stavba potrubia a referencia na stránke radu" varianty={VARIANTY}
  popis="Dve časti, ktoré má každá stránka radu: z čoho je potrubie (vrstvy, parametre, montáž) a kde rad leží (referencia). Ukážka na rade Microflex DUO."
  kde="12 radov SK aj CS (24 stránok); referencia aj na stránkach dielov, kde je pri potrubí">

  <Navrh pismeno="A" nazov="Parametre a lupy v kartách" dnes
    popis="Vľavo popis a biela karta s parametrami a montážou, vpravo fotka radu a tri karty s lupou (rúra, pena, plášť) pod sebou." pozadie="linear-gradient(180deg, var(--zem-1), var(--zem-2))">
    <section class="wrap plocha-pad">
      <div class="a-stavba">
        <div class="a-text">
          <h2>{tx.stavbaH2}</h2>
          {obsah.popis.map((p) => <p class="a-popis">{sadzba(p)}</p>)}
          <div class="harok a-karta">
            <h3>{tx.parametreH3}</h3>
            <dl class="parametre">{obsah.parametre.map(([dt, dd]) => <div><dt>{dt}</dt><dd>{sadzba(dd)}</dd></div>)}</dl>
            <h3>{tx.montazH3}</h3>
            <ul class="montaz">{obsah.montaz.map((m) => <li><Ikona nazov="check" velkost={18} /><span>{sadzba(m)}</span></li>)}</ul>
          </div>
        </div>
        <div class="a-obraz">
          <figure class="a-foto"><Image src={foto} alt="" widths={[480, 760, 1000]} sizes="44vw" /></figure>
          <ol class="a-lupy">
            {vrstvy.map((l) => (
              <li class={`a-lupa lupa-${l.id}`}>
                <span class="lupa-okno"><Image src={l.img} alt="" width={120} height={120} densities={[1, 2]} /></span>
                <div><h3>{l.nazov}</h3><p class="lupa-kluc">{sadzba(l.kluc)}</p><p class="lupa-text">{sadzba(l.text)}</p></div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  </Navrh>

  <Navrh pismeno="B" nazov="Kóty na reze a lupy v rade" odporucam
    popis="Rovnaký podpis ako domov: veľký render rezu s kótou na každej vrstve, pod ním tri lupy so zväčšeným materiálom v jednom rade. Parametre a montáž idú vedľa ako pokojný zoznam, nie ďalšia karta."
    inspiracia="náš domov (rez pod lupou), Dyson a Apple (technika vysvetlená rezom)" pozadie="linear-gradient(180deg, var(--zem-1), var(--zem-2))">
    <section class="wrap plocha-pad">
      <div class="b-hlava">
        <h2>{tx.stavbaH2}</h2>
        <p class="a-popis">{sadzba(obsah.popis[0])}</p>
      </div>
      <div class="b-stavba">
        <div class="b-rez"><span class="b-stage"><Image src={d.pikto} alt="" widths={[640, 960, 1200]} sizes="(max-width: 900px) 100vw, 60vw" /><Koty koty={kotyVrstiev} label="Vrstvy potrubia" /></span></div>
        <div class="b-zoznamy">
          <h3>{tx.parametreH3}</h3>
          <dl class="b-param">{obsah.parametre.map(([dt, dd]) => <div><dt>{dt}</dt><dd>{sadzba(dd)}</dd></div>)}</dl>
          <h3>{tx.montazH3}</h3>
          <ul class="montaz">{obsah.montaz.map((m) => <li><Ikona nazov="check" velkost={18} /><span>{sadzba(m)}</span></li>)}</ul>
          <p class="zdroj"><a href={KATALOG_PDF} target="_blank" rel="noopener">{tx.stranaKat(obsah.strana ?? 10)}</a></p>
        </div>
      </div>
      <ol class="b-lupy">
        {vrstvy.map((l) => (
          <li class={`b-lupa lupa-${l.id}`}>
            <span class="lupa-okno lupa-velka"><Image src={l.img} alt="" width={168} height={168} densities={[1, 2]} /></span>
            <h3>{l.nazov}</h3>
            <p class="lupa-kluc">{sadzba(l.kluc)}</p>
            <p class="lupa-text">{sadzba(l.text)}</p>
          </li>
        ))}
      </ol>
    </section>
  </Navrh>

  <Navrh pismeno="C" nazov="Vrstvy ako tri pásy"
    popis="Od jadra po plášť: každá vrstva má vlastný riadok s veľkou lupou, názvom, kľúčovým číslom a textom. Čitateľné ako kapitola katalógu, parametre a montáž sú pod tým v dvoch stĺpcoch."
    inspiracia="technické katalógy (Watts, Geberit): vrstva po vrstve, Teenage Engineering (veľké detaily)" pozadie="linear-gradient(180deg, var(--zem-1), var(--zem-2))">
    <section class="wrap plocha-pad">
      <div class="b-hlava">
        <h2>{tx.stavbaH2}</h2>
        <p class="a-popis">{sadzba(obsah.popis[0])}</p>
      </div>
      <ol class="c-vrstvy">
        {vrstvy.map((l) => (
          <li class={`c-vrstva lupa-${l.id}`}>
            <span class="lupa-okno c-lupa"><Image src={l.img} alt="" width={220} height={220} densities={[1, 2]} /></span>
            <div class="c-meno"><h3>{l.nazov}</h3><p class="c-kluc">{sadzba(l.kluc)}</p></div>
            <p class="c-text">{sadzba(l.text)}</p>
          </li>
        ))}
      </ol>
      <div class="c-spodok">
        <div><h3>{tx.parametreH3}</h3><dl class="b-param">{obsah.parametre.map(([dt, dd]) => <div><dt>{dt}</dt><dd>{sadzba(dd)}</dd></div>)}</dl></div>
        <div><h3>{tx.montazH3}</h3><ul class="montaz">{obsah.montaz.map((m) => <li><Ikona nazov="check" velkost={18} /><span>{sadzba(m)}</span></li>)}</ul></div>
      </div>
    </section>
  </Navrh>

  <Navrh pismeno="D" nazov="Referencia: fotka so štítkom a text" dnes
    popis="Fotka zo stavby so štítkom potrubia v rohu, pod ňou miesto, názov, perex a odkaz." pozadie="linear-gradient(180deg, var(--zem-2), var(--zem-3))">
    <section class="wrap plocha-pad">
      <div class="s-hlava"><h2>{tx.refH2}</h2><p>{tx.refP}</p></div>
      <div class="d-ref"><KartaReferencie r={ref} lang="sk" velka /></div>
    </section>
  </Navrh>

  <Navrh pismeno="E" nazov="Referencia ako scéna s kótou" odporucam
    popis="Rovnako ako na stránke Referencie a na domove: fotka s kótou priamo v kotolni alebo na rúre, vedľa názov, dva fakty a odkaz. Rad tak na každej stránke ukáže skutočnú stavbu s číslom."
    inspiracia="Thermaflex (prípadová štúdia s číslom), náš domov (Projekty)" pozadie="linear-gradient(180deg, var(--zem-2), var(--zem-3))">
    <section class="wrap plocha-pad">
      <div class="e-ref">
        <Scena class="e-scena" obraz={fotkaReferencie(ref.scena!.fotka)!} alt={ref.nazov} koty={ref.scena!.koty} widths={[640, 895]} sizes="(max-width: 900px) 100vw, 56vw" />
        <div class="e-text">
          <p class="e-nad">{tx.refH2}</p>
          <h2>{sadzba(ref.nazov)}</h2>
          <p class="e-kde">{ref.miesto}, {ref.kedy}</p>
          <dl class="e-fakty">{ref.fakty.slice(0, 2).map(([dt, dd]) => <div><dt>{dt}</dt><dd>{sadzba(dd)}</dd></div>)}</dl>
          <a class="odkaz" href={`${route('sk', 'referencie')}#${ref.id}`}>Celá referencia <Ikona nazov="arrow-right" velkost={16} /></a>
        </div>
      </div>
    </section>
  </Navrh>
</Strana>

<style>
  .plocha-pad { padding-block: 72px 88px; }
  h2 { font-size: clamp(26px, 1.4vw + 17px, 36px); letter-spacing: -0.02em; }
  .a-popis { margin-top: 14px; font-size: 17px; line-height: 1.6; max-width: 36em; }
  .zdroj { margin-top: 18px; font-size: 13px; }
  .zdroj a { color: var(--color-ink-soft); border-bottom: 1px solid currentColor; }
  .montaz li { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 10px; font-size: 15px; line-height: 1.5; }
  .montaz li + li { margin-top: 10px; }
  .montaz :global(.icon) { color: #1f8a4c; margin-top: 2px; }
  /* Lupa: prstenec vo farbe vrstvy. */
  .lupa-rura { --ring: #e0b400; }
  .lupa-pena { --ring: #8e97a3; }
  .lupa-plast { --ring: var(--color-blue-700); }
  .lupa-okno { position: relative; display: block; width: 112px; height: 112px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 5px #fff, 0 0 0 7px var(--ring), 0 20px 36px -16px rgb(11 27 51 / 0.55); flex: none; }
  .lupa-okno :global(img) { display: block; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
  .lupa-okno::after { content: ""; position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(70% 55% at 30% 18%, rgb(255 255 255 / 0.36), rgb(255 255 255 / 0) 62%); box-shadow: inset 0 -10px 22px rgb(11 27 51 / 0.28), inset 0 0 0 1px rgb(11 27 51 / 0.12); pointer-events: none; }
  .lupa-kluc { margin-top: 3px; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 16px; line-height: 1.3; color: var(--color-blue-900); }
  .lupa-text { margin-top: 6px; font-size: 14.5px; line-height: 1.55; color: var(--color-ink-soft); }

  /* ---------- A: dnes ---------- */
  .a-stavba { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 40px 56px; align-items: start; }
  .a-karta { margin-top: 32px; padding: 26px 28px 22px; }
  .a-karta h3 { font-size: 17px; }
  .a-karta h3 + * { margin-top: 12px; }
  .a-karta * + h3 { margin-top: 26px; }
  .parametre > div { display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; border-bottom: 1px solid rgb(10 42 94 / 0.08); }
  .parametre dt { color: var(--color-ink-soft); font-size: 15px; }
  .parametre dd { margin: 0; text-align: right; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 16px; color: var(--color-blue-900); }
  .a-foto { margin: -20px 0 0; mix-blend-mode: multiply; }
  .a-foto :global(img) { display: block; width: min(100%, 620px); height: auto; margin-inline: auto; -webkit-mask-image: radial-gradient(70% 70% at 50% 50%, #000 60%, transparent 100%); mask-image: radial-gradient(70% 70% at 50% 50%, #000 60%, transparent 100%); }
  .a-lupy { position: relative; display: grid; gap: 18px; padding-left: 44px; margin-top: -110px; }
  .a-lupa { display: grid; grid-template-columns: 68px minmax(0, 1fr); gap: 26px; align-items: center; padding: 20px 26px 20px 0; border-radius: 18px; background: #fff; box-shadow: 0 1px 0 rgb(10 42 94 / 0.05), 0 26px 50px -34px rgb(10 42 94 / 0.5); }
  .a-lupa .lupa-okno { margin-left: -44px; }
  .a-lupa h3 { font-size: 18px; }

  /* ---------- B: kóty na reze, lupy v rade ---------- */
  .b-hlava { max-width: 760px; }
  .b-stavba { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 32px 56px; align-items: center; margin-top: 24px; }
  .b-rez { position: relative; margin-left: calc(-1 * var(--bleed) * 0.4); }
  .b-rez::before { content: ""; position: absolute; inset: 0 -10%; background: radial-gradient(50% 55% at 55% 55%, #fff 0%, rgb(255 255 255 / 0.5) 45%, rgb(255 255 255 / 0) 72%); }
  .b-stage { position: relative; display: block; max-width: 760px; container-type: inline-size; }
  .b-stage :global(img) { display: block; width: 100%; height: auto; filter: drop-shadow(0 30px 34px rgb(11 27 51 / 0.22)); }
  .b-zoznamy h3 { font-size: 17px; }
  .b-zoznamy h3 + * { margin-top: 12px; }
  .b-zoznamy * + h3 { margin-top: 28px; }
  .b-param { display: grid; gap: 4px; margin: 0; }
  .b-param > div { display: flex; justify-content: space-between; gap: 16px; padding: 9px 14px; border-radius: 10px; background: rgb(255 255 255 / 0.7); }
  .b-param dt { color: var(--color-ink-soft); font-size: 15px; }
  .b-param dd { margin: 0; text-align: right; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 16px; color: var(--color-blue-900); }
  .b-lupy { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 48px; }
  .b-lupa { display: flex; flex-direction: column; align-items: flex-start; }
  .lupa-velka { width: 168px; height: 168px; margin-bottom: 20px; }
  .b-lupa h3 { font-size: 19px; }

  /* ---------- C: vrstvy ako pásy ---------- */
  .c-vrstvy { display: grid; gap: 20px; margin-top: 36px; }
  .c-vrstva { display: grid; grid-template-columns: 220px minmax(0, 4fr) minmax(0, 6fr); gap: 24px 48px; align-items: center; padding: 26px 32px 26px 26px; border-radius: 28px; background: linear-gradient(100deg, #ffffff 0%, rgb(255 255 255 / 0.55) 100%); box-shadow: 0 30px 60px -44px rgb(10 42 94 / 0.55); }
  .c-lupa { width: 196px; height: 196px; margin: 4px; }
  .c-meno h3 { font-size: 24px; letter-spacing: -0.015em; }
  .c-kluc { margin-top: 6px; font-family: var(--font-display); font-stretch: 118%; font-weight: 600; font-size: clamp(20px, 1vw + 14px, 28px); line-height: 1.15; color: var(--color-blue-900); }
  .c-text { font-size: 16px; line-height: 1.6; color: var(--color-ink-soft); }
  .c-spodok { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 56px; margin-top: 40px; }
  .c-spodok h3 { font-size: 17px; margin-bottom: 12px; }

  /* ---------- D, E: referencia ---------- */
  .d-ref { max-width: 820px; }
  .e-ref { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 32px 56px; align-items: center; }
  .e-ref :global(.e-scena) { margin-left: calc(-1 * var(--bleed)); }
  .e-ref :global(.e-scena .scena-img) { border-radius: 0 20px 20px 0; box-shadow: 0 36px 70px -36px rgb(11 27 51 / 0.6); }
  .e-nad { font-size: 15px; font-weight: 500; color: var(--color-blue-700); }
  .e-text h2 { margin-top: 8px; font-size: clamp(26px, 1.4vw + 17px, 36px); line-height: 1.12; }
  .e-kde { margin-top: 10px; color: var(--color-ink-soft); }
  .e-fakty { display: grid; gap: 6px; margin: 20px 0 22px; }
  .e-fakty > div { display: grid; grid-template-columns: 9em minmax(0, 1fr); gap: 12px; padding: 11px 14px; border-radius: 12px; background: rgb(255 255 255 / 0.7); }
  .e-fakty dt { color: var(--color-ink-soft); font-size: 14.5px; }
  .e-fakty dd { margin: 0; font-weight: 600; }

  @media (max-width: 900px) {
    .a-stavba, .b-stavba, .e-ref, .c-spodok { grid-template-columns: minmax(0, 1fr); }
    .b-lupy { grid-template-columns: minmax(0, 1fr); }
    .c-vrstva { grid-template-columns: 120px minmax(0, 1fr); }
    .c-lupa { width: 110px; height: 110px; }
    .c-text { grid-column: 1 / -1; }
    .e-ref :global(.e-scena) { margin-inline: calc(-1 * var(--gutter)); }
    .a-lupy { padding-left: 0; margin-top: -16px; }
  }
</style>
