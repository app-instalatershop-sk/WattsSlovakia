---
import { getImage } from 'astro:assets';
import Obraz from '../components/Obraz.astro';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Ikona from '../components/Ikona.astro';
import Katalog from '../components/Katalog.astro';
import Scena from '../components/Scena.astro';
import { referencie } from '../content/referencie';
import type { Kota } from '../lib/koty';
import { kategorie, cislo, rozsah } from '../lib/katalog';
import { fotka, fotkaReferencie, render3d, maska3d, rozkladRadu, makroRury } from '../lib/obrazky';
import Rozklad from '../components/Rozklad.astro';
import { stranky } from '../content/stranky';
import rendery from '../data/rendery.json';
import { sadzba } from '../lib/sadzba';
import { type Lang, t, route, staticAlternates, KATALOG_PDF } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const h = ui.home;

const kats = await kategorie();
const rady = (await getCollection('rady')).map((r) => r.data);
const varianty = (await getCollection('varianty')).map((v) => v.data);

const potrubia = kats.filter((k) => k.typ === 'potrubie');
const radyPotrubi = rady.filter((r) => potrubia.some((k) => k.id === r.kategoria));
const variantyPotrubi = varianty.filter((v) => radyPotrubi.some((r) => r.id === v.rad));

// Čísla pri renderi v hero sú z dát, nie z hlavy.
const polomery = variantyPotrubi.map((v) => v.polomer_ohybu_m).filter((x): x is number => typeof x === 'number');
const faktPolomer = `${ui.common.od} ${cislo(Math.min(...polomery), 2)} m`;
const faktRura = rozsah(variantyPotrubi.map((v) => v.rura?.d), 'mm', lang);
const faktPlast = `Ø ${rozsah(variantyPotrubi.map((v) => v.plast_mm), 'mm', lang)}`;
const tlaky = [...new Set(radyPotrubi.map((r) => r.tlak_bar).filter((x): x is number => typeof x === 'number'))].sort((a, b) => a - b);
const faktTlak = h.popisy.tlak(tlaky.map((x) => `${x}`));

// Hero: render vlastného 3D modelu (data/blender, kompozícia ako pôvodný render Watts: rez vľavo, telo
// za pravý okraj). Kým nie je, ostáva render Watts. Body kót a stred rezu sú v data/rendery.json.
const hero3d = render3d('hero', 'duo');
const heroRez = hero3d ?? fotka('hero-rez-duo.png')!;
const heroBody = hero3d ? (rendery.hero as Record<string, { plast?: number[]; rura?: number[]; ohyb?: number[]; stred?: number[] }>).duo : undefined;
const heroMaska = hero3d ? maska3d(hero3d) : undefined;
const rodina3d = render3d('rodina', 'rodina');
const rodina = rodina3d ?? fotka('rodina-potrubi.png')!;
const kotuc = fotka('kotuc.jpg')!;
// Rez výkopom s dvomi potrubiami (render z katalógu Watts): obraz trasy pre kartu konfigurátora.
const trasa = fotka('vykop-rez.jpg')!;

/* Projekty: dve najväčšie stavby z referencií. Fotka a kóty (číslo na rúre alebo v kotolni) sú
   v content/referencie.ts, texty pre domov v ui.ts. */
const po = h.projekty.orange;
const pp = h.projekty.povazska;
const refs = referencie(lang);
const sOrange = refs.find((r) => r.id === 'orange')!.scena!;
const sPovazska = refs.find((r) => r.id === 'povazska-bystrica')!.scena!;
const orangeScena = fotkaReferencie(sOrange.fotka)!;
const povazskaScena = fotkaReferencie(sPovazska.fotka)!;
const kotyOrange = sOrange.koty;
const kotyPovazska = sPovazska.koty;
// Stavenisko so žeriavom: rúra v popredí (modré pixely pri 45 % šírky ležia na 76 % výšky fotky).
const stavenisko = fotkaReferencie('povazska-3.jpg')!;
const kotyStavenisko: Kota[] = [{ x: 45, y: 76, l: 12, smer: 'hore-vpravo', hodnota: pp.stavenisko.kota[0], text: pp.stavenisko.kota[1] }];
// Rozložený rez na domove: DUO vykurovanie ako vzor celej rodiny, texty vrstiev z ui.ts (od plášťa po rúru,
// v poradí, v akom sa pri rolovaní oddelia), makrá materiálov z 3D modelu, keď sú.
const rozklad = rozkladRadu('microflex-duo-6-bar');
const tx = stranky(lang).rad;
const vrstvyRozkladu = (['plast', 'pena', 'rura'] as const).map((id) => ({ ...h.lupy.find((l) => l.id === id)!, img: id === 'rura' ? makroRury('vykurovanie') : render3d('makra', id) }));
// Odlesk po plášti: maska je samotný render, svetlo tak prejde len po výrobku, nie po pozadí.
// Ten istý súbor ako 760 px AVIF v srcset obrázka (Obraz.astro), na mobile sa teda nesťahuje druhýkrát.
// Prehliadač bez AVIF masku nenačíta a odlesk len vynechá.
const leskMaska = (await getImage({ src: heroMaska ?? heroRez, width: 760, format: heroMaska ? 'webp' : 'avif', quality: 50 })).src;
/* Popisy na renderi: bod leží na tom, čo číslo opisuje (okraj plášťa, spodná žltá rúra, zvlnené telo),
   štítok v prázdnom mieste okolo výrobku. Polohy a dĺžky čiar sú v CSS podľa id, zmerané na siluete
   hero-rez-duo.png; dĺžky sú v cqw (percentá šírky štúdia), takže celá vrstva rastie s obrázkom. */
const popisy = [
  { id: 'plast', hodnota: faktPlast, text: h.popisy.plast },
  { id: 'rura', hodnota: faktRura, text: faktTlak },
  { id: 'ohyb', hodnota: faktPolomer, text: h.popisy.polomer },
];
---
<Base lang={lang} alternates={staticAlternates('domov')} title={ui.domov.title} description={ui.domov.description}>
  <section class="hero" aria-labelledby="h-hero" data-mys>
    <div class="wrap hero-in">
      <div class="hero-text">
        {/* Kľúčové slovo ostáva v nadpise, len v tichom riadku nad sloganom. */}
        <h1 id="h-hero">
          <span class="h1-kicker">{h.heroKicker}</span>
          <span class="h1-a">{h.h1a}</span>
          <span class="h1-b">{h.h1b}</span>
        </h1>
        <p class="lead">{sadzba(h.lead)}</p>
        <div class="hero-actions">
          <a class="btn btn-yellow btn-lg" href={route(lang, 'vyber')}>{h.cta} <Ikona nazov="arrow-right" velkost={18} /></a>
          <a class="hero-odkaz" href={`${route(lang, 'firmy')}#dopyt`}>{h.cta2}</a>
        </div>
      </div>
      <div class:list={['hero-product', { je3d: hero3d }]}>
        <div class:list={['hero-stage', { je3d: hero3d }]} style={heroBody?.stred ? `--kx: ${((heroBody.stred[0] + 50) / 190 * 100).toFixed(1)}%; --ky: ${((heroBody.stred[1] + 15) / 115 * 100).toFixed(1)}%` : undefined}>
          <Obraz src={heroRez} alt={h.heroAlt} widths={[760, 1140, 1517]} sizes="(max-width: 760px) 100vw, 62vw" loading="eager" fetchpriority="high" class="hero-img" />
          <span class="lesk" aria-hidden="true" style={`--maska: url("${leskMaska}")`}></span>
          <ul class="popisy" aria-label={h.popisy.label}>
            {popisy.map((p, i) => (
              <li class={`popis popis-${p.id}`} style={`--i: ${i}${heroBody?.[p.id as 'plast'] ? `; --x: ${heroBody[p.id as 'plast']![0]}%; --y: ${heroBody[p.id as 'plast']![1]}%` : ''}`}>
                <span class="bod" aria-hidden="true"></span>
                <span class="ciara" aria-hidden="true"></span>
                <span class="stitok"><strong>{p.hodnota}</strong><span>{sadzba(p.text)}</span></span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Katalog lang={lang} />

  <section class="section rodina" aria-labelledby="h-rodina">
    <div class="wrap rodina-grid">
      <div class="rodina-text">
        <h2 id="h-rodina">{h.rodinaH2}</h2>
        <p class="lead">{sadzba(h.rodinaP)}</p>
      </div>
      <div class:list={['rodina-obraz', { je3d: rodina3d }]}>
        <div class="rodina-wrap"><Obraz src={rodina} alt={h.rodinaAlt} widths={[800, 1200, 1633]} sizes="(max-width: 1100px) 100vw, 64vw" class="rodina-img" /></div>
      </div>
    </div>
  </section>

  {/* Rozložený rez (Juraj 26. 10. 2026 namiesto „rezu pod lupou“): vlastný 3D model DUO sa pri rolovaní
      rozloží na plášť, penu a nosné rúry, pri každej vrstve kóta. Kým nie sú snímky, ostáva len rodina. */}
  {rozklad && <Rozklad class="rozklad-domov" data={rozklad} nadpis={tx.stavbaH2} popis={tx.stavbaP} vrstvy={vrstvyRozkladu} alt={tx.rozkladAlt('Microflex DUO')} label={h.lupyLabel} />}

  <section class="section pokladka" aria-labelledby="h-pokladka">
    {/* Fotka kotúča má čisto bielu plochu: násobením splynie s pásom a text sedí vo vnútri kotúča. */}
    <div class="kotuc-obal">
      <Obraz src={kotuc} alt={h.pokladkaAlt} widths={[900, 1400, 2000]} sizes="(max-width: 760px) 120vw, 76vw" class="kotuc" />
    </div>
    <div class="wrap pokladka-grid">
      <div class="pokladka-text">
        <h2 id="h-pokladka">{h.pokladkaH2}</h2>
        <p class="lead">{sadzba(h.pokladkaP)}</p>
        <div class="kroky-obal" data-rozvin>
          <span class="k-rura" aria-hidden="true"></span>
          <ol class="kroky" aria-label={h.krokyLabel}>
            {h.kroky.map(([nazov, text], i) => (
              <li><span class="k-cislo" aria-hidden="true">{i + 1}</span><h3>{nazov}</h3><p>{sadzba(text)}</p></li>
            ))}
          </ol>
        </div>
        <div class="pokladka-pata">
          <p class="zataz"><strong>{h.zataz[0]}</strong><span>{sadzba(h.zataz[1])}</span></p>
          <p class="zdroj">{h.pokladkaZdroj} <a href={`${KATALOG_PDF}#page=37`} target="_blank" rel="noopener">{h.pokladkaOdkaz} <Ikona nazov="arrow-up-right" velkost={14} /></a></p>
        </div>
      </div>
    </div>
  </section>

  {/* Podzemie: posledný úsek stránky je tmavý ako zem, do ktorej potrubie ide. Fotka prvého
      projektu prekračuje šikmú hranu, takže svetlá a tmavá časť nie sú dva bloky, ale jeden prechod. */}
  <div class="podzemie">
    {/* Projekty ako mozaika (Juraj 22. 10. 2026, návrh C): veľký výkop vľavo, kotolňa a stavenisko
        vpravo nad sebou, každá fotka s jednou kótou; texty oboch projektov pod mozaikou. Keď príde
        fotka veľkej stavby od 2 400 px, prvá fotka pôjde cez celú šírku (návrh B). */}
    <section class="projekty wrap" aria-labelledby="h-projekty">
      <div class="proj-hlava">
        <h2 id="h-projekty">{h.projektyH2}</h2>
        <p class="proj-uvod">{sadzba(h.projektyP)}</p>
      </div>
      <div class="proj-mozaika">
        <Scena class="pm-a" obraz={orangeScena} alt={po.alt} koty={kotyOrange} label={h.projektyKoty} widths={[760, 1000, 1200]} sizes="(max-width: 900px) 100vw, 62vw" />
        <Scena class="pm-b" obraz={povazskaScena} alt={pp.alt} koty={kotyPovazska} label={h.projektyKoty} widths={[480, 895]} sizes="(max-width: 900px) 100vw, 36vw" />
        <Scena class="pm-c" obraz={stavenisko} alt={pp.stavenisko.alt} koty={kotyStavenisko} label={h.projektyKoty} widths={[480, 895]} sizes="(max-width: 900px) 100vw, 36vw" />
      </div>
      <div class="proj-texty">
        <article class="proj-text" aria-labelledby="h-proj-orange">
          <p class="proj-kde">{po.kde}</p>
          <h3 id="h-proj-orange">{sadzba(po.h3)}</h3>
          <p>{sadzba(po.p)}</p>
          <a class="proj-odkaz" href={`${route(lang, 'referencie')}#orange`}>{h.projektyViac}</a>
        </article>
        <article class="proj-text" aria-labelledby="h-proj-povazska">
          <p class="proj-kde">{pp.kde}</p>
          <h3 id="h-proj-povazska">{sadzba(pp.h3)}</h3>
          <p>{sadzba(pp.p)}</p>
          <a class="proj-odkaz" href={`${route(lang, 'referencie')}#povazska-bystrica`}>{h.projektyViac}</a>
        </article>
      </div>
      <p class="proj-vsetky-obal"><a class="proj-vsetky" href={route(lang, 'referencie')}>{h.projektyVsetky}</a></p>
    </section>

    <section class="podpora wrap" aria-labelledby="h-podpora">
      <div class="podpora-hlava">
        <h2 id="h-podpora">{h.podporaH2}</h2>
        <p class="lead">{sadzba(h.podporaP)}</p>
        <div class="podpora-akcie">
          <a class="btn btn-yellow" href={`${route(lang, 'firmy')}#dopyt`}>{h.podporaDopyt}</a>
          <a class="btn btn-ghost-light" href={route(lang, 'stiahnut')}><Ikona nazov="download" velkost={18} />{h.podporaPodklady}</a>
        </div>
      </div>
      <ul class="podpora-sluzby">
        {h.podpora.map((s, i) => (
          <li>
            <h3>{s.h}</h3>
            <p>{sadzba(s.p)}</p>
            <a href={i === 0 ? route(lang, 'stiahnut') : `${route(lang, 'firmy')}#dopyt`}>{s.odkaz}</a>
          </li>
        ))}
      </ul>
      {/* Jediné miesto pre konfigurátor trasy (samostatná etapa). Kým nie je hotový, vedie k dopytu. */}
      <aside class="konfigurator" aria-labelledby="h-konf" data-konfigurator>
        <div class="konf-obraz"><Obraz src={trasa} alt="" widths={[480, 720]} sizes="(max-width: 900px) 100vw, 34vw" /></div>
        <div class="konf-telo">
          <p class="konf-stav">{h.konfigurator.stav}</p>
          <h3 id="h-konf">{h.konfigurator.h}</h3>
          <p>{sadzba(h.konfigurator.p)}</p>
          <a class="konf-odkaz" href={`${route(lang, 'firmy')}#dopyt`}>{h.konfigurator.odkaz}</a>
        </div>
      </aside>
      <p class="istota">{sadzba(h.istota)}</p>
    </section>
  </div>
</Base>


<style>
  /* ---------- Hero: svetlé pole, farbu nesie výrobok ---------- */
  /* Spodných --presah pixelov hero je bez pozadia: je pod nimi šikmá horná hrana pásu katalógu,
     ktorú spodok renderu pretína, rovnako ako fotka z výkopu pretína hranu podzemia. */
  .hero { --presah: var(--presah-hero); position: relative; display: flex; align-items: center; min-height: clamp(540px, 70vh, 720px); overflow-x: clip; z-index: 1; color: var(--color-ink);
    background:
      linear-gradient(to bottom, rgb(255 255 255 / 0) 62%, #ffffff 100%),
      radial-gradient(52% 62% at 76% 52%, rgb(0 93 185 / 0.08) 0%, rgb(0 93 185 / 0) 72%),
      linear-gradient(158deg, #ffffff 0%, #fafbfd 46%, #eef2f7 100%);
    background-size: 100% calc(100% - var(--presah)); background-repeat: no-repeat; }
  .hero-in { position: relative; width: 100%; display: grid; grid-template-columns: minmax(0, 44fr) minmax(0, 56fr); grid-template-areas: "text obraz"; column-gap: 24px; }
  .hero-text { grid-area: text; align-self: center; max-width: 620px; padding-block: 72px; display: flex; flex-direction: column; align-items: flex-start; position: relative; z-index: 3; }
  .hero-text > * { animation: rise 680ms var(--ease-soft) both; }
  .hero-text > :nth-child(2) { animation-delay: 220ms; }
  .hero-text > :nth-child(3) { animation-delay: 320ms; }
  .hero h1 { display: flex; flex-direction: column; font-size: clamp(34px, 2.9vw + 12px, 58px); line-height: 1.03; letter-spacing: -0.03em; text-wrap: nowrap; }
  /* Tichý riadok nad sloganom je súčasť H1 kvôli vyhľadávačom; sadzba ako veta, nie verzálky. */
  .h1-kicker { font-family: var(--font-text); font-stretch: 100%; font-size: 16px; font-weight: 500; line-height: 1.4; letter-spacing: 0; color: var(--color-ink-soft); margin-bottom: 18px; }
  /* Jediný orchestrovaný moment: prvý riadok sa pri načítaní roztiahne po osi šírky písma,
     tak ako sa rozvinie ohybné potrubie. Cieľ je šírka nadpisu, preto animácia nemá koncový stav. */
  .h1-a { color: var(--color-ink); animation: flex 1150ms 60ms var(--ease-soft) both; }
  .h1-b { color: var(--color-blue-700); }
  @keyframes flex { from { font-stretch: 72%; opacity: 0; } 35% { opacity: 1; } }
  .hero .lead { font-size: 18px; max-width: 30em; margin-top: 22px; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 30px; margin-top: 34px; }
  .hero-actions .btn :global(svg) { transition: transform 200ms var(--ease-soft); }
  @media (hover: hover) and (pointer: fine) { .hero-actions .btn:hover :global(svg) { transform: translateX(3px); } }
  /* Druhá akcia nie je tlačidlo: nemá súperiť so žltým, len ponúknuť cestu k dopytu na projekt. */
  .hero-odkaz { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; color: var(--color-blue-700); border-bottom: 1px solid currentColor; padding-bottom: 3px; }
  /* Rúra prekračuje pravý okraj obsahovej mriežky až za okraj obrazovky. */
  /* Render sedí na spodku hero, takže jeho dolná časť pretne šikmú hranu pásu katalógu. */
  .hero-product { grid-area: obraz; position: relative; z-index: 2; align-self: end; margin-left: -9%;
    margin-right: calc(min(calc(-1 * var(--gutter)), calc((var(--container-site) - 100vw) / 2)) - 64px);
    pointer-events: none; animation: settle 1300ms 120ms var(--ease-soft) both; }
  .hero-product :global(.hero-img) { width: 100%; height: auto; display: block; filter: drop-shadow(0 30px 36px rgb(11 27 51 / 0.17)); }
  /* Render 3D modelu má vlastný kontaktný tieň. */
  .hero-stage.je3d :global(.hero-img) { filter: none; }
  /* Render 3D modelu má rez tesne pri ľavom okraji: bez presahu do stĺpca textu, inak by sa pri 1 536 až
     1 920 px rez dotkol nadpisu (meranie po riadkoch: medzera aspoň 32 px pri 1 024 až 2 560 px). */
  @media (min-width: 761px) { .hero-product.je3d { margin-left: 0; } }
  /* Štúdio má presne rozmer obrázka: body popisov sú v percentách obrázka a sedia pri každej šírke.
     Pri pohybe myši sa výrobok jemne posunie a pootočí, text stojí. */
  .hero-stage { position: relative; max-width: 1180px; margin-inline: auto; container-type: inline-size; transform: translate3d(calc(var(--mx, 0) * 12px), calc(var(--my, 0) * 8px), 0); transition: transform 900ms var(--ease-soft); }
  /* Za rezom sústredné kružnice ako na výkrese prierezu, stredom v reze rúry (27 % a 60 % štúdia).
     Zdola doznejú ešte nad šikmou hranou pásu katalógu, aby cez ňu neprechádzali. */
  .hero-stage::before { content: ""; position: absolute; inset: -15% -40% 0 -50%; z-index: -1; pointer-events: none;
    background: repeating-radial-gradient(circle at var(--kx, 40.5%) var(--ky, 65%), rgb(10 42 94 / 0.075) 0 1px, rgb(10 42 94 / 0) 1.5px 46px);
    -webkit-mask-image: radial-gradient(circle at var(--kx, 40.5%) var(--ky, 65%), #000 12%, transparent 50%), linear-gradient(to bottom, #000 40%, transparent calc(100% - var(--presah-hero) - 32px));
    -webkit-mask-composite: source-in;
    mask-image: radial-gradient(circle at var(--kx, 40.5%) var(--ky, 65%), #000 12%, transparent 50%), linear-gradient(to bottom, #000 40%, transparent calc(100% - var(--presah-hero) - 32px));
    mask-composite: intersect;
    animation: kruhy 1600ms 300ms var(--ease-soft) both; }
  @keyframes kruhy { from { opacity: 0; transform: scale(0.97); } to { opacity: 1; transform: none; } }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  /* Bez priehľadnosti: render je najväčší prvok obrazovky (LCP) a prehliadač ho započíta, až keď
     je viditeľný. Na mobile tak čakal aj na písma a obrázky pod ním. Pohyb ostáva. */
  @keyframes settle { from { transform: translate(40px, 0) rotate(-1.5deg) scale(1.02); } to { transform: none; } }

  /* Odlesk: pás svetla raz prejde po plášti. Maska je render, takže svetlo nejde po pozadí. */
  .lesk { position: absolute; inset: 0; pointer-events: none; mix-blend-mode: screen; opacity: 0.9;
    -webkit-mask: var(--maska) center / 100% 100% no-repeat; mask: var(--maska) center / 100% 100% no-repeat;
    background: linear-gradient(105deg, rgb(255 255 255 / 0) 40%, rgb(190 215 255 / 0.42) 50%, rgb(255 255 255 / 0) 60%) no-repeat;
    background-size: 260% 100%; background-position: 135% 0; animation: lesk 2200ms 1100ms cubic-bezier(0.45, 0, 0.25, 1) both; }
  @keyframes lesk { from { background-position: 135% 0; } to { background-position: -35% 0; } }

  /* Technické popisy (kóty): bod leží na tom, čo číslo opisuje, čiara vedie k štítku. Štítok má
     jemne mliečne pozadie, aby bol čitateľný aj tam, kde sa dotkne výrobku. Prídu po nadpise. */
  .popisy { position: absolute; inset: 0; margin: 0; padding: 0; pointer-events: none; }
  .popis { position: absolute; left: var(--x); top: var(--y); width: 0; height: 0; }
  .bod { position: absolute; z-index: 2; left: -7px; top: -7px; width: 14px; height: 14px; border-radius: 50%; background: #fff; box-shadow: inset 0 0 0 3px var(--color-blue-900), 0 0 0 4px rgb(255 255 255 / 0.55), 0 3px 10px rgb(11 27 51 / 0.35); animation: bod 420ms var(--ease-soft) both; animation-delay: calc(1250ms + var(--i) * 170ms); }
  .bod::after { content: ""; position: absolute; inset: -7px; border-radius: 50%; border: 1.5px solid rgb(255 255 255 / 0.95); opacity: 0; animation: pulz 1500ms ease-out 1 both; animation-delay: calc(1650ms + var(--i) * 170ms); }
  .ciara { position: absolute; left: -0.75px; width: 1.5px; height: var(--l); border-radius: 1px; background: var(--color-blue-900); box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.55); animation: ciaraY 520ms var(--ease-soft) both; animation-delay: calc(1330ms + var(--i) * 170ms); }
  .stitok { position: absolute; display: flex; flex-direction: column; gap: clamp(2px, 0.3cqw, 4px); white-space: nowrap;
    padding: clamp(5px, 0.72cqw, 10px) clamp(8px, 1.05cqw, 14px); border-radius: clamp(8px, 0.9cqw, 12px);
    background: rgb(255 255 255 / 0.84); -webkit-backdrop-filter: blur(10px) saturate(1.4); backdrop-filter: blur(10px) saturate(1.4);
    box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.08), var(--elev-2);
    animation: rise 560ms var(--ease-soft) both; animation-delay: calc(1520ms + var(--i) * 170ms); }
  .stitok strong { font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: clamp(15px, 2.5cqw, 28px); line-height: 1.05; letter-spacing: -0.02em; color: var(--color-blue-900); font-variant-numeric: tabular-nums; }
  .stitok span { font-size: clamp(11px, 1.45cqw, 15px); line-height: 1.3; font-weight: 500; color: #3f4b5e; }
  /* Kam ide čiara a štítok. Počítač: plášť nad rezom, rúra pod ňou doľava, ohyb pod telom doprava. */
  @media (min-width: 761px) {
    .popis-plast { --x: 27%; --y: 31%; --l: 10.6cqw; }
    .popis-rura { --x: 24%; --y: 79.5%; --l: 7.2cqw; }
    .popis-ohyb { --x: 74%; --y: 56%; --l: 9.2cqw; }
    .popis-plast .ciara { bottom: 0; transform-origin: bottom; }
    .popis-plast .stitok { left: -0.75px; bottom: var(--l); border-bottom-left-radius: 2px; }
    .popis-rura .ciara, .popis-ohyb .ciara { top: 0; transform-origin: top; }
    .popis-rura .stitok { right: -0.75px; top: var(--l); border-top-right-radius: 2px; align-items: flex-end; text-align: right; }
    .popis-ohyb .stitok { left: -0.75px; top: var(--l); border-top-left-radius: 2px; }
  }
  /* Telefón: plášť a ohyb nad výrobkom, rúra pod ním; štítky sa neprekrývajú ani nevyjdú z displeja. */
  @media (max-width: 760px) {
    .popis-plast { --x: 27%; --y: 31%; --l: 14.4cqw; }
    .popis-rura { --x: 24%; --y: 79.5%; --l: 10.6cqw; }
    .popis-ohyb { --x: 67%; --y: 25%; --l: 13.7cqw; }
    .popis-plast .ciara, .popis-ohyb .ciara { bottom: 0; transform-origin: bottom; }
    .popis-plast .stitok, .popis-ohyb .stitok { left: -0.75px; bottom: var(--l); border-bottom-left-radius: 2px; }
    .popis-rura .ciara { top: 0; transform-origin: top; }
    .popis-rura .stitok { left: -0.75px; top: var(--l); border-top-left-radius: 2px; }
    /* Render 3D modelu: bod ohybu je na spodnej hrane tela, štítok visí pod ňou v prázdnom mieste,
       nie nad bodom na plášti (Juraj 23. 9.: štítok nikdy na plášti). */
    .je3d .popis-ohyb { --l: 8cqw; }
    .je3d .popis-ohyb .ciara { top: 0; bottom: auto; transform-origin: top; }
    .je3d .popis-ohyb .stitok { top: var(--l); bottom: auto; border-radius: clamp(8px, 0.9cqw, 12px); border-top-left-radius: 2px; }
  }
  @keyframes bod { from { opacity: 0; transform: scale(0.3); } to { opacity: 1; transform: none; } }
  @keyframes ciaraY { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes pulz { 0% { opacity: 0.9; transform: scale(0.6); } 100% { opacity: 0; transform: scale(2.4); } }

  /* ---------- Rodina: render prechádza cez švík z modrého pásu do bielej ---------- */
  /* Pod rodinou hneď pokračuje rozložený rez (lupy sú preč), preto len malý spodný okraj. */
  .rodina { background: linear-gradient(180deg, var(--zem-2) 0%, var(--zem-3) 100%); padding-top: 0; padding-bottom: 24px; overflow-x: clip; overflow-y: visible; }
  /* Rozložený rez pokračuje zostupom pod zem: rovnaký tón ako koniec rodiny a začiatok pokládky. */
  :global(.rozklad.rozklad-domov) { background: var(--zem-3); }
  .rodina-grid { position: relative; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 24px; align-items: start; }
  /* Text rodiny začína vyššie, v páse, cez ktorý prechádza render (pás katalógu má dole 200 px pre jeho
     presah); vľavo by inak ostala prázdna plocha (DOLADENIE kap. 2.4, bod 4). */
  .rodina-text { position: relative; z-index: 3; margin-top: -96px; }
  .rodina-text h2 { margin-bottom: 16px; }
  .rodina-text .lead { max-width: 30em; }
  /* Render je veľký a vždy dobehne za pravý okraj obrazovky, aj na širokom monitore. */
  .rodina-obraz { width: max(146%, calc(104% + var(--bleed) + 24px)); max-width: none; margin: -196px 0 0 -4%; position: relative; z-index: 2; }
  .rodina-wrap { filter: drop-shadow(0 28px 36px rgb(11 27 51 / 0.2)); }
  .rodina-wrap :global(.rodina-img) { width: 100%; height: auto; display: block; -webkit-mask-image: linear-gradient(to top right, #000 66%, transparent 97%); mask-image: linear-gradient(to top right, #000 66%, transparent 97%); }
  /* Rodina z 3D modelu: celé telá a vlastný kontaktný tieň, bez doznenia a bez tieňa z CSS. Na počítači
     sa zmestí celá (text menuje aj COOL a HP, tie by za okrajom chýbali), vpravo do okraja obrazovky. */
  .rodina-obraz.je3d .rodina-wrap { filter: none; }
  .rodina-obraz.je3d :global(.rodina-img) { -webkit-mask-image: none; mask-image: none; }
  @media (min-width: 1101px) { .rodina-obraz.je3d { width: calc(100% + var(--bleed) - 16px); margin: -180px 0 0 -1%; } }


  /* ---------- Pokládka: kotúč vľavo cez okraj obrazovky, text v jeho vnútri ---------- */
  .pokladka { position: relative; overflow: hidden; padding-top: 112px; padding-bottom: 232px; isolation: isolate; background: linear-gradient(180deg, var(--zem-3) 0%, var(--zem-4) 100%); }
  /* Obal je celá plocha sekcie: maska na ňom rozpustí kotúč hore aj dole v páse, nech je obrázok
     akokoľvek vysoký. Násobenie je tiež na obale, lebo obrázok v samostatnej vrstve by sa miešal
     len s prázdnom a biela by ostala biela. */
  .kotuc-obal { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; mix-blend-mode: multiply;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 17%, #000 80%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 17%, #000 80%, transparent 100%); }
  /* Vnútorný okraj kotúča (asi 57 % šírky fotky) leží 150 px pred stĺpcom textu, ktorý začína
     v strede mriežky. Na širokom monitore kotúč rastie, aby vždy dobehol za ľavý okraj obrazovky. */
  .kotuc-obal :global(.kotuc) { --w: max(1180px, calc((50vw - 40px) / 0.57)); position: absolute; width: var(--w); max-width: none; height: auto; left: calc(50% - 150px - 0.57 * var(--w)); top: calc(50% - var(--w) / 2.566); transform-origin: 96% 50%; }
  /* Kotúč sa pri prechode sekciou pootočí o 7°, akoby sa odvíjal. Pohyb je v CSS na časovej osi sekcie
     (beží mimo hlavného vlákna, plynulo aj na mobile; predtým Motion scroll()). Kde to prehliadač nevie
     alebo je zapnuté „obmedziť pohyb“, kotúč stojí. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .pokladka { view-timeline: --pokladka block; }
      .kotuc-obal :global(.kotuc) { animation: kotuc-otacaj linear both; animation-timeline: --pokladka; animation-range: cover 0% cover 100%; }
    }
  }
  @keyframes kotuc-otacaj { from { rotate: -4deg; } to { rotate: 3deg; } }
  .pokladka-grid { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px; }
