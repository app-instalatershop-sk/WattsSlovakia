---
/**
 * Diel (spojka alebo príslušenstvo) na podlahe štúdia (Juraj 22. 10. 2026, návrh F): bez bielej
 * karty, fotka výrobcu stojí na svetlej ploche so svetlom zhora a tieňom pod sebou ako pri fotení
 * výrobkov. Pod ňou názov a počet obj. čísel. Malá verzia (maly) je riadok s menšou plochou vľavo.
 * Celá položka vedie na stránku dielu.
 */
import { Image } from 'astro:assets';
import Ikona from './Ikona.astro';
import { fotkaProduktu } from '../lib/obrazky';
import { sadzba } from '../lib/sadzba';
import { pNazov, type Produkt } from '../lib/katalog';
import { faktyProduktu, kodyProduktu } from '../lib/produkty';
import { stranky } from '../content/stranky';
import type { Lang } from '../i18n/ui';

interface Props { p: Produkt; href: string; lang: Lang; maly?: boolean }
const { p, href, lang, maly = false } = Astro.props;
const tx = stranky(lang).skupiny;
const img = fotkaProduktu(p.id);
const kody = kodyProduktu(p).length;
const fakt = faktyProduktu(p, lang).find(([k]) => k !== stranky(lang).produkt.pocet);
---
<a class:list={['kp', { 'kp-maly': maly }]} href={href}>
  <span class="kp-podlaha">{img && <Image src={img} alt="" widths={[240, 400, 560]} sizes={maly ? '120px' : '(max-width: 760px) 44vw, 280px'} />}</span>
  <span class="kp-text">
    <span class="kp-nazov">{sadzba(pNazov(p, lang))}</span>
    <span class="kp-meta">{kody ? tx.objCisel(kody) : tx.bezTabulky}{fakt && !maly && <span>{fakt[1]}</span>}</span>
  </span>
  {maly && <Ikona nazov="arrow-right" velkost={18} class="kp-sipka" />}
</a>

<style>
  .kp { position: relative; display: flex; flex-direction: column; gap: 4px; color: var(--color-ink); }
  .kp:hover { color: var(--color-ink); }
  /* Podlaha štúdia: svetlo zhora, plocha tmavne k spodnej hrane, pod dielom mäkký tieň. */
  .kp-podlaha { position: relative; display: block; aspect-ratio: 1; margin-bottom: 14px; border-radius: 22px; overflow: hidden;
    background: radial-gradient(70% 60% at 50% 35%, #ffffff 0%, #f2f5f9 55%, #e6ecf3 100%); box-shadow: inset 0 -24px 40px -30px rgb(10 42 94 / 0.25); }
  .kp-podlaha::after { content: ""; position: absolute; left: 24%; right: 24%; bottom: 19%; height: 6%; border-radius: 50%; background: radial-gradient(closest-side, rgb(10 42 94 / 0.28), rgb(10 42 94 / 0)); }
  .kp-podlaha :global(img) { position: absolute; z-index: 1; inset: 12% 14% 18%; width: 72%; height: 70%; object-fit: contain; mix-blend-mode: multiply; transition: transform 500ms var(--ease-soft); }
  .kp:hover .kp-podlaha :global(img) { transform: translateY(-6px) scale(1.03); }
  .kp-text { display: flex; flex-direction: column; gap: 4px; }
  .kp-nazov { font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 17px; line-height: 1.25; transition: color 150ms var(--ease-soft); }
  .kp:hover .kp-nazov { color: var(--color-blue-700); }
  .kp-meta { display: flex; flex-wrap: wrap; gap: 2px 12px; font-size: 14px; color: var(--color-ink-soft); }

  /* Malá verzia (ďalšie diely v skupine): riadok, plocha vľavo, šípka vpravo. */
  .kp-maly { flex-direction: row; align-items: center; gap: 16px; padding: 10px 44px 10px 10px; border-radius: 18px; background: rgb(255 255 255 / 0.6); transition: background-color 200ms var(--ease-soft); }
  .kp-maly:hover { background: #fff; }
  .kp-maly .kp-podlaha { flex: none; width: 96px; margin-bottom: 0; border-radius: 14px; }
  .kp-maly .kp-podlaha::after { bottom: 14%; }
  .kp-maly .kp-nazov { font-size: 15.5px; }
  .kp-maly .kp-meta { font-size: 13px; }
  .kp :global(.kp-sipka) { position: absolute; right: 16px; top: 50%; margin-top: -9px; color: var(--color-blue-700); transition: transform 200ms var(--ease-soft); }
  .kp:hover :global(.kp-sipka) { transform: translateX(3px); }
</style>
