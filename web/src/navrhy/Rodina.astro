---
/**
 * Návrh 4: rodina na ťuknutie. Render šiestich systémov z webu; po prejdení myšou, ťuknutí alebo výbere
 * tlačidlom sa jeden systém zvýrazní (ostatné stmavnú) a pri ňom sa objaví štítok s údajmi a odkazom.
 * Masky systémov sú z rovnakého záberu (render --maska, data/navrhy_web.py rodina), malá mapa indexov
 * určuje, nad ktorým systémom je ukazovateľ.
 */
interface System { rad: string; nazov: string; fakty: [string, string]; odkaz: string; bod: number[] }
interface Props { obraz: string; pomer: number; cesta: string; krok: number; systemy: System[]; nadpis: string; popis: string }
const { obraz, pomer, cesta, krok, systemy, nadpis, popis } = Astro.props;
---
<section class="rodina-nv" data-rodina data-cesta={cesta} data-krok={krok}>
  <div class="wrap">
    <h2>{nadpis}</h2>
    <p class="lead">{popis}</p>
    <div class="rn-volba" role="group" aria-label="Systémy">
      {systemy.map((s, k) => <button type="button" data-k={k} aria-pressed="false">{s.nazov.replace('Microflex ', '')}</button>)}
    </div>
  </div>
  <div class="rn-stage" style={`aspect-ratio: ${pomer}`}>
    <img class="rn-zaklad" src={obraz} alt="Šesť systémov Microflex vedľa seba, rezy ku kamere" width="2400" height={Math.round(2400 / pomer)} />
    {systemy.map((_, k) => <img class="rn-svetlo" data-k={k} src={obraz} alt="" aria-hidden="true" style={`-webkit-mask-image: url(${cesta}maska-${k}.webp); mask-image: url(${cesta}maska-${k}.webp)`} />)}
    {systemy.map((s, k) => (
      <div class="rn-stitok" data-k={k} style={`--x: ${s.bod[0]}%; --y: ${s.bod[1]}%`} hidden>
        <span class="rn-bod" aria-hidden="true"></span>
        <div class="rn-karta">
          <strong>{s.nazov.replace('Microflex ', '')}</strong>
          <span>{s.fakty[0]}</span>
          <span>{s.fakty[1]}</span>
          <a href={s.odkaz}>Pozrieť rad</a>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .rodina-nv { padding: 56px 0 72px; background: linear-gradient(180deg, #fff, #eef3f9); }
  .rodina-nv h2 { font-size: clamp(28px, 2.2vw + 14px, 42px); letter-spacing: -0.02em; }
  .rodina-nv .lead { margin-top: 12px; max-width: 44em; }
  .rn-volba { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 22px; }
  .rn-volba button { padding: 9px 16px; border: 0; border-radius: 999px; background: #fff; box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.12); font: inherit; font-weight: 600; color: var(--color-ink); cursor: pointer; }
  .rn-volba button[aria-pressed="true"] { background: var(--color-blue-900); color: #fff; box-shadow: none; }
  .rn-volba button:focus-visible { outline: 3px solid var(--color-yellow-500); outline-offset: 2px; }
  .rn-stage { position: relative; width: min(100%, 1600px); margin: 28px auto 0; cursor: pointer; touch-action: manipulation; }
  .rn-stage img { position: absolute; inset: 0; width: 100%; height: 100%; -webkit-mask-size: 100% 100%; mask-size: 100% 100%; }
  .rn-zaklad { transition: filter 280ms var(--ease-soft); }
  .rn-svetlo { opacity: 0; transition: opacity 280ms var(--ease-soft); pointer-events: none; }
  .rodina-nv.je-vyber .rn-zaklad { filter: saturate(0.35) brightness(0.86) contrast(0.92); }
  .rn-svetlo.is-on { opacity: 1; }
  /* Štítok nad horným okrajom plášťa vybraného systému, rovnaký jazyk ako kóty. */
  .rn-stitok { position: absolute; left: var(--x); top: var(--y); width: 0; height: 0; z-index: 2; }
  .rn-bod { position: absolute; left: -7px; top: -7px; width: 14px; height: 14px; border-radius: 50%; background: #fff; box-shadow: inset 0 0 0 3px var(--color-blue-900), 0 0 0 4px rgb(255 255 255 / 0.5), 0 3px 10px rgb(4 16 40 / 0.4); }
  /* Štítok vedľa bodu (vpravo, pri systémoch v pravej časti vľavo), zvisle na strede bodu: nad bodom
     by pri vyšších systémoch vpravo vyšiel z obrazu do tlačidiel. */
  .rn-karta { position: absolute; top: 0; left: 26px; transform: translateY(-50%); display: grid; gap: 3px; padding: 12px 16px 14px; border-radius: var(--radius-l);
    background: rgb(255 255 255 / 0.93); -webkit-backdrop-filter: blur(10px) saturate(1.4); backdrop-filter: blur(10px) saturate(1.4); box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.08), var(--elev-2); white-space: nowrap; }
  .rn-karta::before { content: ""; position: absolute; left: -26px; top: 50%; width: 26px; height: 1.5px; background: var(--color-blue-900); }
  .rn-karta strong { font-family: var(--font-display); font-stretch: 112%; font-weight: 600; font-size: 20px; color: var(--color-blue-900); }
  .rn-karta span { font-size: 14px; line-height: 1.4; color: #3f4b5e; }
  .rn-karta a { margin-top: 6px; font-weight: 600; font-size: 15px; color: var(--color-blue-700); pointer-events: auto; }
  .rn-stitok:not([hidden]) .rn-karta { animation: rn-prichod 260ms var(--ease-soft) both; }
  @keyframes rn-prichod { from { opacity: 0; } to { opacity: 1; } }
  /* Systémy vpravo: štítok rastie doľava, aby nevyšiel z obrazu. */
  .rn-stitok.vlavo .rn-karta { left: auto; right: 26px; }
  .rn-stitok.vlavo .rn-karta::before { left: auto; right: -26px; }
  @media (max-width: 760px) {
    .rn-karta { padding: 9px 12px 11px; white-space: normal; width: 190px; }
    .rn-karta strong { font-size: 16px; }
    .rn-karta span { font-size: 12.5px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rn-zaklad, .rn-svetlo { transition: none; }
    .rn-stitok:not([hidden]) .rn-karta { animation: none; }
  }
</style>

<script>
  function initRodina() {
    const sek = document.querySelector<HTMLElement>('[data-rodina]');
    if (!sek || sek.dataset.on) return;
    sek.dataset.on = '1';
    const stage = sek.querySelector<HTMLElement>('.rn-stage')!;
    const svetla = [...sek.querySelectorAll<HTMLElement>('.rn-svetlo')];
    const stitky = [...sek.querySelectorAll<HTMLElement>('.rn-stitok')];
    const tlacidla = [...sek.querySelectorAll<HTMLButtonElement>('.rn-volba button')];
    stitky.forEach((s) => s.classList.toggle('vlavo', parseFloat(s.style.getPropertyValue('--x')) > 62));
    let aktivny = -1, pevny = -1;
    const ukaz = (k: number) => {
      if (k === aktivny) return;
      aktivny = k;
      sek.classList.toggle('je-vyber', k >= 0);
      svetla.forEach((s, i) => s.classList.toggle('is-on', i === k));
      stitky.forEach((s, i) => { s.hidden = i !== k; });
      tlacidla.forEach((b, i) => b.setAttribute('aria-pressed', String(i === k)));
    };
    // Mapa indexov: odtieň sivej (k + 1) · krok, 0 = pozadie.
    const mapa = new Image();
    const platno = document.createElement('canvas');
    let data: Uint8ClampedArray | undefined;
    mapa.onload = () => {
      platno.width = mapa.naturalWidth; platno.height = mapa.naturalHeight;
      const ctx = platno.getContext('2d', { willReadFrequently: true })!;
      ctx.drawImage(mapa, 0, 0);
      data = ctx.getImageData(0, 0, platno.width, platno.height).data;
    };
    mapa.src = `${sek.dataset.cesta}mapa.png`;
    const system = (e: PointerEvent) => {
      if (!data) return -1;
      const r = stage.getBoundingClientRect();
      const x = Math.floor(((e.clientX - r.left) / r.width) * platno.width);
      const y = Math.floor(((e.clientY - r.top) / r.height) * platno.height);
      if (x < 0 || y < 0 || x >= platno.width || y >= platno.height) return -1;
      const v = data[(y * platno.width + x) * 4];
      return v ? Math.round(v / Number(sek.dataset.krok)) - 1 : -1;
    };
    stage.addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse') { const k = system(e); ukaz(k >= 0 ? k : pevny); } });
    stage.addEventListener('pointerleave', () => ukaz(pevny));
    stage.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      const k = system(e as PointerEvent);
      pevny = k;
      ukaz(k);
    });
    tlacidla.forEach((b, i) => {
      b.addEventListener('click', () => { pevny = pevny === i ? -1 : i; ukaz(pevny); });
      b.addEventListener('focus', () => ukaz(i));
      b.addEventListener('blur', () => ukaz(pevny));
    });
  }
  initRodina();
  document.addEventListener('astro:page-load', initRodina);
</script>
