---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Ikona from '../components/Ikona.astro';
import { kategorie, cestaKategorie, kKratky, kPopis, cislo, rozsah, type Kategoria, type Rad } from '../lib/katalog';
import { fotka, fotkaRadu, piktogram } from '../lib/obrazky';
import { type Lang, t, route, staticAlternates } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const h = ui.home;

const kats = await kategorie();
const rady = (await getCollection('rady')).map((r) => r.data);
const varianty = (await getCollection('varianty')).map((v) => v.data);
const produkty = (await getCollection('produkty')).map((p) => p.data);

const potrubia = kats.filter((k) => k.typ === 'potrubie');
const diely = kats.filter((k) => k.typ !== 'potrubie');
const radyPotrubi = rady.filter((r) => potrubia.some((k) => k.id === r.kategoria));
const variantyPotrubi = varianty.filter((v) => radyPotrubi.some((r) => r.id === v.rad));

// Fakty z dát, nie z hlavy.
const polomery = variantyPotrubi.map((v) => v.polomer_ohybu_m).filter((x): x is number => typeof x === 'number');
const faktPolomer = `${ui.common.od} ${cislo(Math.min(...polomery), 2)} m`;
const faktRura = rozsah(variantyPotrubi.map((v) => v.rura?.d), 'mm', lang);
const tlaky = [...new Set(radyPotrubi.map((r) => r.tlak_bar).filter((x): x is number => typeof x === 'number'))].sort((a, b) => a - b);
const faktTlak = tlaky.map((x) => `${x}`).join(' / ') + ' bar';
const faktRady = String(radyPotrubi.length);

function obrazokKategorie(k: Kategoria) {
  const r = rady.find((x: Rad) => x.kategoria === k.id && x.fotka);
  return fotkaRadu(r?.fotka);
}
const pocetProduktov = (k: Kategoria) => ui.domov.produktov(produkty.filter((p) => p.kategoria === k.id).length);

const heroRez = fotka('hero-rez-duo.png')!;
const rodina = fotka('rodina-potrubi.png')!;
const kotuc = fotka('kotuc.jpg')!;
const refFotky = [fotka('prierez-duo.jpg')!, fotka('referencia-skola.png')!, fotka('referencia-povazska-bystrica.jpg')!];
---
<Base lang={lang} alternates={staticAlternates('domov')} title={ui.domov.title} description={ui.domov.description}>
  <section class="hero" aria-labelledby="h-hero">
    <div class="hero-panel" aria-hidden="true"></div>
    <div class="wrap hero-in">
      <div class="hero-text">
        <h1 id="h-hero"><span class="brand-line">{h.h1a}</span> {h.h1b}</h1>
        <p class="lead">{h.lead}</p>
        <div class="hero-actions">
          <a class="btn btn-yellow" href={route(lang, 'vyber')}>{h.cta}</a>
          <a class="btn btn-secondary" href={route(lang, 'stiahnut')}><Ikona nazov="download" velkost={18} />{h.cta2}</a>
        </div>
      </div>
      <div class="hero-product">
        <Image src={heroRez} alt="Rez predizolovaným potrubím Microflex DUO" widths={[760, 1140, 1517]} sizes="(max-width: 760px) 100vw, 60vw" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <div class="wrap">
    <dl class="facts-bar">
      <div><dd>{faktPolomer}</dd><dt>{h.facts.polomer}</dt></div>
      <div><dd>{faktRura}</dd><dt>{h.facts.rura}</dt></div>
      <div><dd>{faktTlak}</dd><dt>{h.facts.tlak}</dt></div>
      <div><dd>{faktRady}</dd><dt>{h.facts.rady}</dt></div>
    </dl>
  </div>

  <section class="section uses-section" aria-labelledby="h-uses">
    <div class="wrap">
      <h2 id="h-uses" class="h2-quiet" data-reveal>{h.pouzitieH2}</h2>
      <div class="uses" data-reveal-group>
        {h.pouzitia.map((p) => {
          const img = piktogram(p.pikto);
          const k = kats.find((x) => x.slug === p.slug || x.slug_cs === p.slug);
          return (
            <a class="use" href={k ? cestaKategorie(k, lang) : route(lang, 'potrubia')}>
              {img && <Image src={img} alt="" width={280} height={210} densities={[1, 2]} class="pikto" />}
              <h3>{p.nazov}</h3>
              <p>{p.text}</p>
              <Ikona nazov="arrow-up-right" velkost={20} class="go" />
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section band-soft" aria-labelledby="h-cat">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="h-cat">{h.katalogH2}</h2>
        <p class="muted">{h.katalogP}</p>
      </div>
      <div class="systems" data-reveal-group>
        {potrubia.map((k) => { const img = piktogram(k.piktogram); return (
          <a class="card system" href={cestaKategorie(k, lang)}>
            {img && <Image src={img} alt="" width={420} height={340} densities={[1, 2]} class="pikto" />}
            <div class="body"><h3>{kKratky(k, lang)}</h3><span class="count">{ui.sklonovanie.radov(k.rady.length)}</span></div>
          </a>
        ); })}
      </div>
      <h3 class="diely-h" data-reveal>{h.dielyH3}</h3>
      <div class="parts" data-reveal-group>
        {diely.map((k) => { const img = obrazokKategorie(k); return (
          <a class="part" href={cestaKategorie(k, lang)}>
            <span class="part-img">{img && <Image src={img} alt="" widths={[160, 320]} sizes="120px" />}</span>
            <span class="part-txt"><strong>{kKratky(k, lang)}</strong><span class="muted">{kPopis(k, lang)}</span></span>
            <span class="part-meta">{pocetProduktov(k)} <Ikona nazov="chevron-right" velkost={18} /></span>
          </a>
        ); })}
      </div>
    </div>
  </section>

  <section class="section rodina" aria-labelledby="h-rodina">
    <div class="wrap">
      <div class="rodina-grid">
        <div class="rodina-head" data-reveal>
          <h2 id="h-rodina">{h.rodinaH2}</h2>
          <p class="lead">{h.rodinaP}</p>
        </div>
        <Image src={rodina} alt={h.rodinaAlt} widths={[800, 1200, 1633]} sizes="(max-width: 760px) 100vw, 60vw" class="rodina-img" data-parallax="0.06" />
      </div>
      <div class="fakty" data-reveal-group>
        {h.fakty.map(([dt, dd]) => <div><h3>{dt}</h3><p>{dd}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section band" aria-labelledby="h-refs">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="h-refs">{h.refH2}</h2>
        <a href={route(lang, 'referencie')}>{h.refVsetky}</a>
      </div>
      <div class="refs" data-reveal-group>
        {h.refs.map(([b, s], i) => (
          <a class="ref" href={route(lang, 'referencie')}><Image src={refFotky[i]} alt="" widths={[420, 640]} sizes="(max-width: 760px) 90vw, 30vw" /><span><strong>{b}</strong><span class="muted">{s}</span></span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="section band-dark b2b" aria-labelledby="h-b2b">
    <Image src={kotuc} alt="" class="b2b-bg" widths={[960, 1600]} sizes="100vw" aria-hidden="true" data-parallax="0.1" />
    <div class="wrap b2b-grid">
      <div class="b2b-text" data-reveal>
        <h2 id="h-b2b">{h.b2bH2}</h2>
        <p class="lead">{h.b2bP}</p>
        <div class="hero-actions">
          <a class="btn btn-inverse" href={route(lang, 'firmy')}>{h.b2bDopyt}</a>
          <a class="btn btn-ghost-light" href={route(lang, 'stiahnut')}><Ikona nazov="download" velkost={18} />{h.b2bPodklady}</a>
        </div>
      </div>
      <ul class="b2b-list" data-reveal-group>
        {h.b2bList.map(([b, s]) => <li><strong>{b}</strong><span>{s}</span></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  /* Hero: biely základ, modrý diagonálny panel vpravo (motív Watts), produkt leží cez šikmú hranicu. */
  .hero { position: relative; background: var(--color-white); color: var(--color-ink); min-height: clamp(560px, 78vh, 800px); display: flex; align-items: center; overflow: visible; z-index: 1; }
  .hero-panel { position: absolute; top: 0; right: 0; bottom: 0; width: 60%; clip-path: polygon(24% 0, 100% 0, 100% 100%, 0 100%); background:
      radial-gradient(70% 90% at 62% 38%, rgb(43 118 205 / 0.9) 0%, rgb(43 118 205 / 0) 70%),
      linear-gradient(165deg, #0b3a80 0%, var(--color-blue-900) 100%); animation: panelIn 900ms var(--ease-soft) both; }
  .hero-in { position: relative; width: 100%; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center; gap: 24px; }
  .hero-text { max-width: 560px; padding-block: 96px 120px; display: flex; flex-direction: column; gap: 28px; }
  .hero-text > * { animation: rise 640ms var(--ease-soft) both; }
  .hero-text > :nth-child(1) { animation-delay: 60ms; }
  .hero-text > :nth-child(2) { animation-delay: 160ms; }
  .hero-text > :nth-child(3) { animation-delay: 260ms; }
  .hero h1 { font-size: clamp(34px, 3.1vw + 12px, 58px); line-height: 1.04; letter-spacing: -0.02em; }
  .hero .brand-line { color: var(--color-blue-700); }
  .hero .lead { font-size: 19px; max-width: 28em; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  /* Priehľadný výrez prekračuje šikmú hranicu aj spodok panelu: rezná plocha so žltými rúrami leží nad bielou. */
  .hero-product { position: relative; z-index: 3; align-self: end; width: 116%; max-width: none; margin-left: -14%; margin-bottom: -13%; pointer-events: none; animation: settle 1200ms 150ms var(--ease-soft) both; }
  .hero-product :global(img) { width: 100%; height: auto; display: block; filter: drop-shadow(0 40px 46px rgb(11 27 51 / 0.34)); }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes settle { from { opacity: 0; transform: translate(24px, 0) scale(1.02); } to { opacity: 1; transform: none; } }
  @keyframes panelIn { from { clip-path: polygon(100% 0, 100% 0, 100% 100%, 100% 100%); } to { clip-path: polygon(24% 0, 100% 0, 100% 100%, 0 100%); } }

  /* Pás faktov z dát, prekrýva spodok hero. */
  .facts-bar { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); width: min(100%, 60%); background: var(--color-white); border: var(--line); border-radius: var(--radius-l); margin: 40px 0 0; position: relative; z-index: 2; animation: rise 640ms 380ms var(--ease-soft) both; }
  .facts-bar > div { display: flex; flex-direction: column; gap: 4px; padding: 24px 22px; border-left: var(--line); min-width: 0; }
  .facts-bar > div:first-child { border-left: 0; }
  .facts-bar dd { margin: 0; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: clamp(19px, 1.55vw, 24px); line-height: 1.1; letter-spacing: -0.015em; color: var(--color-blue-900); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .facts-bar dt { font-size: 13.5px; color: var(--color-ink-soft); }

  .uses-section { padding-top: 96px; }
  .h2-quiet { margin-bottom: 64px; }
  .uses { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .use { position: relative; background: var(--color-white); border: var(--line); border-radius: var(--radius-l); padding: 96px 28px 30px; display: flex; flex-direction: column; gap: 10px; color: var(--color-ink); overflow: visible; transition: border-color 150ms var(--ease-soft), transform 200ms var(--ease-soft), box-shadow 200ms var(--ease-soft); }
  .use:hover { border-color: var(--color-blue-700); color: var(--color-ink); transform: translateY(-2px); box-shadow: var(--shadow-lift); }
  .use :global(.pikto) { position: absolute; left: 16px; top: -46px; width: 196px; height: 147px; object-fit: contain; object-position: left bottom; filter: drop-shadow(0 18px 22px rgb(11 27 51 / 0.22)); transition: transform 350ms var(--ease-soft); -webkit-mask-image: linear-gradient(to top right, #000 58%, transparent 96%); mask-image: linear-gradient(to top right, #000 58%, transparent 96%); }
  .use:hover :global(.pikto) { transform: translateY(-4px) rotate(-1deg); }
  .use h3 { font-size: 21px; }
  .use p { color: var(--color-ink-soft); font-size: 15px; }
  .use :global(.go) { position: absolute; right: 22px; top: 22px; color: var(--color-blue-700); transition: transform 200ms var(--ease-soft); }
  .use:hover :global(.go) { transform: translate(2px, -2px); }

  .systems { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 20px; margin-top: 104px; }
  .system { overflow: visible; padding-top: 132px; position: relative; }
  .system :global(.pikto) { position: absolute; left: 4%; top: -58px; width: 100%; height: auto; max-width: none; filter: drop-shadow(0 22px 26px rgb(11 27 51 / 0.24)); -webkit-mask-image: linear-gradient(to top right, #000 66%, transparent 98%); mask-image: linear-gradient(to top right, #000 66%, transparent 98%); transition: transform 350ms var(--ease-soft); }
  .system:hover :global(.pikto) { transform: translateY(-4px); }
  .system .body { padding: 14px 18px 18px; gap: 2px; }
  .system h3 { font-size: 17px; }
  .system .count { font-size: 13.5px; color: var(--color-ink-soft); }
  .diely-h { font-size: 17px; margin: 40px 0 12px; color: var(--color-ink-soft); font-family: var(--font-text); font-stretch: 100%; font-weight: 500; letter-spacing: 0; }
  .parts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .part { display: grid; grid-template-columns: 96px minmax(0, 1fr) auto; gap: 20px; align-items: center; padding: 14px 20px 14px 14px; background: var(--color-white); border: var(--line); border-radius: var(--radius-l); color: var(--color-ink); transition: border-color 150ms var(--ease-soft), transform 200ms var(--ease-soft), box-shadow 200ms var(--ease-soft); }
  .part:hover { border-color: var(--color-blue-700); color: var(--color-ink); transform: translateY(-2px); box-shadow: var(--shadow-lift); }
  .part-img { display: block; width: 104px; height: 80px; position: relative; overflow: visible; }
  .part-img :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; filter: drop-shadow(0 10px 14px rgb(11 27 51 / 0.16)); }
  .part-txt { display: flex; flex-direction: column; gap: 2px; }
  .part-txt strong { font-weight: 600; font-size: 17px; }
  .part-txt .muted { font-size: 14px; }
  .part-meta { display: inline-flex; align-items: center; gap: 6px; color: var(--color-blue-700); font-weight: 500; font-size: 14px; white-space: nowrap; }

  /* Prelínanie sekcií: farby plôch do seba prechádzajú, nie sú nastavené vedľa seba. */
  .band-soft { background: linear-gradient(180deg, var(--color-white) 0, var(--color-blue-50) 140px, var(--color-blue-50) 100%); padding-top: 96px; padding-bottom: 200px; }
  .rodina { background: var(--color-white); padding-top: 0; overflow-x: clip; overflow-y: visible; }
  .rodina-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 24px; align-items: start; }
  .rodina-head { display: flex; flex-direction: column; gap: 16px; padding-top: 56px; }
  .rodina-head .lead { max-width: none; }
  .rodina :global(.rodina-img) { width: 128%; max-width: none; height: auto; display: block; margin: -230px 0 0; margin-right: min(calc(-1 * var(--gutter)), calc((var(--container-site) - 100vw) / 2)); position: relative; z-index: 2; filter: drop-shadow(0 28px 36px rgb(11 27 51 / 0.2)); -webkit-mask-image: linear-gradient(to right, #000 62%, transparent 98%); mask-image: linear-gradient(to right, #000 62%, transparent 98%); }
  .fakty { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px 48px; margin-top: 24px; padding-top: 32px; border-top: var(--line); }
  .fakty h3 { font-size: 19px; margin-bottom: 8px; }
  .fakty p { color: var(--color-ink-soft); max-width: 36em; }

  .refs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .ref { display: flex; flex-direction: column; gap: 12px; color: var(--color-ink); }
  .ref :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-l); background: var(--color-grey-100); }
  .ref strong { display: block; font-weight: 600; }
  .ref .muted { font-size: 14px; }
  .ref:hover strong { color: var(--color-blue-700); }

  /* Šikmá horná hrana tmavého bloku: odkaz na diagonálny motív Watts, zároveň prechod z referencií. */
  .b2b { position: relative; overflow: hidden; clip-path: polygon(0 4vw, 100% 0, 100% 100%, 0 100%); margin-top: -4vw; padding-top: calc(64px + 4vw); margin-bottom: -96px; padding-bottom: 96px; }
  .b2b :global(.b2b-bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 70% 50%; opacity: .55; mix-blend-mode: luminosity; filter: saturate(0) contrast(1.15); pointer-events: none; }
  .b2b::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, var(--color-blue-900) 0%, rgb(10 42 94 / 0.92) 45%, rgb(10 42 94 / 0.45) 100%); pointer-events: none; }
  .b2b-grid { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px; }
  .b2b-text { grid-column: 1 / 7; display: flex; flex-direction: column; gap: 24px; }
  .b2b-text .lead { color: var(--color-on-dark-muted); }
  .b2b-list { grid-column: 8 / 13; }
  .b2b-list li { padding: 14px 0; border-top: 1px solid rgb(255 255 255 / 0.18); display: flex; flex-direction: column; gap: 2px; }
  .b2b-list li:last-child { border-bottom: 1px solid rgb(255 255 255 / 0.18); }
  .b2b-list strong { font-weight: 600; }
  .b2b-list span { color: var(--color-on-dark-muted); font-size: 14px; }

  @media (max-width: 1100px) {
    .facts-bar { width: 100%; }
    .hero-product { margin-bottom: -6%; margin-left: -8%; width: 108%; }
    .systems { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 80px; }
    .uses-section { padding-top: 64px; }
    .rodina-grid { grid-template-columns: 1fr; }
    .rodina :global(.rodina-img) { width: 100%; margin: -120px 0 0; }
    .band-soft { padding-bottom: 140px; }
    .uses { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 64px; }
    .facts-bar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .facts-bar > div:nth-child(3) { border-left: 0; }
    .facts-bar > div:nth-child(n + 3) { border-top: var(--line); }
  }
  @media (max-width: 760px) {
    .hero { min-height: 0; }
    .hero-in { grid-template-columns: 1fr; }
    .hero-text { padding-block: 56px 16px; gap: 20px; }
    .hero-product { width: 100%; margin: 0 0 -10%; justify-self: stretch; }
    .uses-section { padding-top: 48px; }
    .h2-quiet { margin-bottom: 56px; }
    .uses { row-gap: 64px; }
    .rodina :global(.rodina-img) { margin-top: -80px; }
    .band-soft { padding-bottom: 100px; }
    .facts-bar { margin-top: -40px; }
    .facts-bar > div { padding: 18px 20px; }
    .facts-bar dd { font-size: 24px; }
    .uses, .systems, .parts, .fakty, .refs { grid-template-columns: 1fr; }
    .rodina-head { grid-template-columns: 1fr; }
    .b2b-grid > * { grid-column: 1 / -1; }
    .b2b::after { background: rgb(10 42 94 / 0.82); }
    .b2b { clip-path: polygon(0 24px, 100% 0, 100% 100%, 0 100%); margin-top: -24px; padding-top: calc(48px + 24px); }
    .band-soft { padding-top: 64px; }
    .rodina { padding-top: 56px; }
  }
</style>
