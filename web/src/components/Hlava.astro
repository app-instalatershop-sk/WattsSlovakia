---
/**
 * Hlava vnútornej stránky: to isté svetlé pole ako hero domova, drobčeky, nadpis a popis vľavo,
 * obraz vpravo cez okraj obrazovky. Dole je šikmá hrana, cez ktorú obraz prechádza do tela stránky
 * (motív z domova: výrobok prekračuje hranu sekcie).
 *
 *  druh="render"  priehľadný render výrobku (tieň pod ním)
 *  druh="biely"   render na bielom pozadí z katalógu (násobenie, biela splynie s poľom)
 *  druh="foto"    fotka zo stavby (zaoblená, vybieha za pravý okraj)
 * Bez obrazu je hlava nižšia. Slot pod popisom je na tlačidlá alebo údaje, slot "bok" nahrádza obraz.
 * Kóty (koty) stoja priamo na renderi ako v hero domova: plášť, nosná rúra a polomer ohybu z dát stránky.
 *
 *  rozlozenie="vedla"   text vľavo, obraz vpravo (fotky, diely, stránky bez renderu)
 *  rozlozenie="studio"  nadpis hore, popis a akcie vpravo od neho, render pod nimi takmer cez celú
 *                       šírku ako vo fotoštúdiu (rady, systémy, Potrubia; Juraj 22. 10. 2026, návrh B)
 */
import Obraz from './Obraz.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Koty from './Koty.astro';
import { sadzba } from '../lib/sadzba';
import type { Kota } from '../lib/koty';
import { je3d, maska3d } from '../lib/obrazky';
import { type Lang, t, route } from '../i18n/ui';

interface Drobcek { text: string; href?: string }
interface Props {
  lang: Lang; nadpis: string; drobceky?: Drobcek[]; pred?: string; lead?: string;
  obraz?: ImageMetadata; obrazAlt?: string; druh?: 'render' | 'biely' | 'foto'; obrazMax?: number;
  /** Meno pre prechod medzi stránkami (rad-<id>, kat-<id>): render prilieta z karty na predošlej stránke. */
  prechod?: string;
  koty?: Kota[]; kotyLabel?: string;
  rozlozenie?: 'vedla' | 'studio';
  /** Štúdio: na ktorej strane má render zrezané telá rúr (rendery Watts vľavo, rodina potrubí vpravo);
      tam render jemne dozneje, aby nebolo vidno rovnú hranu. */
  dozvenie?: 'vlavo' | 'vpravo';
}
const { lang, nadpis, drobceky = [], pred, lead, obraz, obrazAlt = '', druh = 'render', obrazMax = 760, prechod, koty = [], kotyLabel, rozlozenie = 'vedla', dozvenie = 'vlavo' } = Astro.props;
const ui = t(lang);
const maBok = Astro.slots.has('bok');
// Odlesk po plášti v štúdiu ako v hero domova: maska je samotný render (AVIF 1000 px, ten istý súbor, ktorý
// si prehliadač väčšinou vyberie aj na zobrazenie), svetlo tak prejde len po výrobku.
// Render 3D modelu má celé telo a vlastný kontaktný tieň: bez doznenia, bez tieňa z CSS a s maskou odlesku
// bez tieňa (inak by pás svetla prešiel aj po podlahe).
const z3d = je3d(obraz);
// Čelný záber 3D modelu (rez spredu, vyšší ako široký): v štúdiu menší, aby bol celý rez s kótami na prvej obrazovke.
const celny = z3d && !!obraz && obraz.width / obraz.height < 1.4;
const zdrojMasky = z3d ? maska3d(obraz) : obraz;
const leskMaska = rozlozenie === 'studio' && zdrojMasky && zdrojMasky.format !== 'jpg' && zdrojMasky.format !== 'jpeg'
  ? (await getImage({ src: zdrojMasky, width: 1000, format: z3d ? 'webp' : 'avif', quality: 50 })).src : null;
---
{rozlozenie === 'studio' && obraz ? (
<section class="hlava hlava-studio" data-mys>
  <div class="wrap hs-hore">
    <div class="hs-text">
      <ol class="crumbs" aria-label={ui.crumbs.label}>
        <li><a href={route(lang, 'domov')}>{ui.nav.domov}</a></li>
        {drobceky.map((d) => (d.href ? <li><a href={d.href}>{d.text}</a></li> : <li aria-current="page">{d.text}</li>))}
      </ol>
      {pred && <p class="hlava-pred">{pred}</p>}
      <h1>{sadzba(nadpis)}</h1>
    </div>
    <div class="hs-bok">
      {lead && <p class="lead">{sadzba(lead)}</p>}
      <slot />
    </div>
  </div>
  <div class:list={['hs-studio', { 'hs-vedla-volby': z3d && Astro.slots.has('nad-obrazom') }]}>
    {/* Ovládanie nad renderom (živé kóty na stránke radu): pod nadpisom, priamo nad výrobkom. */}
    {Astro.slots.has('nad-obrazom') && <div class="wrap hs-volba"><slot name="nad-obrazom" /></div>}
    <div class:list={['hs-stage', { 'bez-kot': z3d && koty.length === 0, 'hs-celny': celny }]} style={`--obraz-max: ${obrazMax}px`}>
      <div class:list={['hs-obraz', z3d ? 'je3d' : `dz-${dozvenie}`, { 'ma-prechod': prechod }]} style={prechod ? `view-transition-name: ${prechod}` : undefined}>
        {/* Výrobok sa pri pohybe myši nepatrne posunie (data-mys v pohyb.ts), kóty idú s ním.
            Tieň nesie obal, dozvenie (maska) je na obrázku: maska na tom istom prvku by tieň orezala. */}
        <div class="hs-mys">
          <div class="hs-tien"><Obraz src={obraz} alt={obrazAlt} widths={[700, 1000, 1300]} sizes={`(max-width: 760px) 100vw, ${obrazMax}px`} loading="eager" fetchpriority="high" /></div>
          {leskMaska && <span class="hs-lesk" aria-hidden="true" style={`--maska: url("${leskMaska}")`} data-lesk></span>}
          <Koty koty={koty} label={kotyLabel} />
          {/* Vrstvy nad obrazom, ktoré sa hýbu s ním: teplo v reze (stránka radu), rodina na ťuknutie (Potrubia). */}
          <slot name="na-obraze" />
        </div>
      </div>
    </div>
  </div>
</section>
) : (
<section class:list={['hlava', obraz || maBok ? `hlava-${druh}` : 'hlava-bez']}>
  <div class="wrap hlava-in">
    <div class="hlava-text">
      <ol class="crumbs" aria-label={ui.crumbs.label}>
        <li><a href={route(lang, 'domov')}>{ui.nav.domov}</a></li>
        {drobceky.map((d) => (d.href ? <li><a href={d.href}>{d.text}</a></li> : <li aria-current="page">{d.text}</li>))}
      </ol>
      {pred && <p class="hlava-pred">{pred}</p>}
      <h1>{sadzba(nadpis)}</h1>
      {lead && <p class="lead">{sadzba(lead)}</p>}
      <slot />
    </div>
    {obraz && (
      <div class:list={['hlava-obraz', { 'ma-prechod': prechod }]} style={`--obraz-max: ${obrazMax}px${prechod ? `; view-transition-name: ${prechod}` : ''}`}>
        <div class="hlava-stage">
          <Obraz src={obraz} alt={obrazAlt} widths={[560, 700, 800, 1300]} kvalita={50} sizes="(max-width: 760px) 100vw, 52vw" loading="eager" fetchpriority="high" />
          <Koty koty={koty} label={kotyLabel} />
        </div>
      </div>
    )}
    {!obraz && maBok && <div class="hlava-bok"><slot name="bok" /></div>}
  </div>
</section>
)}

<style>
  .hlava { position: relative; overflow-x: clip; display: flex; align-items: center; min-height: clamp(380px, 50vh, 560px); padding-bottom: calc(var(--presah-hero) * 0.55); color: var(--color-ink);
    background:
      radial-gradient(48% 70% at 78% 46%, rgb(0 93 185 / 0.07) 0%, rgb(0 93 185 / 0) 72%),
      linear-gradient(158deg, #ffffff 0%, #fafbfd 46%, #eef2f7 100%); }
  /* Šikmá hrana: vľavo nižšie, vpravo vyššie, farba začiatku tela stránky. */
  /* Hlava ani jej obsah netvoria vlastnú vrstvu (bez z-index na .hlava a .hlava-in): obraz s kladným
     z-index leží nad telom stránky a biely obraz sa násobí s tým, čo je pod ním, aj pod šikmou hranou.
     Inak by z bieleho pozadia fotky ostal biely obdĺžnik. Hrana (z-index 1) je pod textom aj obrazom. */
  .hlava::after { content: ""; position: absolute; z-index: 1; left: 0; right: 0; bottom: 0; height: var(--presah-hero); background: var(--zem-1); -webkit-mask: var(--hrana-ohyb) center / 100% 100% no-repeat; mask: var(--hrana-ohyb) center / 100% 100% no-repeat; pointer-events: none; }
  .hlava-bez { min-height: 0; padding-top: 8px; }
  .hlava-in { position: relative; width: 100%; display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 24px 40px; align-items: center; }
  .hlava-bez .hlava-in { grid-template-columns: minmax(0, 1fr); }
  .hlava-text { position: relative; z-index: 3; padding-block: 16px 40px; max-width: 640px; }
  .hlava-bez .hlava-text { max-width: 860px; padding-bottom: 24px; }
  .crumbs { padding-block: 0 28px; }
  .hlava-pred { font-size: 16px; font-weight: 500; color: var(--color-blue-700); margin-bottom: 12px; }
  .hlava h1 { font-size: clamp(32px, 2.4vw + 16px, 54px); line-height: 1.05; letter-spacing: -0.025em; max-width: 15em; }
  .hlava .lead { margin-top: 20px; max-width: 34em; }
  .hlava-text > :global(.hlava-akcie) { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; margin-top: 30px; }

  /* Obraz vybieha za pravý okraj obrazovky a spodkom cez šikmú hranu do tela stránky. */
  .hlava-obraz { position: relative; z-index: 2; align-self: end; margin-right: calc(-1 * var(--bleed)); margin-bottom: calc(var(--presah-hero) * -0.9); animation: hlava-obraz 1100ms 80ms var(--ease-soft) both; }
  /* Štúdio má presne rozmer obrázka, aby kóty v percentách sedeli pri každej šírke. */
  .hlava-stage { position: relative; max-width: var(--obraz-max); margin-left: auto; container-type: inline-size; }
  .hlava-obraz :global(img) { display: block; width: 100%; height: auto; }
  .hlava-render .hlava-obraz :global(img) { filter: drop-shadow(0 32px 40px rgb(11 27 51 / 0.2)); }
  .hlava-biely .hlava-obraz { mix-blend-mode: multiply; }
  /* Biely obraz dozneje ku všetkým okrajom (elipsa po najbližšie strany): ani rez obrázka vľavo,
     ani horná hrana pod hlavičkou nevytvoria rovnú čiaru (napr. kotúč v článku o pokládke). */
  .hlava-biely .hlava-obraz :global(img) { -webkit-mask-image: radial-gradient(closest-side, #000 58%, transparent 100%); mask-image: radial-gradient(closest-side, #000 58%, transparent 100%); }
  .hlava-foto .hlava-obraz { align-self: center; margin-bottom: calc(var(--presah-hero) * -0.6); }
  .hlava-foto .hlava-obraz :global(img) { aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--radius-l) 0 0 var(--radius-l); box-shadow: var(--elev-4); }
  .hlava-bok { position: relative; z-index: 2; }
  /* Render s menom prechodu priletí z predošlej stránky, vlastný vstup by sa s preletom bil. */
  .hlava-obraz.ma-prechod { animation: none; }
  /* Obraz hlavy je prvok LCP: len pohyb, bez priehľadnosti (prehliadač by ho započítal až po prelínaní). */
  @keyframes hlava-obraz { from { transform: translateX(28px); } to { transform: none; } }

  /* ---------- Štúdio: nadpis hore, render pod ním ako vo fotoštúdiu ---------- */
  /* Svetlo štúdia je za výrobkom (radiálny prechod), podlaha tmavne do farby tela stránky. */
  .hlava-studio { display: block; min-height: 0; padding: 20px 0 0;
    background: radial-gradient(46% 52% at 58% 68%, #ffffff 0%, rgb(255 255 255 / 0.6) 45%, rgb(255 255 255 / 0) 75%), linear-gradient(180deg, #ffffff 0%, #f3f6fa 55%, #e8eef6 100%); }
  .hs-hore { position: relative; z-index: 3; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 20px 56px; align-items: end; }
  .hlava-studio h1 { font-size: clamp(34px, 3vw + 12px, 64px); line-height: 1.02; letter-spacing: -0.03em; max-width: 12em; }
  .hs-bok { padding-bottom: 6px; }
  .hlava-studio .hs-bok .lead { margin-top: 0; max-width: 30em; }
  .hs-bok > :global(.hlava-akcie) { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; margin-top: 26px; }
  .hs-studio { position: relative; z-index: 2; margin-top: 4px; }
  .hs-volba { position: relative; z-index: 3; padding-top: 28px; }
  /* Render je odsadený doprava, aby jeho telo nebežalo pod nadpis; spodkom prejde cez šikmú hranu. */
  .hs-stage { position: relative; width: min(var(--obraz-max), 92vw); margin: 0 auto -52px; padding-left: 8%; }
  .hs-obraz { position: relative; container-type: inline-size; animation: hlava-studio 1000ms 120ms var(--ease-soft) both; }
  .hs-obraz.ma-prechod { animation: none; }
  /* Živý výrobok ako v hero domova: pri pohybe myši sa nepatrne posunie (s kótami), po načítaní raz
     prejde po plášti pás svetla; pri výbere dimenzie (VolbaDimenzie) prejde znova. */
  .hs-mys { position: relative; transform: translate3d(calc(var(--mx, 0) * 8px), calc(var(--my, 0) * 5px), 0); transition: transform 900ms var(--ease-soft); }
  .hs-lesk { position: absolute; inset: 0; pointer-events: none; mix-blend-mode: screen; opacity: 0.9;
    -webkit-mask: var(--maska) center / 100% 100% no-repeat; mask: var(--maska) center / 100% 100% no-repeat;
    background: linear-gradient(105deg, rgb(255 255 255 / 0) 40%, rgb(190 215 255 / 0.42) 50%, rgb(255 255 255 / 0) 60%) no-repeat;
    background-size: 260% 100%; background-position: 135% 0; animation: hs-lesk 2200ms 900ms cubic-bezier(0.45, 0, 0.25, 1) both; }
  @keyframes hs-lesk { from { background-position: 135% 0; } to { background-position: -35% 0; } }
  .hs-tien { filter: drop-shadow(0 40px 46px rgb(11 27 51 / 0.22)); }
  .je3d .hs-tien { filter: none; }
  .hs-stage:has(.je3d)::before { display: none; }
  .hs-obraz :global(img) { display: block; width: 100%; height: auto; }
  .dz-vlavo :global(img) { -webkit-mask-image: linear-gradient(to right, transparent 0, #000 12%); mask-image: linear-gradient(to right, transparent 0, #000 12%); }
  .dz-vpravo :global(img) { -webkit-mask-image: linear-gradient(to left, transparent 0, #000 16%); mask-image: linear-gradient(to left, transparent 0, #000 16%); }
  /* Tieň na podlahe štúdia pod výrobkom. */
  .hs-stage::before { content: ""; position: absolute; left: 18%; right: 6%; bottom: 7%; height: 12%; border-radius: 50%; background: radial-gradient(closest-side, rgb(10 42 94 / 0.2), rgb(10 42 94 / 0)); }
  @keyframes hlava-studio { from { transform: translateY(24px); } to { transform: none; } }
  /* Render 3D modelu (čelný záber, vyšší ako široký) pri výbere dimenzie: dva stĺpce, výber vľavo pod
     nadpisom, render vpravo od vrchu štúdia. Výber aj celý rez s kótami sú tak naraz na prvej obrazovke
     (1 440 × 900) a klik v lište mení obraz hneď vedľa. Stĺpce sa neprekrývajú: riadok s obj. číslom
     po výbere nezasiahne do plášťa. */
  @media (min-width: 1101px) {
    .hs-stage.hs-celny { width: min(700px, 92vw); margin-top: 16px; }
    .hs-vedla-volby { display: grid; grid-template-columns: minmax(0, 1fr) min(660px, 52vw); column-gap: 40px; align-items: start;
      max-width: var(--container-site); margin-inline: auto; padding-inline: var(--gutter); }
    .hs-vedla-volby .hs-volba { padding-inline: 0; margin-inline: 0; }
    .hs-vedla-volby .hs-stage { width: auto; margin: 0 0 -52px; padding-left: 0; }
    .hs-vedla-volby :global(.volba-riadok) { flex-direction: column; align-items: flex-start; gap: 10px; }
  }

  @media (max-width: 900px) {
    .hlava { min-height: 0; }
    .hlava-in { grid-template-columns: minmax(0, 1fr); }
    .hlava-text { padding-bottom: 8px; max-width: none; }
    .hlava-obraz { margin: 0 calc(-1 * var(--gutter)) calc(var(--presah-hero) * -0.5); }
    .hlava-stage { margin-inline: auto; max-width: min(var(--obraz-max), 100%); }
    .hlava-foto .hlava-obraz { margin-left: 0; }
    .hs-hore { grid-template-columns: minmax(0, 1fr); }
    /* Štítky pod renderom potrebujú miesto: odsadenie hlavy (nie okraj renderu, ten by sa zlúčil cez hlavu). */
    .hlava-studio { padding-bottom: 64px; }
    .hs-stage { width: auto; margin: 0 calc(-1 * var(--gutter)); padding-left: 0; }
    /* Celé telá z 3D modelu bez kót (rodina v Potrubiach) ostanú v okrajoch: nie je čo orezať ani komu robiť miesto. */
    .hs-stage.bez-kot { margin-inline: 0; }
  }
  /* Telefón: render je pod textom hlavy už pod okrajom obrazovky, preto výber dimenzie ide pod render,
     k štítkom kót, ktoré mení. Odsadenie nechá miesto štítkom, ktoré visia pod renderom. */
  @media (max-width: 760px) {
    .hs-studio { display: flex; flex-direction: column; }
    /* Bez automatického okraja z .wrap: inak sa vo flexe nezúži na šírku displeja a dlhá lišta (UNO, 10 dimenzií)
       by pretiekla za okraj namiesto posúvania. */
    .hs-volba { order: 1; padding-top: 0; margin-top: 28px; margin-inline: 0; }
    .hlava-studio:has(.hs-volba) { padding-bottom: 24px; }
  }
</style>
