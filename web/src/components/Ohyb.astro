---
/**
 * Ohyb na najmenší polomer (Juraj 28. 10. 2026): pri rolovaní sa rúra z vlastného 3D modelu ohne z rovnej
 * do oblúka s polomerom z katalógu (data/blender/ohyb.py, data/novinky_web.py ohyb) a pri oblúku sa objaví
 * kóta. Stred oblúka býva mimo záberu, preto kóta ide ako na výkrese: od osi rúry smerom k stredu (časť
 * polomeru) a štítok stojí na jej konci. Prehrávač ako pri rozloženom reze (lib/sekvencia.ts): snímky na
 * <canvas>, sťahovanie až pri sekcii, bez skriptu a pri „obmedziť pohyb“ stojí obraz ohnutý s kótou.
 */
import { sadzba } from '../lib/sadzba';

export interface OhybData { snimok: number; pomer: number; sirky: number[]; cesta: string; rad?: string; obj_cislo?: string; polomer_m: number; plast_mm: number; body: { stred: number[]; os: number[] }[] }
interface Props { data: OhybData; nadpis: string; popis: string; poznamka?: string; alt: string; kota: string; class?: string; hore?: number; horeM?: number; id?: string; tma?: boolean }
const { data, nadpis, popis, poznamka, alt, kota, class: trieda, hore = 72, horeM = 64, id = 'h-ohyb', tma = false } = Astro.props;
const DIEL = 0.42;
const koniec = data.body[data.snimok - 1];
const k0 = [koniec.os[0] + DIEL * (koniec.stred[0] - koniec.os[0]), koniec.os[1] + DIEL * (koniec.stred[1] - koniec.os[1])];
const sirka = Math.max(...data.sirky);
const posledna = `${data.cesta}${sirka}/${String(data.snimok - 1).padStart(3, '0')}`;
const polomer = data.polomer_m.toFixed(2).replace('.', ',');
---
<section class:list={['ohyb', trieda, { 'oh-tma': tma }]} aria-labelledby={id} style={`--oh-top: ${hore}px; --oh-top-m: ${horeM}px`} data-ohyb data-cesta={data.cesta} data-snimok={data.snimok} data-sirky={data.sirky.join(',')} data-body={JSON.stringify(data.body)}>
  <div class="oh-sticky">
    <div class="wrap oh-grid">
      <div class="oh-text">
        <h2 id={id}>{nadpis}</h2>
        <p class="lead">{sadzba(popis)}</p>
        {poznamka && <p class="oh-pozn">{sadzba(poznamka)}</p>}
      </div>
      <div class="oh-stage" style={`aspect-ratio: ${data.pomer}; --pomer: ${data.pomer}`}>
        <picture class="oh-obr">
          <source type="image/avif" srcset={`${posledna}.avif`} />
          <img src={`${posledna}.webp`} alt={alt} width={sirka} height={Math.round(sirka / data.pomer)} loading="lazy" decoding="async" />
        </picture>
        <canvas class="oh-canvas" aria-hidden="true"></canvas>
        <svg class="oh-polomer" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <line x1={koniec.os[0]} y1={koniec.os[1]} x2={k0[0]} y2={k0[1]} />
        </svg>
        <span class="oh-bod" style={`--x: ${koniec.os[0]}%; --y: ${koniec.os[1]}%`} aria-hidden="true"></span>
        <p class="oh-stitok" style={`--x: ${k0[0]}%; --y: ${k0[1]}%`}><strong>R {polomer} m</strong><span>{kota}</span></p>
      </div>
    </div>
  </div>
</section>

<style>
  .ohyb { --oh-pad: clamp(12px, 3vh, 32px); position: relative; height: 225vh; }
  /* Obsah v strede okna pod hlavičkou; okraje auto ho pri vyššom obsahu zarovnajú hore (nič sa neoreže). */
  .oh-sticky { position: sticky; top: var(--oh-top); height: calc(100vh - var(--oh-top)); display: flex; padding-block: var(--oh-pad); overflow: clip; }
  .oh-grid { width: 100%; margin-block: auto; display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 24px 48px; align-items: center; }
  .oh-text h2 { font-size: clamp(28px, 2.2vw + 14px, 42px); letter-spacing: -0.02em; }
  .oh-text .lead { margin-top: 14px; }
  .oh-pozn { margin-top: 18px; padding-left: 18px; border-left: 3px solid var(--color-yellow-500); font-size: 15px; line-height: 1.55; color: var(--color-ink-soft); max-width: 30em; }
  /* Obraz nikdy vyšší ako okno: šírka z voľnej výšky a pomeru strán (samotná max-height by ho roztiahla do šírky). */
  .oh-stage { position: relative; width: min(100%, calc((100vh - var(--oh-top) - 2 * var(--oh-pad)) * var(--pomer))); margin-inline: auto; container-type: inline-size; }
  .oh-obr :global(img), .oh-canvas, .oh-polomer { position: absolute; inset: 0; width: 100%; height: 100%; }
  .oh-canvas { opacity: 0; }
  .ohyb.oh-bezi .oh-canvas { opacity: 1; }
  .ohyb.oh-bezi .oh-obr { visibility: hidden; }

  /* Kóta polomeru: rovnaký jazyk ako kóty na reze (Koty.astro): bod, čiara s bielym lemom, mliečny štítok. */
  .oh-polomer { overflow: visible; pointer-events: none; }
  .oh-polomer line { stroke: var(--color-blue-900); stroke-width: 2px; vector-effect: non-scaling-stroke; stroke-linecap: round; filter: drop-shadow(0 0 1.5px rgb(255 255 255 / 0.9)); }
  .oh-bod { position: absolute; left: var(--x); top: var(--y); width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%; background: #fff; box-shadow: inset 0 0 0 3px var(--color-blue-900), 0 0 0 4px rgb(255 255 255 / 0.5), 0 3px 10px rgb(4 16 40 / 0.4); }
  .oh-stitok { position: absolute; left: var(--x); top: var(--y); transform: translate(14px, -50%); display: flex; flex-direction: column; gap: 3px; white-space: nowrap;
    padding: clamp(6px, 0.9cqw, 11px) clamp(9px, 1.3cqw, 15px); border-radius: var(--radius-l); background: rgb(255 255 255 / 0.88);
    -webkit-backdrop-filter: blur(10px) saturate(1.4); backdrop-filter: blur(10px) saturate(1.4); box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.08), var(--elev-2); }
  .oh-stitok strong { font-family: var(--font-display); font-stretch: 118%; font-weight: 600; font-size: clamp(16px, 3.1cqw, 30px); line-height: 1.02; letter-spacing: -0.02em; color: var(--color-blue-900); font-variant-numeric: tabular-nums; }
  .oh-stitok span { font-size: clamp(12px, 1.6cqw, 15px); line-height: 1.3; font-weight: 500; color: var(--color-ink-soft); }
  .ohyb.oh-js .oh-polomer, .ohyb.oh-js .oh-bod, .ohyb.oh-js .oh-stitok { opacity: 0; transition: opacity 320ms var(--ease-soft); }
  /* So skriptom ide bod a štítok s oblúkom cez transform (--xn, --yn v percentách obrazu, 1cqw = 1 % šírky rámika):
     plynulo a bez nového rozloženia pri každom snímku; štítok bez rozmazania pozadia, pod ním sa mení obraz. */
  .ohyb.oh-js .oh-bod, .ohyb.oh-js .oh-stitok { left: 0; top: 0; will-change: transform; }
  .ohyb.oh-js .oh-bod { transform: translate3d(calc(var(--xn, 0) * 1cqw), calc(var(--yn, 0) * 1cqw / var(--pomer)), 0); }
  .ohyb.oh-js .oh-stitok { transform: translate3d(calc(var(--xn, 0) * 1cqw), calc(var(--yn, 0) * 1cqw / var(--pomer)), 0) translate(14px, -50%); -webkit-backdrop-filter: none; backdrop-filter: none; background: rgb(255 255 255 / 0.94); }
  .ohyb.oh-js.oh-kota .oh-polomer, .ohyb.oh-js.oh-kota .oh-bod, .ohyb.oh-js.oh-kota .oh-stitok { opacity: 1; }

  /* Tmavá scéna (domov, Juraj 28. 10. 2026): pozadie dáva stránka, tu je text na tmavom a za rúrou jemné modré
     svetlo ako v ateliéri. Svetlo ide s obrazom (pseudoprvok rámika), nie s výškou okna, takže na mobile nie je pás. */
  .oh-tma .oh-text h2 { color: #fff; }
  .oh-tma .oh-text .lead, .oh-tma .oh-pozn { color: var(--color-on-dark-muted); }
  .oh-tma .oh-stage::before { content: ""; position: absolute; inset: -28% -22%; pointer-events: none;
    background: radial-gradient(closest-side, rgb(150 190 255 / 0.45) 0%, rgb(120 165 245 / 0.2) 50%, rgb(120 165 245 / 0) 100%); }
  .oh-tma .oh-polomer line { stroke: #fff; filter: none; }

  @media (max-width: 900px) {
    .ohyb { height: 200vh; }
    .oh-sticky { top: var(--oh-top-m); height: calc(100svh - var(--oh-top-m)); }
    .oh-grid { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .oh-text h2 { font-size: clamp(24px, 5vw + 8px, 32px); }
    .oh-text .lead { font-size: 16px; }
    .oh-pozn { display: none; }
    .oh-stage { margin-inline: calc(-1 * var(--gutter)); width: calc(100% + 2 * var(--gutter)); }
    /* štítok pod koncom kóty: vpravo od nej by na úzkom displeji vyšiel z obrazu */
    .oh-stitok { transform: translate(-50%, 14px); }
    .ohyb.oh-js .oh-stitok { transform: translate3d(calc(var(--xn, 0) * 1cqw), calc(var(--yn, 0) * 1cqw / var(--pomer)), 0) translate(-50%, 14px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ohyb { height: auto; }
    .oh-sticky { position: static; height: auto; padding-block: 64px; }
  }
</style>

<script>
  import { prehravaj, zmensiObraz } from '../lib/sekvencia';
  // Dráha 0 až 1 cez sekciu: na začiatku obraz chvíľu stojí, kóta príde pri dokončenom oblúku a hotový ohyb
  // s kótou drží ešte asi pol okna rolovania, kým sekcia odíde.
  const OD = 0.08, DO = 0.74, KOTA = 0.9, DIEL = 0.42;
  const stopky: AbortController[] = [];

  function initOhyb() {
    stopky.splice(0).forEach((s) => s.abort());
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLElement>('[data-ohyb]').forEach((sek) => {
      const stop = new AbortController();
      stopky.push(stop);
      sek.classList.add('oh-js');
      const n = Number(sek.dataset.snimok);
      const body: { stred: number[]; os: number[] }[] = JSON.parse(sek.dataset.body ?? '[]');
      const stage = sek.querySelector<HTMLElement>('.oh-stage')!;
      const ciara = sek.querySelector<SVGLineElement>('.oh-polomer line')!;
      const bod = sek.querySelector<HTMLElement>('.oh-bod')!;
      const stitok = sek.querySelector<HTMLElement>('.oh-stitok')!;
      prehravaj({
        koren: sek, stage, platno: sek.querySelector<HTMLCanvasElement>('.oh-canvas')!, cesta: sek.dataset.cesta ?? '', n,
        sirky: (sek.dataset.sirky ?? '').split(',').map(Number), od: OD, do: DO, signal: stop.signal,
        bezi: () => sek.classList.add('oh-bezi'),
        // Prehliadač bez AVIF dostane statický ohnutý obraz s kótou (WebP), bez pohybu.
        zlyhalo: () => { sek.classList.remove('oh-js'); stop.abort(); },
        popisy: (_p, x) => {
          const i = Math.min(n - 2, Math.floor(x)), t = x - i;
          const medzi = (a: number[], b: number[]) => [a[0] + t * (b[0] - a[0]), a[1] + t * (b[1] - a[1])];
          const os = medzi(body[i].os, body[i + 1].os), stred = medzi(body[i].stred, body[i + 1].stred);
          const k = [os[0] + DIEL * (stred[0] - os[0]), os[1] + DIEL * (stred[1] - os[1])];
          ciara.setAttribute('x1', String(os[0])); ciara.setAttribute('y1', String(os[1]));
          ciara.setAttribute('x2', String(k[0])); ciara.setAttribute('y2', String(k[1]));
          for (const [el, q] of [[bod, os], [stitok, k]] as const) {
            el.style.setProperty('--xn', q[0].toFixed(3));
            el.style.setProperty('--yn', q[1].toFixed(3));
          }
          sek.classList.toggle('oh-kota', x / (n - 1) >= KOTA);
        },
      });
      // Telefón s nízkym oknom: obraz sa zmenší, aby sa nadpis, text aj celý oblúk zmestili do okna.
      const sticky = sek.querySelector<HTMLElement>('.oh-sticky')!;
      const grid = sek.querySelector<HTMLElement>('.oh-grid')!;
      const prisposob = () => zmensiObraz(sticky, grid, stage);
      prisposob();
      document.fonts?.ready.then(prisposob);
      window.addEventListener('resize', prisposob, { signal: stop.signal });
    });
  }

  initOhyb();
  document.addEventListener('astro:page-load', initOhyb);
</script>
