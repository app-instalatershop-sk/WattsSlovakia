  .podpora-akcie { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .podpora-sluzby { grid-column: 1 / 8; grid-row: 2; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }
  /* Bez krátkej žltej čiarky nad nadpisom (znak šablóny, DOLADENIE kap. 2.5): žltá patrí jadru rúry a akcii. */
  .podpora-sluzby li { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; position: relative; }
  /* Krátka žltá značka nad službou: farba jadra rúry, nie čiara cez celú šírku. */
  .podpora-sluzby h3 { font-size: 20px; line-height: 1.25; color: #fff; }
  .podpora-sluzby p { color: var(--color-on-dark-muted); font-size: 15px; line-height: 1.6; }
