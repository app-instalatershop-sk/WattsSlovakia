---
import Strana from '../../navrhy/Strana.astro';

const FOTKY: [string, string][] = [
  ['MD16032C', 'DUO vykurovanie 6 bar, 2 × 32 mm, plášť 160 mm'],
  ['M12532C', 'UNO vykurovanie 6 bar, 32 mm, plášť 125 mm'],
  ['MD1603225SWI', 'DUO sanita 10 bar, plášť 160 mm'],
  ['MQ16032C2520S', 'QUADRO, plášť 160 mm'],
  ['M9032PE', 'COOL, PE 100 32 mm, plášť 90 mm'],
  ['MQ16032C3225E', 'HP, 2 rúry a 2 chráničky, plášť 160 mm'],
];
---
<Strana cesta="/navrhy/videa/" nadpis="6 Videá a fotky mimo webu"
  popis="Z tých istých renderov vznikajú krátke videá na sociálne siete, prezentácie a veľtrhy a produktové fotky všetkých 91 dimenzií na bielom pre e-shop. Súbory len pripravím, do e-shopu ani na siete nič nenahrávam."
  kde="sociálne siete, prezentácie, veľtrhy, instalatershop.sk (fotky nahrá správca e-shopu)">
  <section class="wrap vd">
    <h2>Rozložený rez ako slučka</h2>
    <p>Šesť sekúnd tam a späť, bez zvuku, plynulá slučka. Široké 16 : 9 pre web, YouTube a prezentácie, štvorec 1 : 1 pre Facebook, Instagram a LinkedIn. Rovnako sa dá urobiť ohyb aj kotúč.</p>
    <div class="vd-videa">
      <figure><video src="/navrhy/videa/rozklad-duo-16x9.mp4" poster="/navrhy/videa/rozklad-duo-16x9.webp" autoplay muted loop playsinline controls width="1920" height="1080"></video><figcaption>16 : 9, 1920 × 1080 px, 1,8 MB. <a href="/navrhy/videa/rozklad-duo-16x9.mp4" download>Stiahnuť MP4</a></figcaption></figure>
      <figure class="stvorec"><video src="/navrhy/videa/rozklad-duo-1x1.mp4" poster="/navrhy/videa/rozklad-duo-1x1.webp" autoplay muted loop playsinline controls width="1080" height="1080"></video><figcaption>1 : 1, 1080 × 1080 px, 0,9 MB. <a href="/navrhy/videa/rozklad-duo-1x1.mp4" download>Stiahnuť MP4</a></figcaption></figure>
    </div>
  </section>
  <section class="wrap vd">
    <h2>Ohyb na najmenší polomer</h2>
    <p>Rovnaká sekvencia ako v návrhu 1, ako slučka na siete alebo do prezentácie.</p>
    <div class="vd-videa vd-jedno">
      <figure><video src="/navrhy/videa/ohyb-duo-16x9.mp4" poster="/navrhy/videa/ohyb-duo-16x9.webp" autoplay muted loop playsinline controls width="1920" height="1080"></video><figcaption>16 : 9, 1920 × 1080 px, 1,2 MB. <a href="/navrhy/videa/ohyb-duo-16x9.mp4" download>Stiahnuť MP4</a></figcaption></figure>
    </div>
  </section>
  <section class="wrap vd">
    <h2>Produktové fotky na bielom</h2>
    <p>Štvorec 2000 × 2000 px, JPEG, výrobok v strede s mäkkým tieňom, každá dimenzia v rovnakom svetle a uhle. Ukážka šiestich radov; všetkých 91 dimenzií je hotových za pár minút.</p>
    <ul class="vd-fotky">
      {FOTKY.map(([obj, popis]) => (
        <li><a href={`/navrhy/fotky/${obj}.jpg`}><img src={`/navrhy/fotky/${obj}-nahlad.webp`} alt={`Microflex ${obj}: ${popis}`} width="640" height="640" loading="lazy" /></a><p><strong>{obj}</strong> {popis}</p></li>
      ))}
    </ul>
  </section>
</Strana>

<style>
  .vd { padding-block: 44px 0; }
  .vd h2 { font-size: 26px; }
  .vd > p { margin-top: 10px; max-width: 52em; color: var(--color-ink-soft); }
  .vd-videa { margin-top: 22px; display: grid; grid-template-columns: minmax(0, 16fr) minmax(0, 9fr); gap: 18px; align-items: start; }
  .vd-videa video { display: block; width: 100%; height: auto; border-radius: 16px; background: #f2f5f9; }
  .vd-videa figcaption { margin-top: 8px; font-size: 14px; color: var(--color-ink-soft); }
  .vd-fotky { margin-top: 22px; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px; list-style: none; padding: 0; }
  .vd-fotky img { display: block; width: 100%; height: auto; border-radius: 12px; box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.08), var(--elev-1); }
  .vd-fotky p { margin-top: 8px; font-size: 14px; line-height: 1.4; color: var(--color-ink-soft); }
  .vd-fotky strong { display: block; color: var(--color-blue-900); }
  .vd-jedno { grid-template-columns: minmax(0, 16fr) minmax(0, 9fr); }
  @media (max-width: 760px) { .vd-videa { grid-template-columns: minmax(0, 1fr); } }
</style>
