---
import Clanok from '../../../templates/Clanok.astro';
import { clanky } from '../../../content/clanky';
export function getStaticPaths() {
  return clanky('cs').map((c, i) => ({ params: { clanok: c.slug }, props: { c, i } }));
}
const { c, i } = Astro.props;
---
<Clanok lang="cs" c={c} i={i} />
