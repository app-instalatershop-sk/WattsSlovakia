---
/**
 * Kategória potrubí (systém): hlava s renderom a kľúčovými číslami, karty radov (rady so spoločným
 * renderom ako vyhotovenia pod ním), porovnanie radov, spojky a diely k systému, otázky pred výberom.
 */
import Obraz from '../components/Obraz.astro';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hlava from '../components/Hlava.astro';
import Zaver from '../components/Zaver.astro';
import Ikona from '../components/Ikona.astro';
import KartaRadu from '../components/KartaRadu.astro';
import { kategorie, radyKategorie, cestaKategorie, cestaRadu, cestaProduktu, alternatyKategorie, kNazov, kKratky, kPopis, rNazov, pNazov, cislo, rozsah, rozsahRur, tlakyRadov, tlakText, datum, type Kategoria, type Rad, type Variant } from '../lib/katalog';
import { piktogram, render3d, radPiktogramu, fotkaRadu } from '../lib/obrazky';
import { kotyRenderu, kotyRenderu3d } from '../lib/koty';
import { sadzba } from '../lib/sadzba';
import { faq } from '../content/faq';
import { stranky } from '../content/stranky';
import { type Lang, t, route } from '../i18n/ui';

interface Props { lang: Lang; k: Kategoria }
const { lang, k } = Astro.props;
const ui = t(lang);
const tx = stranky(lang).kategoria;
const rady = await radyKategorie(k.id);
const vsetkyVarianty = (await getCollection('varianty')).map((v) => v.data);
const vsetkyKat = await kategorie();
const skupiny = (await getCollection('rady')).map((r) => r.data);
const produkty = (await getCollection('produkty')).map((p) => p.data);
const variantyRadu = (id: string): Variant[] => vsetkyVarianty.filter((v) => v.rad === id).sort((a, b) => a.poradie - b.poradie);
const varianty = rady.flatMap((r) => variantyRadu(r.id));
const tlaky = tlakyRadov(rady);
const polomery = varianty.map((v) => v.polomer_ohybu_m).filter((x): x is number => typeof x === 'number');
// Render systému: rad, ktorý systém zastupuje (rovnaký ako jeho piktogram Watts), čelný pohľad 3D modelu.
const radSystemu = radPiktogramu(k.piktogram);
const hlava3d = render3d('hlavy', radSystemu);
const rad3d = render3d('rady', radSystemu);
const pikto = hlava3d ?? rad3d ?? piktogram(k.piktogram);
const otazky = faq(k.id, lang);
const faqLd = otazky.length ? [{
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: otazky.map((o) => ({ '@type': 'Question', name: o.q, acceptedAnswer: { '@type': 'Answer', text: o.a } })),
}] : [];

// Rady so spoločným renderom (PRIMO) idú ako vyhotovenia do karty základného radu.
const karty: { rad: Rad; vyhotovenia: Rad[] }[] = [];
for (const r of rady) {
  const spolocna = r.piktogram ? karty.find((x) => x.rad.piktogram === r.piktogram) : undefined;
  if (spolocna) spolocna.vyhotovenia.push(r); else karty.push({ rad: r, vyhotovenia: [] });
}

const fakty: [string, string][] = [
  ...(tlaky.length ? [[ui.kategoria.tlak, `${tlaky.join(' / ')} bar`] as [string, string]] : []),
  ...(varianty.length ? [[ui.kategoria.rura, rozsahRur(varianty, lang)] as [string, string]] : []),
  ...(varianty.length ? [[ui.kategoria.plast, rozsah(varianty.map((v) => v.plast_mm), 'mm', lang)] as [string, string]] : []),
  ...(polomery.length ? [[ui.kategoria.polomer, `${ui.common.od} ${cislo(Math.min(...polomery), 2)} m`] as [string, string]] : []),
];
// Kóty na renderi systému, rovnako ako na stránke radu; zoznam faktov ostáva len bez nich.
const hodnotyHlavy = {
  plast: varianty.length ? [`Ø ${rozsah(varianty.map((v) => v.plast_mm), 'mm', lang)}`, ui.home.popisy.plast] as [string, string] : undefined,
  rura: varianty.length ? [rozsahRur(varianty, lang), [ui.kategoria.rura.toLowerCase(), tlaky.length ? `${tlaky.join(' / ')} bar` : ''].filter(Boolean).join(', ')] as [string, string] : undefined,
  ohyb: polomery.length ? [`${ui.common.od} ${cislo(Math.min(...polomery), 2)} m`, ui.home.popisy.polomer] as [string, string] : undefined,
};
const kotyHlavy = (hlava3d ? kotyRenderu3d('hlavy', radSystemu, hodnotyHlavy) : rad3d ? kotyRenderu3d('rady', radSystemu, hodnotyHlavy) : null) ?? kotyRenderu(k.piktogram, hodnotyHlavy);
const faktyHlavy = kotyHlavy.length >= 2 ? [] : fakty;

const pk = '–';
const riadky: Array<[string, (r: Rad, vs: Variant[]) => string]> = [
  [ui.kategoria.cmpRows.rury, (r) => (r.pocet_rur ? String(r.pocet_rur) : pk)],
  [ui.kategoria.cmpRows.tlak, (r) => tlakText(r) || pk],
  [ui.kategoria.cmpRows.rura, (_r, vs) => rozsahRur(vs, lang) || pk],
  [ui.kategoria.cmpRows.plast, (_r, vs) => (vs.length ? rozsah(vs.map((v) => v.plast_mm), 'mm', lang) : pk)],
  [ui.kategoria.cmpRows.polomer, (_r, vs) => { const p = vs.map((v) => v.polomer_ohybu_m).filter((x): x is number => typeof x === 'number'); return p.length ? `${ui.common.od} ${cislo(Math.min(...p), 2)} m` : pk; }],
  [ui.kategoria.cmpRows.zosilnena, (_r, vs) => { const n = vs.filter((v) => v.izolacia === 'zosilnena').length; return vs.length ? (n ? ui.sklonovanie.dimenzii(n) : ui.common.nie) : pk; }],
  [ui.kategoria.cmpRows.dimenzii, (_r, vs) => (vs.length ? String(vs.length) : pk)],
];

// Spojky pre nosné rúry systému a diely, ktoré treba na každú trasu.
const skupinySpojok: Record<string, string[]> = {
  vykurovanie: ['pe-x-spojky-vykurovanie-a-cool'], sanita: ['pe-x-spojky-sanita'],
  'vykurovanie-a-sanita': ['pe-x-spojky-vykurovanie-a-cool', 'pe-x-spojky-sanita'],
  'studena-a-chladena-voda': ['pe-x-spojky-vykurovanie-a-cool'], 'tepelne-cerpadla': ['pe-x-spojky-vykurovanie-a-cool'],
};
const naTrasu = ['koncovky-a-redukcie', 'izolacne-sady', 'prestupy-stenou'];
const katProduktu = (id: string) => vsetkyKat.find((x) => x.id === id)!;
const spojky = (skupinySpojok[k.id] ?? []).map((sid) => ({ s: skupiny.find((x) => x.id === sid)!, ps: produkty.filter((p) => p.skupina === sid).sort((a, b) => a.poradie - b.poradie) }));
const trasa = naTrasu.map((sid) => skupiny.find((x) => x.id === sid)!).filter(Boolean);
const drobceky = [{ text: ui.nav.potrubia, href: route(lang, 'potrubia') }, { text: kKratky(k, lang) }];
---
<Base lang={lang} alternates={alternatyKategorie(k)} title={kNazov(k, lang)} description={kPopis(k, lang)} aktivna="potrubia" drobceky={drobceky} vizualneDrobceky={false} jsonLd={faqLd}>
  <Hlava lang={lang} nadpis={kNazov(k, lang)} drobceky={drobceky} lead={kPopis(k, lang)} obraz={pikto} obrazAlt={ui.kategoria.piktoAlt(kKratky(k, lang))} obrazMax={860} prechod={`kat-${k.id}`} koty={kotyHlavy} kotyLabel={ui.home.popisy.label} rozlozenie="studio">
    {faktyHlavy.length > 0 && <dl class="hlava-fakty">{faktyHlavy.map(([dt, dd]) => <div><dt>{dt}</dt><dd>{dd}</dd></div>)}</dl>}
    <div class="hlava-akcie">
      <a class="btn btn-yellow btn-lg" href="#rady">{tx.rady} <Ikona nazov="arrow-down" velkost={18} /></a>
      <a class="odkaz" href={route(lang, 'vyber')}>{tx.sprievodca} <Ikona nazov="arrow-right" velkost={16} /></a>
    </div>
  </Hlava>

  <div class="telo">
    <section class="wrap" id="rady" aria-labelledby="h-rady">
      <div class="s-hlava"><h2 id="h-rady">{tx.radyH2}</h2><p>{sadzba(tx.radyP(ui.sklonovanie.radov(rady.length), ui.sklonovanie.dimenzii(varianty.length)))}</p></div>
      <div class="karty" data-pocet={karty.length}>
        {karty.map(({ rad, vyhotovenia }) => (
          <KartaRadu rad={rad} href={cestaRadu(k, rad, lang)} varianty={variantyRadu(rad.id)} lang={lang} vyhotovenia={vyhotovenia.map((v) => ({ rad: v, href: cestaRadu(k, v, lang) }))} />
        ))}
      </div>
    </section>

    {rady.length > 1 && (
      <section class="wrap" aria-labelledby="h-cmp">
        <div class="s-hlava"><h2 id="h-cmp">{ui.kategoria.cmpH2}</h2><p>{ui.kategoria.cmpP}</p></div>
        <div class="harok tab-obal">
          <table class="data porovnanie">
            <thead><tr><th scope="col"><span class="sr">{ui.kategoria.cmpH2}</span></th>{rady.map((r) => <th scope="col"><a href={cestaRadu(k, r, lang)}>{rNazov(r, lang).split(',')[0]}</a></th>)}</tr></thead>
            <tbody>{riadky.map(([label, fn]) => <tr><th scope="row">{label}</th>{rady.map((r) => <td>{fn(r, variantyRadu(r.id))}</td>)}</tr>)}</tbody>
          </table>
        </div>
        <p class="source">{ui.common.zdroj} {datum(k.stiahnute, lang)}. {stranky(lang).potrubia.legenda}</p>
      </section>
    )}

    {spojky.length > 0 && (
      <section class="wrap" aria-labelledby="h-spojky">
        <div class="s-hlava"><h2 id="h-spojky">{tx.spojkyH2}</h2><p>{sadzba(tx.spojkyP)}</p><a href={route(lang, 'spojky')}>{tx.vsetkySpojky} <Ikona nazov="arrow-right" velkost={16} /></a></div>
        <div class="spojky">
          {spojky.map(({ s, ps }) => { const img = fotkaRadu(s.fotka); return (
            <div class="harok skupina">
              <div class="skupina-hlava">
                {img && <Obraz src={img} alt="" width={72} height={72} densities={[1, 2]} class="skupina-ikona" />}
                <h3>{rNazov(s, lang)}</h3>
              </div>
              <ul>{ps.map((p) => <li><a href={cestaProduktu(p, katProduktu(p.kategoria), lang)}><span>{pNazov(p, lang)}</span>{p.pocet_variantov > 0 && <span class="pocet">{ui.sklonovanie.dimenzii(p.pocet_variantov)}</span>}</a></li>)}</ul>
            </div>
          ); })}
          <div class="harok skupina skupina-trasa">
            <h3>{tx.dalsie}</h3>
            <ul>{trasa.map((s) => { const kp = katProduktu(s.kategoria); return <li><a href={`${cestaKategorie(kp, lang)}#${s.id}`}><span>{rNazov(s, lang)}</span><Ikona nazov="chevron-right" velkost={16} /></a></li>; })}</ul>
          </div>
        </div>
      </section>
    )}

    {otazky.length > 0 && (
      <section class="wrap" aria-labelledby="h-faq">
        <div class="faq-grid">
          <div>
            <h2 id="h-faq">{ui.kategoria.faqH2}</h2>
            <p class="muted" style="margin-top: 12px">{ui.kategoria.faqP} <a href={route(lang, 'kontakt')}>{ui.kategoria.faqNapisat}</a>.</p>
          </div>
          <div class="faq harok">
            {otazky.map((o) => <details><summary>{o.q}</summary><p>{sadzba(o.a)}</p></details>)}
          </div>
        </div>
      </section>
    )}
  </div>
  <Zaver lang={lang} />
</Base>

<style>
  .hlava-fakty { display: flex; flex-wrap: wrap; gap: 16px 32px; margin: 24px 0 0; }
  .hlava-fakty dt { font-size: 13px; color: var(--color-ink-soft); }
  .hlava-fakty dd { margin: 2px 0 0; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: clamp(17px, 0.6vw + 13px, 22px); letter-spacing: -0.01em; color: var(--color-blue-900); white-space: nowrap; font-variant-numeric: tabular-nums; }

  .karty { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px 28px; align-items: start; }
  .karty[data-pocet="1"] { grid-template-columns: minmax(0, 560px); }
  .karty[data-pocet="2"] { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  .tab-obal { overflow-x: auto; padding: 8px 20px 12px; }
  .porovnanie th, .porovnanie td { white-space: nowrap; }
  .porovnanie thead th { color: var(--color-ink); font-weight: 600; font-size: 14px; background: #fff; }
  .porovnanie thead th a { color: var(--color-ink); }
  .porovnanie thead th a:hover { color: var(--color-blue-700); }
  .porovnanie tbody th { text-align: left; font-weight: 400; color: var(--color-ink-soft); position: sticky; left: 0; background: #fff; padding: 12px 16px; border-bottom: var(--line); font-size: 14px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .source { margin-top: 12px; }

  .spojky { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; align-items: start; }
  .skupina { padding: 24px 24px 16px; }
  .skupina-hlava { display: flex; align-items: center; gap: 16px; margin-bottom: 8px; }
  .skupina :global(.skupina-ikona) { width: 56px; height: 56px; object-fit: contain; flex: none; }
  .skupina h3 { font-size: 18px; }
  .skupina li a { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 8px 0; border-top: 1px solid rgb(10 42 94 / 0.08); font-size: 15px; font-weight: 500; }
  .skupina .pocet { font-weight: 400; font-size: 14px; color: var(--color-ink-soft); white-space: nowrap; }
  .skupina-trasa { background: linear-gradient(160deg, #fff 0%, #f3f7fc 100%); }
  .skupina-trasa h3 { margin-bottom: 8px; }
  .skupina-trasa :global(svg) { color: var(--color-blue-700); flex: none; }

  .faq-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 24px 48px; align-items: start; }
  .faq-grid h2 { font-size: clamp(26px, 1.4vw + 17px, 36px); }
  .faq { padding: 4px 24px; }
  .faq details + details { border-top: 1px solid rgb(10 42 94 / 0.1); }
  .faq summary { cursor: pointer; padding: 16px 0; font-weight: 600; font-size: 17px; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: "+"; color: var(--color-blue-700); font-weight: 400; font-size: 22px; line-height: 1; transition: transform 200ms var(--ease-soft); }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq details p { padding-bottom: 16px; color: var(--color-ink-soft); max-width: 62ch; }

  @media (max-width: 900px) { .karty[data-pocet="2"] { grid-template-columns: minmax(0, 1fr); } .faq-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
