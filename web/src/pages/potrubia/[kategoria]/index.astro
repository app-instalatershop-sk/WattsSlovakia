---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import KartaRadu from '../../../components/KartaRadu.astro';
import { kategorie, radyKategorie, cestaKategorie, cestaRadu, cislo, rozsah, skloňujRady, skloňujDimenzie, type Variant } from '../../../lib/katalog';
import { piktogram } from '../../../lib/obrazky';
import { faq } from '../../../content/faq';

export async function getStaticPaths() {
  const kats = (await kategorie()).filter((k) => k.typ === 'potrubie');
  return kats.map((k) => ({ params: { kategoria: k.slug }, props: { k } }));
}
const { k } = Astro.props;
const rady = await radyKategorie(k.id);
const vsetkyVarianty = (await getCollection('varianty')).map((v) => v.data);
const variantyRadu = (id: string): Variant[] => vsetkyVarianty.filter((v) => v.rad === id);
const varianty = rady.flatMap((r) => variantyRadu(r.id));
const tlaky = [...new Set(rady.map((r) => r.tlak_bar).filter((x): x is number => typeof x === 'number'))].sort((a, b) => a - b);
const polomery = varianty.map((v) => v.polomer_ohybu_m).filter((x): x is number => typeof x === 'number');
const pikto = piktogram(k.piktogram);
const otazky = faq[k.slug] ?? [];
const faqLd = otazky.length ? [{
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: otazky.map((o) => ({ '@type': 'Question', name: o.q, acceptedAnswer: { '@type': 'Answer', text: o.a } })),
}] : [];
const riadky: Array<[string, (r: typeof rady[number], vs: Variant[]) => string]> = [
  ['Počet rúr v plášti', (r) => (r.pocet_rur ? String(r.pocet_rur) : 'podľa katalógu')],
  ['Prevádzkový tlak', (r) => (r.tlak_bar ? `${r.tlak_bar} bar` : 'podľa katalógu')],
  ['Nosná rúra', (_r, vs) => rozsah(vs.map((v) => v.rura?.d), 'mm')],
  ['Plášť HDPE', (_r, vs) => rozsah(vs.map((v) => v.plast_mm), 'mm')],
  ['Polomer ohybu', (_r, vs) => { const p = vs.map((v) => v.polomer_ohybu_m).filter((x): x is number => typeof x === 'number'); return p.length ? `od ${cislo(Math.min(...p), 2)} m` : 'podľa katalógu'; }],
  ['Zosilnená izolácia', (_r, vs) => { const n = vs.filter((v) => v.izolacia === 'zosilnena').length; return vs.length ? (n ? skloňujDimenzie(n) : 'nie') : 'podľa katalógu'; }],
  ['Dimenzií s obj. číslom', (_r, vs) => (vs.length ? String(vs.length) : 'podľa katalógu')],
];
---
<Base title={k.nazov} description={k.popis} aktivna="potrubia" drobceky={[{ text: 'Potrubia', href: '/potrubia/' }, { text: k.kratky_nazov }]} jsonLd={faqLd}>
  <div class="wrap">
    <div class="cat-head">
      <div>
        <h1>{k.nazov}</h1>
        <p class="lead">{k.popis}</p>
      </div>
      {pikto && <Image src={pikto} alt={`${k.kratky_nazov}, rez potrubím`} width={400} height={300} class="cat-pikto" />}
    </div>

    <dl class="spec spec-row">
      {tlaky.length > 0 && <div><dt>Prevádzkový tlak</dt><dd>{tlaky.map((t) => `${t} bar`).join(' / ')}</dd></div>}
      {varianty.length > 0 && <div><dt>Nosná rúra</dt><dd>{rozsah(varianty.map((v) => v.rura?.d), 'mm')}</dd></div>}
      {varianty.length > 0 && <div><dt>Plášť</dt><dd>{rozsah(varianty.map((v) => v.plast_mm), 'mm')}</dd></div>}
      {polomery.length > 0 && <div><dt>Polomer ohybu</dt><dd>od {cislo(Math.min(...polomery), 2)} m</dd></div>}
      <div><dt>Rady</dt><dd class="rady-dd">{rady.map((r) => r.nazov.replace(/^Microflex /, '').replace(/,.*$/, '')).join(', ')}</dd></div>
    </dl>

    <div class="list-head">
      <p class="muted">{skloňujRady(rady.length)}, {skloňujDimenzie(varianty.length)} s obj. číslom podľa katalógu</p>
    </div>
    <div class="series">
      {rady.map((r) => <KartaRadu rad={r} href={cestaRadu(k, r)} varianty={variantyRadu(r.id)} />)}
    </div>
  </div>

  {rady.length > 1 && (
    <section class="section" aria-labelledby="h-cmp">
      <div class="wrap">
        <div class="section-head">
          <h2 id="h-cmp">Ktorý rad zvoliť</h2>
          <p class="muted">Porovnanie radov v kategórii podľa katalógu výrobcu.</p>
        </div>
        <div class="table-wrap">
          <table class="data compare">
            <thead><tr><th></th>{rady.map((r) => <th>{r.nazov}</th>)}</tr></thead>
            <tbody>
              {riadky.map(([label, fn]) => <tr><td>{label}</td>{rady.map((r) => <td>{fn(r, variantyRadu(r.id))}</td>)}</tr>)}
            </tbody>
          </table>
        </div>
        <p class="source">Zdroj: katalóg Watts Microflex, slovenské vydanie, stav k {new Date(k.stiahnute).toLocaleDateString('sk-SK')}. Rady bez tabuľky doplníme z PDF katalógu.</p>
      </div>
    </section>
  )}

  {otazky.length > 0 && (
    <section class="section band" aria-labelledby="h-faq">
      <div class="wrap faq-grid">
        <div>
          <h2 id="h-faq">Otázky pred výberom</h2>
          <p class="muted" style="margin-top: 12px">Čo sa nás pýtajú najčastejšie. Ak vám odpoveď chýba, <a href="/kontakt/">napíšte nám</a>.</p>
        </div>
        <div class="faq">
          {otazky.map((o) => <details><summary>{o.q}</summary><p>{o.a}</p></details>)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .cat-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px 48px; align-items: start; padding-block: 12px 32px; }
  .cat-head h1 { max-width: 16ch; }
  .cat-head .lead { margin-top: 16px; }
  .cat-head :global(.cat-pikto) { width: 200px; height: 150px; object-fit: contain; }
  .spec-row { grid-template-columns: repeat(5, auto); justify-content: start; margin-bottom: 32px; }
  .spec-row > div { border-bottom: 0; }
  .spec-row > div:last-child { border-right: 0; }
  .rady-dd { font-size: 16px !important; font-family: var(--font-text) !important; font-stretch: 100% !important; }
  .list-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 24px; }
  .series { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .compare th:first-child, .compare td:first-child { color: var(--color-ink-soft); font-weight: 400; position: sticky; left: 0; background: var(--color-white); }
  .compare thead th { color: var(--color-ink); font-weight: 600; font-size: 14px; }
  .faq-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 24px 48px; }
  .faq details { border-top: var(--line); }
  .faq details:last-child { border-bottom: var(--line); }
  .faq summary { cursor: pointer; padding: 16px 0; font-weight: 600; font-size: 17px; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: "+"; color: var(--color-blue-700); font-weight: 400; font-size: 22px; line-height: 1; transition: transform 200ms var(--ease-soft); }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq details p { padding-bottom: 16px; color: var(--color-ink-soft); max-width: 62ch; }
  @media (max-width: 1000px) { .spec-row { grid-template-columns: repeat(2, minmax(0, 1fr)); } .spec-row > div { border-bottom: 1px solid rgb(0 93 185 / 0.16); } }
  @media (max-width: 760px) {
    .cat-head { grid-template-columns: 1fr; }
    .cat-head :global(.cat-pikto) { width: 120px; height: 90px; order: -1; }
    .series { grid-template-columns: 1fr; }
    .faq-grid { grid-template-columns: 1fr; }
  }
</style>
