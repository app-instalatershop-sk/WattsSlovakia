---
/**
 * Kotúč sa odvaľuje (Juraj 28. 10. 2026, v pokládke na domove namiesto fotky): 100 m potrubia DUO
 * (4 vrstvy po 5 závitoch z rozmerov kotúča v katalógu) sa odvaľuje pozdĺž ryhy a za ním ostáva položená rúra
 * (data/blender/potrubie.py pohľad kotuc, data/novinky_web.py kotuc). Záber je široký (kotúč prejde celý
 * obraz), preto ide cez celú šírku a pod ním sú kroky pokládky v rade; rozsvietia sa s pohybom.
 * Kóta nad kotúčom ide s ním: najprv priemer kotúča, pri odvaľovaní koľko metrov na ňom ostáva.
 * Pohyb sa prehrá sám, keď je obraz v okne (Juraj 4. 11. 2026, predtým rolovanie cez 1,75 okna); návrhy ako
 * pri rozloženom reze: A raz plynulo, B po krokoch so zastávkou a kroky sa dajú vybrať, C potom ťahaním.
 * Prehrávač: lib/sekvencia.ts. Bez skriptu a pri „obmedziť pohyb“ stojí prvý záber s kótami a všetky kroky.
 */
import Koty from './Koty.astro';
import SekvenciaOvladanie from './SekvenciaOvladanie.astro';
import type { Kota } from '../lib/koty';
import type { KotucData } from '../lib/obrazky';
import { sadzba } from '../lib/sadzba';

type Odvalenie = NonNullable<KotucData['odvalenie']>;
interface Props { data: Odvalenie; texty: { priemer: string; ostava: string; label: string }; celo: [string, string]; alt: string; kroky: [string, string][]; krokyLabel: string; ovladanie: { znova: string; tahaj: string } }
const { data, texty, celo, alt, kroky, krokyLabel, ovladanie } = Astro.props;
const prvy = data.body[0];
const sirka = Math.max(...data.sirky);
const zaber0 = `${data.cesta}${sirka}/000`;
const m = (x: number) => x.toLocaleString('sk-SK', { maximumFractionDigits: 2, minimumFractionDigits: 2 });
const koty: Kota[] = [
  { x: prvy.vrch[0], y: prvy.vrch[1], l: 3.5, smer: 'hore-vpravo', smerM: 'hore-vpravo', hodnota: `Ø ${m(data.kotuc.d_m)} m`, text: texty.priemer, kod: 'kotuc' },
  { x: prvy.celo[0], y: prvy.celo[1], l: 6, smer: 'hore-vlavo', smerM: 'hore-vlavo', hodnota: celo[0], text: celo[1], kod: 'celo' },
];
const dlzka = Math.floor(data.kotuc.dlzka_m);
---
<div class="ks" data-kotuc data-cesta={data.cesta} data-snimok={data.snimok} data-sirky={data.sirky.join(',')} data-body={JSON.stringify(data.body)} data-dlzka={dlzka} data-ostava={texty.ostava} data-priemer={`Ø ${m(data.kotuc.d_m)} m|${texty.priemer}`} style={`--pomer: ${data.pomer}`}>
  <div class="ks-obal">
    <div class="wrap ks-obsah">
      <div class="ks-stage" style={`aspect-ratio: ${data.pomer}`}>
        <picture class="ks-obr">
          <source type="image/avif" srcset={`${zaber0}.avif`} />
          <img src={`${zaber0}.webp`} alt={alt} width={sirka} height={Math.round(sirka / data.pomer)} loading="lazy" decoding="async" />
        </picture>
        <canvas class="ks-canvas" aria-hidden="true"></canvas>
        <Koty koty={koty} label={texty.label} />
        <SekvenciaOvladanie znova={ovladanie.znova} tahaj={ovladanie.tahaj} roh="vpravo-hore" />
      </div>
      <ol class="ks-kroky" aria-label={krokyLabel}>
        {kroky.map(([nazov, text], i) => (
          <li><span class="ks-cislo" aria-hidden="true">{i + 1}</span><h3>{nazov}</h3><p>{sadzba(text)}</p></li>
        ))}
      </ol>
    </div>
  </div>
</div>

<style>
  .ks { position: relative; margin-top: 8px; }
  /* Sekcia je taká vysoká ako obsah. Hore miesto pre kótu nad kotúčom, ktorá stojí nad horným okrajom obrazu
     (Juraj 28. 10.: štítok bol orezaný) a s kotúčom prejde až pod text pokládky vľavo; nesmie ho prekryť. */
  .ks-obal { padding-block: 104px 24px; overflow: clip visible; }
  .ks-obsah { width: 100%; display: grid; gap: 16px; }
  /* Široký záber: kotúč prejde celý obraz; výška obmedzená, aby sa pod ním zmestili kroky a nad ním kóta. */
  .ks-stage { position: relative; width: min(100%, calc((100vh - 72px - 360px) * var(--pomer))); margin-inline: auto; container-type: inline-size; }
  .ks-obr :global(img), .ks-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ks-canvas { opacity: 0; }
  .ks.ks-bezi .ks-canvas { opacity: 1; }
  .ks.ks-bezi .ks-obr { visibility: hidden; }
  /* C: kotúč sa dá ťahaním odvaľovať; zvislé rolovanie prstom ostáva stránke. */
  .ks-stage.sq-tahatelne { touch-action: pan-y; cursor: grab; user-select: none; -webkit-user-select: none; }
  .ks-stage.sq-taha { cursor: grabbing; }
  /* Kóta nad kotúčom ide s ním cez transform (plynulo, bez nového rozloženia pri každom snímku) a bez rozmazania
     pozadia, pod ňou sa každý snímok mení obraz. --pomer je na koreni, 1cqw = 1 % šírky rámika. */
  .ks.ks-js .ks-stage :global(.k-kotuc) { left: 0; top: 0; transform: translate3d(calc(var(--xn, 0) * 1cqw), calc(var(--yn, 0) * 1cqw / var(--pomer)), 0); will-change: transform; }
  .ks.ks-js .ks-stage :global(.stitok) { -webkit-backdrop-filter: none; backdrop-filter: none; background: var(--sklo-3); }
  /* Kroky v rade pod obrazom: rozsvieti sa ten, ku ktorému kotúč dorazil (bez skriptu všetky). */
  .ks-kroky { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin: 0; padding: 0; list-style: none; }
  .ks-kroky li { position: relative; isolation: isolate; padding-top: 16px; border-top: 3px solid rgb(10 42 94 / 0.14); transition: border-color 300ms var(--ease-soft), opacity 300ms var(--ease-soft); }
  .ks-cislo { font-family: var(--font-display); font-weight: 700; font-size: 18px; color: var(--color-blue-700); }
  .ks-kroky h3 { margin-top: 2px; font-size: 18px; line-height: 1.3; }
  .ks-kroky p { margin-top: 4px; font-size: 15px; line-height: 1.5; color: var(--color-ink-soft); }
  .ks.ks-js .ks-kroky li { opacity: var(--ks-neaktivny-opacity, 0.5); }
  .ks.ks-js .ks-kroky li.is-on { opacity: 1; border-top-color: var(--color-blue-700); }

  /* B: kroky sú tlačidlá (skript vloží <button> do nadpisu, klikateľný je celý krok); vybraný krok má pod sebou
     mliečnu plochu (pseudoprvok, pri prepnutí sa nič neposunie). */
  .ks[data-rezim="b"] .ks-kroky li::before { content: ""; position: absolute; z-index: -1; inset: 0 -12px -12px; border-radius: 0 0 var(--radius-l) var(--radius-l); background: var(--sklo-1); box-shadow: var(--elev-1); opacity: 0; transition: opacity 250ms var(--ease-soft); }
  .ks[data-rezim="b"] .ks-kroky li.is-aktivny::before { opacity: 1; }
  .ks-kroky :global(.ks-vyber) { margin: 0; padding: 0; border: 0; background: none; font: inherit; color: inherit; text-align: inherit; cursor: pointer; }
  .ks-kroky :global(.ks-vyber)::after { content: ""; position: absolute; inset: -3px -12px -12px; border-radius: 0 0 var(--radius-l) var(--radius-l); }
  .ks-kroky :global(.ks-vyber:focus-visible) { outline: none; }
  .ks-kroky :global(.ks-vyber:focus-visible)::after { outline: 2px solid var(--color-blue-700); outline-offset: 2px; }
  @media (hover: hover) and (pointer: fine) {
    .ks[data-rezim="b"] .ks-kroky li:not(.is-aktivny):hover h3 { color: var(--color-blue-700); }
  }

  @media (max-width: 900px) {
    .ks-obal { padding-block: 56px 16px; }
    .ks-stage { width: calc(100% + 2 * var(--gutter)); margin-inline: calc(-1 * var(--gutter)); }
    .ks-kroky { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    /* B: popis len pri vybranom kroku, ostatné ukážu číslo a názov (zoznam drží výšku, skript). */
    .ks[data-rezim="b"] .ks-kroky { gap: 12px; }
    .ks[data-rezim="b"] .ks-kroky li { display: grid; grid-template-columns: 24px minmax(0, 1fr); column-gap: 8px; align-items: baseline; padding-top: 12px; }
    .ks[data-rezim="b"] .ks-kroky li > :not(.ks-cislo) { grid-column: 2; }
    .ks[data-rezim="b"] .ks-kroky h3 { margin-top: 0; }
    .ks[data-rezim="b"] .ks-kroky p { display: none; }
    .ks[data-rezim="b"] .ks-kroky li.is-aktivny p { display: block; }
    .ks[data-rezim="b"] .ks-kroky li::before, .ks-kroky :global(.ks-vyber)::after { left: -8px; right: -8px; }
  }
</style>

<script>
  import { prehravaj, ovladaj, rezimAnimacii, type Krok } from '../lib/sekvencia';
  // Kedy sa rozsvieti krok (podiel odvalenia): kotúč pri výkope, rozvinutie, spojky, páska a zásyp na konci.
  const KROK = [0, 0.36, 0.85, 1];
  // Scenár (cieľ, ms pohybu, ms zastávky). A a C: odvalenie naraz. B: po krokoch. Spolu pod 5 s (WCAG 2.2.2).
  const NARAZ: Krok[] = [[1, 3600, 0]];
  const PO_KROKOCH: Krok[] = [[0, 0, 500], [KROK[1], 1000, 600], [KROK[2], 1200, 600], [KROK[3], 600, 0]];
  const stopky: AbortController[] = [];

  function initKotuc() {
    stopky.splice(0).forEach((s) => s.abort());
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const rezim = rezimAnimacii();
    document.querySelectorAll<HTMLElement>('[data-kotuc]').forEach((koren) => {
      const stop = new AbortController();
      const signal = stop.signal;
      stopky.push(stop);
      koren.dataset.rezim = rezim;
      koren.classList.add('ks-js');
      const n = Number(koren.dataset.snimok);
      const body: { vrch: number[]; celo: number[]; volny_m: number }[] = JSON.parse(koren.dataset.body ?? '[]');
      const dlzka = Number(koren.dataset.dlzka);
      const [priemer, priemerText] = (koren.dataset.priemer ?? '|').split('|');
      const stage = koren.querySelector<HTMLElement>('.ks-stage')!;
      const kota = koren.querySelector<HTMLElement>('.k-kotuc')!;
      const hodnota = kota.querySelector<HTMLElement>('strong')!;
      const text = kota.querySelector<HTMLElement>('.stitok > span')!;
      const kroky = [...koren.querySelectorAll<HTMLElement>('.ks-kroky li')];
      let naposledy = -1;
      const prehravac = prehravaj({
        koren, stage, platno: koren.querySelector<HTMLCanvasElement>('.ks-canvas')!,
        cesta: koren.dataset.cesta ?? '', n, sirky: (koren.dataset.sirky ?? '').split(',').map(Number), zaciatok: 0, signal,
        bezi: () => koren.classList.add('ks-bezi'),
        zlyhalo: () => { koren.classList.remove('ks-js'); delete koren.dataset.rezim; stop.abort(); },
        popisy: (x) => {
          // kóta ide s kotúčom plynulo (medzi bodmi susedných snímok), metre na ňom ubúdajú po jednom
          const i = Math.min(n - 2, Math.floor(x)), t = x - i, a = body[i], b = body[i + 1];
          kota.style.setProperty('--xn', (a.vrch[0] + t * (b.vrch[0] - a.vrch[0])).toFixed(3));
          kota.style.setProperty('--yn', (a.vrch[1] + t * (b.vrch[1] - a.vrch[1])).toFixed(3));
          // kým sa kotúč nepohol, priemer; potom koľko metrov na ňom ostáva (100 m mínus voľný koniec)
          const ide = x > 0.02;
          const novaHodnota = ide ? `${Math.round(dlzka - (a.volny_m + t * (b.volny_m - a.volny_m)))} m` : priemer;
          const novyText = ide ? koren.dataset.ostava! : priemerText;
          if (hodnota.textContent !== novaHodnota) hodnota.textContent = novaHodnota;
          if (text.textContent !== novyText) text.textContent = novyText;
          const f = x / (n - 1);
          let aktivny = 0;
          KROK.forEach((k, j) => { if (f >= k - 1e-6) aktivny = j; });
          if (aktivny === naposledy) return;
          naposledy = aktivny;
          kroky.forEach((li, j) => {
            li.classList.toggle('is-on', j <= aktivny);
            li.classList.toggle('is-aktivny', j === aktivny);
            li.querySelector('.ks-vyber')?.setAttribute('aria-pressed', String(j === aktivny));
          });
        },
      });

      // Prehranie pri zobrazení, Prehrať znova, v C ťahanie (kotúč ide sprava doľava: ťah doľava ho odvaľuje ďalej).
      const ovl = ovladaj({ koren, stage, prehravac, hore: window.matchMedia('(max-width: 900px)').matches ? 64 : 72, scenar: rezim === 'b' ? PO_KROKOCH : NARAZ, rezim, smerTahu: -1, signal });

      if (rezim === 'b') {
        kroky.forEach((li, j) => {
          const h3 = li.querySelector('h3')!;
          const tlacidlo = document.createElement('button');
          tlacidlo.type = 'button';
          tlacidlo.className = 'ks-vyber';
          tlacidlo.textContent = h3.textContent;
          tlacidlo.setAttribute('aria-pressed', 'false');
          h3.replaceChildren(tlacidlo);
          tlacidlo.addEventListener('click', () => { void ovl.vyber(KROK[j], 1100); }, { signal });
        });
        // telefón: zoznam drží výšku s najdlhším popisom, pod ním sa pri prepnutí kroku nič nehýbe
        const zoznam = koren.querySelector<HTMLElement>('.ks-kroky')!;
        const drzVysku = () => {
          zoznam.style.minHeight = '';
          if (!window.matchMedia('(max-width: 900px)').matches) return;
          const aktivne = kroky.map((li) => li.classList.contains('is-aktivny'));
          let max = 0;
          for (const li of kroky) { kroky.forEach((x) => x.classList.toggle('is-aktivny', x === li)); max = Math.max(max, zoznam.offsetHeight); }
          kroky.forEach((x, k) => x.classList.toggle('is-aktivny', aktivne[k]));
          zoznam.style.minHeight = `${max}px`;
        };
        drzVysku();
        document.fonts?.ready.then(drzVysku);
        window.addEventListener('resize', drzVysku, { signal });
      }
    });
  }

  initKotuc();
  document.addEventListener('astro:page-load', initKotuc);
</script>
