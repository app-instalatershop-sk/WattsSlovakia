---
/**
 * Článok poradne: hlava s obrazom, text na hárku a vedľa neho lepkavý obsah článku, zdroj
 * v katalógu a súvisiace stránky. Bloky (odsek, postup, zoznam, tabuľka, fakty) sú v content/clanky.ts.
 */
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hlava from '../components/Hlava.astro';
import Zaver from '../components/Zaver.astro';
import Ikona from '../components/Ikona.astro';
import { clanky, alternatyClanku, type Clanok } from '../content/clanky';
import { fotka } from '../lib/obrazky';
import { sadzba } from '../lib/sadzba';
import { type Lang, route, KATALOG_PDF } from '../i18n/ui';

interface Props { lang: Lang; c: Clanok; i: number }
const { lang, c, i } = Astro.props;
const tx = {
  sk: { poradna: 'Poradňa', obsah: 'V článku', zdroj: 'Zdroj', katalog: (s: string) => `Katalóg Watts Microflex, s. ${s}`, citanie: (n: number) => `${n} min čítania`, suvisiace: 'Ďalej', dalsie: 'Ďalšie články' },
  cs: { poradna: 'Poradna', obsah: 'V článku', zdroj: 'Zdroj', katalog: (s: string) => `Katalog Watts Microflex, s. ${s}`, citanie: (n: number) => `${n} min čtení`, suvisiace: 'Dále', dalsie: 'Další články' },
}[lang];
const obraz = fotka(c.obraz);
const druh = c.obraz.endsWith('.png') ? 'render' : c.obraz === 'rez-render.jpg' ? 'biely' : 'foto';
const id = (h: string) => h.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const ostatne = clanky(lang).filter((x) => x.slug !== c.slug);
const drobceky = [{ text: tx.poradna, href: route(lang, 'poradna') }, { text: c.nazov }];
const ldObraz = obraz ? (await getImage({ src: obraz, width: 1000, format: 'webp' })).src : undefined;
const ld = [{
  '@context': 'https://schema.org', '@type': 'Article', headline: c.nazov, description: c.perex, inLanguage: lang,
  author: { '@type': 'Organization', name: 'Ohrievacia Technika, s. r. o.' }, publisher: { '@type': 'Organization', name: 'Microflex Slovensko' },
  ...(ldObraz ? { image: new URL(ldObraz, Astro.site).href } : {}),
}];
---
<Base lang={lang} alternates={alternatyClanku(i)} title={c.nazov} description={`${c.perex} ${tx.katalog(c.strany)}.`} aktivna="poradna" drobceky={drobceky} vizualneDrobceky={false} jsonLd={ld}>
  <Hlava lang={lang} nadpis={c.nazov} drobceky={drobceky} pred={tx.citanie(c.minut)} lead={c.perex} obraz={obraz} obrazAlt={c.obrazAlt} druh={druh} obrazMax={640} />

  <div class="telo">
    <div class="wrap clanok-mriezka">
      <article class="harok clanok">
        {c.sekcie.map((s) => (
          <section id={id(s.h)} class="cast">
            <h2>{sadzba(s.h)}</h2>
            {s.bloky.map((b) => (
              'p' in b ? <p>{sadzba(b.p)}</p>
              : 'kroky' in b ? <ol class="kroky">{b.kroky.map(([h, t]) => <li><strong>{h}</strong><span>{sadzba(t)}</span></li>)}</ol>
              : 'zoznam' in b ? <ul class="zoznam">{b.zoznam.map((z) => <li><Ikona nazov="check" velkost={18} /><span>{sadzba(z)}</span></li>)}</ul>
              : 'fakty' in b ? <dl class="fakty">{b.fakty.map(([dt, dd]) => <div><dt>{dt}</dt><dd>{sadzba(dd)}</dd></div>)}</dl>
              : (
                <figure class="tabulka">
                  {b.tabulka.nadpis && <figcaption>{b.tabulka.nadpis}</figcaption>}
                  <div class="tabulka-obal"><table class="data">
                    <thead><tr>{b.tabulka.hlavicky.map((h) => <th scope="col">{h}</th>)}</tr></thead>
                    <tbody>{b.tabulka.riadky.map((r) => <tr>{r.map((x, j) => (j === 0 ? <th scope="row">{x}</th> : <td>{x}</td>))}</tr>)}</tbody>
                  </table></div>
                  {b.tabulka.pozn && <p class="tabulka-pozn">{b.tabulka.pozn}</p>}
                </figure>
              )
            ))}
          </section>
        ))}
      </article>

      <aside class="bok">
        <nav class="harok bok-karta" aria-label={tx.obsah}>
          <h2>{tx.obsah}</h2>
          <ol>{c.sekcie.map((s) => <li><a href={`#${id(s.h)}`}>{s.h}</a></li>)}</ol>
        </nav>
        <div class="harok bok-karta">
          <h2>{tx.zdroj}</h2>
          <a class="bok-zdroj" href={KATALOG_PDF} target="_blank" rel="noopener"><Ikona nazov="file-text" velkost={18} />{tx.katalog(c.strany)}</a>
          <h2 class="bok-h2">{tx.suvisiace}</h2>
          <ul>{c.suvisiace.map((s) => <li><a href={route(lang, s.kam)}>{s.text} <Ikona nazov="arrow-right" velkost={15} /></a></li>)}</ul>
        </div>
      </aside>
    </div>

    <section class="wrap" aria-labelledby="h-dalsie">
      <div class="s-hlava"><h2 id="h-dalsie">{tx.dalsie}</h2><a href={route(lang, 'poradna')}>{tx.poradna} <Ikona nazov="arrow-right" velkost={16} /></a></div>
      <ul class="dalsie">
        {ostatne.map((x) => (
          <li><a class="harok dalsi" href={`${route(lang, 'poradna')}${x.slug}/`}><span class="dalsi-min">{tx.citanie(x.minut)}</span><span class="dalsi-n">{sadzba(x.nazov)}</span><span class="dalsi-p">{sadzba(x.perex)}</span></a></li>
        ))}
      </ul>
    </section>
  </div>
  <Zaver lang={lang} />
</Base>

<style>
  .clanok-mriezka { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: 32px 40px; align-items: start; }
  .clanok { padding: 40px 48px 44px; }
  .clanok section + section { margin-top: 40px; }
  .clanok h2 { font-size: clamp(22px, 0.8vw + 16px, 28px); letter-spacing: -0.015em; margin-bottom: 14px; }
  .clanok p { font-size: 17px; line-height: 1.65; max-width: 40em; }
  .clanok p + p, .clanok * + p { margin-top: 14px; }
  .kroky { counter-reset: krok; margin-top: 18px; }
  .kroky li { counter-increment: krok; position: relative; display: flex; flex-direction: column; gap: 2px; padding: 0 0 20px 54px; }
  .kroky li::before { content: counter(krok); position: absolute; left: 0; top: -2px; width: 36px; height: 36px; border-radius: 11px; display: grid; place-items: center; background: var(--color-blue-900); color: #fff; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 700; }
  .kroky li:not(:last-child)::after { content: ""; position: absolute; left: 17px; top: 40px; bottom: 4px; width: 2px; background: rgb(10 42 94 / 0.12); }
  .kroky strong { font-size: 17px; }
  .kroky span { color: var(--color-ink-soft); }
  .zoznam { margin-top: 16px; }
  .zoznam li { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 10px; line-height: 1.55; }
  .zoznam li + li { margin-top: 10px; }
  .zoznam :global(.icon) { color: #1f8a4c; margin-top: 3px; }
  .fakty { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin: 20px 0 0; }
  .fakty > div { padding: 16px 18px; border-radius: 14px; background: linear-gradient(160deg, #f5f8fc 0%, #eaf1f9 100%); }
  .fakty dt { font-size: 13px; color: var(--color-ink-soft); }
  .fakty dd { margin: 4px 0 0; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 17px; line-height: 1.3; color: var(--color-blue-900); }
  .tabulka { margin: 20px 0 0; }
  .tabulka figcaption { font-weight: 600; margin-bottom: 8px; }
  .tabulka-obal { overflow-x: auto; border-radius: 12px; box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.1); }
  .tabulka th, .tabulka td { white-space: normal; }
  .tabulka tbody th { text-align: left; font-weight: 600; color: var(--color-ink); font-size: 14px; }
  .tabulka-pozn { font-size: 13px !important; color: var(--color-ink-soft); margin-top: 8px !important; }

  .bok { position: sticky; top: 90px; display: flex; flex-direction: column; gap: 20px; }
  .bok-karta { padding: 22px 24px; }
  .bok-karta h2 { font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-blue-700); margin-bottom: 10px; }
  .bok-karta .bok-h2 { margin-top: 20px; }
  .bok-karta ol li a, .bok-karta ul li a { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 8px 0; border-top: 1px solid rgb(10 42 94 / 0.08); color: var(--color-ink); font-weight: 500; font-size: 15px; }
  .bok-karta li:first-child a { border-top: 0; }
  .bok-karta a:hover { color: var(--color-blue-700); }
  .bok-karta :global(.icon) { color: var(--color-blue-700); flex: none; }
  .bok-zdroj { display: flex !important; justify-content: flex-start !important; gap: 10px !important; font-weight: 500; }

  .dalsie { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .dalsi { display: flex; flex-direction: column; gap: 8px; height: 100%; padding: 24px 26px; color: var(--color-ink); transition: transform 250ms var(--ease-soft); }
  .dalsi:hover { color: var(--color-ink); transform: translateY(-3px); }
  .dalsi-min { font-size: 12.5px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--color-blue-700); }
  .dalsi-n { font-family: var(--font-display); font-weight: 700; font-size: 20px; line-height: 1.2; letter-spacing: -0.01em; }
  .dalsi-p { font-size: 14.5px; color: var(--color-ink-soft); }
  @media (max-width: 1000px) { .clanok-mriezka { grid-template-columns: minmax(0, 1fr); } .bok { position: static; } .dalsie { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 760px) { .clanok { padding: 26px 20px 30px; } .clanok p { font-size: 16.5px; } }
</style>
