---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Ikona from '../../components/Ikona.astro';
import { kategorie, cestaKategorie, skloňujRady } from '../../lib/katalog';
import { piktogram, fotka } from '../../lib/obrazky';

const potrubia = (await kategorie()).filter((k) => k.typ === 'potrubie');
const rady = (await getCollection('rady')).map((r) => r.data);
const rodina = fotka('rodina-potrubi.jpg')!;
---
<Base title="Predizolované potrubia Microflex" description="Päť potrubných systémov Microflex podľa média: vykurovanie, teplá a studená voda, vykurovanie a sanita v jednom plášti, studená a chladená voda, tepelné čerpadlá." aktivna="potrubia" drobceky={[{ text: 'Potrubia' }]}>
  <section class="wrap head">
    <div>
      <h1>Predizolované potrubia Microflex</h1>
      <p class="lead">Ohybné potrubie v jednom kuse z kotúča. Vyberte podľa toho, čo ním chcete viesť: teplo, pitnú vodu, chlad alebo prepojenie tepelného čerpadla.</p>
    </div>
    <Image src={rodina} alt="Rodina potrubí Microflex: UNO, DUO, QUADRO a COOL vedľa seba" widths={[600, 900, 1216]} sizes="(max-width: 760px) 100vw, 45vw" class="rodina" />
  </section>
  <section class="wrap section" style="padding-top: 24px">
    <div class="list">
      {potrubia.map((k) => { const p = piktogram(k.piktogram); const r = rady.filter((x) => x.kategoria === k.id); return (
        <a class="row" href={cestaKategorie(k)}>
          {p && <Image src={p} alt="" width={224} height={168} class="pikto" />}
          <div class="txt">
            <h2>{k.nazov}</h2>
            <p class="muted">{k.popis}</p>
            <p class="rady">{r.map((x) => x.nazov).join(' · ').replace(/ · /g, ', ')}</p>
          </div>
          <span class="go">{skloňujRady(r.length)} <Ikona nazov="chevron-right" velkost={18} /></span>
        </a>
      ); })}
    </div>
  </section>
</Base>

<style>
  .head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px 48px; align-items: center; padding-block: 8px 16px; }
  .head .lead { margin-top: 16px; }
  .head :global(.rodina) { width: 100%; height: auto; border-radius: var(--radius-l); }
  .list { display: flex; flex-direction: column; }
  .row { display: grid; grid-template-columns: 140px minmax(0, 1fr) auto; gap: 24px; align-items: center; padding: 24px 0; border-top: var(--line); color: var(--color-ink); transition: background-color 150ms var(--ease-soft); }
  .row:last-child { border-bottom: var(--line); }
  .row:hover { background: var(--color-blue-50); color: var(--color-ink); }
  .row :global(.pikto) { width: 140px; height: 105px; object-fit: contain; }
  .row h2 { font-size: 22px; }
  .txt { display: flex; flex-direction: column; gap: 6px; }
  .rady { font-size: 14px; color: var(--color-ink-soft); }
  .go { display: inline-flex; align-items: center; gap: 6px; color: var(--color-blue-700); font-weight: 500; white-space: nowrap; }
  @media (max-width: 760px) {
    .head { grid-template-columns: 1fr; }
    .row { grid-template-columns: 1fr; gap: 12px; }
    .row :global(.pikto) { width: 112px; height: 84px; }
  }
</style>
