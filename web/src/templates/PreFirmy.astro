---
/**
 * Pre firmy: čo dostanú projektanti, montážne firmy a veľkoobchod, dôkaz z vlastnej dodávky (sieť pre
 * 31 budov s kótou na fotke), istota výrobcu, podklady a dopyt na projekt.
 * Dopyt odosiela PHP skript na hostingu (web/public/api/dopyt.php) e-mailom na FIRMA.emailDopyt; skript stránky
 * ho pošle cez fetch a ukáže potvrdenie priamo vo formulári. Keď odoslanie zlyhá, ponúkne rovnaký dopyt
 * ako vyplnený e-mail (mailto). Bez JavaScriptu formulár odošle prehliadač a skript ho vráti na kotvu
 * #dopyt-odoslany alebo #dopyt-chyba (zobrazí ich :target). Parameter ?rad= predvyplní potrubie (odkazy
 * zo stránok radov), ?zoznam= vloží zoznam materiálu zo sprievodcu výberom do poznámky.
 */
import Base from '../layouts/Base.astro';
import Hlava from '../components/Hlava.astro';
import Zaver from '../components/Zaver.astro';
import Ikona from '../components/Ikona.astro';
import Scena from '../components/Scena.astro';
import Obraz from '../components/Obraz.astro';
import { FIRMA } from '../content/firma';
import { referencie } from '../content/referencie';
import { fotka, fotkaReferencie } from '../lib/obrazky';
import { sadzba } from '../lib/sadzba';
import { type Lang, t, route, staticAlternates } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = {
  sk: {
    title: 'Pre projektantov, montážne firmy a veľkoobchod', kratko: 'Pre firmy',
    desc: 'Podklady na projekt s potrubím Microflex, ponuka materiálu na celú trasu a dopyt na projekt. Výkresy DWG a DXF, katalóg, vyhlásenia o zhode.',
    lead: 'Podklady na projekt, materiál na celú trasu od potrubia po prestupy stenou a ponuka s dostupnosťou. Pri väčších sieťach aj s technickou podporou výrobcu.',
    foto: 'Potrubie Microflex vstupuje cez stenu do budovy, pripojenie k zdroju tepla',
    pre: [
      { h: 'Projektanti', p: 'Výkresy DWG a DXF pre každý rad, tabuľky rozmerov a výkonu, tepelné a tlakové straty a vyhlásenia výrobcu na jednom mieste.', odkaz: 'Podklady na stiahnutie', href: 'stiahnut', foto: 'katalog-obalka.jpg', alt: 'Katalóg Microflex od výrobcu Watts' },
      { h: 'Montážne firmy', p: 'Materiál na celý výkop v jednej ponuke: potrubie, svorné spojky, koncové krytky, izolačné sady na spoje pod zemou a prestupy stenou.', odkaz: 'Spojky a príslušenstvo', href: 'spojky', foto: 'vykop-spojky.jpg', alt: 'Potrubie Microflex vo výkope s odbočkou a spojkami' },
      { h: 'Veľkoobchod', p: 'Obj. čísla výrobcu pri každej dimenzii a diele, kopírovateľné jedným klikom. Ponuku a dostupnosť pripravíme na dopyt.', odkaz: 'Všetky potrubia', href: 'potrubia', foto: 'povazska-2.jpg', alt: 'Kotúče potrubia Microflex pripravené na stavbe' },
    ],
    arealAlt: 'Potrubie Microflex vo výkope pred kancelárskym areálom',
    dokazH2: 'Sieť pre 31 budov sme dodali sami.', dokazP: 'Obytný súbor v Považskej Bystrici: 30 rodinných domov a bytový dom na jednej kotolni na pelety, so štyrmi revíznymi šachtami. Ponuku aj dodávku potrubia, pevných bodov, tesnení a príslušenstva sme pripravili s podporou Watts.', dokazOdkaz: 'Celá referencia', dokazVsetky: 'Všetky referencie',
    istotaH2: 'Istota výrobcu',
    dopytH2: 'Dopyt na projekt', dopytP: 'Čím viac o trase viete, tým presnejšia bude ponuka. Stačí aj orientačná dĺžka a médium.',
    meno: 'Meno a priezvisko', firma: 'Firma', email: 'E-mail', telefon: 'Telefón', miesto: 'Miesto stavby',
    medium: 'Čo potrubím povediete', media: ['Vykurovanie', 'Teplá a studená voda', 'Vykurovanie aj teplá voda', 'Studená alebo chladená voda', 'Tepelné čerpadlo', 'Neviem, poraďte'],
    potrubie: 'Potrubie a dĺžky', potrubieHint: 'napríklad DUO 125/2 × 32, asi 40 m', termin: 'Termín', terminHint: 'napríklad jar 2027',
    poznamka: 'Poznámka', poznamkaHint: 'Spojky, prestupy stenou, počet odbočiek, zdroj tepla…',
    povinne: 'povinné', odoslat: 'Odoslať dopyt', odosielam: 'Odosielam dopyt…',
    pozn: (e: string) => `Dopyt príde na ${e}. Môžete napísať aj priamo alebo zavolať.`,
    predmet: 'Dopyt Microflex', chyba: 'Vyplňte meno a e-mail, aby sme Vám mohli odpovedať.',
    chybaPolia: 'Skontrolujte označené polia.', pasca: 'Toto pole nevypĺňajte',
    uspechH: 'Dopyt sme prijali', uspechP: 'Ďakujeme. Ozveme sa Vám na e-mail alebo telefón, ktorý ste uviedli.', uspechTel: 'Ak sa ponáhľate, zavolajte na',
    zlyhanieH: 'Dopyt sa nepodarilo odoslať.', zlyhanieP: 'Skúste to o chvíľu znova alebo nám ho pošlite e-mailom či zavolajte.', mailto: 'Pripraviť e-mail s dopytom',
    postupH2: 'Ako dopyt prebieha', postup: [['Pošlete trasu', 'Médium, dĺžky, dimenzie alebo výkon a miesto stavby. Stačí aj náčrt trasy v prílohe e-mailu.'], ['Pripravíme ponuku', 'Potrubie, spojky a príslušenstvo na celú trasu s dostupnosťou.'], ['Objednáte', 'Objednávka podľa ponuky, menšie množstvá priamo v e-shope instalatershop.sk.']] as [string, string][],
    kontaktH3: 'Radšej telefonicky?',
  },
  cs: {
    title: 'Pro projektanty, montážní firmy a velkoobchod', kratko: 'Pro firmy',
    desc: 'Podklady pro projekt s potrubím Microflex, nabídka materiálu na celou trasu a poptávka na projekt. Výkresy DWG a DXF, katalog, prohlášení o shodě.',
    lead: 'Podklady pro projekt, materiál na celou trasu od potrubí po prostupy stěnou a nabídka s dostupností. U větších sítí i s technickou podporou výrobce.',
    foto: 'Potrubí Microflex vstupuje stěnou do budovy, připojení ke zdroji tepla',
    pre: [
      { h: 'Projektanti', p: 'Výkresy DWG a DXF pro každou řadu, tabulky rozměrů a výkonu, tepelné a tlakové ztráty a prohlášení výrobce na jednom místě.', odkaz: 'Podklady ke stažení', href: 'stiahnut', foto: 'katalog-obalka.jpg', alt: 'Katalog Microflex od výrobce Watts' },
      { h: 'Montážní firmy', p: 'Materiál na celý výkop v jedné nabídce: potrubí, svěrné spojky, koncové krytky, izolační sady na spoje pod zemí a prostupy stěnou.', odkaz: 'Spojky a příslušenství', href: 'spojky', foto: 'vykop-spojky.jpg', alt: 'Potrubí Microflex ve výkopu s odbočkou a spojkami' },
      { h: 'Velkoobchod', p: 'Obj. čísla výrobce u každé dimenze a dílu, kopírovatelná jedním klikem. Nabídku a dostupnost připravíme na poptávku.', odkaz: 'Všechna potrubí', href: 'potrubia', foto: 'povazska-2.jpg', alt: 'Kotouče potrubí Microflex připravené na stavbě' },
    ],
    arealAlt: 'Potrubí Microflex ve výkopu před kancelářským areálem',
    dokazH2: 'Síť pro 31 budov jsme dodali sami.', dokazP: 'Obytný soubor v Považské Bystrici: 30 rodinných domů a bytový dům na jedné kotelně na pelety, se čtyřmi revizními šachtami. Nabídku i dodávku potrubí, pevných bodů, těsnění a příslušenství jsme připravili s podporou Watts.', dokazOdkaz: 'Celá reference', dokazVsetky: 'Všechny reference',
    istotaH2: 'Jistota výrobce',
    dopytH2: 'Poptávka na projekt', dopytP: 'Čím víc o trase víte, tím přesnější bude nabídka. Stačí i orientační délka a médium.',
    meno: 'Jméno a příjmení', firma: 'Firma', email: 'E-mail', telefon: 'Telefon', miesto: 'Místo stavby',
    medium: 'Co potrubím povedete', media: ['Vytápění', 'Teplá a studená voda', 'Vytápění i teplá voda', 'Studená nebo chlazená voda', 'Tepelné čerpadlo', 'Nevím, poraďte'],
    potrubie: 'Potrubí a délky', potrubieHint: 'například DUO 125/2 × 32, asi 40 m', termin: 'Termín', terminHint: 'například jaro 2027',
    poznamka: 'Poznámka', poznamkaHint: 'Spojky, prostupy stěnou, počet odboček, zdroj tepla…',
    povinne: 'povinné', odoslat: 'Odeslat poptávku', odosielam: 'Odesílám poptávku…',
    pozn: (e: string) => `Poptávka přijde na ${e}. Můžete napsat i přímo nebo zavolat.`,
    predmet: 'Poptávka Microflex', chyba: 'Vyplňte jméno a e-mail, abychom Vám mohli odpovědět.',
    chybaPolia: 'Zkontrolujte označená pole.', pasca: 'Toto pole nevyplňujte',
    uspechH: 'Poptávku jsme přijali', uspechP: 'Děkujeme. Ozveme se Vám na e-mail nebo telefon, který jste uvedli.', uspechTel: 'Pokud spěcháte, zavolejte na',
    zlyhanieH: 'Poptávku se nepodařilo odeslat.', zlyhanieP: 'Zkuste to za chvíli znovu, nebo nám ji pošlete e-mailem či zavolejte.', mailto: 'Připravit e-mail s poptávkou',
    postupH2: 'Jak poptávka probíhá', postup: [['Pošlete trasu', 'Médium, délky, dimenze nebo výkon a místo stavby. Stačí i náčrt trasy v příloze e-mailu.'], ['Připravíme nabídku', 'Potrubí, spojky a příslušenství na celou trasu s dostupností.'], ['Objednáte', 'Objednávka podle nabídky, menší množství přímo v e-shopu instalatershop.sk.']] as [string, string][],
    kontaktH3: 'Raději telefonicky?',
  },
}[lang];
const ui = t(lang);
const obraz = fotka('montaz-budova.jpg');
// Fotka pri skupine: katalóg a výkop sú medzi fotkami webu, kotúče na stavbe z referencie v Považskej Bystrici.
const fotkaPre = (f: string) => fotka(f) ?? fotkaReferencie(f);
// Kancelársky areál s potrubím vo výkope pred budovou (obálka brožúry Watts Microflex 2026).
const areal = fotka('areal-vykop.jpg')!;
const povazska = referencie(lang).find((r) => r.id === 'povazska-bystrica')!;
const polia = { meno: tx.meno, firma: tx.firma, email: tx.email, telefon: tx.telefon, miesto: tx.miesto, medium: tx.medium, potrubie: tx.potrubie, termin: tx.termin, poznamka: tx.poznamka };
/** PHP skript na hostingu Websupport; dĺžky polí (maxlength) sú rovnaké ako POLIA v ňom. */
const DOPYT_URL = '/api/dopyt.php';
---
<Base lang={lang} alternates={staticAlternates('firmy')} title={tx.title} description={tx.desc} aktivna="firmy" drobceky={[{ text: tx.kratko }]} vizualneDrobceky={false}>
  <Hlava lang={lang} nadpis={tx.title} drobceky={[{ text: tx.kratko }]} lead={tx.lead} obraz={obraz} obrazAlt={tx.foto} druh="foto">
    <div class="hlava-akcie">
      <a class="btn btn-yellow btn-lg" href="#dopyt">{tx.dopytH2} <Ikona nazov="arrow-down" velkost={18} /></a>
      <a class="odkaz" href={route(lang, 'stiahnut')}>{tx.pre[0].odkaz} <Ikona nazov="arrow-right" velkost={16} /></a>
    </div>
  </Hlava>

  <div class="telo">
    {/* Skupiny zákazníkov (Juraj 22. 10. 2026, návrh C): jedna veľká fotka nesie náladu veľkej
        stavby, tri skupiny vedľa nej majú okrúhlu lupu ako vrstvy potrubia na domove. */}
    <section class="wrap pre" aria-label={tx.kratko}>
      <figure class="pre-velka"><Obraz src={areal} alt={tx.arealAlt} widths={[640, 960, 1245]} sizes="(max-width: 900px) 100vw, 56vw" /></figure>
      <ul class="pre-zoznam">
        {tx.pre.map((x) => { const f = fotkaPre(x.foto); return (
          <li>
            <span class="pre-lupa">{f && <Obraz src={f} alt={x.alt} width={96} height={96} densities={[1, 2]} />}</span>
            <div>
              <h2>{x.h}</h2>
              <p>{sadzba(x.p)}</p>
              <a class="odkaz" href={route(lang, x.href as 'stiahnut')}>{x.odkaz} <Ikona nazov="arrow-right" velkost={16} /></a>
            </div>
          </li>
        ); })}
      </ul>
    </section>

    {/* Dôkaz z vlastnej dodávky: kotolňa siete pre 31 budov s kótou výkonu, rovnaká scéna ako na domove. */}
    <section class="wrap dokaz" aria-labelledby="h-dokaz">
      {povazska.scena && <Scena class="dokaz-scena" obraz={fotkaReferencie(povazska.scena.fotka)!} alt={povazska.nazov} koty={povazska.scena.koty} label={ui.home.projektyKoty} widths={[640, 895]} sizes="(max-width: 900px) 100vw, 52vw" />}
      <div class="dokaz-text">
        <h2 id="h-dokaz">{tx.dokazH2}</h2>
        <p>{sadzba(tx.dokazP)}</p>
        <div class="dokaz-odkazy">
          <a class="odkaz" href={`${route(lang, 'referencie')}#povazska-bystrica`}>{tx.dokazOdkaz} <Ikona nazov="arrow-right" velkost={16} /></a>
          <a class="odkaz odkaz-tichy" href={route(lang, 'referencie')}>{tx.dokazVsetky}</a>
        </div>
        <div class="istota">
          <h3>{tx.istotaH2}</h3>
          <p>{sadzba(ui.home.istota)}</p>
        </div>
      </div>
    </section>

    <section class="wrap cast dopyt" id="dopyt" aria-labelledby="h-dopyt">
      <div class="dopyt-bok">
        <h2 id="h-dopyt">{tx.dopytH2}</h2>
        <p class="dopyt-p">{tx.dopytP}</p>
        <ol class="postup">
          {tx.postup.map(([h, p]) => <li><strong>{h}</strong><span>{sadzba(p)}</span></li>)}
        </ol>
        <div class="telefon">
          <h3>{tx.kontaktH3}</h3>
          <a href={FIRMA.telefonHref}><Ikona nazov="phone" velkost={20} /> {FIRMA.telefon}</a>
          <a href={`mailto:${FIRMA.emailDopyt}`}><Ikona nazov="mail" velkost={20} /> {FIRMA.emailDopyt}</a>
        </div>
      </div>

      <form class="harok formular" action={DOPYT_URL} method="post" data-astro-reload data-dopyt data-komu={FIRMA.emailDopyt} data-predmet={tx.predmet} data-chyba={tx.chyba} data-chyba-polia={tx.chybaPolia} data-odosielam={tx.odosielam}>
        <input type="hidden" name="jazyk" value={lang} />
        <div class="riadok">
          <label class="pole"><span>{tx.meno} <em>{tx.povinne}</em></span><input name="meno" autocomplete="name" maxlength="120" required /></label>
          <label class="pole"><span>{tx.firma}</span><input name="firma" autocomplete="organization" maxlength="160" /></label>
        </div>
        <div class="riadok">
          <label class="pole"><span>{tx.email} <em>{tx.povinne}</em></span><input name="email" type="email" autocomplete="email" maxlength="200" required /></label>
          <label class="pole"><span>{tx.telefon}</span><input name="telefon" type="tel" autocomplete="tel" maxlength="40" /></label>
        </div>
        <div class="riadok">
          <label class="pole"><span>{tx.miesto}</span><input name="miesto" autocomplete="address-level2" maxlength="160" /></label>
          <label class="pole"><span>{tx.termin}</span><input name="termin" placeholder={tx.terminHint} maxlength="80" /></label>
        </div>
        <fieldset class="pole">
          <legend>{tx.medium}</legend>
          <div class="volby">{tx.media.map((m, i) => <label class="volba"><input type="radio" name="medium" value={m} checked={i === 0} /><span>{m}</span></label>)}</div>
        </fieldset>
        <label class="pole"><span>{tx.potrubie}</span><input name="potrubie" placeholder={tx.potrubieHint} maxlength="400" data-rad /></label>
        <label class="pole"><span>{tx.poznamka}</span><textarea name="poznamka" rows="4" maxlength="8000" placeholder={tx.poznamkaHint}></textarea></label>
        {/* Pasca na roboty: človek pole nevidí a klávesnicou sa naň nedostane, robot ho vyplní a skript dopyt zahodí. */}
        <div class="pasca" aria-hidden="true"><label>{tx.pasca} <input name="web" tabindex="-1" autocomplete="off" /></label></div>
        <p class="chyba" role="alert" data-chyba-text hidden></p>
        <button type="submit" class="btn btn-yellow" data-odoslat><span data-popis>{tx.odoslat}</span> <Ikona nazov="arrow-right" velkost={18} /></button>
        <p class="formular-pozn">{tx.pozn(FIRMA.emailDopyt)}</p>
        <div class="dopyt-zlyhanie" id="dopyt-chyba" role="alert" tabindex="-1" data-zlyhanie>
          <p><strong>{tx.zlyhanieH}</strong> {tx.zlyhanieP}</p>
          <div class="dopyt-zlyhanie-akcie">
            <a class="btn btn-secondary" href={`mailto:${FIRMA.emailDopyt}`} data-mailto><Ikona nazov="mail" velkost={18} /> {tx.mailto}</a>
            <a class="dopyt-tel" href={FIRMA.telefonHref}><Ikona nazov="phone" velkost={18} /> {FIRMA.telefon}</a>
          </div>
        </div>
        <div class="dopyt-uspech" id="dopyt-odoslany" data-uspech>
          <span class="dopyt-uspech-znak"><Ikona nazov="check" velkost={28} /></span>
          <h3 tabindex="-1">{tx.uspechH}</h3>
          <p>{tx.uspechP}</p>
          <p>{tx.uspechTel} <a class="dopyt-tel" href={FIRMA.telefonHref}>{FIRMA.telefon}</a>.</p>
        </div>
        <script type="application/json" data-polia set:html={JSON.stringify(polia)} />
      </form>
    </section>
  </div>
  <Zaver lang={lang} />
</Base>

<style>
  /* Skupiny zákazníkov: veľká fotka vľavo cez okraj obrazovky, vpravo tri skupiny s lupou. */
  .pre { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 40px 56px; align-items: center; }
  .pre-velka { margin: 0 0 0 calc(-1 * var(--bleed)); }
  .pre-velka :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 5 / 4; object-fit: cover; object-position: 40% 50%; border-radius: 0 var(--radius-xl) var(--radius-xl) 0; box-shadow: var(--elev-4); }
  .pre-zoznam { display: grid; gap: 32px; }
  .pre-zoznam li { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 24px; align-items: start; }
  .pre-zoznam h2 { font-size: 22px; letter-spacing: -0.015em; }
  .pre-zoznam p { margin-top: 8px; color: var(--color-ink-soft); font-size: 16px; line-height: 1.55; }
  .pre-zoznam .odkaz { margin-top: 8px; }
  /* Lupa: prstenec vo farbách vrstiev potrubia (jadro, pena, plášť) a odlesk skla. */
  .pre-lupa { --ring: var(--color-blue-700); position: relative; display: block; width: 96px; height: 96px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 5px #fff, 0 0 0 7px var(--ring), var(--elev-2); }
  .pre-zoznam li:nth-child(1) .pre-lupa { --ring: #e0b400; }
  .pre-zoznam li:nth-child(2) .pre-lupa { --ring: #8e97a3; }
  .pre-lupa :global(img) { display: block; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
  .pre-lupa::after { content: ""; position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(70% 55% at 30% 18%, rgb(255 255 255 / 0.35), rgb(255 255 255 / 0) 62%); box-shadow: inset 0 -10px 20px rgb(11 27 51 / 0.25); pointer-events: none; }

  /* Dôkaz z vlastnej dodávky: scéna s kótou vľavo cez okraj obrazovky, text vpravo. */
  .dokaz { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 32px 56px; align-items: center; }
  .dokaz :global(.dokaz-scena) { margin-left: calc(-1 * var(--bleed)); }
  .dokaz :global(.dokaz-scena .scena-img) { border-radius: 0 var(--radius-xl) var(--radius-xl) 0; box-shadow: var(--elev-4); }
  .dokaz-text h2 { font-size: clamp(28px, 1.6vw + 17px, 40px); letter-spacing: -0.02em; line-height: 1.1; }
  .dokaz-text > p { margin-top: 16px; font-size: 17px; line-height: 1.6; max-width: 32em; }
  .dokaz-odkazy { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 20px; }
  .odkaz-tichy { color: var(--color-ink-soft); }
  .istota { margin-top: 32px; padding: 20px 24px; border-radius: var(--radius-xl); background: var(--sklo-1); }
  .istota h3 { font-size: 16px; }
  .istota p { margin-top: 8px; font-size: 15px; line-height: 1.6; color: var(--color-ink-soft); }

  .dopyt { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 32px 56px; align-items: start; }
  .dopyt h2 { font-size: clamp(28px, 1.6vw + 17px, 40px); letter-spacing: -0.02em; }
  .dopyt-p { margin-top: 16px; color: var(--color-ink-soft); max-width: 30em; }
  .postup { counter-reset: krok; margin-top: 28px; }
  .postup li { counter-increment: krok; position: relative; display: flex; flex-direction: column; gap: 2px; padding: 0 0 24px 56px; }
  .postup li::before { content: counter(krok); position: absolute; left: 0; top: -2px; width: 38px; height: 38px; border-radius: var(--radius-l); display: grid; place-items: center; background: #fff; box-shadow: var(--elev-1); font-family: var(--font-display); font-stretch: 112.5%; font-weight: 700; color: var(--color-blue-900); }
  .postup li:not(:last-child)::after { content: ""; position: absolute; left: 18px; top: 42px; bottom: 4px; width: 2px; background: rgb(10 42 94 / 0.12); }
  .postup strong { font-size: 17px; }
  .postup span { color: var(--color-ink-soft); font-size: 15px; }
  .telefon { margin-top: 12px; padding-top: 24px; border-top: 1px solid rgb(10 42 94 / 0.12); display: flex; flex-direction: column; gap: 8px; }
  .telefon h3 { font-size: 16px; }
  .telefon a { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; }

  .formular { display: flex; flex-direction: column; gap: 16px; padding: 32px; }
  .riadok { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .pole { display: flex; flex-direction: column; gap: 8px; border: 0; margin: 0; padding: 0; min-width: 0; }
  .pole > span, .pole legend { font-size: 14px; font-weight: 600; color: var(--color-ink); padding: 0; }
  .pole em { font-style: normal; font-weight: 400; font-size: 13px; color: var(--color-ink-soft); margin-left: 4px; }
  .pole input, .pole textarea { width: 100%; min-height: 46px; padding: 12px 16px; border: 1px solid rgb(10 42 94 / 0.18); border-radius: var(--radius-l); background: #f8fafd; font: inherit; font-size: 16px; color: var(--color-ink); transition: border-color 150ms var(--ease-soft), box-shadow 150ms var(--ease-soft), background-color 150ms var(--ease-soft); }
  .pole textarea { resize: vertical; min-height: 110px; }
  .pole input::placeholder, .pole textarea::placeholder { color: #8a93a2; }
  .pole input:focus, .pole textarea:focus { outline: none; background: #fff; border-color: var(--color-blue-700); box-shadow: 0 0 0 4px rgb(0 93 185 / 0.12); }
  .pole input[aria-invalid="true"], .pole textarea[aria-invalid="true"] { border-color: #c2410c; box-shadow: 0 0 0 4px rgb(194 65 12 / 0.12); }
  .volby { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .volba { position: relative; }
  .volba input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .volba span { display: inline-flex; align-items: center; height: 38px; padding: 0 16px; border-radius: var(--radius-m); border: 1px solid rgb(10 42 94 / 0.18); background: #f8fafd; font-size: 15px; font-weight: 500; transition: background-color 150ms var(--ease-soft), border-color 150ms var(--ease-soft), color 150ms var(--ease-soft); }
  .volba input:checked + span { background: var(--color-blue-900); border-color: var(--color-blue-900); color: #fff; }
  .volba input:focus-visible + span { box-shadow: 0 0 0 4px rgb(0 93 185 / 0.2); }
  .formular .btn { align-self: flex-start; margin-top: 4px; }
  .chyba { color: #c2410c; font-weight: 500; font-size: 15px; }
  .formular-pozn { font-size: 14px; color: var(--color-ink-soft); }
  /* Pasca na roboty mimo obrazovky (nie display: none, také pole roboty často vynechajú). */
  .pasca { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }

  /* Stavy odoslania: so skriptom triedy na formulári, bez neho kotva z presmerovania (:target). */
  .dopyt-zlyhanie, .dopyt-uspech { display: none; scroll-margin-top: 150px; }
  .formular.je-zlyhanie .dopyt-zlyhanie, .dopyt-zlyhanie:target { display: block; }
  .formular.je-odoslany > :not(.dopyt-uspech), .formular:has(.dopyt-uspech:target) > :not(.dopyt-uspech) { display: none; }
  .formular.je-odoslany .dopyt-uspech, .dopyt-uspech:target { display: grid; }
  .dopyt-zlyhanie { padding: 16px 20px; border-radius: var(--radius-l); background: rgb(194 65 12 / 0.07); outline: none; }
  .dopyt-zlyhanie p { font-size: 15px; line-height: 1.55; }
  .dopyt-zlyhanie strong { color: #c2410c; }
  .dopyt-zlyhanie-akcie { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 12px; }
  .dopyt-zlyhanie-akcie .btn { align-self: auto; margin-top: 0; }
  .dopyt-tel { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; white-space: nowrap; }
  /* Potvrdenie: zelená značka (--color-ok, DESIGN.md kap. 4) a krátky posun ako odpoveď na odoslanie. */
  .dopyt-uspech { grid-template-columns: 56px minmax(0, 1fr); gap: 4px 20px; align-content: start; padding: 8px 0; animation: dopyt-potvrdenie 220ms var(--ease-soft) both; }
  .dopyt-uspech-znak { grid-row: 1 / span 3; display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: var(--color-ok); color: #fff; box-shadow: var(--elev-2); }
  .dopyt-uspech h3 { align-self: center; font-size: 24px; letter-spacing: -0.015em; outline: none; }
  .dopyt-uspech p { color: var(--color-ink-soft); font-size: 16px; line-height: 1.55; }
  .dopyt-uspech .dopyt-tel { display: inline; color: var(--color-blue-700); }
  @keyframes dopyt-potvrdenie { from { opacity: 0; transform: translateY(8px); } }
  @media (max-width: 900px) { .pre { grid-template-columns: minmax(0, 1fr); } .pre-velka { margin-inline: calc(-1 * var(--gutter)); } .pre-velka :global(img) { border-radius: 0; aspect-ratio: 16 / 10; } }
  @media (max-width: 900px) { .dopyt, .dokaz { grid-template-columns: minmax(0, 1fr); } .dokaz :global(.dokaz-scena) { margin-inline: calc(-1 * var(--gutter)); } .dokaz :global(.dokaz-scena .scena-img) { border-radius: 0; } }
  @media (max-width: 760px) { .riadok { grid-template-columns: minmax(0, 1fr); } .formular { padding: 24px 16px; } .dopyt-zlyhanie, .dopyt-uspech { scroll-margin-top: 130px; } }
</style>

<script>
  function initDopyt() {
    const f = document.querySelector<HTMLFormElement>('[data-dopyt]');
    if (!f || f.dataset.init) return;
    f.dataset.init = '1';
    const polia = JSON.parse(f.querySelector('[data-polia]')?.textContent ?? '{}') as Record<string, string>;
    const rad = new URLSearchParams(location.search).get('rad');
    const radPole = f.querySelector<HTMLInputElement>('[data-rad]');
    if (rad && radPole && !radPole.value) radPole.value = rad;
    // Zoznam materiálu zo sprievodcu výberom príde ako ?zoznam= a vloží sa do poznámky.
    const zoznam = new URLSearchParams(location.search).get('zoznam');
    const poznamka = f.elements.namedItem('poznamka') as HTMLTextAreaElement | null;
    if (zoznam && poznamka && !poznamka.value) { poznamka.value = zoznam; poznamka.rows = Math.min(16, zoznam.split('\n').length + 1); }
    // Kontrolu polí robí skript (vlastné hlásenie); bez skriptu ostáva kontrola prehliadača.
    f.noValidate = true;
    const chyba = f.querySelector<HTMLElement>('[data-chyba-text]')!;
    const zlyhanie = f.querySelector<HTMLElement>('[data-zlyhanie]')!;
    const uspech = f.querySelector<HTMLElement>('[data-uspech]')!;
    const tlacidlo = f.querySelector<HTMLButtonElement>('[data-odoslat]')!;
    const popis = tlacidlo.querySelector<HTMLElement>('[data-popis]')!;
    const odoslat = popis.textContent ?? '';
    const pole = (meno: string) => {
      const x = f.elements.namedItem(meno);
      return x instanceof HTMLInputElement || x instanceof HTMLTextAreaElement ? x : null;
    };

    // Záloha, keď server dopyt neprijme: ten istý dopyt ako vyplnený e-mail v e-mailovom programe.
    f.querySelector<HTMLAnchorElement>('[data-mailto]')?.addEventListener('click', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const riadky = Object.entries(polia).map(([k, nazov]) => [nazov, String(d.get(k) ?? '').trim()]).filter(([, v]) => v).map(([n, v]) => `${n}: ${v}`);
      const predmet = `${f.dataset.predmet} – ${String(d.get('firma') || d.get('meno')).trim()}`;
      location.href = `mailto:${f.dataset.komu}?subject=${encodeURIComponent(predmet)}&body=${encodeURIComponent(riadky.join('\n'))}`;
    });

    const oznac = (zle: string[], text: string) => {
      ['meno', 'email', ...zle].forEach((m) => pole(m)?.setAttribute('aria-invalid', String(zle.includes(m))));
      chyba.textContent = text;
      chyba.hidden = false;
      pole(zle[0])?.focus();
    };

    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (f.dataset.odosiela) return;
      const zle = ['meno', 'email'].filter((m) => { const x = pole(m); return !x || !x.value.trim() || !x.checkValidity(); });
      if (zle.length) { oznac(zle, f.dataset.chyba ?? ''); return; }
      ['meno', 'email'].forEach((m) => pole(m)?.setAttribute('aria-invalid', 'false'));
      chyba.hidden = true;
      f.classList.remove('je-zlyhanie');
      f.dataset.odosiela = '1';
      tlacidlo.disabled = true;
      popis.textContent = f.dataset.odosielam ?? odoslat;
      try {
        const odpoved = await fetch(f.action, { method: 'POST', body: new FormData(f), headers: { Accept: 'application/json' } });
        const data = await odpoved.json().catch(() => null) as { ok?: boolean; polia?: string[] } | null;
        if (odpoved.ok && data?.ok) {
          // Polia zmiznú a formulár sa skráti: potvrdenie môže ostať nad oknom (telefón), preto posun k nemu.
          f.classList.add('je-odoslany');
          uspech.scrollIntoView({ block: 'nearest' });
          uspech.querySelector<HTMLElement>('h3')?.focus({ preventScroll: true });
          return;
        }
        if (odpoved.status === 422 && data?.polia?.length) { oznac(data.polia, f.dataset.chybaPolia ?? ''); return; }
        throw new Error(`dopyt: ${odpoved.status}`);
      } catch {
        f.classList.add('je-zlyhanie');
        zlyhanie.scrollIntoView({ block: 'nearest' });
        zlyhanie.focus({ preventScroll: true });
      } finally {
        delete f.dataset.odosiela;
        tlacidlo.disabled = false;
        popis.textContent = odoslat;
      }
    });
  }
  initDopyt();
  document.addEventListener('astro:page-load', initDopyt);
</script>
