---
/**
 * Rodina na ťuknutie (Juraj 28. 10. 2026): vrstva nad renderom rodiny systémov. Systém pod myšou, prstom
 * alebo v ohnisku klávesnice sa zvýrazní (ostatné stmavnú) a pri ňom sa objaví štítok s tým hlavným a odkazom
 * na rad. Masky systémov sú z toho istého záberu (render --maska, data/novinky_web.py rodina), malá mapa
 * indexov určuje, nad ktorým systémom je ukazovateľ. Rodič musí mať position: relative a rozmer obrazu.
 */
import type { SystemyData } from '../lib/obrazky';

export interface SystemRodiny { nazov: string; fakty: string[]; odkaz: string }
interface Props { data: SystemyData; obraz: string; systemy: SystemRodiny[]; label: string; pozriet: string }
const { data, obraz, systemy, label, pozriet } = Astro.props;
---
<div class="rv" data-rodina-vyber data-cesta={data.cesta} data-krok={data.krok}>
  <img class="rv-svetlo" src={obraz} alt="" aria-hidden="true" loading="lazy" decoding="async" />
  {data.systemy.map((s, k) => (
    <div class="rv-stitok" data-k={k} style={`--x: ${s.bod[0]}%; --y: ${s.bod[1]}%`} hidden>
      <span class="rv-bod" aria-hidden="true"></span>
      <div class="rv-karta">
        <strong>{systemy[k]?.nazov}</strong>
        {systemy[k]?.fakty.map((f) => <span>{f}</span>)}
        <a href={systemy[k]?.odkaz}>{pozriet}</a>
      </div>
    </div>
  ))}
  <ul class="rv-tlacidla" aria-label={label}>
    {data.systemy.map((_, k) => <li><button type="button" data-k={k}>{systemy[k]?.nazov}</button></li>)}
  </ul>
</div>

<style>
  .rv { position: absolute; inset: 0; z-index: 3; }
  .rv-svetlo { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; pointer-events: none; transition: opacity 260ms var(--ease-soft);
    -webkit-mask-size: 100% 100%; mask-size: 100% 100%; }
  .rv.je-vyber .rv-svetlo { opacity: 1; }
  /* Ostatné systémy stmavnú: filter na samotnom renderi rodiča (obraz pod vrstvou). */
  :global(.rv-ztlm) { transition: filter 260ms var(--ease-soft); }
  :global(.rv-rodic.je-vyber .rv-ztlm) { filter: saturate(0.35) brightness(0.86) contrast(0.92); }
  .rv-stitok { position: absolute; left: var(--x); top: var(--y); width: 0; height: 0; z-index: 2; }
  .rv-bod { position: absolute; left: -7px; top: -7px; width: 14px; height: 14px; border-radius: 50%; background: #fff; box-shadow: inset 0 0 0 3px var(--color-blue-900), 0 0 0 4px rgb(255 255 255 / 0.5), 0 3px 10px rgb(4 16 40 / 0.4); }
  /* Štítok vedľa bodu (vpravo, pri systémoch v pravej časti vľavo), zvisle na strede bodu. */
  .rv-karta { position: absolute; top: 0; left: 26px; transform: translateY(-50%); display: grid; gap: 3px; padding: 12px 16px 14px; border-radius: var(--radius-l); white-space: nowrap;
    background: rgb(255 255 255 / 0.93); -webkit-backdrop-filter: blur(10px) saturate(1.4); backdrop-filter: blur(10px) saturate(1.4); box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.08), var(--elev-2);
    animation: rv-prichod 220ms var(--ease-soft) both; }
  .rv-karta::before { content: ""; position: absolute; left: -26px; top: 50%; width: 26px; height: 1.5px; background: var(--color-blue-900); }
  .rv-stitok.vlavo .rv-karta { left: auto; right: 26px; }
  .rv-stitok.vlavo .rv-karta::before { left: auto; right: -26px; }
  .rv-karta strong { font-family: var(--font-display); font-stretch: 112%; font-weight: 600; font-size: 20px; color: var(--color-blue-900); }
  .rv-karta span { font-size: 14px; line-height: 1.4; color: #3f4b5e; }
  .rv-karta a { margin-top: 6px; font-weight: 600; font-size: 15px; color: var(--color-blue-700); }
  @keyframes rv-prichod { from { opacity: 0; } to { opacity: 1; } }
  /* Tlačidlá pre klávesnicu a čítačky obrazovky: neviditeľné, kým nie sú v ohnisku. */
  .rv-tlacidla { position: absolute; left: 0; bottom: 0; margin: 0; padding: 0; list-style: none; }
  .rv-tlacidla button { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .rv-tlacidla button:focus-visible { position: fixed; z-index: 50; left: 50%; bottom: 24px; width: auto; height: auto; clip-path: none; transform: translateX(-50%);
    padding: 10px 16px; border-radius: 999px; background: var(--color-blue-900); color: #fff; font: inherit; font-weight: 600; outline: 3px solid var(--color-yellow-500); }
  @media (max-width: 760px) {
    .rv-karta { padding: 9px 12px 11px; white-space: normal; width: 180px; }
    .rv-karta strong { font-size: 16px; }
    .rv-karta span { font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rv-svetlo, :global(.rv-ztlm) { transition: none; }
    .rv-karta { animation: none; }
  }
</style>

<script>
  function initRodinaVyber() {
    document.querySelectorAll<HTMLElement>('[data-rodina-vyber]:not([data-on])').forEach((vrstva) => {
      vrstva.dataset.on = '1';
      const rodic = vrstva.parentElement!;
      rodic.classList.add('rv-rodic');
      // obraz rodiny pod vrstvou (prvý obrázok rodiča, ktorý nie je súčasťou vrstvy)
      [...rodic.querySelectorAll<HTMLImageElement>('img')].find((im) => !vrstva.contains(im))?.classList.add('rv-ztlm');
      const svetlo = vrstva.querySelector<HTMLImageElement>('.rv-svetlo')!;
      const stitky = [...vrstva.querySelectorAll<HTMLElement>('.rv-stitok')];
      const tlacidla = [...vrstva.querySelectorAll<HTMLButtonElement>('.rv-tlacidla button')];
      // Štítok ide doprava od bodu, ak sa tam zmestí do okna (obraz rodiny na domove siaha po pravý okraj), inak doľava.
      const smer = (s: HTMLElement) => {
        s.classList.remove('vlavo');
        const karta = s.querySelector<HTMLElement>('.rv-karta')!.getBoundingClientRect();
        s.classList.toggle('vlavo', karta.right > document.documentElement.clientWidth - 12);
      };
      const cesta = vrstva.dataset.cesta!;
      const krok = Number(vrstva.dataset.krok);
      let aktivny = -1, pevny = -1;
      const ukaz = (k: number) => {
        if (k === aktivny) return;
        aktivny = k;
        if (k >= 0) {
          const maska = `url(${cesta}maska-${k}.webp)`;
          svetlo.style.setProperty('-webkit-mask-image', maska);
          svetlo.style.setProperty('mask-image', maska);
        }
        vrstva.classList.toggle('je-vyber', k >= 0);
        rodic.classList.toggle('je-vyber', k >= 0);
        stitky.forEach((s, i) => { s.hidden = i !== k; });
        if (k >= 0) smer(stitky[k]);
      };
      // Mapa indexov: odtieň sivej (k + 1) · krok, 0 = pozadie. Masky sa stiahnu pri prvom priblížení.
      const platno = document.createElement('canvas');
      let data: Uint8ClampedArray | undefined;
      const pripravMapu = () => {
        if (data !== undefined || platno.dataset.nacitava) return;
        platno.dataset.nacitava = '1';
        const mapa = new Image();
        mapa.onload = () => {
          platno.width = mapa.naturalWidth; platno.height = mapa.naturalHeight;
          const ctx = platno.getContext('2d', { willReadFrequently: true })!;
          ctx.drawImage(mapa, 0, 0);
          data = ctx.getImageData(0, 0, platno.width, platno.height).data;
        };
        mapa.src = `${cesta}mapa.png`;
        stitky.forEach((_, k) => { new Image().src = `${cesta}maska-${k}.webp`; });
      };
      const system = (e: MouseEvent) => {
        if (!data) return -1;
        const r = rodic.getBoundingClientRect();
        const x = Math.floor(((e.clientX - r.left) / r.width) * platno.width);
        const y = Math.floor(((e.clientY - r.top) / r.height) * platno.height);
        if (x < 0 || y < 0 || x >= platno.width || y >= platno.height) return -1;
        const v = data[(y * platno.width + x) * 4];
        return v ? Math.round(v / krok) - 1 : -1;
      };
      rodic.addEventListener('pointerenter', pripravMapu);
      rodic.addEventListener('touchstart', pripravMapu, { passive: true });
      rodic.addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse') { const k = system(e); ukaz(k >= 0 ? k : pevny); rodic.style.cursor = k >= 0 ? 'pointer' : ''; } });
      rodic.addEventListener('pointerleave', () => ukaz(pevny));
      rodic.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a, button')) return;
        pripravMapu();
        const k = system(e);
        pevny = k;
        ukaz(k);
      });
      tlacidla.forEach((b, i) => {
        b.addEventListener('focus', () => { pripravMapu(); ukaz(i); });
        b.addEventListener('blur', () => ukaz(pevny));
      });
    });
  }
  initRodinaVyber();
  document.addEventListener('astro:page-load', initRodinaVyber);
</script>
