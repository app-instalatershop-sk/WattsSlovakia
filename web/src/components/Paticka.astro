---
import WattsLogo from './WattsLogo.astro';
import { kategorie, cestaKategorie, kKratky } from '../lib/katalog';
import { type Lang, t, route } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const kats = await kategorie();
---
<footer class="ftr">
  <div class="ftr-ribs ribs-x" aria-hidden="true"></div>
  <div class="wrap ftr-in">
    <div>
      <a class="brand" href={route(lang, 'domov')}><span class="brand-name">Microflex</span><span class="brand-sub">{ui.site.sub}</span></a>
      <p class="muted" style="max-width:32em">{ui.footer.popis} <a href="https://www.instalatershop.sk/">instalatershop.sk</a>.</p>
      <div class="vyrobca">
        <WattsLogo height={20} farba="biela" />
        <span class="muted">{ui.footer.vyrobcaText}</span>
      </div>
    </div>
    <div>
      <h3>{ui.footer.potrubia}</h3>
      <ul>{kats.map((k) => <li><a href={cestaKategorie(k, lang)}>{kKratky(k, lang)}</a></li>)}</ul>
    </div>
    <div>
      <h3>{ui.footer.podklady}</h3>
      <ul>
        <li><a href={route(lang, 'stiahnut')}>{ui.footer.katalog}</a></li>
        <li><a href={route(lang, 'stiahnut')}>{ui.footer.technicke}</a></li>
        <li><a href={route(lang, 'stiahnut')}>{ui.footer.bim}</a></li>
        <li><a href={route(lang, 'stiahnut')}>{ui.footer.vyhlasenia}</a></li>
        <li><a href={route(lang, 'poradna')}>{ui.footer.poradna}</a></li>
      </ul>
    </div>
    <div>
      <h3>{ui.footer.prevadzkovatel}</h3>
      <ul>
        <li>{ui.footer.firma}</li>
        <li class="muted">{ui.footer.ico}</li>
        <li><a href={route(lang, 'kontakt')}>{ui.footer.kontakt}</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap ftr-bottom">
    <span>{ui.footer.znamka}</span>
    <span>© {new Date().getFullYear()} {ui.site.name}</span>
  </div>
</footer>

<style>
  .ftr { background: var(--color-blue-900); color: #fff; margin-top: 96px; }
  .ftr-ribs { height: 14px; }
  .ftr-in { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.2fr; gap: 32px; padding-block: 48px; }
  .ftr h3 { color: #fff; font-size: 15px; font-family: var(--font-text); font-stretch: 100%; font-weight: 600; margin-bottom: 12px; letter-spacing: 0; }
  .ftr a { color: #fff; }
  .ftr a:hover { color: var(--color-yellow-500); }
  .ftr li { padding: 4px 0; font-size: 15px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; color: #fff; margin-bottom: 12px; }
  .brand-name { font-family: var(--font-display); font-stretch: 112.5%; font-weight: 700; font-size: 22px; letter-spacing: -0.01em; line-height: 1; }
  .brand-sub { font-size: 13px; color: var(--color-on-dark-muted); border-left: 1px solid rgb(255 255 255 / 0.3); padding-left: 12px; line-height: 1; }
  .ftr .muted { color: var(--color-on-dark-muted); }
  .vyrobca { display: flex; align-items: center; gap: 16px; margin-top: 24px; padding-top: 20px; border-top: 1px solid rgb(255 255 255 / 0.18); font-size: 14px; max-width: 32em; }
  .ftr-bottom { border-top: 1px solid rgb(255 255 255 / 0.18); padding-block: 16px; font-size: 13px; color: var(--color-on-dark-muted); display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; }
  @media (max-width: 1100px) { .ftr-in { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 760px) { .ftr-in { grid-template-columns: 1fr; } }
</style>
