---
/**
 * Fotka zo stavby s kótami: číslo stojí priamo pri tom, čo opisuje (rúra vo výkope, kotolňa),
 * rovnako ako kóty na renderi v hero domova. Súradnice bodu sú v percentách obrázka, preto sa
 * obrázok neorezáva (výrez je pripravený v súbore) a kóty sedia pri každej šírke. Kóty: Koty.astro.
 */
import Obraz from './Obraz.astro';
import type { ImageMetadata } from 'astro';
import Koty from './Koty.astro';
import type { Kota } from '../lib/koty';

interface Props {
  obraz: ImageMetadata; alt: string; koty?: Kota[];
  widths?: number[]; sizes?: string; class?: string; label?: string;
}
const { obraz, alt, koty = [], widths = [640, 960, 1200], sizes = '(max-width: 900px) 100vw, 66vw', class: trieda, label } = Astro.props;
---
<figure class:list={['scena', trieda]}>
  <Obraz src={obraz} alt={alt} widths={widths.filter((w) => w <= obraz.width)} sizes={sizes} class="scena-img" />
  <Koty koty={koty} label={label} />
</figure>

<style>
  .scena { position: relative; margin: 0; container-type: inline-size; isolation: isolate; }
  .scena :global(.scena-img) { display: block; width: 100%; height: auto; }
</style>
