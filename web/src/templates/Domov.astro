  .proj-odkaz, .proj-vsetky { margin-top: 18px; font-weight: 500; border-bottom: 1px solid rgb(255 255 255 / 0.5); padding-bottom: 2px; }
  .proj-vsetky-obal { position: relative; margin-top: 32px; }

  /* ---------- Projektová podpora a miesto pre konfigurátor ---------- */
  .podpora { position: relative; margin-top: 136px; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; row-gap: 48px; align-items: start; }
  .podpora-hlava { grid-column: 1 / 8; grid-row: 1; }
