---
/**
 * Stránka radu: hlava s renderom a kľúčovými číslami, plávajúca navigácia po častiach, tabuľka
 * variantov, stavba potrubia pod lupou s parametrami a montážou z katalógu, podklady na stiahnutie,
 * referencie a spojky s príslušenstvom k radu. Na konci záver s kúpou a kontaktom.
 */
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hlava from '../components/Hlava.astro';
import Zaver from '../components/Zaver.astro';
import Ikona from '../components/Ikona.astro';
import TabulkaVariantov from '../components/TabulkaVariantov.astro';
import Subory from '../components/Subory.astro';
import KartaReferencie from '../components/KartaReferencie.astro';
import CastiStranky from '../components/CastiStranky.astro';
import Kopirovanie from '../components/Kopirovanie.astro';
import { kategorie, radyKategorie, variantyRadu, cestaKategorie, cestaRadu, cestaProduktu, alternatyRadu, kKratky, rNazov, rKratky, rMedium, rOznacenie, pNazov, cislo, rozsah, rozsahRur, tlakText, kotvaKodu, type Kategoria, type Rad } from '../lib/katalog';
import { piktogram, fotkaRadu, detail } from '../lib/obrazky';
import { kotyRenderu } from '../lib/koty';
import { sadzba } from '../lib/sadzba';
import { obsahRadu } from '../content/rady';
import { referencie } from '../content/referencie';
import { stranky } from '../content/stranky';
import { type Lang, t, route, ESHOP_SEARCH, KATALOG_PDF } from '../i18n/ui';

interface Props { lang: Lang; k: Kategoria; r: Rad }
const { lang, k, r } = Astro.props;
const ui = t(lang);
const tx = stranky(lang).rad;
const varianty = await variantyRadu(r.id);
const obsah = obsahRadu(r.slug, lang);
const nazov = rNazov(r, lang);
const model = nazov.split(',')[0].trim();
const kratky = rKratky(r, lang);
const pikto = piktogram(r.piktogram);
const foto = fotkaRadu(r.fotka);
const fotoOk = foto && foto.width >= 500;

// Rady s rovnakým renderom v kategórii (UNO a UNO PRIMO): PRIMO preberá príslušenstvo základného radu.
const radyKat = await radyKategorie(k.id);
const zaklad = radyKat.find((x) => x.id !== r.id && x.piktogram === r.piktogram && x.suvisiace.length > 0 && !/primo/.test(x.slug));
const sestry = radyKat.filter((x) => x.id !== r.id && x.piktogram === r.piktogram);
const primoZaklad = /primo/.test(r.slug) && zaklad && varianty.every((v) => typeof v.zdroj_strana === 'number') ? rNazov(zaklad, lang).split(',')[0].trim() : undefined;

const polomery = varianty.map((v) => v.polomer_ohybu_m).filter((x): x is number => typeof x === 'number');
const zosilnene = varianty.filter((v) => v.izolacia === 'zosilnena').length;
const ruraRozsah = rozsahRur(varianty, lang);
const plastRozsah = varianty.some((v) => v.plast_mm) ? rozsah(varianty.map((v) => v.plast_mm), 'mm', lang) : '';
const ruryText = r.pocet_rur === 1 ? ui.rad.jednaRura : r.pocet_rur === 2 ? ui.rad.dveRury : r.pocet_rur ? ui.rad.rury(r.pocet_rur) : '';
const fakty: [string, string][] = [
  ...(rMedium(r, lang) ? [[ui.rad.medium, rMedium(r, lang)!] as [string, string]] : []),
  ...(tlakText(r) ? [[ui.rad.tlak, tlakText(r)] as [string, string]] : []),
  ...(ruraRozsah ? [[ui.rad.rura, `${r.pocet_rur && r.pocet_rur > 1 && varianty.some((v) => v.rura) ? `${r.pocet_rur} × ` : ''}${ruraRozsah}`] as [string, string]] : []),
  ...(plastRozsah ? [[ui.rad.plast, plastRozsah] as [string, string]] : []),
  ...(polomery.length ? [[ui.rad.polomer, `${ui.common.od} ${cislo(Math.min(...polomery), 2)} m`] as [string, string]] : []),
];
// Kóty na renderi v hlave: plášť, nosná rúra s tlakom a polomer ohybu stoja pri tom, čo opisujú.
// Keď sú na obraze aspoň dve, zoznam faktov pod nadpisom sa nezobrazí (čísla by boli dvakrát).
const kotyHlavy = kotyRenderu(r.piktogram, {
  plast: plastRozsah ? [`Ø ${plastRozsah}`, ui.home.popisy.plast] : undefined,
  rura: ruraRozsah ? [`${r.pocet_rur && r.pocet_rur > 1 && varianty.some((v) => v.rura) ? `${r.pocet_rur} × ` : ''}${ruraRozsah}`, [ui.rad.rura.toLowerCase(), tlakText(r)].filter(Boolean).join(', ')] : undefined,
  ohyb: polomery.length ? [`${ui.common.od} ${cislo(Math.min(...polomery), 2)} m`, ui.home.popisy.polomer] : undefined,
});
const faktyHlavy = kotyHlavy.length >= 2 ? [] : fakty;

// Stavba pod lupou: kľúčové číslo plášťa berie rozsah z tabuľky, nosnej rúry aj priemery.
const vrstvy = obsah ? (['rura', 'pena', 'plast'] as const).map((id) => {
  const v = obsah.vrstvy[id];
  const kluc = id === 'plast' ? (plastRozsah ? `Ø ${plastRozsah}` : 'HDPE') : id === 'rura' && ruraRozsah && !/^\d/.test(v.kluc ?? '') ? `Ø ${ruraRozsah}, ${v.kluc?.replace(/^PE-Xa, |^PE 100, /, '')}` : v.kluc ?? '';
  return { id, nazov: tx.vrstvy[id], kluc, text: v.text, img: detail(`vrstva-${id}.jpg`)! };
}) : [];

// Príslušenstvo odporúčané výrobcom, podľa skupín (spojky, krytky, prestupy).
const produkty = (await getCollection('produkty')).map((p) => p.data);
const skupiny = (await getCollection('rady')).map((x) => x.data);
const vsetkyKat = await kategorie();
const idsSuvisiace = r.suvisiace.length ? r.suvisiace : zaklad?.suvisiace ?? [];
const suvisiace = idsSuvisiace.map((id) => produkty.find((p) => p.id === id)).filter((p): p is NonNullable<typeof p> => Boolean(p));
const skupinyRel = [...new Set(suvisiace.map((p) => p.skupina))].map((sid) => ({
  s: skupiny.find((x) => x.id === sid)!,
  ps: suvisiace.filter((p) => p.skupina === sid),
})).filter((g) => g.s);
const katProduktu = (id: string) => vsetkyKat.find((x) => x.id === id)!;
const dielyUrl = Object.fromEntries(produkty.map((p) => [p.id, cestaProduktu(p, katProduktu(p.kategoria), lang)]));
// Obj. číslo dielu → jeho riadok v tabuľke dielu (príslušenstvo pod variantom vedie priamo naň).
const kodyDielov = Object.fromEntries(produkty.flatMap((p) => p.tabulky.flatMap((t) => t.riadky.map((x) => x[0]))
  .filter(Boolean).map((kod) => [`${p.id}|${kod}`, `${dielyUrl[p.id]}#${kotvaKodu(kod)}`])));

const refs = referencie(lang).filter((x) => x.rad === r.slug || (x.rad === null && x.kategoria === k.id)).sort((a, b) => Number(b.rad === r.slug) - Number(a.rad === r.slug)).slice(0, 2);

const casti = [
  { id: 'varianty', text: tx.navVarianty },
  ...(obsah ? [{ id: 'stavba', text: tx.navStavba }] : []),
  ...(r.subory.length ? [{ id: 'stiahnut', text: tx.navDl }] : []),
  ...(refs.length ? [{ id: 'referencie', text: tx.navRef }] : []),
  ...(skupinyRel.length ? [{ id: 'suvisiace', text: tx.navRel }] : []),
];

const eshop = ESHOP_SEARCH + encodeURIComponent(model);
// Popis pre vyhľadávače: čo rad je, jeho čísla a počet dimenzií (Base ho zarovná na 120 až 160 znakov).
const cs = lang === 'cs';
const faktyVeta = [tlakText(r) && `${ui.rad.tlak} ${tlakText(r)}`, ruraRozsah && `${cs ? 'nosná trubka' : 'nosná rúra'} ${ruraRozsah}`, plastRozsah && `plášť ${plastRozsah}`].filter(Boolean).join(', ');
const meta = [`${model}: ${kratky ?? obsah?.popis[0] ?? ''}`, faktyVeta && `${faktyVeta}.`, varianty.length && `${tx.pocetDim(varianty.length)} ${cs ? 's obj. čísly' : 's obj. číslami'}.`].filter(Boolean).join(' ');
const ldObraz = pikto ? (await getImage({ src: pikto, width: 800, format: 'webp' })).src : undefined;
const drobceky = [{ text: ui.nav.potrubia, href: route(lang, 'potrubia') }, { text: kKratky(k, lang), href: cestaKategorie(k, lang) }, { text: model }];
const productLd = [{
  '@context': 'https://schema.org', '@type': 'ProductGroup', name: nazov, alternateName: rOznacenie(r, lang), description: meta,
  brand: { '@type': 'Brand', name: 'Microflex' }, manufacturer: { '@type': 'Organization', name: 'Watts' },
  url: new URL(cestaRadu(k, r, lang), Astro.site).href, productGroupID: r.slug,
  ...(ldObraz ? { image: new URL(ldObraz, Astro.site).href } : {}),
  hasVariant: varianty.map((v) => ({ '@type': 'Product', sku: v.obj_cislo, mpn: v.obj_cislo, name: `${model} ${v.obj_cislo}` })),
}];
---
<Base lang={lang} alternates={alternatyRadu(k, r)} title={nazov} description={meta} aktivna="potrubia" drobceky={drobceky} vizualneDrobceky={false} jsonLd={productLd}>
  <Hlava lang={lang} nadpis={nazov} drobceky={drobceky} pred={[kKratky(k, lang), ruryText].filter(Boolean).join(', ')} lead={kratky ?? undefined} obraz={pikto} obrazAlt={ui.rad.fotoAlt(nazov)} obrazMax={640} prechod={`rad-${r.id}`} koty={kotyHlavy} kotyLabel={ui.home.popisy.label}>
    {faktyHlavy.length > 0 && <dl class="hlava-fakty">{faktyHlavy.map(([dt, dd]) => <div><dt>{dt}</dt><dd>{dd}</dd></div>)}</dl>}
    <div class="hlava-akcie">
      <a class="btn btn-yellow" href="#varianty">{tx.vybrat} <Ikona nazov="arrow-down" velkost={18} /></a>
      <a class="odkaz" href={eshop} target="_blank" rel="noopener">{tx.kupit} <Ikona nazov="external-link" velkost={16} /></a>
    </div>
    {sestry.length > 0 && (
      <p class="hlava-sestry">{tx.ajVo} {sestry.map((x, i) => <>{i > 0 && ', '}<a href={cestaRadu(k, x, lang)}>{rNazov(x, lang).split(',')[0].trim()}</a></>)}</p>
    )}
  </Hlava>

  <div class="telo">
    {casti.length > 2 && <CastiStranky casti={casti} label={tx.navLabel} />}

    <section class="wrap cast" id="varianty" aria-labelledby="h-var">
      <div class="s-hlava">
        <h2 id="h-var">{ui.rad.variantyH2}</h2>
        <p>{varianty.length ? <>{tx.pocetDim(varianty.length)}{zosilnene ? tx.zosilnenych(zosilnene) : ''}. {tx.variantyP}</> : tx.chybaju(model, obsah?.strana ?? null)}</p>
      </div>
      {varianty.length > 0 ? (
        <div class="harok"><TabulkaVariantov varianty={varianty} zdroj={r.zdroj_url} stiahnute={r.stiahnute} lang={lang} primoZaklad={primoZaklad} diely={dielyUrl} kodyDielov={kodyDielov} /></div>
      ) : (
        <div class="harok prazdne">
          <a class="btn btn-yellow" href={KATALOG_PDF} target="_blank" rel="noopener">{tx.otvoritKatalog} <Ikona nazov="download" velkost={18} /></a>
          <a class="odkaz" href={eshop} target="_blank" rel="noopener">{tx.hladatEshop} <Ikona nazov="external-link" velkost={16} /></a>
        </div>
      )}
    </section>

    {obsah && (
      <section class="wrap cast" id="stavba" aria-labelledby="h-stavba">
        <div class="stavba">
          <div class="stavba-text">
            <h2 id="h-stavba">{tx.stavbaH2}</h2>
            {obsah.popis.map((p) => <p class="stavba-popis">{sadzba(p)}</p>)}
            <div class="harok stavba-karta">
              <h3>{tx.parametreH3}</h3>
              <dl class="parametre">{obsah.parametre.map(([dt, dd]) => <div><dt>{dt}</dt><dd>{sadzba(dd)}</dd></div>)}</dl>
              <h3>{tx.montazH3}</h3>
              <ul class="montaz">{obsah.montaz.map((m) => <li><Ikona nazov="check" velkost={18} /><span>{sadzba(m)}</span></li>)}</ul>
              {obsah.strana && <p class="stavba-zdroj"><a href={KATALOG_PDF} target="_blank" rel="noopener">{tx.stranaKat(obsah.strana)}</a></p>}
            </div>
          </div>
          <div class="stavba-obraz">
            {fotoOk && (
              <figure class="stavba-foto">
                <Image src={foto!} alt={ui.rad.fotoAlt(nazov)} widths={[480, 760, 1000]} sizes="(max-width: 900px) 90vw, 44vw" />
              </figure>
            )}
            <ol class="lupy" aria-label={tx.stavbaH2}>
              {vrstvy.map((l) => (
                <li class={`lupa lupa-${l.id}`}>
                  <span class="lupa-okno"><Image src={l.img} alt="" width={120} height={120} densities={[1, 2]} /></span>
                  <div>
                    <h3>{l.nazov}</h3>
                    {l.kluc && <p class="lupa-kluc">{sadzba(l.kluc)}</p>}
                    <p class="lupa-text">{sadzba(l.text)}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>
    )}

    {r.subory.length > 0 && (
      <section class="wrap cast" id="stiahnut" aria-labelledby="h-dl">
        <div class="s-hlava"><h2 id="h-dl">{ui.rad.dlH2}</h2><p>{tx.dlP}</p><a href={route(lang, 'stiahnut')}>{ui.nav.stiahnut} <Ikona nazov="arrow-right" velkost={16} /></a></div>
        <div class="harok dl-harok"><Subory subory={r.subory} lang={lang} /></div>
      </section>
    )}

    {refs.length > 0 && (
      <section class="wrap cast" id="referencie" aria-labelledby="h-ref">
        <div class="s-hlava"><h2 id="h-ref">{tx.refH2}</h2><p>{tx.refP}</p><a href={route(lang, 'referencie')}>{tx.refVsetky} <Ikona nazov="arrow-right" velkost={16} /></a></div>
        <div class:list={['refs', { 'refs-1': refs.length === 1 }]}>
          {refs.map((x, i) => <KartaReferencie r={x} lang={lang} velka={refs.length === 1 || i === 0} />)}
        </div>
      </section>
    )}

    {skupinyRel.length > 0 && (
      <section class="wrap cast" id="suvisiace" aria-labelledby="h-rel">
        <div class="s-hlava"><h2 id="h-rel">{tx.relH2}</h2><p>{tx.relP}</p><a href={route(lang, 'spojky')}>{tx.vsetkyDiely} <Ikona nazov="arrow-right" velkost={16} /></a></div>
        <div class="rel">
          {skupinyRel.map(({ s, ps }) => { const img = fotkaRadu(s.fotka); return (
            <div class="harok rel-skupina">
              <div class="rel-hlava">
                {img && <span class="rel-ikona"><Image src={img} alt="" width={64} height={64} densities={[1, 2]} /></span>}
                <h3>{rNazov(s, lang)}</h3>
              </div>
              <ul>{ps.map((p) => <li><a href={cestaProduktu(p, katProduktu(p.kategoria), lang)}><span>{pNazov(p, lang)}</span><Ikona nazov="chevron-right" velkost={16} /></a></li>)}</ul>
            </div>
          ); })}
        </div>
      </section>
    )}

    <p class="wrap oznacenie"><span>{tx.oznacenie}:</span> {rOznacenie(r, lang)}</p>
  </div>
  <Zaver lang={lang} />
  <Kopirovanie lang={lang} />
</Base>

<style>
  .hlava-fakty { display: flex; flex-wrap: wrap; gap: 14px 30px; margin: 26px 0 0; }
  .hlava-fakty dt { font-size: 13px; color: var(--color-ink-soft); }
  .hlava-fakty dd { margin: 2px 0 0; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: clamp(17px, 0.6vw + 13px, 21px); letter-spacing: -0.01em; color: var(--color-blue-900); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .hlava-sestry { margin-top: 20px; font-size: 14.5px; color: var(--color-ink-soft); }
  .hlava-sestry a { font-weight: 600; }


  .prazdne { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; padding: 28px; }

  .stavba { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 40px 56px; align-items: start; }
  .stavba h2 { font-size: clamp(26px, 1.4vw + 17px, 36px); letter-spacing: -0.02em; }
  .stavba-popis { margin-top: 16px; font-size: 17px; line-height: 1.6; max-width: 36em; }
  .stavba-karta { margin-top: 32px; padding: 26px 28px 22px; }
  .stavba-karta h3 { font-size: 17px; font-weight: 600; color: var(--color-ink); }
  .stavba-karta h3 + * { margin-top: 12px; }
  .stavba-karta * + h3 { margin-top: 26px; }
  .parametre > div { display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; border-bottom: 1px solid rgb(10 42 94 / 0.08); }
  .parametre dt { color: var(--color-ink-soft); font-size: 15px; }
  .parametre dd { margin: 0; text-align: right; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 16px; color: var(--color-blue-900); }
  .montaz li { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 10px; font-size: 15px; line-height: 1.5; }
  .montaz li + li { margin-top: 10px; }
  .montaz :global(.icon) { color: #1f8a4c; margin-top: 2px; }
  .stavba-zdroj { margin-top: 20px; font-size: 13px; }
  .stavba-zdroj a { color: var(--color-ink-soft); border-bottom: 1px solid currentColor; }

  /* Fotka radu splynie s pozadím (biele pozadie katalógu), lupy pod ňou prekrývajú jej spodok. */
  .stavba-obraz { position: relative; }
  .stavba-foto { margin: -20px 0 0; mix-blend-mode: multiply; }
  .stavba-foto :global(img) { display: block; width: min(100%, 620px); height: auto; margin-inline: auto; -webkit-mask-image: radial-gradient(70% 70% at 50% 50%, #000 60%, transparent 100%); mask-image: radial-gradient(70% 70% at 50% 50%, #000 60%, transparent 100%); }
  .stavba-foto + .lupy { margin-top: -110px; }
  /* Lupy: kruh so zväčšeným materiálom presahuje ľavý okraj karty, text vedľa neho. */
  .lupy { position: relative; display: grid; gap: 18px; padding-left: 44px; }
  .lupa { --ring: var(--color-blue-700); display: grid; grid-template-columns: 68px minmax(0, 1fr); gap: 26px; align-items: center; padding: 20px 26px 20px 0; border-radius: 18px; background: #fff; box-shadow: 0 1px 0 rgb(10 42 94 / 0.05), 0 26px 50px -34px rgb(10 42 94 / 0.5); }
  .lupa-rura { --ring: #e0b400; }
  .lupa-pena { --ring: #8e97a3; }
  .lupa-okno { position: relative; display: block; width: 112px; height: 112px; margin-left: -44px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 5px #fff, 0 0 0 7px var(--ring), 0 20px 36px -16px rgb(11 27 51 / 0.55); }
  .lupa-okno :global(img) { display: block; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
  .lupa-okno::after { content: ""; position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(70% 55% at 30% 18%, rgb(255 255 255 / 0.36), rgb(255 255 255 / 0) 62%); box-shadow: inset 0 -10px 22px rgb(11 27 51 / 0.28), inset 0 0 0 1px rgb(11 27 51 / 0.12); pointer-events: none; }
  .lupa h3 { font-size: 18px; line-height: 1.25; }
  .lupa-kluc { margin-top: 3px; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 16px; line-height: 1.3; color: var(--color-blue-900); }
  .lupa-text { margin-top: 6px; font-size: 14.5px; line-height: 1.55; color: var(--color-ink-soft); max-width: 44em; }

  .dl-harok { padding: 8px 28px 12px; }

  .refs { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 32px 40px; align-items: start; }
  .refs-1 { grid-template-columns: minmax(0, 760px); }

  .rel { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; align-items: start; }
  .rel-skupina { padding: 22px 24px 16px; }
  .rel-hlava { display: flex; align-items: center; gap: 14px; margin-bottom: 8px; }
  .rel-ikona { flex: none; width: 56px; height: 56px; display: grid; place-items: center; border-radius: 14px; background: linear-gradient(160deg, #f3f7fc 0%, #e6eef8 100%); mix-blend-mode: multiply; }
  .rel-ikona :global(img) { width: 48px; height: 48px; object-fit: contain; }
  .rel-skupina h3 { font-size: 18px; }
  .rel-skupina li a { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 0; border-top: 1px solid rgb(10 42 94 / 0.08); font-size: 15px; font-weight: 500; }
  .rel-skupina :global(.icon) { color: var(--color-blue-700); flex: none; }

  .oznacenie { margin-top: 56px !important; font-size: 13px; color: var(--color-ink-soft); }
  .oznacenie span { color: var(--color-ink); font-weight: 500; }

  @media (max-width: 900px) { .stavba, .refs { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 760px) { .lupy { padding-left: 0; } .lupa { grid-template-columns: 76px minmax(0, 1fr); gap: 16px; align-items: start; padding: 18px; } .lupa-okno { width: 76px; height: 76px; margin: 0; box-shadow: 0 0 0 4px #fff, 0 0 0 6px var(--ring), 0 14px 26px -12px rgb(11 27 51 / 0.5); } .stavba-foto + .lupy { margin-top: -16px; } }
  @media (max-width: 760px) { .stavba-karta { padding: 22px 20px 18px; } .dl-harok { padding: 4px 18px 8px; } }
</style>
