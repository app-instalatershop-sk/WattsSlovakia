  .konf-obraz { position: relative; }
  .konf-obraz :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 11; object-fit: cover; object-position: 50% 70%; }
  .konf-obraz::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(13 50 112 / 0) 45%, #0f3878 100%); }
  .konf-telo { position: relative; padding: 4px 28px 30px; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .konf-stav { display: inline-flex; align-items: center; height: 28px; padding: 0 12px; border-radius: 999px; background: var(--color-yellow-500); color: var(--color-ink); font-size: 14px; font-weight: 600; }
  .konfigurator h3 { margin-top: 6px; font-size: clamp(24px, 1vw + 16px, 30px); line-height: 1.1; letter-spacing: -0.02em; color: #fff; }
  .konfigurator p:not(.konf-stav) { color: var(--color-on-dark-muted); font-size: 16px; line-height: 1.6; }
  .konf-odkaz { margin-top: 8px; font-weight: 600; border-bottom: 1px solid rgb(255 255 255 / 0.55); padding-bottom: 2px; }

  /* ---------- Tablet ---------- */
  @media (max-width: 1100px) {
    .hero-in { grid-template-columns: minmax(0, 46fr) minmax(0, 54fr); }
    .hero h1 { font-size: clamp(34px, 3.4vw + 10px, 50px); }
    .rodina-grid { grid-template-columns: 1fr; }
    /* Render rodiny dobehne za pravý okraj obrazovky ako na počítači: rúry sú v renderi zrezané
       vpravo a na okraji mriežky by bolo rez vidno. */
    .rodina-obraz { width: calc(100% + var(--gutter)); margin: -120px calc(-1 * var(--gutter)) 0 0; grid-row: 1; }
    .rodina-text { padding-top: 24px; margin-top: 0; }
