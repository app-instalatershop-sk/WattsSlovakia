---
/**
 * Tlačidlo Prehrať znova vo vnútri obrazu animácie z 3D modelu (rez, ohyb, kotúč; lib/sekvencia.ts): ukáže ho
 * skript, keď pohyb dobehne. Bez skriptu a pri „obmedziť pohyb“ stojí hotový obraz bez tlačidla.
 * roh: kde je na konci pohybu na obraze voľno.
 */
import Ikona from './Ikona.astro';

interface Props { znova: string; roh?: 'vlavo-dole' | 'vpravo-hore' }
const { znova, roh = 'vlavo-dole' } = Astro.props;
---
<div class:list={['sq-ovl', `sq-${roh}`]}>
  <button type="button" class="sq-znova" hidden><Ikona nazov="rotate-ccw" velkost={16} /><span>{znova}</span></button>
</div>

<style>
  .sq-ovl { position: absolute; z-index: 4; display: flex; pointer-events: none; }
  .sq-vlavo-dole { left: 12px; bottom: 12px; }
  .sq-vpravo-hore { right: 12px; top: 12px; }
  .sq-znova { pointer-events: auto; display: inline-flex; align-items: center; gap: 8px; min-height: 40px; margin: 0; padding: 8px 16px 8px 12px;
    border: 0; border-radius: var(--radius-l); background: var(--sklo-3); box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.08), var(--elev-2);
    font: inherit; font-size: 14px; font-weight: 600; line-height: 1.2; color: var(--color-blue-900); white-space: nowrap; cursor: pointer;
    transition: background-color 150ms var(--ease-soft), transform 120ms var(--ease-soft); }
  .sq-znova:active { transform: scale(0.98); }
  .sq-znova:focus-visible { outline: 2px solid var(--color-blue-700); outline-offset: 2px; }
  .sq-znova:not([hidden]) { animation: sq-ukaz 250ms var(--ease-soft) both; }
  .sq-znova :global(svg) { flex: none; color: var(--color-blue-700); }
  @media (hover: hover) and (pointer: fine) { .sq-znova:hover { background: #fff; } }
  @keyframes sq-ukaz { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  @media (max-width: 760px) { .sq-znova { padding: 8px 12px 8px 8px; font-size: 13px; } }
  /* Prst: hlavné ovládanie aspoň 44 px (POLISH O1). */
  @media (pointer: coarse) { .sq-znova { min-height: 44px; } }
</style>
