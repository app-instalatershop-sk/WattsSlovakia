---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Ikona from '../components/Ikona.astro';
import Katalog from '../components/Katalog.astro';
import { kategorie, cislo, rozsah } from '../lib/katalog';
import { fotka, detail } from '../lib/obrazky';
import { sadzba } from '../lib/sadzba';
import { type Lang, t, route, staticAlternates, KATALOG_PDF } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const h = ui.home;

const kats = await kategorie();
const rady = (await getCollection('rady')).map((r) => r.data);
const varianty = (await getCollection('varianty')).map((v) => v.data);

const potrubia = kats.filter((k) => k.typ === 'potrubie');
const radyPotrubi = rady.filter((r) => potrubia.some((k) => k.id === r.kategoria));
const variantyPotrubi = varianty.filter((v) => radyPotrubi.some((r) => r.id === v.rad));

// Čísla pri renderi v hero sú z dát, nie z hlavy.
const polomery = variantyPotrubi.map((v) => v.polomer_ohybu_m).filter((x): x is number => typeof x === 'number');
const faktPolomer = `${ui.common.od} ${cislo(Math.min(...polomery), 2)} m`;
const faktRura = rozsah(variantyPotrubi.map((v) => v.rura?.d), 'mm', lang);
const faktPlast = `Ø ${rozsah(variantyPotrubi.map((v) => v.plast_mm), 'mm', lang)}`;
const tlaky = [...new Set(radyPotrubi.map((r) => r.tlak_bar).filter((x): x is number => typeof x === 'number'))].sort((a, b) => a - b);
const faktTlak = h.popisy.tlak(tlaky.map((x) => `${x}`));

const heroRez = fotka('hero-rez-duo.png')!;
const rodina = fotka('rodina-potrubi.png')!;
const kotuc = fotka('kotuc.jpg')!;
const vykop = fotka('vykop-spojky.jpg')!;
/* Rez pod lupou: tri vrstvy od jadra po plášť. Bod (x, y v % renderu rodiny) leží na prvej rúre
   (DUO vykurovanie): žltá nosná rúra, pena vpravo od nej, plášť na hrane rezu. Zmerané na siluete
   rodina-potrubi.png; body idú zľava doprava v tom istom poradí ako lupy, takže sa čiary nekrížia.
   Zábery v lupách sú dočasne výrezy z podkladov Watts, nahradia ich fotky odrezku. */
const polohyBodov: Record<string, [number, number]> = { rura: [11.5, 71], pena: [17, 68], plast: [20.4, 64] };
const lupy = h.lupy.map((l) => ({ ...l, img: detail(`vrstva-${l.id}.jpg`)!, bod: polohyBodov[l.id] }));
// Odlesk po plášti: maska je samotný render, svetlo tak prejde len po výrobku, nie po pozadí.
const leskMaska = (await getImage({ src: heroRez, width: 760, format: 'webp' })).src;
/* Popisy na renderi: bod leží na tom, čo číslo opisuje (okraj plášťa, spodná žltá rúra, zvlnené telo),
   štítok v prázdnom mieste okolo výrobku. Polohy a dĺžky čiar sú v CSS podľa id, zmerané na siluete
   hero-rez-duo.png; dĺžky sú v cqw (percentá šírky štúdia), takže celá vrstva rastie s obrázkom. */
const popisy = [
  { id: 'plast', hodnota: faktPlast, text: h.popisy.plast },
  { id: 'rura', hodnota: faktRura, text: faktTlak },
  { id: 'ohyb', hodnota: faktPolomer, text: h.popisy.polomer },
];
---
<Base lang={lang} alternates={staticAlternates('domov')} title={ui.domov.title} description={ui.domov.description}>
  <section class="hero" aria-labelledby="h-hero" data-mys>
    <div class="wrap hero-in">
      <div class="hero-text">
        {/* Kľúčové slovo ostáva v nadpise, len v tichom riadku nad sloganom. */}
        <h1 id="h-hero">
          <span class="h1-kicker">{h.heroKicker}</span>
          <span class="h1-a">{h.h1a}</span>
          <span class="h1-b">{h.h1b}</span>
        </h1>
        <p class="lead">{sadzba(h.lead)}</p>
        <div class="hero-actions">
          <a class="btn btn-yellow" href="#vyber">{h.cta} <Ikona nazov="arrow-down" velkost={18} /></a>
          <a class="hero-odkaz" href={KATALOG_PDF} target="_blank" rel="noopener">{h.cta2} <span class="meta">{h.cta2Meta}</span> <Ikona nazov="download" velkost={16} /></a>
        </div>
      </div>
      <div class="hero-product">
        <div class="hero-stage">
          <Image src={heroRez} alt={h.heroAlt} widths={[760, 1140, 1517]} sizes="(max-width: 760px) 100vw, 62vw" loading="eager" fetchpriority="high" class="hero-img" />
          <span class="lesk" aria-hidden="true" style={`--maska: url("${leskMaska}")`}></span>
          <ul class="popisy" aria-label={h.popisy.label}>
            {popisy.map((p, i) => (
              <li class={`popis popis-${p.id}`} style={`--i: ${i}`}>
                <span class="bod" aria-hidden="true"></span>
                <span class="ciara" aria-hidden="true"></span>
                <span class="stitok"><strong>{p.hodnota}</strong><span>{sadzba(p.text)}</span></span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Katalog lang={lang} />

  <section class="section rodina" aria-labelledby="h-rodina">
    <div class="wrap rodina-grid">
      <div class="rodina-text">
        <h2 id="h-rodina">{h.rodinaH2}</h2>
        <p class="lead">{sadzba(h.rodinaP)}</p>
      </div>
      <div class="rodina-obraz" data-lupy-obraz>
        <div class="rodina-wrap"><Image src={rodina} alt={h.rodinaAlt} widths={[800, 1200, 1633]} sizes="(max-width: 1100px) 100vw, 64vw" class="rodina-img" /></div>
        {lupy.map((l) => <span class="lupa-bod" data-bod={l.id} style={`--x: ${l.bod[0]}%; --y: ${l.bod[1]}%`} aria-hidden="true"></span>)}
      </div>
      {/* Rez pod lupou: každá lupa zväčší jednu vrstvu prvej rúry a čiara ju spojí s miestom na nej.
          Čiary kreslí skript nižšie podľa skutočnej polohy bodov a líp; bez skriptu ostanú lupy s textom. */}
      <svg class="lupy-ciary" data-lupy-ciary aria-hidden="true"></svg>
      <ul class="lupy" aria-label={h.lupyLabel} data-reveal-group>
        {lupy.map((l) => (
          <li class={`lupa lupa-${l.id}`} data-lupa={l.id}>
            <span class="lupa-okno"><Image src={l.img} alt="" width={168} height={168} densities={[1, 2]} /></span>
            <h3>{l.nazov}</h3>
            <p class="lupa-kluc">{sadzba(l.kluc)}</p>
            <p>{sadzba(l.text)}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section pokladka" aria-labelledby="h-pokladka">
    {/* Fotka kotúča má čisto bielu plochu: násobením splynie s pásom a text sedí vo vnútri kotúča. */}
    <div class="kotuc-obal">
      <Image src={kotuc} alt={h.pokladkaAlt} widths={[900, 1400, 2000]} sizes="(max-width: 760px) 120vw, 76vw" class="kotuc" data-otacaj="-4 3" />
    </div>
    <div class="wrap pokladka-grid">
      <div class="pokladka-text">
        <h2 id="h-pokladka">{h.pokladkaH2}</h2>
        <p class="lead">{sadzba(h.pokladkaP)}</p>
        <div class="kroky-obal" data-rozvin>
          <span class="k-rura" aria-hidden="true"></span>
          <ol class="kroky" aria-label={h.krokyLabel}>
            {h.kroky.map(([nazov, text], i) => (
              <li><span class="k-cislo" aria-hidden="true">{i + 1}</span><h3>{nazov}</h3><p>{sadzba(text)}</p></li>
            ))}
          </ol>
        </div>
        <div class="pokladka-pata">
          <p class="zataz"><strong>{h.zataz[0]}</strong><span>{sadzba(h.zataz[1])}</span></p>
          <p class="zdroj">{h.pokladkaZdroj} <a href={`${KATALOG_PDF}#page=37`} target="_blank" rel="noopener">{h.pokladkaOdkaz} <Ikona nazov="arrow-up-right" velkost={14} /></a></p>
        </div>
      </div>
    </div>
  </section>

  {/* Podzemie: posledný úsek stránky je tmavý ako zem, do ktorej potrubie ide. Fotka z výkopu
      prekračuje šikmú hranu, takže svetlá a tmavá časť nie sú dva bloky, ale jeden prechod. */}
  <div class="podzemie">
    <section class="refs" aria-labelledby="h-refs">
      <div class="wrap refs-grid">
        <figure class="refs-photo">
          <Image src={vykop} alt={h.refAlt} widths={[800, 1200, 1600]} sizes="(max-width: 1100px) 100vw, 70vw" />
        </figure>
        <div class="refs-text">
          <h2 id="h-refs">{h.refH2}</h2>
          <ul class="refs-list" data-reveal-group>
            {h.refs.map(([b, s]) => (
              <li><a href={route(lang, 'referencie')}><strong>{b}</strong><span>{sadzba(s)}</span></a></li>
            ))}
          </ul>
          <p class="refs-pata"><a href={route(lang, 'referencie')}>{h.refVsetky} <Ikona nazov="arrow-up-right" velkost={16} /></a></p>
        </div>
      </div>
    </section>

    <section class="b2b wrap" aria-labelledby="h-b2b">
      <div class="b2b-grid">
        <div class="b2b-text">
          <h2 id="h-b2b">{h.b2bH2}</h2>
          <p class="lead">{sadzba(h.b2bP)}</p>
          <div class="b2b-akcie">
            <a class="btn btn-inverse" href={route(lang, 'firmy')}>{h.b2bDopyt}</a>
            <a class="btn btn-ghost-light" href={route(lang, 'stiahnut')}><Ikona nazov="download" velkost={18} />{h.b2bPodklady}</a>
          </div>
        </div>
        <ul class="b2b-list" data-reveal-group>
          {h.b2bList.map(([b, s]) => <li><strong>{b}</strong><span>{sadzba(s)}</span></li>)}
        </ul>
      </div>
    </section>
  </div>
</Base>

<script>
  /* Čiary od bodu na rúre k lupe. Počíta sa z polohy v rozložení (offsetLeft a offsetTop), nie
     z getBoundingClientRect, aby ich nerozhodil pohyb lúp pri zjavení. Kreslí sa len tam, kde je
     čiara v CSS viditeľná (od 1 101 px). */
  function initLupy() {
    const svg = document.querySelector<SVGSVGElement>('[data-lupy-ciary]');
    const grid = svg?.parentElement as HTMLElement | null;
    if (!svg || !grid) return;
    const w = window as unknown as { __lupy?: AbortController };
    w.__lupy?.abort();
    const ac = new AbortController();
    w.__lupy = ac;
    const NS = 'http://www.w3.org/2000/svg';
    const poloha = (el: HTMLElement) => {
      let x = 0, y = 0, n: HTMLElement | null = el;
      while (n && n !== grid) { x += n.offsetLeft; y += n.offsetTop; n = n.offsetParent as HTMLElement | null; }
      return { x, y };
    };
    const kresli = () => {
      if (getComputedStyle(svg).display === 'none') return;
      svg.setAttribute('viewBox', `0 0 ${grid.offsetWidth} ${grid.offsetHeight}`);
      svg.replaceChildren();
      grid.querySelectorAll<HTMLElement>('[data-lupa]').forEach((li) => {
        const bod = grid.querySelector<HTMLElement>(`[data-bod="${li.dataset.lupa}"]`);
        const okno = li.querySelector<HTMLElement>('.lupa-okno');
        if (!bod || !okno) return;
        const b = poloha(bod), o = poloha(okno);
        const bx = b.x + bod.offsetWidth / 2, by = b.y + bod.offsetHeight / 2;
        const r = okno.offsetWidth / 2, ox = o.x + r, oy = o.y + r;
        const dx = bx - ox, dy = by - oy, d = Math.hypot(dx, dy) || 1;
        // Od okraja bodu po okraj lupy (za bielym a farebným prstencom).
        const x1 = bx - (dx / d) * 11, y1 = by - (dy / d) * 11;
        const x2 = ox + (dx / d) * (r + 10), y2 = oy + (dy / d) * (r + 10);
        for (const trieda of ['lupa-halo', 'lupa-ciara']) {
          const path = document.createElementNS(NS, 'path');
          path.setAttribute('d', `M${x1.toFixed(1)} ${y1.toFixed(1)} L${x2.toFixed(1)} ${y2.toFixed(1)}`);
          path.setAttribute('pathLength', '1');
          path.setAttribute('class', trieda);
          svg.appendChild(path);
        }
      });
    };
    let snimka = 0;
    const naplanuj = () => { cancelAnimationFrame(snimka); snimka = requestAnimationFrame(kresli); };
    window.addEventListener('resize', naplanuj, { signal: ac.signal });
    document.fonts?.ready.then(naplanuj);
    grid.querySelectorAll('img').forEach((img) => img.addEventListener('load', naplanuj, { once: true, signal: ac.signal }));
    kresli();
    // Čiary sa nakreslia, keď sa lupy objavia v okne.
    const lupyEl = grid.querySelector('.lupy');
    if (lupyEl && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((z) => { if (z.some((e) => e.isIntersecting)) { svg.classList.add('is-on'); io.disconnect(); } }, { rootMargin: '0px 0px -15% 0px' });
      io.observe(lupyEl);
      ac.signal.addEventListener('abort', () => io.disconnect());
    } else svg.classList.add('is-on');
  }
  initLupy();
  document.addEventListener('astro:page-load', initLupy);
</script>

<style>
  /* ---------- Hero: svetlé pole, farbu nesie výrobok ---------- */
  /* Spodných --presah pixelov hero je bez pozadia: je pod nimi šikmá horná hrana pásu katalógu,
     ktorú spodok renderu pretína, rovnako ako fotka z výkopu pretína hranu podzemia. */
  .hero { --presah: var(--presah-hero); position: relative; display: flex; align-items: center; min-height: clamp(540px, 70vh, 720px); overflow-x: clip; z-index: 1; color: var(--color-ink);
    background:
      linear-gradient(to bottom, rgb(255 255 255 / 0) 62%, #ffffff 100%),
      radial-gradient(52% 62% at 76% 52%, rgb(0 93 185 / 0.08) 0%, rgb(0 93 185 / 0) 72%),
      linear-gradient(158deg, #ffffff 0%, #fafbfd 46%, #eef2f7 100%);
    background-size: 100% calc(100% - var(--presah)); background-repeat: no-repeat; }
  .hero-in { position: relative; width: 100%; display: grid; grid-template-columns: minmax(0, 44fr) minmax(0, 56fr); grid-template-areas: "text obraz"; column-gap: 24px; }
  .hero-text { grid-area: text; align-self: center; max-width: 620px; padding-block: 72px; display: flex; flex-direction: column; align-items: flex-start; position: relative; z-index: 3; }
  .hero-text > * { animation: rise 680ms var(--ease-soft) both; }
  .hero-text > :nth-child(2) { animation-delay: 220ms; }
  .hero-text > :nth-child(3) { animation-delay: 320ms; }
  .hero h1 { display: flex; flex-direction: column; font-size: clamp(34px, 2.9vw + 12px, 58px); line-height: 1.03; letter-spacing: -0.03em; text-wrap: nowrap; }
  .h1-kicker { font-family: var(--font-text); font-stretch: 100%; font-size: 12.5px; font-weight: 600; line-height: 1.4; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-ink-soft); margin-bottom: 20px; }
  /* Jediný orchestrovaný moment: prvý riadok sa pri načítaní roztiahne po osi šírky písma,
     tak ako sa rozvinie ohybné potrubie. Cieľ je šírka nadpisu, preto animácia nemá koncový stav. */
  .h1-a { color: var(--color-ink); animation: flex 1150ms 60ms var(--ease-soft) both; }
  .h1-b { color: var(--color-blue-700); }
  @keyframes flex { from { font-stretch: 72%; opacity: 0; } 35% { opacity: 1; } }
  .hero .lead { font-size: 18px; max-width: 30em; margin-top: 22px; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 30px; margin-top: 34px; }
  .hero-actions .btn :global(svg) { transition: transform 200ms var(--ease-soft); }
  .hero-actions .btn:hover :global(svg) { transform: translateY(3px); }
  /* Druhá akcia nie je tlačidlo: nemá súperiť so žltým, len ponúknuť katalóg na stiahnutie. */
  .hero-odkaz { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; color: var(--color-blue-700); border-bottom: 1px solid currentColor; padding-bottom: 3px; }
  .hero-odkaz .meta { font-weight: 400; font-size: 14px; color: var(--color-ink-soft); }
  .hero-odkaz :global(svg) { transition: transform 200ms var(--ease-soft); }
  .hero-odkaz:hover :global(svg) { transform: translateY(2px); }
  /* Rúra prekračuje pravý okraj obsahovej mriežky až za okraj obrazovky. */
  /* Render sedí na spodku hero, takže jeho dolná časť pretne šikmú hranu pásu katalógu. */
  .hero-product { grid-area: obraz; position: relative; z-index: 2; align-self: end; margin-left: -9%;
    margin-right: calc(min(calc(-1 * var(--gutter)), calc((var(--container-site) - 100vw) / 2)) - 64px);
    pointer-events: none; animation: settle 1300ms 120ms var(--ease-soft) both; }
  .hero-product :global(.hero-img) { width: 100%; height: auto; display: block; filter: drop-shadow(0 30px 36px rgb(11 27 51 / 0.17)); }
  /* Štúdio má presne rozmer obrázka: body popisov sú v percentách obrázka a sedia pri každej šírke.
     Pri pohybe myši sa výrobok jemne posunie a pootočí, text stojí. */
  .hero-stage { position: relative; max-width: 1180px; margin-inline: auto; container-type: inline-size; transform: translate3d(calc(var(--mx, 0) * 12px), calc(var(--my, 0) * 8px), 0); transition: transform 900ms var(--ease-soft); }
  /* Za rezom sústredné kružnice ako na výkrese prierezu, stredom v reze rúry (27 % a 60 % štúdia).
     Zdola doznejú ešte nad šikmou hranou pásu katalógu, aby cez ňu neprechádzali. */
  .hero-stage::before { content: ""; position: absolute; inset: -15% -40% 0 -50%; z-index: -1; pointer-events: none;
    background: repeating-radial-gradient(circle at 40.5% 65%, rgb(10 42 94 / 0.075) 0 1px, rgb(10 42 94 / 0) 1.5px 46px);
    -webkit-mask-image: radial-gradient(circle at 40.5% 65%, #000 12%, transparent 50%), linear-gradient(to bottom, #000 40%, transparent calc(100% - var(--presah-hero) - 32px));
    -webkit-mask-composite: source-in;
    mask-image: radial-gradient(circle at 40.5% 65%, #000 12%, transparent 50%), linear-gradient(to bottom, #000 40%, transparent calc(100% - var(--presah-hero) - 32px));
    mask-composite: intersect;
    animation: kruhy 1600ms 300ms var(--ease-soft) both; }
  @keyframes kruhy { from { opacity: 0; transform: scale(0.97); } to { opacity: 1; transform: none; } }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes settle { from { opacity: 0; transform: translate(40px, 0) rotate(-1.5deg) scale(1.02); } to { opacity: 1; transform: none; } }

  /* Odlesk: pás svetla raz prejde po plášti. Maska je render, takže svetlo nejde po pozadí. */
  .lesk { position: absolute; inset: 0; pointer-events: none; mix-blend-mode: screen; opacity: 0.9;
    -webkit-mask: var(--maska) center / 100% 100% no-repeat; mask: var(--maska) center / 100% 100% no-repeat;
    background: linear-gradient(105deg, rgb(255 255 255 / 0) 40%, rgb(190 215 255 / 0.42) 50%, rgb(255 255 255 / 0) 60%) no-repeat;
    background-size: 260% 100%; background-position: 135% 0; animation: lesk 2200ms 1100ms cubic-bezier(0.45, 0, 0.25, 1) both; }
  @keyframes lesk { from { background-position: 135% 0; } to { background-position: -35% 0; } }

  /* Technické popisy (kóty): bod leží na tom, čo číslo opisuje, čiara vedie k štítku. Štítok má
     jemne mliečne pozadie, aby bol čitateľný aj tam, kde sa dotkne výrobku. Prídu po nadpise. */
  .popisy { position: absolute; inset: 0; margin: 0; padding: 0; pointer-events: none; }
  .popis { position: absolute; left: var(--x); top: var(--y); width: 0; height: 0; }
  .bod { position: absolute; z-index: 2; left: -7px; top: -7px; width: 14px; height: 14px; border-radius: 50%; background: #fff; box-shadow: inset 0 0 0 3px var(--color-blue-900), 0 0 0 4px rgb(255 255 255 / 0.55), 0 3px 10px rgb(11 27 51 / 0.35); animation: bod 420ms var(--ease-soft) both; animation-delay: calc(1250ms + var(--i) * 170ms); }
  .bod::after { content: ""; position: absolute; inset: -7px; border-radius: 50%; border: 1.5px solid rgb(255 255 255 / 0.95); opacity: 0; animation: pulz 1500ms ease-out 1 both; animation-delay: calc(1650ms + var(--i) * 170ms); }
  .ciara { position: absolute; left: -0.75px; width: 1.5px; height: var(--l); border-radius: 1px; background: var(--color-blue-900); box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.55); animation: ciaraY 520ms var(--ease-soft) both; animation-delay: calc(1330ms + var(--i) * 170ms); }
  .stitok { position: absolute; display: flex; flex-direction: column; gap: clamp(2px, 0.3cqw, 4px); white-space: nowrap;
    padding: clamp(5px, 0.72cqw, 10px) clamp(8px, 1.05cqw, 14px); border-radius: clamp(8px, 0.9cqw, 12px);
    background: rgb(255 255 255 / 0.84); -webkit-backdrop-filter: blur(10px) saturate(1.4); backdrop-filter: blur(10px) saturate(1.4);
    box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.08), 0 14px 30px -16px rgb(11 27 51 / 0.5);
    animation: rise 560ms var(--ease-soft) both; animation-delay: calc(1520ms + var(--i) * 170ms); }
  .stitok strong { font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: clamp(15px, 2.5cqw, 28px); line-height: 1.05; letter-spacing: -0.02em; color: var(--color-blue-900); font-variant-numeric: tabular-nums; }
  .stitok span { font-size: clamp(11px, 1.45cqw, 15px); line-height: 1.3; font-weight: 500; color: #3f4b5e; }
