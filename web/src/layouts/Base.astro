---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Hlavicka from '../components/Hlavicka.astro';
import Paticka from '../components/Paticka.astro';
import { type Lang, type Alternates, LOCALE, t, route } from '../i18n/ui';
import { titulok, popisMeta } from '../lib/seo';
import { ogObrazok } from '../lib/og';
import { FIRMA } from '../content/firma';

interface Drobcek { text: string; href?: string }
interface Props {
  lang: Lang;
  alternates: Alternates;
  title: string;
  description: string;
  aktivna?: 'potrubia' | 'vyber' | 'referencie' | 'stiahnut' | 'firmy' | 'poradna' | 'kontakt';
  drobceky?: Drobcek[];
  jsonLd?: Record<string, unknown>[];
  ogImage?: string;
  /** false = drobčeky vykreslí hlava stránky (komponent Hlava), tu ostanú len v štruktúrovaných dátach */
  vizualneDrobceky?: boolean;
  robots?: string;
}
const { lang, alternates, title, description, aktivna, drobceky = [], jsonLd = [], ogImage, vizualneDrobceky = true, robots } = Astro.props;
const ui = t(lang);
const site = Astro.site ?? new URL('https://microflex.sk');
const canonical = new URL(Astro.url.pathname, site).href;
const fullTitle = titulok(title, ui.site.name);
const popis = popisMeta(description, lang);
// Náhľad pri zdieľaní: vlastný obrázok stránky z registra (lib/og.ts), inak predvolený pre jazyk.
const ogCesta = ogImage ?? (await ogObrazok(Astro.url.pathname, lang));
const ogAlt = `${title}, ${ui.site.name}`;

// Web prevádzkuje Ohrievacia Technika (predajňa Inštalatérshop); @id spája organizáciu na všetkých stránkach.
// Logo zámerne nie: MICROFLEX® je značka Watts, nie znak tejto organizácie.
const organizacia = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organizacia', site).href,
  name: ui.site.name,
  legalName: FIRMA.nazov,
  url: site.href,
  description: ui.site.tagline,
  email: FIRMA.email,
  telephone: FIRMA.telefon,
  vatID: FIRMA.icdph,
  address: { '@type': 'PostalAddress', streetAddress: FIRMA.sidlo.ulica, postalCode: FIRMA.sidlo.psc, addressLocality: FIRMA.sidlo.mesto, addressCountry: 'SK' },
  sameAs: [FIRMA.eshop],
};
// Názov webu vo výsledkoch Google (site name) berie Google zo štruktúrovaných dát WebSite na úvodnej stránke.
const domov = Astro.url.pathname === route(lang, 'domov');
const web = domov
  ? { '@context': 'https://schema.org', '@type': 'WebSite', name: ui.site.name, alternateName: ['Microflex SK', 'microflex.sk'], url: new URL(route(lang, 'domov'), site).href, inLanguage: lang, publisher: { '@id': organizacia['@id'] } }
  : null;
const breadcrumbs = drobceky.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ text: ui.nav.domov, href: route(lang, 'domov') }, ...drobceky].map((d, i) => ({
        '@type': 'ListItem', position: i + 1, name: d.text, ...(d.href ? { item: new URL(d.href, site).href } : {}),
      })),
    }
  : null;
const ld = [organizacia, ...(web ? [web] : []), ...(breadcrumbs ? [breadcrumbs] : []), ...jsonLd];

/* Prechod medzi stránkami: hlavička stojí, obsah starej stránky rýchlo zmizne a nový vystúpi.
   Rendery s rovnakým menom (transition:name) medzitým preletia na svoje miesto na novej stránke.
   Kľúčové snímky sú v global.css, pri „obmedziť pohyb“ ich prehliadač nespustí. */
const prechod = { old: { name: 'mfx-von', duration: '160ms', easing: 'cubic-bezier(0.4, 0, 1, 1)', fillMode: 'both' }, new: { name: 'mfx-dnu', duration: '440ms', easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)', delay: '40ms', fillMode: 'both' } };
// Späť (tlačidlo prehliadača): obsah prichádza zhora, akoby sa človek vrátil o krok vyššie.
const spat = { ...prechod, new: { ...prechod.new, name: 'mfx-dnu-spat' } };
const stranka = { forwards: prechod, backwards: spat };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={popis} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="alternate" hreflang="sk" href={new URL(alternates.sk, site).href} />
    <link rel="alternate" hreflang="cs" href={new URL(alternates.cs, site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.sk, site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={popis} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LOCALE[lang].replace('-', '_')} />
    <meta property="og:site_name" content={ui.site.name} />
    <meta property="og:image" content={new URL(ogCesta, site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <ClientRouter />
  </head>
  <body>
    <Hlavicka lang={lang} aktivna={aktivna} alternates={alternates} />
    {vizualneDrobceky && drobceky.length > 0 && (
      <div class="wrap">
        <ol class="crumbs" aria-label={ui.crumbs.label}>
          <li><a href={route(lang, 'domov')}>{ui.nav.domov}</a></li>
          {drobceky.map((d) => (d.href ? <li><a href={d.href}>{d.text}</a></li> : <li aria-current="page">{d.text}</li>))}
        </ol>
      </div>
    )}
    <main id="obsah" transition:animate={stranka}>
      <slot />
    </main>
    <div class="paticka-obal" transition:animate={stranka}><Paticka lang={lang} /></div>
    <script src="../scripts/pohyb.ts"></script>
  </body>
</html>
