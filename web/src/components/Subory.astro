---
/**
 * Podklady výrobcu na stiahnutie ako dokumenty na stole (Juraj 22. 10. 2026, návrh B). Od 3. 11. 2026
 * (variant A z 1. 11.) ukazuje každý list skutočný obsah: obálku katalógu a brožúry, prvú stranu PDF
 * alebo výkres (data/nahlady_dokumentov.py). Pod listom druh a doplnok („Výkres DWG“ + „DUO a DUO
 * PRIMO …“), názov len raz. Výkres je list A3 naležato cez dva stĺpce; DWG a DXF je ten istý výkres,
 * preto jeden list a DXF ako odkaz pod ním. Podklad bez náhľadu je list s veľkou skratkou formátu.
 * Katalóg vedie priamo na PDF, ostatné na stránku podkladu na watts.eu.
 */
import Obraz from './Obraz.astro';
import { nahladSuboru, popisSuboru, type Subor } from '../lib/subory';
import { fotka, nahladDokumentu } from '../lib/obrazky';
import { type Lang, KATALOG_PDF } from '../i18n/ui';
interface Props { subory: Subor[]; lang: Lang }
const { subory, lang } = Astro.props;
// Katalóg a brožúra prvé, za nimi výkres (na telefóne celý riadok, takže v mriežke neostane diera),
// potom technické listy, vyhlásenia a EPD.
const poradie: Record<string, number> = { katalog: 0, brozura: 1, vykres: 2, list: 3, zhoda: 4, iny: 5, epd: 6 };
const obalky: Partial<Record<string, ReturnType<typeof fotka>>> = { katalog: fotka('katalog-obalka.jpg'), brozura: fotka('brozura-obalka.jpg') };
const vsetky = subory.map((s) => { const p = popisSuboru(s, lang); return { ...p, url: p.druh === 'katalog' ? KATALOG_PDF : s.url, obalka: obalky[p.druh] ?? nahladDokumentu(nahladSuboru(s)) }; });
const dvojca = (p: (typeof vsetky)[number], typ: string) => vsetky.find((q) => q.druh === 'vykres' && q.typ === typ && q.meta === p.meta);
const polozky = vsetky
  .filter((p) => !(p.typ === 'DXF' && dvojca(p, 'DWG')))
  .map((p) => ({ ...p, dxf: p.typ === 'DWG' ? dvojca(p, 'DXF') : undefined, a3: p.druh === 'vykres' && Boolean(p.obalka) }))
  .sort((a, b) => poradie[a.druh] - poradie[b.druh]);
const ajDxf = lang === 'cs' ? 'I ve formátu DXF' : 'Aj vo formáte DXF';
---
<ul class="stol">
  {polozky.map((p) => (
    <li class:list={{ a3: p.a3 }}>
      <a class="dok" href={p.url} target="_blank" rel="noopener">
        {p.obalka ? (
          <span class="list"><Obraz src={p.obalka} alt="" widths={p.a3 ? [480, 920] : [240, 460]} sizes={p.a3 ? '(max-width: 760px) 92vw, 440px' : '(max-width: 760px) 44vw, 220px'} /></span>
        ) : (
          // Výkres: v rohovej pečiatke, čo zobrazuje; ostatné listy majú názov ako titulná strana.
          <span class:list={['list', 'format', `format-${p.druh}`]}><b>{p.typ}</b>{p.druh === 'vykres' ? p.meta && <em>{p.meta}</em> : <em>{p.nazov}{p.meta && <small>{p.meta}</small>}</em>}</span>
        )}
        <strong>{p.nazov}</strong>
        {p.meta && p.obalka && <span class="meta">{p.meta}</span>}
      </a>
      {p.dxf && <a class="odkaz dxf" href={p.dxf.url} target="_blank" rel="noopener" aria-label={`${ajDxf}: ${p.dxf.meta}`}>{ajDxf}</a>}
    </li>
  ))}
</ul>

<style>
  .stol { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 36px 28px; align-items: end; }
  .dok { display: flex; flex-direction: column; gap: 4px; color: var(--color-ink); }
  .dok strong { margin-top: 16px; font-family: var(--font-display); font-stretch: 112.5%; font-size: 17px; line-height: 1.25; transition: color 150ms var(--ease-soft); }
  .dok:hover { color: var(--color-ink); }
  .dok:hover strong { color: var(--color-blue-700); }
  .meta { font-size: 14px; color: var(--color-ink-soft); }
  /* Dokument ako list papiera: pomer A4, tieň, striedavo jemne natočený; pri prejdení sa zdvihne a narovná. */
  .list { position: relative; display: block; aspect-ratio: 210 / 297; border-radius: var(--radius-s); overflow: hidden; background: #fff; box-shadow: 0 1px 0 rgb(10 42 94 / 0.08), var(--elev-3); transform: rotate(var(--r, 0deg)); transition: transform 350ms var(--ease-soft), box-shadow 350ms var(--ease-soft); }
  .stol li:nth-child(odd) .list { --r: -1.2deg; }
  .stol li:nth-child(even) .list { --r: 1deg; }
  @media (hover: hover) and (pointer: fine) { .dok:hover .list { transform: translateY(-8px) rotate(0deg); box-shadow: 0 1px 0 rgb(10 42 94 / 0.08), var(--elev-4); } }
  .list :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* Výkres je list A3 naležato, teda dva listy A4 vedľa seba: na stole zaberá dva stĺpce. */
  .stol .a3 { grid-column: span 2; }
  .a3 .list { aspect-ratio: 420 / 297; }
  .dxf { margin-top: 8px; font-size: 14px; }
  /* Podklad bez obálky je biely list ako skutočný dokument vedľa obálok katalógu a brožúry, nie farebný
     blok (DOLADENIE kap. 2.2): hore formát, dole čo dokument obsahuje. Výkres má papier s jemnou
     mriežkou, rámik a rohovú pečiatku ako technický výkres. */
  .format { display: flex; flex-direction: column; justify-content: space-between; gap: 8px; padding: 16px; color: var(--color-blue-900); background: #fff; }
  .format b { position: relative; z-index: 1; align-self: flex-start; padding: 8px 8px 4px; border-radius: var(--radius-s); background: var(--color-blue-900); color: #fff;
    font-family: var(--font-display); font-stretch: 112.5%; font-weight: 700; font-size: 13px; line-height: 1; letter-spacing: 0.03em; }
  .format em { position: relative; z-index: 1; font-style: normal; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 15px; line-height: 1.25; text-wrap: balance; }
  .format em small { display: block; margin-top: 8px; font-family: var(--font-text); font-stretch: 100%; font-weight: 400; font-size: 13px; color: var(--color-ink-soft); }
  /* Zahnutý roh listu. */
  .format::before { content: ""; position: absolute; z-index: 2; top: 0; right: 0; width: 30px; height: 30px; background: linear-gradient(225deg, var(--zem-2) 50%, #dce5f0 50%); box-shadow: -2px 2px 4px rgb(10 42 94 / 0.12); }
  .format-vykres { background-color: #fff;
    background-image: linear-gradient(rgb(0 93 185 / 0.07) 1px, transparent 1px), linear-gradient(90deg, rgb(0 93 185 / 0.07) 1px, transparent 1px); background-size: 14px 14px; background-position: 8px 8px; }
  .format-vykres::after { content: ""; position: absolute; inset: 8px; border: 1px solid rgb(10 42 94 / 0.32); pointer-events: none; }
  .format-vykres b { margin: 4px 0 0 4px; }
  .format-vykres em { align-self: flex-end; max-width: 86%; margin: 0 -8px -8px 0; padding: 8px 8px; border: 1px solid rgb(10 42 94 / 0.32); background: #fff; font-size: 13px; }
  @media (max-width: 760px) { .stol { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 20px; } }
</style>
