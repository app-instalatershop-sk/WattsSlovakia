---
import Strana from '../../navrhy/Strana.astro';
import Mierka from '../../navrhy/Mierka.astro';
import varianty from '../../data/varianty.json';
import data from '../../data/navrhy/mierka-duo.json';

const cislo = (x: number, d = 2) => x.toLocaleString('sk-SK', { minimumFractionDigits: d, maximumFractionDigits: d });
const riadky = data.systemy.map((s) => {
  const v = varianty.find((x) => x.rad === 'microflex-duo-6-bar' && x.obj_cislo === s.obj)!;
  return {
    obj: v.obj_cislo, plast: v.plast_mm, rury: `2 × ${v.rura!.d} × ${cislo(v.rura!.s, 1)} mm`,
    polomer: `${cislo(v.polomer_ohybu_m!)} m`, hmotnost: `${cislo(v.hmotnost_kg_m!)} kg/m`,
    kotuc: v.kotuc ? `${cislo(v.kotuc.d)} / ${cislo(v.kotuc.sirka)} m` : '', bod: s.bod,
  };
});
---
<Strana cesta="/navrhy/mierka/" nadpis="5 Dimenzie v mierke"
  popis="Všetky dimenzie radu vedľa seba v skutočnom pomere veľkostí, nad tabuľkou variantov. Projektant hneď vidí, kedy sa zmení len rúra a kedy aj plášť, a riadok tabuľky ukáže, o ktorý rez ide. Prejdite myšou po riadkoch alebo po rezoch."
  kde="stránka radu, časť Varianty (nad tabuľkou), pre všetkých 12 radov">
  <Mierka cesta={data.cesta} pomer={data.pomer} krok={data.krok} riadky={riadky}
    nadpis="Microflex DUO, vykurovanie 6 bar: všetky dimenzie"
    popis="Osem dimenzií v plášťoch 125, 160 a 200 mm. Rezy stoja v jednej rovine a sú v skutočnom pomere veľkostí, ako na výkrese." />
</Strana>
