  /* ---------- Projekty: mozaika troch fotiek s kótami (návrh C) ---------- */
  .projekty { position: relative; padding-top: 24px; }
  .proj-hlava { position: relative; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 20px 56px; align-items: end; }
  .proj-hlava h2 { font-size: clamp(30px, 2.2vw + 14px, 46px); line-height: 1.06; letter-spacing: -0.025em; max-width: 12em; }
  .proj-uvod { color: var(--color-on-dark-muted); font-size: 17px; line-height: 1.55; max-width: 26em; }
  /* Šírky stĺpcov sú vypočítané tak, aby výška veľkej fotky (3 : 2) sedela s dvomi menšími (16 : 9) nad sebou. */
  .proj-mozaika { position: relative; display: grid; grid-template-columns: minmax(0, 1.765fr) minmax(0, 1fr); grid-template-rows: auto auto; gap: 24px; margin-top: 40px; }
