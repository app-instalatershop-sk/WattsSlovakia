---
/**
 * Pracovná stránka s návrhmi (Juraj 22. 10. 2026: „urob mi návrhy na časti, ktoré opakujú design na
 * iných stránkach, aby som sa vedel rozhodnúť“). Varianty sú zo skutočných dát a fotiek, nie makety.
 * Stránky /navrhy/ sú noindex a mimo sitemap; po rozhodnutí sa celý priečinok src/navrhy aj
 * src/pages/navrhy zmaže.
 */
import Base from '../layouts/Base.astro';
import { type Lang } from '../i18n/ui';

interface Props { nadpis: string; popis: string; kde?: string; varianty?: { pismeno: string; nazov: string }[]; cesta: string }
const { nadpis, popis, kde, varianty = [], cesta } = Astro.props;
const lang: Lang = 'sk';
const STRANKY = [
  ['/navrhy/', 'Prehľad'], ['/navrhy/hlava/', 'Hlava stránky'], ['/navrhy/zaver/', 'Záver stránky'], ['/navrhy/projekty/', 'Projekty na domove'],
  ['/navrhy/karty/', 'Karty radov a dielov'], ['/navrhy/rad/', 'Stavba a referencia radu'], ['/navrhy/firmy/', 'Fotky pre firmy'], ['/navrhy/podklady/', 'Podklady'],
];
---
<Base lang={lang} alternates={{ sk: cesta, cs: cesta }} title={`Návrhy: ${nadpis}`} description={`Pracovná stránka s návrhmi pre web Microflex Slovensko: ${popis}`} robots="noindex, nofollow">
  <div class="nv-hlava">
    <div class="wrap">
      <nav class="nv-stranky" aria-label="Návrhy">
        {STRANKY.map(([href, text]) => <a href={href} aria-current={href === cesta ? 'page' : undefined}>{text}</a>)}
      </nav>
      <h1>{nadpis}</h1>
      <p class="nv-popis">{popis}</p>
      {kde && <p class="nv-kde"><strong>Kde sa opakuje:</strong> {kde}</p>}
      {varianty.length > 0 && (
        <p class="nv-skok">{varianty.map((v) => <a href={`#v-${v.pismeno}`}><b>{v.pismeno}</b> {v.nazov}</a>)}</p>
      )}
    </div>
  </div>
  <slot />
  <div class="nv-koniec wrap">
    <p>Napíšte, ktorý variant chcete pri každej časti (napríklad „Hlava C, Záver B“). Varianty sa dajú aj kombinovať.</p>
  </div>
</Base>

<style>
  .nv-hlava { padding: 28px 0 36px; background: #0b1b33; color: #fff; }
  .nv-stranky { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 26px; }
  .nv-stranky a { padding: 7px 12px; border-radius: 999px; color: #c7d4e8; font-size: 14px; font-weight: 500; background: rgb(255 255 255 / 0.06); }
  .nv-stranky a:hover { color: #fff; background: rgb(255 255 255 / 0.12); }
  .nv-stranky a[aria-current] { color: var(--color-ink); background: var(--color-yellow-500); }
  .nv-hlava h1 { color: #fff; font-size: clamp(30px, 2vw + 16px, 44px); }
  .nv-popis { margin-top: 12px; max-width: 52em; color: #c7d4e8; font-size: 17px; line-height: 1.55; }
  .nv-kde { margin-top: 10px; color: #c7d4e8; font-size: 15px; }
  .nv-kde strong { color: #fff; }
  .nv-skok { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 22px; }
  .nv-skok a { color: #fff; font-weight: 500; }
  .nv-skok b { display: inline-grid; place-items: center; width: 26px; height: 26px; margin-right: 6px; border-radius: 8px; background: var(--color-yellow-500); color: var(--color-ink); font-family: var(--font-display); }
  .nv-koniec { padding-block: 56px 72px; }
  .nv-koniec p { font-size: 18px; font-weight: 500; max-width: 40em; }
</style>
