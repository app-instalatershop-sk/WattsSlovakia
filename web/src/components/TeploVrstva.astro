---
/**
 * Teplo v reze (Juraj 28. 10. 2026), vrstva nad renderom v hlave radu (slot „na-obraze“ v Hlava.astro):
 * ten istý záber ako obraz termokamery (data/blender/teplo.py, pohľad studio --termo; data/novinky_web.py teplo),
 * kóty s teplotami médií a plášťa a stratou z katalógu. Zapína ju prepínač TeploRezim (trieda je-termo na sekcii
 * hlavy, udalosť mfx:teplo); obraz sa stiahne až pri prvom zapnutí. Pri výbere dimenzie (udalosť mfx:variant
 * z VolbaDimenzie) sa vymení za záber presnej dimenzie a kóty sa presunú.
 * Bez tmavej obrazovky za výrobkom (Juraj 6. 11. 2026: „teplotná mapa nemá mať pozadie“): záber termokamery má
 * priehľadné pozadie a ten istý obrys ako render, ktorý prekryje; kontaktný tieň renderu pod ním ostáva. Kóty preto
 * stoja v prázdnom mieste okolo výrobku ako kóty rozmerov (smer a dĺžky počíta Rad.astro, kotyTepla).
 */
import Koty from './Koty.astro';
import type { Kota } from '../lib/koty';

export type KotaTepla = Pick<Kota, 'smer' | 'smerM' | 'l' | 'lM'> & { kod: string; x: number; y: number; hodnota: string; text: string };
export interface ZaberTepla { avif: string; webp: string; src: string; koty: KotaTepla[] }
interface Props { zabery: Record<string, ZaberTepla>; alt: string; label: string }
const { zabery, alt, label } = Astro.props;
const hlava = zabery[''];
const koty: Kota[] = hlava.koty.map((k) => ({ x: k.x, y: k.y, smer: k.smer, smerM: k.smerM, l: k.l, lM: k.lM, hodnota: k.hodnota, text: k.text, kod: k.kod }));
---
<div class="tv" data-teplo-vrstva>
  <picture class="tv-obr">
    <source type="image/avif" data-srcset={hlava.avif} sizes="(max-width: 760px) 100vw, 860px" />
    <img data-srcset={hlava.webp} data-src={hlava.src} sizes="(max-width: 760px) 100vw, 860px" alt={alt} width="1400" height="1224" decoding="async" />
  </picture>
  <Koty koty={koty} label={label} />
  <script type="application/json" data-teplo-zabery set:html={JSON.stringify(zabery)} />
</div>

<style>
  .tv { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .tv-obr :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* Teplota prejde cez výrobok zľava doprava ako snímanie termokamerou; pred čelom snímania je ešte render.
     <picture> potrebuje vlastný box: globálne má display: contents a orezanie by naň nepôsobilo (obraz tepla
     by ostal viditeľný aj v pohľade). */
  .tv-obr { display: block; position: absolute; inset: 0; clip-path: inset(0 100% 0 0); transition: clip-path 760ms cubic-bezier(0.65, 0, 0.35, 1); }
  .tv :global([data-koty]) { opacity: 0; transition: opacity 260ms var(--ease-soft); }
  :global(.je-termo) .tv-obr { clip-path: inset(0 0 0 0); }
  :global(.je-termo) .tv :global([data-koty]) { opacity: 1; transition-delay: 520ms; }
  /* V teplote kóty rozmerov a pás svetla po plášti zmiznú (patria k obrazu výrobku). */
  :global(.je-termo .hs-mys > [data-koty]), :global(.je-termo .hs-lesk) { opacity: 0; transition: opacity 200ms var(--ease-soft); }
  /* Telefón: štítok plášťa so stratou („plášť, strata 17,5 W/m“) visí pod telom vľavo, kde je len úzky kus obrazu;
     popis sa zalomí v mieste zlomu z dát („plášť,“ a pod ním strata), aby štítok nevyšiel za okraj displeja. */
  @media (max-width: 760px) { .tv :global(.k-tp .stitok > span) { white-space: pre; } }
  @media (prefers-reduced-motion: reduce) {
    .tv-obr, .tv :global([data-koty]) { transition: none; }
  }
</style>

<script>
  type KotaT = { kod: string; x: number; y: number; hodnota: string; text: string; l: number; lM?: number };
  type Zaber = { avif: string; webp: string; src: string; koty: KotaT[] };

  function initTeploVrstva() {
    document.querySelectorAll<HTMLElement>('[data-teplo-vrstva]:not([data-on])').forEach((vrstva) => {
      vrstva.dataset.on = '1';
      const zabery: Record<string, Zaber> = JSON.parse(vrstva.querySelector('[data-teplo-zabery]')!.textContent ?? '{}');
      const zdroj = vrstva.querySelector<HTMLSourceElement>('.tv-obr source')!;
      const img = vrstva.querySelector<HTMLImageElement>('.tv-obr img')!;
      const volba = document.querySelector<HTMLElement>('[data-volba]');
      let obj = volba?.dataset.aktivny ?? '';
      let nacitane = false;
      const ukaz = () => {
        const z = zabery[obj] ?? zabery[''];
        if (nacitane) {
          zdroj.srcset = z.avif;
          img.srcset = z.webp;
          img.src = z.src;
        }
        for (const k of z.koty) {
          const li = vrstva.querySelector<HTMLElement>(`.k-${k.kod}`);
          if (!li) continue;
          li.style.setProperty('--x', `${k.x}%`);
          li.style.setProperty('--y', `${k.y}%`);
          // Dĺžka čiary podľa polohy rúry v reze danej dimenzie: štítok ostane nad čelom alebo pod ním.
          li.style.setProperty('--l', String(k.l));
          if (k.lM !== undefined) li.style.setProperty('--lm', String(k.lM));
          li.querySelector('strong')!.textContent = k.hodnota;
          li.querySelector('.stitok > span')!.textContent = k.text;
        }
      };
      document.addEventListener('mfx:variant', (e) => {
        obj = (e as CustomEvent<{ obj: string | null }>).detail.obj ?? '';
        ukaz();
      });
      document.addEventListener('mfx:teplo', (e) => {
        if ((e as CustomEvent<{ on: boolean }>).detail.on && !nacitane) {
          nacitane = true;
          ukaz();
          // ostatné dimenzie vopred, aby prepínanie v teplote nečakalo na sieť
          window.setTimeout(() => Object.values(zabery).forEach((z) => { const p = new Image(); p.sizes = img.sizes; p.srcset = z.avif; }), 1200);
        }
      });
      ukaz();
    });
  }
  initTeploVrstva();
  document.addEventListener('astro:page-load', initTeploVrstva);
</script>
