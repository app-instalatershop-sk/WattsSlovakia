# Prístupy na hosting (web/nasadenie): FTP v .env, heslo schránky v dopyt.konfig.php. Do gitu ide z priečinka
# len to, čo je tu vymenované; každý iný súbor (.env, dopyt.konfig.php, ich kópie a zálohy) git ignoruje.
web/nasadenie/*
!web/nasadenie/nasad.mjs
!web/nasadenie/over.mjs
!web/nasadenie/env.vzor
!web/nasadenie/dopyt.konfig.vzor.php
