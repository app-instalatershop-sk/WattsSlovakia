---
/**
 * Katalóg na domove (Juraj 5. 11. 2026, verzia G2 „bento podľa použitia“): predstaví sortiment, nevyberá.
 * Výber krok za krokom robí sprievodca /vyber/, na ktorý sekcia odkazuje dvakrát (veta v úvode a tmavá dlaždica).
 * Každé použitie má dlaždicu s renderom systému (ten istý rad ako na stránke Potrubia a v hlave kategórie, preto aj
 * rovnaký prechod kat-<id>) a so všetkými svojimi radmi ako odkazmi s počtom dimenzií, takže počet radov sedí s tým,
 * čo je vidieť. Prvé použitie je veľká dlaždica, druhé stredná, ostatné malé. Pri názve je čelo rúry (výrez prierezu,
 * data/cela_rur.py): farba nosných rúr ukáže médium bez ikony. Spojky a príslušenstvo majú vlastné dlaždice
 * s fotkami výrobkov. Bez vlasových čiar, plochy nesú hĺbku tieňom (DESIGN.md kap. 9).
 */
import { getCollection } from 'astro:content';
import Obraz from './Obraz.astro';
import Ikona from './Ikona.astro';
import { kategorie, cestaKategorie, cestaRadu, kKratky, kPopis, rNazov, tlakyRadov, type Kategoria, type Rad } from '../lib/katalog';
import { obrazPiktogramu, radPiktogramu, render3d, fotkaProduktu } from '../lib/obrazky';
import { sadzba } from '../lib/sadzba';
import { type Lang, t, route } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const h = ui.home;

const kats = await kategorie();
const rady = (await getCollection('rady')).map((r) => r.data);
const varianty = (await getCollection('varianty')).map((v) => v.data);
const produkty = (await getCollection('produkty')).map((p) => p.data);
const potrubia = kats.filter((k) => k.typ === 'potrubie');
const diely = kats.filter((k) => k.typ !== 'potrubie');

const radyKat = (k: Kategoria) => rady.filter((r) => r.kategoria === k.id).sort((a, b) => a.poradie - b.poradie);
const pocetRadov = potrubia.reduce((n, k) => n + radyKat(k).length, 0);
/** „Microflex UNO, vykurovanie 6 bar“ → „Microflex UNO“; v dlaždici s viacerými radmi stačí „UNO“ (použitie je v nadpise). */
const model = (r: Rad) => rNazov(r, lang).split(',')[0].trim();
const kratko = (r: Rad) => model(r).replace(/^Microflex\s+/, '');
const dimenzie = (r: Rad) => { const n = varianty.filter((v) => v.rad === r.id).length; return n ? ui.sklonovanie.dimenzii(n) : ''; };
const prvaVeta = (s: string) => s.split(/(?<=\.)\s/)[0];
const tlak = (rr: Rad[]) => { const t = tlakyRadov(rr); return t.length ? `${t.join(' / ')} bar` : ''; };
const velkost = (i: number) => (i === 0 ? 'dl-vel' : i === 1 ? 'dl-str' : 'dl-mal');
const SIZES: Record<string, string> = {
  'dl-vel': '(max-width: 760px) 40vw, (max-width: 1100px) 50vw, 420px',
  'dl-str': '(max-width: 760px) 40vw, 280px',
  'dl-mal': '(max-width: 760px) 40vw, 280px',
};
// Typické výrobky na dlaždici dielov: rôzne tvary, aby bolo na prvý pohľad jasné, čo v skupine je.
const FOTKY_DIELOV: Record<string, string[]> = {
  spojky: ['pe-x-spojka-kurenie-cool-6-16bar', '3-x-ohrev-spojky-pe-x-t', 'pe-x-x-pe-x-koleno-spojky-vykurovanie', 't-kus-z-bronzu'],
  prislusenstvo: ['teplom-zmrstitelne-hlavice-pre-rurku-duo', 'izolovana-suprava-t-kusu', 'tesnenie-na-prienik-na-stenu-micro-press', 'vystrazna-paska'],
};
const pocetVyrobkov = (k: Kategoria) => produkty.filter((p) => p.kategoria === k.id).length;
---
<section id="vyber" class="section katalog" aria-labelledby="h-kat">
  <div class="wrap">
    <div class="kat-hlava">
      <h2 id="h-kat">{h.katalogH2}</h2>
      <div class="kat-uvod">
        <p>{sadzba(h.katalogLead(pocetRadov, potrubia.length))} {sadzba(h.katalogNeviete)}<a href={route(lang, 'vyber')}>{sadzba(h.katalogSprievodca)}</a>.</p>
        <a class="kat-vsetko" href={route(lang, 'potrubia')}>{h.celyKatalog} <Ikona nazov="arrow-right" velkost={16} /></a>
      </div>
    </div>

    <div class="bento">
      {potrubia.map((k, i) => {
        const rr = radyKat(k);
        const rad = radPiktogramu(k.piktogram);
        const img = obrazPiktogramu(k.piktogram);
        const celo = render3d('cela', rad);
        const tl = tlak(rr);
        return (
          <article class:list={['dl', velkost(i)]} aria-labelledby={`h-pouzitie-${k.id}`}>
            <div class="dl-text">
              <div class="dl-hlava">
                {celo && <span class="celo"><Obraz src={celo} alt="" width={44} densities={[1, 2]} /></span>}
                <div>
                  <h3 id={`h-pouzitie-${k.id}`}><a href={cestaKategorie(k, lang)}>{kKratky(k, lang)}</a></h3>
                  <span class="dl-sub">{ui.sklonovanie.radov(rr.length)}{tl && ` · ${tl}`}</span>
                </div>
              </div>
              <p>{sadzba(prvaVeta(kPopis(k, lang)))}</p>
            </div>
            {img && <div class="dl-obr" style={`view-transition-name: kat-${k.id}`}><Obraz src={img} alt="" widths={[280, 420, 560, 840]} sizes={SIZES[velkost(i)]} /></div>}
            <ul class="dl-rady">
              {rr.map((r) => (
                <li><a href={cestaRadu(k, r, lang)}><strong>{sadzba(rr.length > 1 ? kratko(r) : model(r))}</strong><span>{dimenzie(r)}</span><Ikona nazov="chevron-right" velkost={16} /></a></li>
              ))}
            </ul>
          </article>
        );
      })}

      {diely.map((k) => (
        <a class="dl dl-diel" href={cestaKategorie(k, lang)}>
          <span class="dl-diel-t">
            <span class="dl-diel-h"><span class="dl-diel-n">{kKratky(k, lang)}</span><span class="dl-pocet">{ui.sklonovanie.vyrobkov(pocetVyrobkov(k))}</span></span>
            <span class="dl-diel-p">{sadzba(prvaVeta(kPopis(k, lang)))}</span>
          </span>
          <span class="dl-fotky">
            {(FOTKY_DIELOV[k.id] ?? []).map(fotkaProduktu).filter(Boolean).map((f) => <span><Obraz src={f!} alt="" width={96} densities={[1, 2]} /></span>)}
          </span>
          <Ikona nazov="arrow-right" velkost={20} class="dl-sipka" />
        </a>
      ))}

      <a class="dl dl-sprievodca" href={route(lang, 'vyber')}>
        <span class="dl-sp-h">{h.sprievodcaH}</span>
        <span class="dl-sp-p">{sadzba(h.sprievodcaP)}</span>
        <span class="dl-sp-cta">{h.sprievodcaCta} <Ikona nazov="arrow-right" velkost={18} /></span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Pás sa podsunie pod spodok hero a má šikmú hornú hranu ako podzemie: vľavo začína pod textom hero,
     vpravo vyššie, takže ju spodok renderu pretína. Dole ostáva miesto pre render rodiny, ktorý
     zhora prechádza cez švík do sekcie pod ním. */
  .katalog { position: relative; isolation: isolate; margin-top: calc(-1 * var(--presah-hero)); padding-top: calc(var(--presah-hero) + 84px); padding-bottom: 200px; scroll-margin-top: calc(72px - var(--presah-hero)); overflow-x: clip; }
  /* Pás siaha o 1 px pod sekciu: pri zlomkovej výške by medzi ním a rodinou ostala svetlá vlasová škára. */
  .katalog::before { content: ""; position: absolute; inset: 0 0 -1px; z-index: -1; background: linear-gradient(180deg, var(--zem-1) 0%, var(--zem-2) 100%);
    -webkit-mask: var(--hrana-ohyb) left top / 100% var(--presah-hero) no-repeat, linear-gradient(#000 0 0) left var(--presah-hero) / 100% 100% no-repeat;
    mask: var(--hrana-ohyb) left top / 100% var(--presah-hero) no-repeat, linear-gradient(#000 0 0) left var(--presah-hero) / 100% 100% no-repeat; }
  .katalog h2 { margin: 0; font-size: clamp(28px, 2.2vw + 14px, 42px); text-wrap: balance; }

  /* Úvod: nadpis vľavo, vpravo veta s odkazom na sprievodcu a celý katalóg. */
  .kat-hlava { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: 48px; align-items: end; }
  .kat-uvod p { margin: 0; font-size: 17px; line-height: 1.5; color: var(--color-ink-soft); max-width: 30em; }
  .kat-uvod p a { font-weight: 600; }
  .kat-vsetko { margin-top: 12px; display: inline-flex; align-items: center; gap: 8px; font-weight: 600; }
  .kat-vsetko :global(svg) { width: 16px; height: 16px; }

  /* Bento na mriežke 12 stĺpcov: 7 + 5, 4 + 4 + 4, 5 + 5 + 2. */
  .bento { margin-top: 32px; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px; }
  .dl { position: relative; display: grid; border-radius: var(--radius-xl); color: var(--color-ink);
    background: radial-gradient(90% 90% at 78% 62%, var(--color-white) 0%, var(--sklo-3) 40%, var(--color-blue-50) 100%);
    box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.06), var(--elev-3); }
  .dl-text { display: flex; flex-direction: column; padding: 24px 24px 0; }
  .dl-hlava { display: grid; grid-template-columns: 44px minmax(0, 1fr); align-items: center; gap: 12px; }
  .celo { display: block; width: 44px; height: 44px; border-radius: 50%; overflow: hidden; background: var(--color-white); box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.1); }
  .celo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .dl h3 { margin: 0; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 650; font-size: 22px; line-height: 1.2; letter-spacing: -0.01em; }
  .dl h3 a { color: inherit; text-decoration: none; }
  .dl-sub { display: block; margin-top: 2px; font-size: 13px; color: var(--color-ink-soft); font-variant-numeric: tabular-nums; }
  .dl-text p { margin: 16px 0 0; font-size: 15px; line-height: 1.5; color: var(--color-ink-soft); max-width: 30em; }
  .dl-obr { display: grid; place-items: center; }
  .dl-obr :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: contain; }

  /* Rady použitia: viditeľné odkazy s počtom dimenzií. */
  .dl-rady { list-style: none; margin: 0; padding: 20px 24px 24px; display: grid; gap: 8px; align-content: end; }
  .dl-rady a { display: grid; grid-template-columns: minmax(0, 1fr) auto 16px; align-items: center; gap: 12px; min-height: 44px; padding: 0 12px 0 16px; border-radius: var(--radius-m);
    background: var(--sklo-2); box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.1); color: var(--color-ink); text-decoration: none;
    transition: background-color 150ms var(--ease-soft), box-shadow 150ms var(--ease-soft); }
  .dl-rady strong { font-size: 15px; font-weight: 600; }
  .dl-rady span { font-size: 13px; color: var(--color-ink-soft); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .dl-rady :global(svg) { width: 16px; height: 16px; color: var(--color-blue-700); transition: transform 150ms var(--ease-soft); }

  /* Veľká: text a rady vľavo, výrobok vpravo cez celú výšku. */
  .dl-vel { grid-column: span 7; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); grid-template-rows: auto 1fr; }
  .dl-vel .dl-text { grid-column: 1; grid-row: 1; }
  .dl-vel .dl-rady { grid-column: 1; grid-row: 2; }
  .dl-vel .dl-obr { grid-column: 2; grid-row: 1 / -1; padding: 16px 12px 16px 0; }
  /* Stredná: hlavička cez celú šírku, pod ňou rady vľavo a výrobok vpravo. */
  .dl-str { grid-column: span 5; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-rows: auto 1fr; }
  .dl-str .dl-text { grid-column: 1 / -1; grid-row: 1; }
  .dl-str .dl-rady { grid-column: 1; grid-row: 2; padding-right: 0; }
  .dl-str .dl-obr { grid-column: 2; grid-row: 2; align-self: end; padding: 0 12px 16px 4px; }
  /* Malá: hlavička, výrobok a rady pod sebou. */
  .dl-mal { grid-column: span 4; grid-template-rows: auto 1fr auto; }
  .dl-mal .dl-obr { padding: 4px 32px 0; }
  .dl-mal .dl-obr :global(img) { max-width: 280px; }

  /* Spojky a príslušenstvo: celá dlaždica je odkaz na kategóriu, fotky ukážu typické výrobky. */
  .dl-diel { grid-column: span 5; grid-template-columns: minmax(0, 1fr); gap: 16px; padding: 24px; text-decoration: none; background: linear-gradient(180deg, var(--color-white) 0%, var(--color-blue-50) 100%); }
  .dl-diel-t { display: block; padding-right: 32px; }
  .dl-diel-h { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 12px; }
  .dl-diel-n { font-family: var(--font-display); font-stretch: 112.5%; font-weight: 650; font-size: 22px; line-height: 1.2; letter-spacing: -0.01em; }
  .dl-pocet { font-size: 13px; color: var(--color-ink-soft); font-variant-numeric: tabular-nums; }
  .dl-diel-p { display: block; margin-top: 8px; font-size: 15px; line-height: 1.5; color: var(--color-ink-soft); }
  .dl-fotky { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
  .dl-fotky > span { display: grid; place-items: center; height: 96px; border-radius: var(--radius-l); background: var(--color-white); box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.06); }
  .dl-fotky :global(img) { width: auto; max-width: 80%; height: auto; max-height: 76px; object-fit: contain; }
  .dl-diel :global(.dl-sipka) { position: absolute; top: 28px; right: 24px; width: 20px; height: 20px; color: var(--color-blue-700); transition: transform 150ms var(--ease-soft); }

  /* Sprievodca výberom: jediná tmavá plocha v sekcii, vedie na /vyber/. */
  .dl-sprievodca { grid-column: span 2; display: flex; flex-direction: column; gap: 12px; padding: 24px 20px; background: var(--color-blue-900); color: var(--color-white); text-decoration: none; box-shadow: var(--elev-3);
    transition: background-color 150ms var(--ease-soft); }
  .dl-sp-h { font-family: var(--font-display); font-stretch: 112.5%; font-size: 20px; font-weight: 650; line-height: 1.2; }
  .dl-sp-p { font-size: 14px; line-height: 1.45; color: var(--color-on-dark-muted); }
  .dl-sp-cta { margin-top: auto; display: inline-flex; align-items: center; gap: 8px; font-weight: 600; }
  .dl-sp-cta :global(svg) { width: 18px; height: 18px; flex: none; transition: transform 150ms var(--ease-soft); }

  @media (hover: hover) and (pointer: fine) {
    .dl h3 a:hover { color: var(--color-blue-700); }
    .dl-rady a:hover { background: var(--color-white); box-shadow: inset 0 0 0 1px var(--color-blue-700); }
    .dl-rady a:hover :global(svg), .dl-diel:hover :global(.dl-sipka), .dl-sprievodca:hover .dl-sp-cta :global(svg) { transform: translateX(3px); }
    .dl-diel:hover .dl-diel-n { color: var(--color-blue-700); }
    .dl-sprievodca:hover { background: var(--color-blue-800); }
  }

  /* Tablet: veľká dlaždica cez celú šírku, ostatné po dvoch, sprievodca ako pás. */
  @media (max-width: 1100px) {
    .katalog { padding-bottom: 140px; }
    .kat-hlava { grid-template-columns: minmax(0, 1fr); row-gap: 12px; }
    .dl-vel { grid-column: 1 / -1; }
    .dl-str, .dl-mal, .dl-diel { grid-column: span 6; }
    .dl-str { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr auto; }
    .dl-str .dl-text, .dl-str .dl-obr, .dl-str .dl-rady { grid-column: 1; grid-row: auto; }
    .dl-str .dl-obr { align-self: auto; padding: 4px 32px 0; }
    .dl-str .dl-obr :global(img) { max-width: 280px; }
    .dl-str .dl-rady { padding-right: 24px; }
    .dl-sprievodca { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; }
    .dl-sp-cta { margin-top: 0; margin-left: auto; }
  }
  /* Telefón: dlaždice pod sebou, text vľavo a výrobok vpravo, rady pod nimi; veta o použití odpadne. */
  @media (max-width: 760px) {
    .katalog { padding-top: calc(var(--presah-hero) + 52px); padding-bottom: 100px; }
    .bento { margin-top: 24px; grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .dl-vel, .dl-str, .dl-mal, .dl-diel, .dl-sprievodca { grid-column: 1; }
    .dl-vel, .dl-str, .dl-mal { grid-template-columns: minmax(0, 1fr) 40%; grid-template-rows: auto auto; }
    .dl-vel .dl-text, .dl-str .dl-text, .dl-mal .dl-text { grid-column: 1; grid-row: 1; padding: 16px 8px 8px 16px; }
    .dl-vel .dl-obr, .dl-str .dl-obr, .dl-mal .dl-obr { grid-column: 2; grid-row: 1; align-self: center; padding: 8px 8px 0 0; }
    .dl-vel .dl-rady, .dl-str .dl-rady, .dl-mal .dl-rady { grid-column: 1 / -1; grid-row: 2; padding: 4px 16px 16px; }
    .dl-text p { display: none; }
    .dl-hlava { grid-template-columns: 36px minmax(0, 1fr); gap: 8px; }
    .celo { width: 36px; height: 36px; }
    .dl h3 { font-size: 18px; }
    .dl-diel { padding: 16px; }
    .dl-diel :global(.dl-sipka) { top: 20px; right: 16px; }
    .dl-fotky > span { height: 72px; }
    .dl-fotky :global(img) { max-height: 56px; }
    .dl-sprievodca { flex-direction: column; align-items: flex-start; padding: 20px; }
    .dl-sp-cta { margin-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dl-rady a, .dl-rady :global(svg), .dl-diel :global(.dl-sipka), .dl-sprievodca, .dl-sp-cta :global(svg) { transition: none; }
  }
</style>
