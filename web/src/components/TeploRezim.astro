---
/**
 * Prepínač „Pohľad / Teplota“ v hlave radu: zapne obraz termokamery (TeploVrstva) a vedľa prepínača ukáže príklad
 * prevádzky a stupnicu teplôt. Od 6. 11. 2026 je pod renderom v produktovej karte (Hlava rozlozenie="karta", slot
 * „pod-obrazom“), lebo ovláda obraz, nie výber; oba stavy majú rovnaký tmavomodrý jazdec a ikonu (oko, teplomer),
 * farby teplôt sú v stupnici, nie na tlačidle. Bez skriptu je skrytý (vrstva tepla sa bez neho nedá zapnúť).
 */
import Ikona from './Ikona.astro';
interface Props { texty: { rezim: string; pohlad: string; teplota: string; stupnica: string }; podmienky: string; rozsah: number[]; paleta: [number, [number, number, number]][] }
const { texty, podmienky, rozsah, paleta } = Astro.props;
const stupne = (t: number) => `${Math.round(t)} °C`;
const gradient = `linear-gradient(90deg, ${paleta.map(([t, c]) => `rgb(${c.map((x) => Math.round(x * 255)).join(' ')}) ${Math.round(t * 100)}%`).join(', ')})`;
---
<div class="tr" data-teplo-rezim hidden>
  <div class="tr-seg" role="group" aria-label={texty.rezim}>
    <button type="button" data-rezim="foto" aria-pressed="true"><Ikona nazov="eye" velkost={16} />{texty.pohlad}</button>
    <button type="button" data-rezim="termo" aria-pressed="false"><Ikona nazov="thermometer" velkost={16} />{texty.teplota}</button>
  </div>
  <div class="tr-legenda" data-legenda hidden>
    <p>{podmienky}</p>
    <div class="tr-stupnica" style={`background: ${gradient}`} role="img" aria-label={`${texty.stupnica}: ${stupne(rozsah[0])} až ${stupne(rozsah[1])}`}></div>
    <div class="tr-osi" aria-hidden="true"><span>{stupne(rozsah[0])}</span><span>{stupne((rozsah[0] + rozsah[1]) / 2)}</span><span>{stupne(rozsah[1])}</span></div>
  </div>
</div>

<style>
  .tr { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 12px 24px; }
  .tr[hidden] { display: none; }
  .tr-seg { display: inline-flex; flex: none; gap: 2px; padding: 4px; border-radius: var(--radius-l); background: var(--sklo-2); box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.1), var(--elev-1); }
  .tr-seg button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 40px; padding: 0 16px; border: 0; border-radius: var(--radius-m); background: transparent;
    font: 600 15px/1 var(--font-display); font-stretch: 112.5%; color: var(--color-ink); cursor: pointer; transition: background 260ms var(--ease-soft), color 200ms var(--ease-soft); }
  .tr-seg button :global(.icon) { opacity: 0.8; }
  .tr-seg button[aria-pressed="true"] { color: #fff; background: linear-gradient(180deg, #123a7a 0%, var(--color-blue-900) 100%); box-shadow: var(--elev-1); }
  .tr-seg button:focus-visible { outline: 3px solid var(--color-yellow-500); outline-offset: 2px; }
  @media (hover: hover) and (pointer: fine) { .tr-seg button[aria-pressed="false"]:hover { color: var(--color-blue-700); } }
  /* Legenda vedľa prepínača: podmienky príkladu a stupnica s krajnými teplotami. */
  .tr-legenda { flex: 1 1 260px; max-width: 440px; animation: tr-prichod 300ms var(--ease-soft) both; }
  .tr-legenda[hidden] { display: none; }
  .tr-legenda p { font-size: 13px; line-height: 1.45; color: var(--color-ink-soft); }
  .tr-stupnica { height: 8px; margin-top: 8px; border-radius: var(--radius-s); box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.08); }
  .tr-osi { display: flex; justify-content: space-between; margin-top: 4px; font-size: 12px; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--color-ink-soft); }
  @keyframes tr-prichod { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .tr-legenda { animation: none; } .tr-seg button { transition: none; } }
  /* Užší stĺpec obrazu (tablet, telefón): legenda pod prepínačom, nie vedľa neho (vedľa by mala štyri riadky a siahla
     by po štítkoch pod rezom). */
  @media (max-width: 1100px) { .tr-legenda { flex-basis: 100%; max-width: 520px; } }
</style>

<script>
  function initTeploRezim() {
    document.querySelectorAll<HTMLElement>('[data-teplo-rezim]:not([data-on])').forEach((koren) => {
      koren.dataset.on = '1';
      koren.hidden = false;
      const hlava = koren.closest('section') ?? document.body;
      const legenda = koren.querySelector<HTMLElement>('[data-legenda]')!;
      const tlacidla = [...koren.querySelectorAll<HTMLButtonElement>('[data-rezim]')];
      tlacidla.forEach((b) => b.addEventListener('click', () => {
        const on = b.dataset.rezim === 'termo';
        if (hlava.classList.contains('je-termo') === on) return;
        hlava.classList.toggle('je-termo', on);
        legenda.hidden = !on;
        tlacidla.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        document.dispatchEvent(new CustomEvent('mfx:teplo', { detail: { on } }));
      }));
    });
  }
  initTeploRezim();
  document.addEventListener('astro:page-load', initTeploRezim);
</script>
