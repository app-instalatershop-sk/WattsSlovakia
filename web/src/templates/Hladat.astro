---
/**
 * Hľadanie podľa obj. čísla, radu, dimenzie a názvu dielu. Index je statický JSON (lib/hladanie.ts),
 * hľadá sa v prehliadači: bez diakritiky, „x“ aj „×“, obj. číslo aj s medzerami. Adresa ?q= je
 * zdieľateľná a vedie sem aj hľadanie v hlavičke.
 */
import Base from '../layouts/Base.astro';
import Hlava from '../components/Hlava.astro';
import Zaver from '../components/Zaver.astro';
import Ikona from '../components/Ikona.astro';
import { type Lang, route, staticAlternates } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = {
  sk: {
    title: 'Hľadanie', desc: 'Hľadanie v potrubiach, spojkách a príslušenstve Microflex podľa obj. čísla, radu, dimenzie alebo názvu.',
    lead: 'Obj. číslo, rad, dimenzia, názov dielu alebo bežné slová. Napríklad M9032C, DUO 125/32, kúrenie alebo T-spojka.',
    placeholder: 'Obj. číslo, rad, dimenzia', hladat: 'Hľadať',
    skupiny: { rad: 'Rady potrubia', kod: 'Obj. čísla', diel: 'Spojky a príslušenstvo', stranka: 'Stránky' },
    vysledkov: (n: number) => (n === 1 ? '1 výsledok' : n >= 2 && n <= 4 ? `${n} výsledky` : `${n} výsledkov`),
    pre: 'pre', viac: (n: number) => `Zobraziť ďalšie (${n})`,
    nic: 'Nič sme nenašli.', nicP: 'Skúste kratší výraz, obj. číslo bez medzier alebo len rad (UNO, DUO, QUADRO). Pomôžeme aj telefonicky.',
    skuste: 'Skúste napríklad', navrhy: ['M9032C', 'DUO 125/32', 'kúrenie', 'tepelné čerpadlo', 'T-spojka', 'izolačná sada'],
    kontakt: 'Kontakt', sprievodca: 'Sprievodca výberom',
    ciastocne: 'Presnú zhodu sme nenašli. Najbližšie:',
  },
  cs: {
    title: 'Hledání', desc: 'Hledání v potrubí, spojkách a příslušenství Microflex podle obj. čísla, řady, dimenze nebo názvu.',
    lead: 'Obj. číslo, řada, dimenze, název dílu nebo běžná slova. Například M9032C, DUO 125/32, topení nebo T-spojka.',
    placeholder: 'Obj. číslo, řada, dimenze', hladat: 'Hledat',
    skupiny: { rad: 'Řady potrubí', kod: 'Obj. čísla', diel: 'Spojky a příslušenství', stranka: 'Stránky' },
    vysledkov: (n: number) => (n === 1 ? '1 výsledek' : n >= 2 && n <= 4 ? `${n} výsledky` : `${n} výsledků`),
    pre: 'pro', viac: (n: number) => `Zobrazit další (${n})`,
    nic: 'Nic jsme nenašli.', nicP: 'Zkuste kratší výraz, obj. číslo bez mezer nebo jen řadu (UNO, DUO, QUADRO). Pomůžeme i telefonicky.',
    skuste: 'Zkuste například', navrhy: ['M9032C', 'DUO 125/32', 'topení', 'tepelné čerpadlo', 'T-spojka', 'izolační sada'],
    kontakt: 'Kontakt', sprievodca: 'Průvodce výběrem',
    ciastocne: 'Přesnou shodu jsme nenašli. Nejbližší:',
  },
}[lang];
const index = lang === 'cs' ? '/cs/hledat/index.json' : '/hladat/index.json';
const texty = { skupiny: tx.skupiny, vysledkov: [tx.vysledkov(1), tx.vysledkov(2), tx.vysledkov(5)], pre: tx.pre, viac: tx.viac(0), ciastocne: tx.ciastocne };
---
<Base lang={lang} alternates={staticAlternates('hladat')} title={tx.title} description={tx.desc} drobceky={[{ text: tx.title }]} vizualneDrobceky={false} robots="noindex, follow">
  <Hlava lang={lang} nadpis={tx.title} drobceky={[{ text: tx.title }]} lead={tx.lead}>
    <form class="hl-form" role="search" aria-label={tx.title} action={route(lang, 'hladat')} method="get" data-hl-form>
      <Ikona nazov="search" velkost={22} />
      <input name="q" type="search" placeholder={tx.placeholder} aria-label={tx.placeholder} autocomplete="off" data-hl-q />
      <button type="submit" class="btn btn-yellow">{tx.hladat}</button>
    </form>
    <p class="hl-navrhy"><span>{tx.skuste}:</span> {tx.navrhy.map((n) => <a href={`${route(lang, 'hladat')}?q=${encodeURIComponent(n)}`} data-hl-navrh>{n}</a>)}</p>
  </Hlava>

  {/* Pri hľadaní (?q=) sa výsledky dočítajú až po načítaní stránky: miesto pre ne je vyhradené vopred, inak by
      odsunuli záver, ktorý je na prvej obrazovke (CLS 0,43, polish 1. 11.). Trieda sa nastaví ešte pred vykreslením. */}
  <script is:inline>if (new URLSearchParams(location.search).get('q')) document.documentElement.classList.add('hl-dotaz');</script>
  <div class="telo">
    <section class="wrap hl-sekcia" aria-live="polite">
      <p class="hl-stav" data-hl-stav></p>
      <template data-hl-ikona><Ikona nazov="chevron-right" velkost={16} /></template>
      <template data-hl-ikona-ext><Ikona nazov="external-link" velkost={15} /></template>
      <div class="hl-vysledky" data-hl-vysledky data-index={index} data-texty={JSON.stringify(texty)}></div>
      <div class="harok hl-nic" data-hl-nic hidden>
        <h2>{tx.nic}</h2>
        <p>{tx.nicP}</p>
        <p class="hl-nic-odkazy">
          <a class="odkaz" href={route(lang, 'vyber')}>{tx.sprievodca} <Ikona nazov="arrow-right" velkost={16} /></a>
          <a class="odkaz" href={route(lang, 'kontakt')}>{tx.kontakt} <Ikona nazov="arrow-right" velkost={16} /></a>
        </p>
      </div>
    </section>
  </div>
  <Zaver lang={lang} />
</Base>

<style>
  .hl-form { position: relative; display: flex; align-items: center; gap: 8px; margin-top: 32px; padding: 8px 8px 8px 56px; max-width: 640px; border-radius: var(--radius-xl); background: #fff; box-shadow: 0 1px 0 rgb(10 42 94 / 0.06), var(--elev-3), inset 0 0 0 1px rgb(10 42 94 / 0.08); transition: box-shadow 150ms var(--ease-soft); }
  .hl-form:focus-within { box-shadow: 0 0 0 4px rgb(0 93 185 / 0.14), var(--elev-3), inset 0 0 0 1px var(--color-blue-700); }
  .hl-form > :global(.icon) { position: absolute; left: 18px; color: var(--color-blue-700); }
  .hl-form input { flex: 1; min-width: 0; height: 48px; border: 0; background: transparent; font: inherit; font-size: 18px; color: var(--color-ink); outline: none; }
  .hl-form input::-webkit-search-cancel-button { display: none; }
  .hl-navrhy { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 8px; margin-top: 16px; font-size: 14px; color: var(--color-ink-soft); }
  .hl-navrhy a { padding: 4px 12px; border-radius: var(--radius-m); background: var(--sklo-2); box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.1); color: var(--color-ink); font-weight: 500; }
  @media (hover: hover) and (pointer: fine) { .hl-navrhy a:hover { color: var(--color-blue-700); box-shadow: inset 0 0 0 1px var(--color-blue-700); } }

  .hl-stav { font-size: 15px; color: var(--color-ink-soft); margin-bottom: 20px; }
  .hl-stav :global(strong) { color: var(--color-ink); }
  :global(.hl-dotaz) .hl-sekcia { min-height: 100svh; }
  .hl-vysledky { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: start; }
  .hl-vysledky :global(.hl-sk) { padding: 24px 24px 16px; }
  .hl-vysledky :global(.hl-sk h2) { font-size: 15px; font-weight: 600; color: var(--color-blue-700); margin-bottom: 8px; }
  .hl-vysledky :global(.hl-sk h2 span) { color: var(--color-ink-soft); letter-spacing: 0; text-transform: none; font-weight: 400; margin-left: 8px; }
  .hl-vysledky :global(.hl-sk a) { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 12px; align-items: center; padding: 12px 0; border-top: 1px solid rgb(10 42 94 / 0.08); color: var(--color-ink); }
  .hl-vysledky :global(.hl-sk a:first-of-type) { border-top: 0; }
  .hl-vysledky :global(.hl-sk a:hover .hl-n) { color: var(--color-blue-700); }
  .hl-vysledky :global(.hl-n) { font-weight: 600; font-size: 16px; }
  .hl-vysledky :global(.hl-kod .hl-n) { font-family: var(--font-display); font-stretch: 112.5%; color: var(--color-blue-900); letter-spacing: 0.01em; }
  .hl-vysledky :global(.hl-d) { grid-column: 1; font-size: 14px; color: var(--color-ink-soft); }
  .hl-vysledky :global(.hl-sk a .icon) { grid-row: 1 / span 2; grid-column: 2; color: var(--color-blue-700); }
  .hl-vysledky :global(.hl-sk a.hl-obr) { grid-template-columns: 48px minmax(0, 1fr) auto; column-gap: 16px; }
  .hl-vysledky :global(.hl-obr .hl-i) { grid-row: 1 / span 2; grid-column: 1; width: 48px; height: 48px; }
  .hl-vysledky :global(.hl-obr .hl-i img) { width: 48px; height: 48px; object-fit: contain; mix-blend-mode: multiply; }
  .hl-vysledky :global(.hl-obr .hl-n) { grid-column: 2; }
  .hl-vysledky :global(.hl-obr .hl-d) { grid-column: 2; }
  .hl-vysledky :global(.hl-sk a.hl-obr .icon) { grid-column: 3; }
  .hl-vysledky :global(mark) { background: rgb(247 201 0 / 0.35); color: inherit; border-radius: 3px; padding: 0 1px; }
  .hl-vysledky :global(.hl-viac) { margin: 8px 0 8px; padding: 0; border: 0; background: none; font: inherit; font-size: 15px; font-weight: 500; color: var(--color-blue-700); cursor: pointer; border-bottom: 1px solid currentColor; }
  .hl-nic { padding: 28px 32px; max-width: 640px; }
  .hl-nic h2 { font-size: 22px; }
  .hl-nic p { margin: 8px 0 16px; color: var(--color-ink-soft); }
  .hl-nic .hl-nic-odkazy { display: flex; flex-wrap: wrap; gap: 8px 28px; margin: 0; }
  @media (max-width: 900px) { .hl-vysledky { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 760px) { .hl-form { padding-left: 48px; } .hl-form > :global(.icon) { left: 14px; } .hl-form .btn { padding-inline: 16px; } .hl-vysledky :global(.hl-sk) { padding: 16px 16px 8px; } }
</style>

<script>
  import { hladaj, zvyrazni, esc, nacitajIndex, type Skupina } from '../lib/hladanie-klient';

  async function initHladanie() {
    const kont = document.querySelector<HTMLElement>('[data-hl-vysledky]');
    if (!kont || kont.dataset.init) return;
    kont.dataset.init = '1';
    const texty = JSON.parse(kont.dataset.texty!);
    const ikona = document.querySelector<HTMLTemplateElement>('[data-hl-ikona]')?.innerHTML ?? '';
    const ikonaExt = document.querySelector<HTMLTemplateElement>('[data-hl-ikona-ext]')?.innerHTML ?? '';
    const stav = document.querySelector<HTMLElement>('[data-hl-stav]')!;
    const nic = document.querySelector<HTMLElement>('[data-hl-nic]')!;
    const vstup = document.querySelector<HTMLInputElement>('[data-hl-q]')!;
    const form = document.querySelector<HTMLFormElement>('[data-hl-form]')!;
    const q0 = new URLSearchParams(location.search).get('q') ?? '';
    vstup.value = q0;
    if (!q0) vstup.focus();
    let index: Awaited<ReturnType<typeof nacitajIndex>> = [];
    try { index = await nacitajIndex(kont.dataset.index!); } catch { return; }
    const tvar = (n: number) => texty.vysledkov[n === 1 ? 0 : n >= 2 && n <= 4 ? 1 : 2].replace(/^\d+/, String(n));

    function vypis(q: string) {
      const dotaz = q.trim();
      kont.innerHTML = '';
      nic.hidden = true;
      if (!dotaz) { stav.textContent = ''; return; }
      const { vysledky: najdene, ciastocne, terminy } = hladaj(index, dotaz);
      stav.innerHTML = ciastocne
        ? `${esc(texty.ciastocne)} <strong>${tvar(najdene.length)}</strong> ${texty.pre} „${esc(dotaz)}“`
        : `<strong>${tvar(najdene.length)}</strong> ${texty.pre} „${esc(dotaz)}“`;
      if (!najdene.length) { nic.hidden = false; return; }
      // Skupiny v poradí podľa najlepšieho výsledku: pri obj. čísle idú prvé kódy, pri názve diely.
      const najlepsie = (s: Skupina) => Math.max(...najdene.filter((x) => x.p.s === s).map((x) => x.s));
      const poradie = (['kod', 'rad', 'diel', 'stranka'] as const).filter((s) => najdene.some((x) => x.p.s === s)).sort((a, b) => najlepsie(b) - najlepsie(a));
      for (const s of poradie) {
        const v = najdene.filter((x) => x.p.s === s);
        const sek = document.createElement('div');
        sek.className = `harok hl-sk hl-${s}`;
        const riadok = (p: (typeof v)[number]['p']) => {
          const von = /^https?:/.test(p.u);
          // Malý render radu alebo výrez dielu ako v našepkávači v hlavičke.
          return `<a href="${esc(p.u)}"${von ? ' target="_blank" rel="noopener"' : ''}${p.o ? ' class="hl-obr"' : ''}>${p.o ? `<span class="hl-i"><img src="${esc(p.o)}" alt="" width="48" height="48" loading="lazy" decoding="async"></span>` : ''}<span class="hl-n">${zvyrazni(p.n, terminy)}</span>${von ? ikonaExt : ikona}${p.d ? `<span class="hl-d">${zvyrazni(p.d, terminy)}</span>` : ''}</a>`;
        };
        const prve = 8;
        sek.innerHTML = `<h2>${esc(texty.skupiny[s])}<span>${v.length}</span></h2>${v.slice(0, prve).map((x) => riadok(x.p)).join('')}`;
        if (v.length > prve) {
          const b = document.createElement('button');
          b.type = 'button'; b.className = 'hl-viac'; b.textContent = texty.viac.replace('0', String(v.length - prve));
          b.addEventListener('click', () => { b.insertAdjacentHTML('beforebegin', v.slice(prve).map((x) => riadok(x.p)).join('')); b.remove(); });
          sek.appendChild(b);
        }
        kont.appendChild(sek);
      }
    }
    vypis(q0);
    let casovac = 0;
    vstup.addEventListener('input', () => {
      clearTimeout(casovac);
      casovac = window.setTimeout(() => {
        const u = new URL(location.href);
        if (vstup.value.trim()) u.searchParams.set('q', vstup.value.trim()); else u.searchParams.delete('q');
        history.replaceState(history.state, '', u);
        vypis(vstup.value);
      }, 120);
    });
    form.addEventListener('submit', (e) => { e.preventDefault(); vypis(vstup.value); });
  }
  initHladanie();
  document.addEventListener('astro:page-load', initHladanie);
</script>
