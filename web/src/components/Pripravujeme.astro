---
import Base from '../layouts/Base.astro';
interface Props { title: string; text: string; aktivna?: 'potrubia' | 'vyber' | 'stiahnut' | 'firmy' | 'poradna' }
const { title, text, aktivna } = Astro.props;
---
<Base title={title} description={text} aktivna={aktivna} drobceky={[{ text: title }]}>
  <section class="wrap section">
    <h1>{title}</h1>
    <p class="lead" style="margin-top: 16px">{text}</p>
    <p style="margin-top: 24px"><a class="btn btn-primary" href="/potrubia/">Prejsť na potrubia</a></p>
  </section>
</Base>
