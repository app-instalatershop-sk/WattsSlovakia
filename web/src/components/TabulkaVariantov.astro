---
import Ikona from './Ikona.astro';
import { cislo, datum, type Variant } from '../lib/katalog';
import { type Lang, t } from '../i18n/ui';

interface Props { varianty: Variant[]; zdroj: string; stiahnute: string; lang: Lang }
const { varianty, zdroj, stiahnute, lang } = Astro.props;
const ui = t(lang);
const ma = (k: keyof Variant) => varianty.some((v) => v[k] !== null && v[k] !== undefined);
const maRuru = ma('rura') || ma('rura_text');
const ruraText = (v: Variant) => (v.rura ? `${cislo(v.rura.d)} × ${cislo(v.rura.s, 1)}` : (v.rura_text ?? '').replace(/x/g, '×'));
---
<div class="table-wrap">
  <table class="data variants">
    <thead>
      <tr>
        <th>{ui.tabulka.obj}</th>
        {ma('plast_mm') && <th class="right">{ui.tabulka.plast}<small>mm</small></th>}
        {maRuru && <th class="right">{ui.tabulka.rura}<small>mm</small></th>}
        {ma('dn') && <th>{ui.tabulka.dn}</th>}
        {ma('tlak_bar') && <th class="right">{ui.tabulka.tlak}<small>bar</small></th>}
        {ma('hmotnost_kg_m') && <th class="right">{ui.tabulka.hmotnost}<small>kg/m</small></th>}
        {ma('izolacia') && <th>{ui.tabulka.izolacia}</th>}
        {ma('polomer_ohybu_m') && <th class="right">{ui.tabulka.polomer}<small>m</small></th>}
        {ma('kotuc') && <th class="right">{ui.tabulka.kotuc}<small>m</small></th>}
        <th><span class="sr-only">{ui.tabulka.eshop}</span></th>
      </tr>
    </thead>
    <tbody>
      {varianty.map((v) => (
        <tr data-pipe={v.rura?.d ?? ''} data-ins={v.izolacia ?? ''}>
          <td class="code">{v.obj_cislo}</td>
          {ma('plast_mm') && <td class="right">{cislo(v.plast_mm)}</td>}
          {maRuru && <td class="right">{ruraText(v)}</td>}
          {ma('dn') && <td>{v.dn ?? ''}</td>}
          {ma('tlak_bar') && <td class="right">{cislo(v.tlak_bar)}</td>}
          {ma('hmotnost_kg_m') && <td class="right">{cislo(v.hmotnost_kg_m, 2)}</td>}
          {ma('izolacia') && <td><span class:list={['ins', { adv: v.izolacia === 'zosilnena' }]}>{v.izolacia === 'zosilnena' ? ui.tabulka.zosilnena : ui.tabulka.standard}</span></td>}
          {ma('polomer_ohybu_m') && <td class="right">{cislo(v.polomer_ohybu_m, 2)}</td>}
          {ma('kotuc') && <td class="right">{v.kotuc ? `${cislo(v.kotuc.d, 2)} / ${cislo(v.kotuc.sirka, 2)}` : ''}</td>}
          <td><a class="shop" href={v.eshop_url} target="_blank" rel="noopener">{ui.common.doEshopu} <Ikona nazov="external-link" velkost={14} /></a></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="source">{ui.common.zdroj} {datum(stiahnute, lang)}. {ui.tabulka.zdrojPozn} <a href={zdroj} target="_blank" rel="noopener">{ui.common.strankaVyrobcu}</a>.</p>

<style>
  .shop { display: inline-flex; align-items: center; gap: 6px; color: var(--color-blue-700); font-weight: 500; }
  .ins { display: inline-flex; align-items: center; gap: 6px; }
  .ins::before { content: ""; width: 10px; height: 10px; border-radius: 50%; background: var(--color-grey-300); }
  .ins.adv::before { background: var(--color-blue-700); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
