---
import Ikona from './Ikona.astro';
interface Subor { nazov: string; typ: string; jazyk: string | null; url: string }
interface Props { subory: Subor[] }
const { subory } = Astro.props;
const jazyk = (j: string | null) => (j === 'sk' ? 'slovensky' : j === 'en' ? 'anglicky' : null);
---
<div class="files">
  {subory.map((s) => (
    <a class="file" href={s.url} target="_blank" rel="noopener">
      <span class="type">{s.typ}</span>
      <span><span class="name">{s.nazov}</span>{jazyk(s.jazyk) && <span class="meta">{jazyk(s.jazyk)}</span>}</span>
      <Ikona nazov="download" velkost={20} class="dl" />
    </a>
  ))}
</div>

<style>
  .files { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 24px; }
  .file { display: grid; grid-template-columns: 44px 1fr auto; gap: 14px; align-items: center; padding: 12px 14px; border: var(--line); border-radius: var(--radius-s); color: var(--color-ink); transition: border-color 150ms var(--ease-soft); }
  .file:hover { border-color: var(--color-blue-700); color: var(--color-ink); }
  .type { width: 44px; height: 44px; border-radius: var(--radius-s); background: var(--color-blue-50); color: var(--color-blue-700); display: grid; place-items: center; font-size: 11px; font-weight: 600; letter-spacing: .02em; }
  .name { font-weight: 500; display: block; }
  .meta { font-size: 13px; color: var(--color-ink-soft); display: block; }
  .dl { color: var(--color-blue-700); }
  @media (max-width: 760px) { .files { grid-template-columns: 1fr; } }
</style>
