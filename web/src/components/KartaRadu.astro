---
/**
 * Karta radu na stránke systému (Juraj 22. 10. 2026, návrh B): štúdio so svetlom a render radu
 * s kótami priamo na výrobku (plášť, nosná rúra s tlakom, polomer ohybu), rovnako ako hlava
 * stránky a hero domova. Pod ním názov, počet rúr a dimenzií, jedna veta a vyhotovenia, ktoré
 * zdieľajú render (PRIMO). V úzkej karte kóta polomeru ustúpi, aby sa štítky neprekrývali.
 */
import Obraz from './Obraz.astro';
import Ikona from './Ikona.astro';
import Koty from './Koty.astro';
import { obrazRadu, je3d } from '../lib/obrazky';
import { sadzba } from '../lib/sadzba';
import { kotyRenderu, kotyRenderu3d } from '../lib/koty';
import { rozsah, rozsahRur, rNazov, rKratky, cislo, tlakText, type Rad, type Variant } from '../lib/katalog';
import { stranky } from '../content/stranky';
import { type Lang, t } from '../i18n/ui';

interface Vyhotovenie { rad: Rad; href: string }
interface Props { rad: Rad; href: string; varianty: Variant[]; lang: Lang; vyhotovenia?: Vyhotovenie[] }
const { rad, href, varianty, lang, vyhotovenia = [] } = Astro.props;
const ui = t(lang);
const tx = stranky(lang).kategoria;
const img = obrazRadu(rad);
const z3d = je3d(img);
const model = rNazov(rad, lang).split(',')[0].trim();
const kratky = rKratky(rad, lang);
const pol = varianty.map((v) => v.polomer_ohybu_m).filter((x): x is number => typeof x === 'number');
const rura = varianty.length ? `${rad.pocet_rur && rad.pocet_rur > 1 && varianty.some((v) => v.rura) ? `${rad.pocet_rur} × ` : ''}${rozsahRur(varianty, lang)}` : '';
const plast = varianty.some((v) => v.plast_mm) ? rozsah(varianty.map((v) => v.plast_mm), 'mm', lang) : '';
const hodnoty = {
  plast: plast ? [`Ø ${plast}`, ui.home.popisy.plast] as [string, string] : undefined,
  rura: rura ? [rura, [ui.rad.rura.toLowerCase(), tlakText(rad)].filter(Boolean).join(', ')] as [string, string] : undefined,
  ohyb: pol.length ? [`${ui.common.od} ${cislo(Math.min(...pol), 2)} m`, ui.home.popisy.polomer] as [string, string] : undefined,
};
const koty = (z3d && kotyRenderu3d('rady', rad.id, hodnoty)) || kotyRenderu(rad.piktogram, hodnoty);
const pod = [rad.pocet_rur ? ui.home.rury(rad.pocet_rur) : '', varianty.length ? ui.sklonovanie.dimenzii(varianty.length) : tlakText(rad)].filter(Boolean).join(', ');
---
<article class="karta">
  <a class="karta-studio" href={href} tabindex="-1" aria-hidden="true">
    <span class:list={['karta-stage', { je3d: z3d }]} style={`view-transition-name: rad-${rad.id}`}>
      {img && <Obraz src={img} alt="" widths={[480, 720, 960]} sizes="(max-width: 900px) 92vw, 44vw" />}
      <Koty koty={koty} label={ui.home.popisy.label} />
    </span>
  </a>
  <div class="karta-telo">
    <h3><a href={href}>{model}</a></h3>
    {pod && <p class="karta-pod">{pod}</p>}
    {kratky && <p class="karta-popis">{sadzba(kratky)}</p>}
    <div class="karta-akcie">
      <a class="odkaz" href={href}>{varianty.length ? tx.varianty : tx.rozmery} <Ikona nazov="arrow-right" velkost={16} /></a>
      {vyhotovenia.map((v) => (
        <a class="karta-vyh" href={v.href} title={ui.home.primo}><strong>{rNazov(v.rad, lang).split(',')[0].trim()}</strong><span>{ui.home.primo.toLowerCase()}</span></a>
      ))}
    </div>
  </div>
</article>

<style>
  .karta { display: flex; flex-direction: column; border-radius: var(--radius-xl); overflow: hidden; background: #fff; box-shadow: 0 1px 0 rgb(10 42 94 / 0.05), var(--elev-4); }
  /* Štúdio: svetlo za výrobkom, render stojí na spodku plochy, všetky karty majú rovnakú výšku štúdia. */
  .karta-studio { display: flex; align-items: flex-end; height: 420px; padding: 28px 24px 12px; background: radial-gradient(60% 70% at 55% 55%, #ffffff 0%, #eef3f9 70%, #e3ebf5 100%); }
  .karta-stage { position: relative; display: block; width: 100%; max-width: 520px; margin: 0 auto; container-type: inline-size; transition: transform 420ms var(--ease-soft); }
  .karta-stage :global(img) { display: block; width: 100%; height: auto; filter: drop-shadow(0 24px 26px rgb(11 27 51 / 0.22)); }
  /* Render 3D modelu má vlastný kontaktný tieň: bez druhého tieňa z CSS. */
  .karta-stage.je3d :global(img) { filter: none; }
  @media (hover: hover) and (pointer: fine) { .karta:has(a:hover) .karta-stage { transform: translateY(-4px); } }
  /* V úzkej karte (tri rady vedľa seba, telefón) by sa štítky prekrývali: kóta polomeru ustúpi. */
  @container (max-width: 440px) {
    .karta-stage :global(.k-ohyb) { display: none; }
    /* Štítok plášťa by vyšiel z karty vpravo: v úzkom poli rastie doľava. */
    .karta .karta-stage :global(.k-plast .stitok) { left: auto; right: -0.75px; align-items: flex-end; text-align: right; border-radius: var(--radius-l); border-bottom-right-radius: 2px; }
  }
  .karta-telo { display: flex; flex-direction: column; gap: 6px; padding: 22px 28px 26px; }
  .karta h3 { font-size: 24px; letter-spacing: -0.015em; }
  .karta h3 a { color: var(--color-ink); }
  .karta h3 a:hover { color: var(--color-blue-700); }
  .karta-pod { color: var(--color-ink-soft); font-size: 15px; }
  .karta-popis { margin-top: 6px; font-size: 16px; max-width: 34em; }
  .karta-akcie { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 22px; margin-top: 16px; }
  .karta-vyh { display: inline-flex; align-items: baseline; gap: 6px; padding: 7px 12px; border-radius: 999px; background: var(--color-blue-50); color: var(--color-ink); font-size: 15px; transition: background-color 150ms var(--ease-soft); }
  .karta-vyh:hover { background: var(--color-blue-100); color: var(--color-ink); }
  .karta-vyh strong { font-weight: 600; }
  .karta-vyh span { color: var(--color-ink-soft); font-size: 13px; }
  @media (max-width: 760px) { .karta-studio { height: auto; padding: 22px 12px 8px; } .karta-telo { padding: 18px 20px 22px; } }
</style>
