---
/**
 * Návrh 2: teplo v reze. Hlava radu s výberom dimenzie a prepínačom „Pohľad / Teplota“: v teplote sa ten
 * istý záber zmení na obraz termokamery (data/blender/teplo.py, pohľad studio --termo). Kóty ukážu teploty
 * médií a plášťa a stratu na meter z katalógu výrobcu (s. 38). Obraz teploty je v rovnakom výreze ako render
 * (data/navrhy_web.py teplo), takže sa pri prepnutí nič neposunie.
 */
import Koty from '../components/Koty.astro';
import type { Kota } from '../lib/koty';

export interface VariantTepla {
  obj: string; plast: number; rura: number; foto: string; termo: string; pomer: number;
  fotoBody: { plast: number[]; rura: number[] };
  termoBody: { rury: { bod: number[]; t: number }[]; plast: { bod: number[]; t: number } };
  q: number;
}
interface Props { varianty: VariantTepla[]; predvoleny: string; rozsah: number[]; paleta: [number, [number, number, number]][]; nadpis: string; pred: string; lead: string; podmienky: string }
const { varianty, predvoleny, rozsah, paleta, nadpis, pred, lead, podmienky } = Astro.props;
const v0 = varianty.find((v) => v.obj === predvoleny) ?? varianty[0];
const cislo = (x: number, d = 0) => x.toLocaleString('sk-SK', { minimumFractionDigits: d, maximumFractionDigits: d });
const rury = [...new Set(varianty.map((v) => v.rura))].sort((a, b) => a - b);
const kotyFoto: Kota[] = [
  { x: v0.fotoBody.plast[0], y: v0.fotoBody.plast[1], l: 8, smer: 'hore-vlavo', hodnota: `Ø ${v0.plast} mm`, text: 'plášť z HDPE', kod: 'plast' },
  { x: v0.fotoBody.rura[0], y: v0.fotoBody.rura[1], l: 9, smer: 'dole-vlavo', hodnota: `2 × ${v0.rura} mm`, text: 'nosná rúra PE-Xa', kod: 'rura' },
];
const kotyTermo: Kota[] = [
  { x: v0.termoBody.rury[0].bod[0], y: v0.termoBody.rury[0].bod[1], l: 10, smer: 'hore-vpravo', hodnota: `${cislo(v0.termoBody.rury[0].t)} °C`, text: 'prívod', kod: 't0' },
  { x: v0.termoBody.rury[1].bod[0], y: v0.termoBody.rury[1].bod[1], l: 9, smer: 'dole-vpravo', hodnota: `${cislo(v0.termoBody.rury[1].t)} °C`, text: 'spiatočka', kod: 't1' },
  { x: v0.termoBody.plast.bod[0], y: v0.termoBody.plast.bod[1], l: 7, smer: 'hore-vlavo', hodnota: `${cislo(v0.termoBody.plast.t)} °C`, text: `plášť, strata ${cislo(v0.q, 1)} W/m`, kod: 'tp' },
];
const gradient = `linear-gradient(90deg, ${paleta.map(([t, c]) => `rgb(${c.map((x) => Math.round(x * 255)).join(' ')}) ${Math.round(t * 100)}%`).join(', ')})`;
---
<section class="teplo" data-teplo data-varianty={JSON.stringify(varianty)}>
  <div class="wrap tp-grid">
    <div class="tp-text">
      <p class="tp-pred">{pred}</p>
      <h1 class="tp-h1">{nadpis}</h1>
      <p class="lead">{lead}</p>
      <div class="tp-volba">
        <p class="tp-lbl">Nosná rúra Ø</p>
        <div class="tp-seg" role="group" aria-label="Nosná rúra">
          {rury.map((r) => <button type="button" data-rura={r} aria-pressed={r === v0.rura ? 'true' : 'false'}>{r}</button>)}
        </div>
        <p class="tp-lbl">Plášť Ø</p>
        <div class="tp-seg tp-seg2" role="group" aria-label="Plášť">
          {varianty.map((v) => <button type="button" data-obj={v.obj} data-pre={v.rura} hidden={v.rura !== v0.rura} aria-pressed={v.obj === v0.obj ? 'true' : 'false'}>{v.plast}</button>)}
        </div>
      </div>
      <div class="tp-rezim" role="group" aria-label="Zobrazenie">
        <button type="button" data-rezim="foto" aria-pressed="true">Pohľad</button>
        <button type="button" data-rezim="termo" aria-pressed="false">Teplota</button>
      </div>
      <div class="tp-legenda">
        <p>{podmienky}</p>
        <div class="tp-stupnica" style={`background: ${gradient}`} aria-hidden="true"></div>
        <div class="tp-osi"><span>{cislo(rozsah[0])} °C</span><span>{cislo((rozsah[0] + rozsah[1]) / 2)} °C</span><span>{cislo(rozsah[1])} °C</span></div>
      </div>
    </div>
    <div class="tp-stage" style={`aspect-ratio: ${v0.pomer}`}>
      <img class="tp-foto" src={v0.foto} alt={`Microflex DUO ${v0.obj}: rez potrubia`} width="1400" height={Math.round(1400 / v0.pomer)} />
      <img class="tp-termo" src={v0.termo} alt={`Microflex DUO ${v0.obj}: teploty v reze ako na termokamere`} width="1400" height={Math.round(1400 / v0.pomer)} />
      <div class="tp-koty-foto"><Koty koty={kotyFoto} label="Rozmery" /></div>
      <div class="tp-koty-termo"><Koty koty={kotyTermo} label="Teploty" /></div>
    </div>
  </div>
</section>

<style>
  .teplo { padding: 40px 0 72px; background: radial-gradient(120% 90% at 75% 40%, #f4f7fb, #fff 70%); transition: background 500ms var(--ease-soft); }
  .tp-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 32px 56px; align-items: center; }
  .tp-pred { font-size: 15px; font-weight: 600; color: var(--color-blue-700); }
  .tp-h1 { margin-top: 8px; font-size: clamp(34px, 3vw + 16px, 60px); letter-spacing: -0.025em; line-height: 1.02; }
  .tp-text .lead { margin-top: 18px; max-width: 32em; }
  .tp-volba { margin-top: 26px; display: grid; gap: 8px; justify-items: start; }
  .tp-lbl { font-size: 14px; color: var(--color-ink-soft); }
  .tp-seg, .tp-rezim { display: inline-flex; gap: 4px; padding: 5px; border-radius: 16px; background: #fff; box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.08), var(--elev-1); }
  .tp-seg button, .tp-rezim button { min-width: 48px; padding: 9px 14px; border: 0; border-radius: 11px; background: none; font: inherit; font-weight: 600; color: var(--color-ink); cursor: pointer; }
  .tp-seg button[aria-pressed="true"], .tp-rezim button[aria-pressed="true"] { background: var(--color-blue-900); color: #fff; }
  .tp-seg button:focus-visible, .tp-rezim button:focus-visible { outline: 3px solid var(--color-yellow-500); outline-offset: 2px; }
  .tp-seg2:not(:has(button:not([hidden]) + button:not([hidden]))) { display: none; }
  .tp-rezim { margin-top: 26px; }
  .tp-rezim button { min-width: 110px; }
  .tp-rezim button[data-rezim="termo"][aria-pressed="true"] { background: linear-gradient(90deg, #6d1a8a, #e2532a 60%, #f7b51c); }
  .tp-legenda { margin-top: 18px; max-width: 30em; opacity: 0; transform: translateY(6px); transition: opacity 300ms var(--ease-soft), transform 300ms var(--ease-soft); }
  .tp-legenda p { font-size: 14px; line-height: 1.5; color: var(--color-ink-soft); }
  .tp-stupnica { margin-top: 12px; height: 12px; border-radius: 6px; box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.08); }
  .tp-osi { display: flex; justify-content: space-between; margin-top: 6px; font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--color-ink-soft); }

  .tp-stage { position: relative; width: 100%; max-width: 860px; justify-self: end; container-type: inline-size; border-radius: 28px; transition: background 500ms var(--ease-soft), box-shadow 500ms var(--ease-soft); }
  .tp-stage img { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* Teplota prechádza cez obraz zľava doprava ako snímanie termokamerou. */
  .tp-termo { clip-path: inset(0 100% 0 0); transition: clip-path 700ms cubic-bezier(0.65, 0, 0.35, 1); }
  .tp-koty-termo, .tp-koty-foto { position: absolute; inset: 0; transition: opacity 300ms var(--ease-soft); }
  .tp-koty-termo { opacity: 0; }

  .teplo.je-termo { background: radial-gradient(120% 90% at 75% 40%, #1a1240, #0b1b33 70%); }
  .teplo.je-termo .tp-text { color: #fff; }
  .teplo.je-termo .tp-h1 { color: #fff; }
  .teplo.je-termo .tp-text .lead, .teplo.je-termo .tp-lbl, .teplo.je-termo .tp-legenda p, .teplo.je-termo .tp-osi { color: #c7d4e8; }
  .teplo.je-termo .tp-pred { color: #f7b51c; }
  .teplo.je-termo .tp-termo { clip-path: inset(0 0 0 0); }
  .tp-foto { transition: opacity 300ms var(--ease-soft); }
  .teplo.je-termo .tp-foto { opacity: 0; transition-delay: 600ms; }
  .teplo.je-termo .tp-koty-foto { opacity: 0; }
  .teplo.je-termo .tp-koty-termo { opacity: 1; transition-delay: 450ms; }
  .teplo.je-termo .tp-legenda { opacity: 1; transform: none; }

  /* Telefón: nadpis, obraz a hneď pod ním výber a prepínač, aby bolo zmenu na obraze vidno. */
  @media (max-width: 900px) {
    .tp-grid { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    .tp-text { display: contents; }
    .tp-pred, .tp-h1, .tp-text .lead { order: 0; }
    .tp-stage { order: 1; margin-inline: calc(-1 * var(--gutter)); width: calc(100% + 2 * var(--gutter)); max-width: none; }
    .tp-volba, .tp-rezim { order: 2; margin-top: 0; }
    .tp-legenda { order: 3; margin-top: 0; }
    .tp-h1 { margin-top: -10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tp-termo, .teplo, .tp-legenda, .tp-koty-termo, .tp-koty-foto { transition: none; }
  }
</style>

<script>
  interface V { obj: string; plast: number; rura: number; foto: string; termo: string; pomer: number; q: number;
    fotoBody: { plast: number[]; rura: number[] }; termoBody: { rury: { bod: number[]; t: number }[]; plast: { bod: number[]; t: number } } }

  function initTeplo() {
    const sek = document.querySelector<HTMLElement>('[data-teplo]');
    if (!sek || sek.dataset.on) return;
    sek.dataset.on = '1';
    const varianty: V[] = JSON.parse(sek.dataset.varianty ?? '[]');
    const cislo = (x: number, d = 0) => x.toLocaleString('sk-SK', { minimumFractionDigits: d, maximumFractionDigits: d });
    const foto = sek.querySelector<HTMLImageElement>('.tp-foto')!;
    const termo = sek.querySelector<HTMLImageElement>('.tp-termo')!;
    const kota = (kod: string) => sek.querySelector<HTMLElement>(`.k-${kod}`)!;
    const nastavKotu = (kod: string, bod: number[], hodnota: string, text?: string) => {
      const li = kota(kod);
      li.style.setProperty('--x', `${bod[0]}%`);
      li.style.setProperty('--y', `${bod[1]}%`);
      li.querySelector('strong')!.textContent = hodnota;
      if (text !== undefined) li.querySelector('.stitok > span')!.textContent = text;
    };
    const vyber = (obj: string) => {
      const v = varianty.find((x) => x.obj === obj);
      if (!v) return;
      foto.src = v.foto;
      termo.src = v.termo;
      nastavKotu('plast', v.fotoBody.plast, `Ø ${v.plast} mm`);
      nastavKotu('rura', v.fotoBody.rura, `2 × ${v.rura} mm`);
      nastavKotu('t0', v.termoBody.rury[0].bod, `${cislo(v.termoBody.rury[0].t)} °C`);
      nastavKotu('t1', v.termoBody.rury[1].bod, `${cislo(v.termoBody.rury[1].t)} °C`);
      nastavKotu('tp', v.termoBody.plast.bod, `${cislo(v.termoBody.plast.t)} °C`, `plášť, strata ${cislo(v.q, 1)} W/m`);
      sek.querySelectorAll<HTMLButtonElement>('[data-obj]').forEach((b) => {
        b.hidden = Number(b.dataset.pre) !== v.rura;
        b.setAttribute('aria-pressed', String(b.dataset.obj === obj));
      });
      sek.querySelectorAll<HTMLButtonElement>('[data-rura]').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.rura) === v.rura)));
    };
    sek.querySelectorAll<HTMLButtonElement>('[data-rura]').forEach((b) => b.addEventListener('click', () => {
      const r = Number(b.dataset.rura);
      const aktualny = varianty.find((x) => x.obj === sek.querySelector('[data-obj][aria-pressed="true"]')?.getAttribute('data-obj'));
      const kandidati = varianty.filter((x) => x.rura === r);
      const v = kandidati.find((x) => x.plast === aktualny?.plast) ?? kandidati.find((x) => x.plast === 160) ?? kandidati[0];
      vyber(v.obj);
    }));
    sek.querySelectorAll<HTMLButtonElement>('[data-obj]').forEach((b) => b.addEventListener('click', () => vyber(b.dataset.obj!)));
    sek.querySelectorAll<HTMLButtonElement>('[data-rezim]').forEach((b) => b.addEventListener('click', () => {
      const t = b.dataset.rezim === 'termo';
      sek.classList.toggle('je-termo', t);
      sek.querySelectorAll('[data-rezim]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    }));
    // obrázky ostatných dimenzií vopred, aby prepínanie nečakalo na sieť
    window.setTimeout(() => varianty.forEach((v) => { new Image().src = v.foto; new Image().src = v.termo; }), 1500);
  }
  initTeplo();
  document.addEventListener('astro:page-load', initTeplo);
</script>
