---
/**
 * Kotúč sa odvaľuje (Juraj 28. 10. 2026, v pokládke na domove namiesto fotky): 100 m potrubia DUO
 * (4 vrstvy po 5 závitoch z rozmerov kotúča v katalógu) sa pri rolovaní odvaľuje pozdĺž ryhy a za ním ostáva
 * položená rúra (data/blender/potrubie.py pohľad kotuc, data/novinky_web.py kotuc). Záber je široký (kotúč
 * prejde celý obraz), preto ide cez celú šírku a pod ním sú kroky pokládky v rade; rozsvietia sa s pohybom.
 * Kóta nad kotúčom ide s ním: najprv priemer kotúča, pri odvaľovaní koľko metrov na ňom ostáva.
 * Dlhá dráha so stojacim obsahom ako rozložený rez (Rozklad.astro). Bez skriptu a pri „obmedziť pohyb“ stojí
 * prvý záber s kótami a všetky kroky.
 */
import Koty from './Koty.astro';
import type { Kota } from '../lib/koty';
import type { KotucData } from '../lib/obrazky';
import { sadzba } from '../lib/sadzba';

type Odvalenie = NonNullable<KotucData['odvalenie']>;
interface Props { data: Odvalenie; texty: { priemer: string; ostava: string; label: string }; celo: [string, string]; alt: string; kroky: [string, string][]; krokyLabel: string }
const { data, texty, celo, alt, kroky, krokyLabel } = Astro.props;
const prvy = data.body[0];
const sirka = Math.max(...data.sirky);
const zaber0 = `${data.cesta}${sirka}/000`;
const m = (x: number) => x.toLocaleString('sk-SK', { maximumFractionDigits: 2, minimumFractionDigits: 2 });
const koty: Kota[] = [
  { x: prvy.vrch[0], y: prvy.vrch[1], l: 3.5, smer: 'hore-vpravo', smerM: 'hore-vpravo', hodnota: `Ø ${m(data.kotuc.d_m)} m`, text: texty.priemer, kod: 'kotuc' },
  { x: prvy.celo[0], y: prvy.celo[1], l: 6, smer: 'hore-vlavo', smerM: 'hore-vlavo', hodnota: celo[0], text: celo[1], kod: 'celo' },
];
const dlzka = Math.floor(data.kotuc.dlzka_m);
---
<div class="ks" data-kotuc data-cesta={data.cesta} data-snimok={data.snimok} data-sirky={data.sirky.join(',')} data-body={JSON.stringify(data.body)} data-dlzka={dlzka} data-ostava={texty.ostava} data-priemer={`Ø ${m(data.kotuc.d_m)} m|${texty.priemer}`} style={`--pomer: ${data.pomer}`}>
  <div class="ks-sticky">
    <div class="wrap ks-obsah">
      <div class="ks-stage" style={`aspect-ratio: ${data.pomer}`}>
        <picture class="ks-obr">
          <source type="image/avif" srcset={`${zaber0}.avif`} />
          <img src={`${zaber0}.webp`} alt={alt} width={sirka} height={Math.round(sirka / data.pomer)} loading="lazy" decoding="async" />
        </picture>
        <canvas class="ks-canvas" aria-hidden="true"></canvas>
        <Koty koty={koty} label={texty.label} />
      </div>
      <ol class="ks-kroky" aria-label={krokyLabel}>
        {kroky.map(([nazov, text], i) => (
          <li><span class="ks-cislo" aria-hidden="true">{i + 1}</span><h3>{nazov}</h3><p>{sadzba(text)}</p></li>
        ))}
      </ol>
    </div>
  </div>
</div>

<style>
  .ks { position: relative; height: 230vh; margin-top: 8px; }
  .ks-sticky { position: sticky; top: 72px; height: calc(100vh - 72px); display: flex; align-items: center; overflow: clip; }
  .ks-obsah { width: 100%; display: grid; gap: 18px; }
  /* Široký záber: kotúč prejde celý obraz; výška obmedzená, aby sa pod ním zmestili kroky a nad ním kóta. */
  .ks-stage { position: relative; width: min(100%, calc((100vh - 72px - 360px) * var(--pomer))); margin-inline: auto; container-type: inline-size; }
  .ks-obr :global(img), .ks-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ks-canvas { opacity: 0; }
  .ks.ks-bezi .ks-canvas { opacity: 1; }
  .ks.ks-bezi .ks-obr { visibility: hidden; }
  .ks-stage :global(.k-kotuc) { transition: left 120ms linear, top 120ms linear; }
  /* Kroky v rade pod obrazom: rozsvieti sa ten, ku ktorému kotúč dorazil (bez skriptu všetky). */
  .ks-kroky { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin: 0; padding: 0; list-style: none; }
  .ks-kroky li { position: relative; padding-top: 16px; border-top: 3px solid rgb(10 42 94 / 0.14); transition: border-color 300ms var(--ease-soft), opacity 300ms var(--ease-soft); }
  .ks-cislo { font-family: var(--font-display); font-weight: 700; font-size: 18px; color: var(--color-blue-700); }
  .ks-kroky h3 { margin-top: 2px; font-size: 18px; line-height: 1.3; }
  .ks-kroky p { margin-top: 4px; font-size: 15px; line-height: 1.5; color: var(--color-ink-soft); }
  .ks.ks-js .ks-kroky li { opacity: 0.5; }
  .ks.ks-js .ks-kroky li.is-on { opacity: 1; border-top-color: var(--color-blue-700); }
  @media (max-width: 900px) {
    .ks { height: 210vh; }
    .ks-sticky { top: 64px; height: calc(100svh - 64px); align-items: center; padding-top: 56px; }
    .ks-stage { width: calc(100% + 2 * var(--gutter)); margin-inline: calc(-1 * var(--gutter)); }
    .ks-kroky { grid-template-columns: minmax(0, 1fr); }
    /* telefón: len krok, ku ktorému kotúč práve dorazil */
    .ks.ks-js .ks-kroky li { display: none; }
    .ks.ks-js .ks-kroky li.is-aktivny { display: block; opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ks { height: auto; }
    .ks-sticky { position: static; height: auto; padding-block: 24px; }
  }
</style>

<script>
  // Priebeh 0 až 1 cez dráhu: odvaľovanie do 0,7, potom kotúč stojí; krok sa rozsvieti v štvrtinách.
  const ZACIATOK = 0.06, KONIEC = 0.72, KROKY = [0.0, 0.3, 0.62, 0.86];
  const stopky: AbortController[] = [];

  function initKotuc() {
    stopky.splice(0).forEach((s) => s.abort());
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLElement>('[data-kotuc]').forEach((koren) => {
      const stop = new AbortController();
      stopky.push(stop);
      const signal = stop.signal;
      koren.classList.add('ks-js');
      const n = Number(koren.dataset.snimok);
      const body: { vrch: number[]; celo: number[]; volny_m: number }[] = JSON.parse(koren.dataset.body ?? '[]');
      const sirky = (koren.dataset.sirky ?? '').split(',').map(Number).sort((a, b) => a - b);
      const dlzka = Number(koren.dataset.dlzka);
      const [priemer, priemerText] = (koren.dataset.priemer ?? '|').split('|');
      const stage = koren.querySelector<HTMLElement>('.ks-stage')!;
      const platno = koren.querySelector<HTMLCanvasElement>('.ks-canvas')!;
      const ctx = platno.getContext('2d')!;
      const kota = koren.querySelector<HTMLElement>('.k-kotuc')!;
      const hodnota = kota.querySelector<HTMLElement>('strong')!;
      const text = kota.querySelector<HTMLElement>('.stitok > span')!;
      const kroky = [...koren.querySelectorAll<HTMLElement>('.ks-kroky li')];
      const snimky: (HTMLImageElement | undefined)[] = new Array(n);
      let sirka = sirky[sirky.length - 1], nakreslena = -1, rafId = 0;

      const velkost = () => {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        platno.width = Math.round(stage.clientWidth * dpr);
        platno.height = Math.round(stage.clientHeight * dpr);
        nakreslena = -1;
      };
      const priebeh = () => {
        const r = koren.getBoundingClientRect();
        return Math.min(1, Math.max(0, -r.top / Math.max(1, koren.offsetHeight - window.innerHeight)));
      };
      const najblizsia = (i: number) => {
        for (let d = 0; d < n; d++) {
          if (snimky[i - d]) return i - d;
          if (snimky[i + d]) return i + d;
        }
        return -1;
      };
      const kresli = () => {
        rafId = 0;
        const p = priebeh();
        const f = Math.min(1, Math.max(0, (p - ZACIATOK) / (KONIEC - ZACIATOK)));
        const i = Math.round(f * (n - 1));
        const j = najblizsia(i);
        if (j >= 0 && j !== nakreslena) {
          ctx.clearRect(0, 0, platno.width, platno.height);
          ctx.drawImage(snimky[j]!, 0, 0, platno.width, platno.height);
          nakreslena = j;
          koren.classList.add('ks-bezi');
        }
        const b = body[i];
        kota.style.setProperty('--x', `${b.vrch[0]}%`);
        kota.style.setProperty('--y', `${b.vrch[1]}%`);
        // kým sa kotúč nepohol, priemer; potom koľko metrov na ňom ostáva (100 m mínus voľný koniec)
        const ide = i > 0;
        const novaHodnota = ide ? `${Math.round(dlzka - b.volny_m)} m` : priemer;
        const novyText = ide ? koren.dataset.ostava! : priemerText;
        if (hodnota.textContent !== novaHodnota) hodnota.textContent = novaHodnota;
        if (text.textContent !== novyText) text.textContent = novyText;
        let aktivny = 0;
        kroky.forEach((li, k) => { const on = p >= KROKY[k]; li.classList.toggle('is-on', on); if (on) aktivny = k; });
        kroky.forEach((li, k) => li.classList.toggle('is-aktivny', k === aktivny));
      };
      const naplanuj = () => { if (!rafId) rafId = requestAnimationFrame(kresli); };

      let zacate = false;
      const nacitaj = async (i: number) => {
        const im = new Image();
        im.src = `${koren.dataset.cesta}${sirka}/${String(i).padStart(3, '0')}.avif`;
        await im.decode();
        snimky[i] = im;
        naplanuj();
      };
      const stiahni = async () => {
        if (zacate) return;
        zacate = true;
        const potrebna = stage.clientWidth * Math.min(window.devicePixelRatio || 1, 2);
        sirka = sirky.find((s) => s >= potrebna * 0.85) ?? sirky[sirky.length - 1];
        try { await nacitaj(0); } catch { koren.classList.remove('ks-js'); stop.abort(); return; }
        const poradie: number[] = [];
        for (const krok of [n - 1, 8, 4, 2, 1]) for (let i = 0; i < n; i += krok) if (!snimky[i] && !poradie.includes(i)) poradie.push(i);
        let k = 0;
        const vlakno = async () => { while (k < poradie.length && !signal.aborted) { try { await nacitaj(poradie[k++]); } catch { /* susedná snímka */ } } };
        await Promise.all([vlakno(), vlakno(), vlakno(), vlakno()]);
      };
      const pozorovatel = new IntersectionObserver((z) => { if (z.some((e) => e.isIntersecting)) { stiahni(); pozorovatel.disconnect(); } }, { rootMargin: '100% 0px' });
      pozorovatel.observe(koren);
      signal.addEventListener('abort', () => pozorovatel.disconnect());
      velkost();
      window.addEventListener('scroll', naplanuj, { passive: true, signal });
      window.addEventListener('resize', () => { velkost(); naplanuj(); }, { signal });
      naplanuj();
    });
  }

  initKotuc();
  document.addEventListener('astro:page-load', initKotuc);
</script>
