    }
  }
  @keyframes vykop { from { clip-path: inset(8% 0 8% 0 round 16px); } to { clip-path: inset(0 0 0 0 round 16px); } }
  .proj-texty { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 56px; margin-top: 36px; }
  .proj-text { display: flex; flex-direction: column; align-items: flex-start; }
  .proj-kde { font-size: 15px; font-weight: 500; color: #8fb9ec; }
  .proj-text h3 { margin-top: 8px; font-size: clamp(22px, 0.9vw + 15px, 28px); line-height: 1.15; letter-spacing: -0.015em; color: #fff; max-width: 14em; }
