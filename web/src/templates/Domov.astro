---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Ikona from '../components/Ikona.astro';
import Katalog from '../components/Katalog.astro';
import { kategorie, cislo, rozsah } from '../lib/katalog';
import { fotka } from '../lib/obrazky';
import { sadzba } from '../lib/sadzba';
import { type Lang, t, route, staticAlternates, KATALOG_PDF } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const h = ui.home;

const kats = await kategorie();
const rady = (await getCollection('rady')).map((r) => r.data);
const varianty = (await getCollection('varianty')).map((v) => v.data);

const potrubia = kats.filter((k) => k.typ === 'potrubie');
const radyPotrubi = rady.filter((r) => potrubia.some((k) => k.id === r.kategoria));
const variantyPotrubi = varianty.filter((v) => radyPotrubi.some((r) => r.id === v.rad));

// Fakty z dát, nie z hlavy.
const polomery = variantyPotrubi.map((v) => v.polomer_ohybu_m).filter((x): x is number => typeof x === 'number');
const faktPolomer = `${ui.common.od} ${cislo(Math.min(...polomery), 2)} m`;
const faktRura = rozsah(variantyPotrubi.map((v) => v.rura?.d), 'mm', lang);
const tlaky = [...new Set(radyPotrubi.map((r) => r.tlak_bar).filter((x): x is number => typeof x === 'number'))].sort((a, b) => a - b);
const faktTlak = tlaky.map((x) => `${x}`).join(' / ') + ' bar';
const faktRady = String(radyPotrubi.length);

const heroRez = fotka('hero-rez-duo.png')!;
const rodina = fotka('rodina-potrubi.png')!;
const kotuc = fotka('kotuc.jpg')!;
const vykop = fotka('vykop-spojky.jpg')!;
const [plast, izolacia, rura] = h.vrstvy;
---
<Base lang={lang} alternates={staticAlternates('domov')} title={ui.domov.title} description={ui.domov.description}>
  <section class="hero" aria-labelledby="h-hero">
    <div class="wrap hero-in">
      <div class="hero-text">
        {/* Kľúčové slovo ostáva v nadpise, len v tichom riadku nad sloganom. */}
        <h1 id="h-hero">
          <span class="h1-kicker">{h.heroKicker}</span>
          <span class="h1-a">{h.h1a}</span>
          <span class="h1-b">{h.h1b}</span>
        </h1>
        <p class="lead">{sadzba(h.lead)}</p>
        <div class="hero-actions">
          <a class="btn btn-yellow" href="#vyber">{h.cta} <Ikona nazov="arrow-down" velkost={18} /></a>
          <a class="hero-odkaz" href={KATALOG_PDF} target="_blank" rel="noopener">{h.cta2} <span class="meta">{h.cta2Meta}</span> <Ikona nazov="download" velkost={16} /></a>
        </div>
      </div>
      <div class="hero-product">
        <Image src={heroRez} alt={h.heroAlt} widths={[760, 1140, 1517]} sizes="(max-width: 760px) 100vw, 62vw" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <div class="wrap">
    <dl class="facts-bar">
      <div><dd>{faktPolomer}</dd><dt>{h.facts.polomer}</dt></div>
      <div><dd>{faktRura}</dd><dt>{h.facts.rura}</dt></div>
      <div><dd>{faktTlak}</dd><dt>{h.facts.tlak}</dt></div>
      <div><dd>{faktRady}</dd><dt>{h.facts.rady}</dt></div>
    </dl>
  </div>

  <Katalog lang={lang} />

  <section class="section rodina" aria-labelledby="h-rodina">
    <div class="wrap rodina-grid">
      <div class="rodina-text">
        <h2 id="h-rodina">{h.rodinaH2}</h2>
        <p class="lead">{sadzba(h.rodinaP)}</p>
        {/* Vrstvy sú vnorené do seba ako v reze: izolácia je v plášti, rúra v izolácii.
            Farba linky je farba vrstvy na renderi vedľa: modrý plášť, sivá pena, žltá rúra. */}
        <ol class="vrstvy" aria-label={h.vrstvyLabel} data-reveal-seq>
          <li class="v v-plast" data-seq>
            <h3>{plast[0]}</h3><p>{sadzba(plast[1])}</p>
            <ol>
              <li class="v v-pena" data-seq>
                <h3>{izolacia[0]}</h3><p>{sadzba(izolacia[1])}</p>
                <ol>
                  <li class="v v-rura" data-seq><h3>{rura[0]}</h3><p>{sadzba(rura[1])}</p></li>
                </ol>
              </li>
            </ol>
          </li>
        </ol>
      </div>
      <div class="rodina-wrap"><Image src={rodina} alt={h.rodinaAlt} widths={[800, 1200, 1633]} sizes="(max-width: 1100px) 100vw, 64vw" class="rodina-img" data-parallax="0.06" /></div>
    </div>
  </section>

  <section class="section band-soft pokladka" aria-labelledby="h-pokladka">
    {/* Fotka kotúča má čisto bielu plochu: násobením splynie s pásom a text sedí vo vnútri kotúča. */}
    <div class="kotuc-obal">
      <Image src={kotuc} alt={h.pokladkaAlt} widths={[900, 1400, 2000]} sizes="(max-width: 760px) 120vw, 76vw" class="kotuc" data-otacaj="-4 3" />
    </div>
    <div class="wrap pokladka-grid">
      <div class="pokladka-text">
        <h2 id="h-pokladka">{h.pokladkaH2}</h2>
        <p class="lead">{sadzba(h.pokladkaP)}</p>
        <div class="kroky-obal" data-rozvin>
          <span class="k-rura" aria-hidden="true"></span>
          <ol class="kroky" aria-label={h.krokyLabel}>
            {h.kroky.map(([nazov, text], i) => (
              <li><span class="k-cislo" aria-hidden="true">{i + 1}</span><h3>{nazov}</h3><p>{sadzba(text)}</p></li>
            ))}
          </ol>
        </div>
        <div class="pokladka-pata">
          <p class="zataz"><strong>{h.zataz[0]}</strong><span>{sadzba(h.zataz[1])}</span></p>
          <p class="zdroj">{h.pokladkaZdroj} <a href={`${KATALOG_PDF}#page=37`} target="_blank" rel="noopener">{h.pokladkaOdkaz} <Ikona nazov="arrow-up-right" velkost={14} /></a></p>
        </div>
      </div>
    </div>
  </section>

  {/* Podzemie: posledný úsek stránky je tmavý ako zem, do ktorej potrubie ide. Fotka z výkopu
      prekračuje šikmú hranu, takže svetlá a tmavá časť nie sú dva bloky, ale jeden prechod. */}
  <div class="podzemie">
    <section class="refs" aria-labelledby="h-refs">
      <div class="wrap refs-grid">
        <figure class="refs-photo">
          <Image src={vykop} alt={h.refAlt} widths={[800, 1200, 1600]} sizes="(max-width: 1100px) 100vw, 70vw" />
        </figure>
        <div class="refs-text">
          <h2 id="h-refs">{h.refH2}</h2>
          <ul class="refs-list" data-reveal-group>
            {h.refs.map(([b, s]) => (
              <li><a href={route(lang, 'referencie')}><strong>{b}</strong><span>{sadzba(s)}</span></a></li>
            ))}
          </ul>
          <p class="refs-pata"><a href={route(lang, 'referencie')}>{h.refVsetky} <Ikona nazov="arrow-up-right" velkost={16} /></a></p>
        </div>
      </div>
    </section>

    <section class="b2b wrap" aria-labelledby="h-b2b">
      <div class="b2b-grid">
        <div class="b2b-text">
          <h2 id="h-b2b">{h.b2bH2}</h2>
          <p class="lead">{sadzba(h.b2bP)}</p>
          <div class="b2b-akcie">
            <a class="btn btn-inverse" href={route(lang, 'firmy')}>{h.b2bDopyt}</a>
            <a class="btn btn-ghost-light" href={route(lang, 'stiahnut')}><Ikona nazov="download" velkost={18} />{h.b2bPodklady}</a>
          </div>
        </div>
        <ul class="b2b-list" data-reveal-group>
          {h.b2bList.map(([b, s]) => <li><strong>{b}</strong><span>{sadzba(s)}</span></li>)}
        </ul>
      </div>
    </section>
  </div>
</Base>

<style>
  /* ---------- Hero: svetlé pole, farbu nesie výrobok ---------- */
  .hero { position: relative; display: flex; align-items: center; min-height: clamp(540px, 70vh, 720px); overflow: hidden; z-index: 1; color: var(--color-ink);
    background:
      linear-gradient(to bottom, rgb(255 255 255 / 0) 62%, #ffffff 100%),
      radial-gradient(52% 62% at 76% 52%, rgb(0 93 185 / 0.08) 0%, rgb(0 93 185 / 0) 72%),
      linear-gradient(158deg, #ffffff 0%, #fafbfd 46%, #eef2f7 100%); }
  .hero-in { position: relative; width: 100%; display: grid; grid-template-columns: minmax(0, 44fr) minmax(0, 56fr); align-items: center; gap: 24px; }
  .hero-text { max-width: 620px; padding-block: 72px; display: flex; flex-direction: column; align-items: flex-start; position: relative; z-index: 3; }
  .hero-text > * { animation: rise 680ms var(--ease-soft) both; }
  .hero-text > :nth-child(2) { animation-delay: 220ms; }
  .hero-text > :nth-child(3) { animation-delay: 320ms; }
  .hero h1 { display: flex; flex-direction: column; font-size: clamp(34px, 2.9vw + 12px, 58px); line-height: 1.03; letter-spacing: -0.03em; text-wrap: nowrap; }
  .h1-kicker { font-family: var(--font-text); font-stretch: 100%; font-size: 12.5px; font-weight: 600; line-height: 1.4; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-ink-soft); margin-bottom: 20px; }
  /* Jediný orchestrovaný moment: prvý riadok sa pri načítaní roztiahne po osi šírky písma,
     tak ako sa rozvinie ohybné potrubie. Cieľ je šírka nadpisu, preto animácia nemá koncový stav. */
  .h1-a { color: var(--color-ink); animation: flex 1150ms 60ms var(--ease-soft) both; }
  .h1-b { color: var(--color-blue-700); }
  @keyframes flex { from { font-stretch: 72%; opacity: 0; } 35% { opacity: 1; } }
  .hero .lead { font-size: 18px; max-width: 30em; margin-top: 22px; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 30px; margin-top: 34px; }
  .hero-actions .btn :global(svg) { transition: transform 200ms var(--ease-soft); }
  .hero-actions .btn:hover :global(svg) { transform: translateY(3px); }
  /* Druhá akcia nie je tlačidlo: nemá súperiť so žltým, len ponúknuť katalóg na stiahnutie. */
  .hero-odkaz { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; color: var(--color-blue-700); border-bottom: 1px solid currentColor; padding-bottom: 3px; }
  .hero-odkaz .meta { font-weight: 400; font-size: 14px; color: var(--color-ink-soft); }
  .hero-odkaz :global(svg) { transition: transform 200ms var(--ease-soft); }
  .hero-odkaz:hover :global(svg) { transform: translateY(2px); }
  /* Rúra prekračuje pravý okraj obsahovej mriežky až za okraj obrazovky. */
  .hero-product { position: relative; z-index: 2; margin-left: -9%;
    margin-right: calc(min(calc(-1 * var(--gutter)), calc((var(--container-site) - 100vw) / 2)) - 64px);
    pointer-events: none; animation: settle 1300ms 120ms var(--ease-soft) both; }
  .hero-product :global(img) { width: 100%; max-width: 1180px; height: auto; display: block; margin-inline: auto; filter: drop-shadow(0 38px 46px rgb(11 27 51 / 0.2)); }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes settle { from { opacity: 0; transform: translate(40px, 0) rotate(-1.5deg) scale(1.02); } to { opacity: 1; transform: none; } }

  /* Kľúčové čísla nie sú karty. Je to pás na mriežke stránky: prvý údaj lícuje s nadpisom
     hero, oddeľujú ich len vlasové čiary a číslo nesie váhu, nie rámček. */
  .facts-bar { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: var(--line); margin: 48px 0 0; position: relative; z-index: 2; animation: rise 640ms 420ms var(--ease-soft) both; }
  .facts-bar > div { display: flex; flex-direction: column; gap: 8px; padding: 30px 36px; border-left: var(--line); min-width: 0; }
  .facts-bar > div:first-child { border-left: 0; padding-left: 0; }
  .facts-bar > div:last-child { padding-right: 0; }
  .facts-bar dd { margin: 0; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: clamp(25px, 2vw, 36px); line-height: 1.02; letter-spacing: -0.025em; color: var(--color-blue-900); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .facts-bar dt { font-size: 14px; color: var(--color-ink-soft); }

  /* ---------- Rodina: render prechádza cez švík z modrého pásu do bielej ---------- */
  .rodina { background: var(--color-white); padding-top: 0; padding-bottom: 96px; overflow-x: clip; overflow-y: visible; }
  .rodina-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 24px; align-items: start; }
  .rodina-text { padding-top: 64px; }
  .rodina-text h2 { margin-bottom: 16px; }
  .rodina-text .lead { max-width: 30em; }
  /* Render je veľký a vždy dobehne za pravý okraj obrazovky, aj na širokom monitore. */
  .rodina-wrap { width: max(146%, calc(104% + var(--bleed) + 24px)); max-width: none; margin: -196px 0 0 -4%; position: relative; z-index: 2; filter: drop-shadow(0 28px 36px rgb(11 27 51 / 0.2)); }
  .rodina-wrap :global(.rodina-img) { width: 100%; height: auto; display: block; -webkit-mask-image: linear-gradient(to top right, #000 66%, transparent 97%); mask-image: linear-gradient(to top right, #000 66%, transparent 97%); }

  /* Stavba potrubia ako rez v typografii: každá vrstva je vnorená v predchádzajúcej. */
  .vrstvy { margin-top: 40px; }
  .vrstvy ol { margin-top: 20px; }
  .v { position: relative; padding-left: 22px; }
  .v::before { content: ""; position: absolute; left: 0; top: 4px; bottom: 0; width: 3px; border-radius: 2px; }
  .v-plast::before { background: var(--color-blue-700); }
  .v-pena::before { background: #9aa3ae; }
  .v-rura::before { background: var(--color-yellow-500); bottom: 4px; }
  .v h3 { font-size: 18px; line-height: 1.3; margin-bottom: 4px; }
  .v p { font-size: 15px; color: var(--color-ink-soft); max-width: 34em; }

  /* ---------- Pokládka: kotúč vľavo cez okraj obrazovky, text v jeho vnútri ---------- */
  .pokladka { position: relative; overflow: hidden; padding-top: 112px; padding-bottom: 232px; isolation: isolate; }
  /* Obal je celá plocha sekcie: maska na ňom rozpustí kotúč hore aj dole v páse, nech je obrázok
     akokoľvek vysoký. Násobenie je tiež na obale, lebo obrázok v samostatnej vrstve by sa miešal
     len s prázdnom a biela by ostala biela. */
  .kotuc-obal { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; mix-blend-mode: multiply;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 17%, #000 80%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 17%, #000 80%, transparent 100%); }
  /* Vnútorný okraj kotúča (asi 57 % šírky fotky) leží 150 px pred stĺpcom textu, ktorý začína
     v strede mriežky. Na širokom monitore kotúč rastie, aby vždy dobehol za ľavý okraj obrazovky. */
  .kotuc-obal :global(.kotuc) { --w: max(1180px, calc((50vw - 40px) / 0.57)); position: absolute; width: var(--w); max-width: none; height: auto; left: calc(50% - 150px - 0.57 * var(--w)); top: calc(50% - var(--w) / 2.566); transform-origin: 96% 50%; }
  .pokladka-grid { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px; }
  .pokladka-text { grid-column: 7 / 13; }
  .pokladka h2 { font-size: clamp(32px, 3vw + 12px, 58px); line-height: 1.04; letter-spacing: -0.03em; max-width: 11em; }
  .pokladka .lead { margin-top: 22px; max-width: 32em; }

  /* Postup je skutočná postupnosť, preto čísla. Rúra po ľavej strane sa pri rolovaní rozvinie. */
  .kroky-obal { position: relative; margin-top: 44px; padding-left: 28px; }
  .kroky-obal::before { content: ""; position: absolute; left: 2px; top: 6px; bottom: 6px; width: 2px; background: rgb(10 42 94 / 0.14); border-radius: 1px; }
  .k-rura { position: absolute; left: 0; top: 6px; bottom: 6px; width: 6px; border-radius: 3px; background: linear-gradient(90deg, #2a7fd6 0%, var(--color-blue-700) 45%, var(--color-blue-800) 100%); transform-origin: top; transform: scaleY(var(--rozvin, 1)); }
  .kroky { display: flex; flex-direction: column; gap: 22px; }
  .kroky li { display: grid; grid-template-columns: 30px minmax(0, 1fr); column-gap: 10px; }
  .k-cislo { grid-row: 1 / span 2; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 19px; line-height: 1.3; color: var(--color-blue-700); font-variant-numeric: tabular-nums; transition: color 250ms var(--ease-soft); }
  .kroky h3 { font-size: 18px; line-height: 1.3; margin-bottom: 2px; }
  .kroky p { font-size: 15px; color: var(--color-ink-soft); max-width: 32em; }
  /* Kým ich rúra nedosiahne, sú kroky tlmené. Bez skriptu sú všetky plné. */
  .kroky-obal.is-ready li:not(.is-on) .k-cislo { color: #9aa3ae; }
  .kroky-obal.is-ready li { transition: opacity 300ms var(--ease-soft); }
  .kroky-obal.is-ready li:not(.is-on) { opacity: 0.6; }

  .pokladka-pata { margin-top: 36px; padding-top: 22px; border-top: 1px solid rgb(10 42 94 / 0.14); display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 28px; }
  .zataz { display: flex; align-items: baseline; gap: 12px; }
  .zataz strong { font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 28px; letter-spacing: -0.02em; color: var(--color-blue-900); white-space: nowrap; }
  .zataz span { font-size: 15px; color: var(--color-ink-soft); }
  .zdroj { font-size: 13px; color: #7a8494; }
  .zdroj a { display: inline-flex; align-items: center; gap: 4px; font-weight: 500; }
  .zdroj :global(svg) { width: 14px; height: 14px; }

  /* ---------- Podzemie: referencie a pre firmy na tmavom, šikmá horná hrana ---------- */
  .podzemie { --sikmina: clamp(28px, 5vw, 96px); position: relative; overflow-x: clip; margin-top: calc(-1 * var(--sikmina)); padding-top: calc(var(--sikmina) + 8px); margin-bottom: -96px; padding-bottom: 112px; color: #fff; }
  /* Spodok končí farbou, ktorou začína pätička, aby medzi nimi nebol schod. */
  .podzemie::before { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, #0e3676 0%, var(--color-blue-900) 38%, #0b2d66 78%, #0c3272 100%); clip-path: polygon(0 var(--sikmina), 100% 0, 100% 100%, 0 100%); }
  .podzemie h2 { color: #fff; }
  .podzemie a { color: #fff; }
  .podzemie a:not(.btn):hover { color: var(--color-yellow-500); }

  .refs { position: relative; }
  .refs-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px; align-items: end; }
  /* Fotka zo stavby vystupuje nad šikmú hranu do svetlého pásu a vpravo za okraj obrazovky. */
  .refs-photo { grid-column: 5 / 13; grid-row: 1; margin: -176px calc(-1 * var(--bleed)) 0 0; position: relative; z-index: 1; }
  .refs-photo :global(img) { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: 55% 60%; display: block; border-radius: var(--radius-l) 0 0 var(--radius-l); box-shadow: 0 30px 60px rgb(4 16 40 / 0.45); }
  .refs-text { grid-column: 1 / 5; grid-row: 1; padding-bottom: 4px; }
  .refs-text h2 { font-size: clamp(26px, 1.6vw + 16px, 36px); margin-bottom: 24px; max-width: 9em; }
  .refs-list li { border-top: 1px solid rgb(255 255 255 / 0.16); }
  .refs-list li:last-child { border-bottom: 1px solid rgb(255 255 255 / 0.16); }
  .refs-list a { display: flex; flex-direction: column; gap: 2px; padding: 14px 0; }
  .refs-list strong { font-weight: 600; transition: color 150ms var(--ease-soft); }
  .refs-list span { font-size: 14px; color: var(--color-on-dark-muted); }
  .refs-list a:hover strong { color: var(--color-yellow-500); }
  .refs-pata { margin-top: 20px; font-size: 15px; }
  .refs-pata a { display: inline-flex; align-items: center; gap: 6px; font-weight: 500; }
  .refs-pata :global(svg) { width: 16px; height: 16px; }

  .b2b { position: relative; margin-top: 96px; }
  .b2b-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px; padding-top: 56px; border-top: 1px solid rgb(255 255 255 / 0.16); }
  .b2b-text { grid-column: 1 / 7; display: flex; flex-direction: column; gap: 22px; }
  .b2b-text h2 { font-size: clamp(26px, 1.6vw + 16px, 36px); max-width: 15em; }
  .b2b-text .lead { color: var(--color-on-dark-muted); }
  .b2b-akcie { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .b2b-akcie .btn-inverse, .b2b-akcie .btn-inverse:hover { color: var(--color-blue-900); }
  .b2b-list { grid-column: 8 / 13; }
  .b2b-list li { padding: 14px 0; border-top: 1px solid rgb(255 255 255 / 0.16); display: flex; flex-direction: column; gap: 2px; }
  .b2b-list li:last-child { border-bottom: 1px solid rgb(255 255 255 / 0.16); }
  .b2b-list strong { font-weight: 600; }
  .b2b-list span { color: var(--color-on-dark-muted); font-size: 14px; }

  /* ---------- Tablet ---------- */
  @media (max-width: 1100px) {
    .facts-bar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
