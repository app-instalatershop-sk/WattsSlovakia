  .pokladka .lead { margin-top: 22px; max-width: 32em; }

  /* Postup je skutočná postupnosť, preto čísla. Rúra po ľavej strane sa pri rolovaní rozvinie. */
  .kroky-obal { position: relative; margin-top: 44px; padding-left: 28px; }
  .kroky-obal::before { content: ""; position: absolute; left: 2px; top: 6px; bottom: 6px; width: 2px; background: rgb(10 42 94 / 0.14); border-radius: 1px; }
  .k-rura { position: absolute; left: 0; top: 6px; bottom: 6px; width: 6px; border-radius: 3px; background: linear-gradient(90deg, #2a7fd6 0%, var(--color-blue-700) 45%, var(--color-blue-800) 100%); transform-origin: top; transform: scaleY(var(--rozvin, 1)); }
  .kroky { display: flex; flex-direction: column; gap: 22px; }
