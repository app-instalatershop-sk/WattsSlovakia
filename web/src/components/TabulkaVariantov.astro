---
/**
 * Tabuľka variantov radu: filter podľa priemeru nosnej rúry a izolácie, kopírovanie obj. čísla,
 * výkon z katalógu výrobcu. Poradie podľa rúry a plášťa, takže štandardná a zosilnená izolácia
 * tej istej rúry stoja pod sebou. Príslušenstvo z katalógu (krytky, pevné body) sa rozbalí pod riadkom.
 * Každý riadok má kotvu podľa obj. čísla (#MD12532C): hľadanie a sprievodca vedú naň, riadok sa zvýrazní
 * a rozbalí sa jeho príslušenstvo. Pod 760 px je každý variant karta.
 */
import Ikona from './Ikona.astro';
import { cislo, datum, priemery, ruraText, kotvaKodu, type Variant } from '../lib/katalog';
import { stranky } from '../content/stranky';
import { type Lang, t, ESHOP_SEARCH } from '../i18n/ui';

/** diely: id produktu → adresa jeho stránky; kodyDielov: „id produktu|obj. číslo“ → adresa riadku v tabuľke dielu. */
interface Props { varianty: Variant[]; zdroj: string; stiahnute: string; lang: Lang; primoZaklad?: string; diely?: Record<string, string>; kodyDielov?: Record<string, string> }
const { varianty, zdroj, stiahnute, lang, primoZaklad, diely = {}, kodyDielov = {} } = Astro.props;
const ui = t(lang);
const tx = stranky(lang).rad;
const ma = (k: keyof Variant) => varianty.some((v) => v[k] !== null && v[k] !== undefined && v[k] !== '');
const maRuru = varianty.some((v) => v.rura || v.rura_text);
const zoradene = [...varianty].sort((a, b) => (priemery(a)[0] ?? 0) - (priemery(b)[0] ?? 0) || (a.plast_mm ?? 0) - (b.plast_mm ?? 0) || a.poradie - b.poradie);
const rury = [...new Set(varianty.flatMap(priemery))].sort((a, b) => a - b);
const izolacie = new Set(varianty.map((v) => v.izolacia).filter(Boolean));
const strany = [...new Set(varianty.map((v) => v.zdroj_strana).filter((x): x is number => typeof x === 'number'))];
const zKatalogu = strany.length > 0 && varianty.every((v) => typeof v.zdroj_strana === 'number');
const maVykon = ma('vykon_kw');
const maPrisl = varianty.some((v) => v.prislusenstvo?.length);
const stlpcov = 2 + [maRuru, ma('dn'), ma('plast_mm'), maVykon, ma('tlak_bar'), ma('hmotnost_kg_m'), ma('polomer_ohybu_m'), ma('kotuc'), izolacie.size > 0, maPrisl].filter(Boolean).length;
const idDetailu = (v: Variant) => `pr-${v.obj_cislo.replace(/[^A-Za-z0-9]/g, '')}`;
---
<div class="tv" data-tv>
  {(rury.length > 2 || izolacie.size > 1) && (
    <div class="tv-filter" role="group" aria-label={tx.filterRura}>
      {rury.length > 2 && (
        <div class="tv-skupina">
          <span class="tv-meno">{tx.filterRura} Ø</span>
          <div class="chips">
            <button type="button" class="chip" aria-pressed="true" data-rura="">{tx.vsetky}</button>
            {rury.map((d) => <button type="button" class="chip" aria-pressed="false" data-rura={d}>{d}</button>)}
          </div>
        </div>
      )}
      {izolacie.size > 1 && (
        <div class="tv-skupina">
          <span class="tv-meno">{tx.filterIzolacia}</span>
          <div class="chips">
            <button type="button" class="chip" aria-pressed="true" data-izolacia="">{tx.vsetky}</button>
            <button type="button" class="chip" aria-pressed="false" data-izolacia="standard">{tx.standard}</button>
            <button type="button" class="chip" aria-pressed="false" data-izolacia="zosilnena">{tx.zosilnena}</button>
          </div>
        </div>
      )}
      <p class="tv-pocet" aria-live="polite" data-pocet data-sablona={tx.zobrazene(0, 0).replace(/\d+/, '{n}').replace(/\d+/, '{z}')}>{tx.zobrazene(varianty.length, varianty.length)}</p>
    </div>
  )}

  <div class="tv-obal">
    <table class="data tv-tab">
      <thead>
        <tr>
          <th scope="col">{ui.tabulka.obj}</th>
          {maRuru && <th scope="col" class="right">{ui.tabulka.rura}<small>mm</small></th>}
          {ma('dn') && <th scope="col">{ui.tabulka.dn}</th>}
          {ma('plast_mm') && <th scope="col" class="right">{ui.tabulka.plast}<small>mm</small></th>}
          {maVykon && <th scope="col" class="right">{tx.vykon}<small>kW</small></th>}
          {ma('tlak_bar') && <th scope="col" class="right">{ui.tabulka.tlak}<small>bar</small></th>}
          {ma('hmotnost_kg_m') && <th scope="col" class="right">{ui.tabulka.hmotnost}<small>kg/m</small></th>}
          {ma('polomer_ohybu_m') && <th scope="col" class="right">{ui.tabulka.polomer}<small>m</small></th>}
          {ma('kotuc') && <th scope="col" class="right">{ui.tabulka.kotuc}<small>m</small></th>}
          {izolacie.size > 0 && <th scope="col">{ui.tabulka.izolacia}</th>}
          {maPrisl && <th scope="col" class="tv-pr-th">{tx.prislusenstvo}</th>}
          <th scope="col" class="tv-shop-th"><span class="sr">{ui.tabulka.eshop}</span></th>
        </tr>
      </thead>
      <tbody>
        {zoradene.map((v) => (<>
          <tr id={kotvaKodu(v.obj_cislo)} data-rury={priemery(v).join(' ')} data-izolacia={v.izolacia ?? ''}>
            <td class="code"><span class="tv-kod-obal">
              <span class="tv-kod">{v.obj_cislo}</span>
              <button type="button" class="kopia" data-kopia={v.obj_cislo} aria-label={`${tx.kopirovat} ${v.obj_cislo}`} title={tx.kopirovat}><Ikona nazov="copy" velkost={15} /></button>
            </span></td>
            {maRuru && <td class:list={['right', { viac: ruraText(v).includes('+') }]} data-l={ui.tabulka.rura}>{ruraText(v)}{ruraText(v) ? <span class="tv-j">&nbsp;mm</span> : null}</td>}
            {ma('dn') && <td data-l={ui.tabulka.dn}>{v.dn ?? ''}</td>}
            {ma('plast_mm') && <td class="right" data-l={ui.tabulka.plast}>{cislo(v.plast_mm)}{v.plast_mm ? <span class="tv-j">&nbsp;mm</span> : null}</td>}
            {maVykon && <td class="right" data-l={tx.vykon}>{v.vykon_kw ? `~${cislo(v.vykon_kw)}` : ''}{v.vykon_kw ? <span class="tv-j">&nbsp;kW</span> : null}</td>}
            {ma('tlak_bar') && <td class="right" data-l={ui.tabulka.tlak}>{cislo(v.tlak_bar)}{v.tlak_bar ? <span class="tv-j">&nbsp;bar</span> : null}</td>}
            {ma('hmotnost_kg_m') && <td class="right" data-l={ui.tabulka.hmotnost}>{cislo(v.hmotnost_kg_m, 2)}{v.hmotnost_kg_m ? <span class="tv-j">&nbsp;kg/m</span> : null}</td>}
            {ma('polomer_ohybu_m') && <td class="right" data-l={ui.tabulka.polomer}>{cislo(v.polomer_ohybu_m, 2)}{v.polomer_ohybu_m ? <span class="tv-j">&nbsp;m</span> : null}</td>}
            {ma('kotuc') && <td class="right tv-kotuc" data-l={ui.tabulka.kotuc}>{v.kotuc ? `${cislo(v.kotuc.d, 2)} / ${cislo(v.kotuc.sirka, 2)}` : ''}{v.kotuc ? <span class="tv-j">&nbsp;m</span> : null}</td>}
            {izolacie.size > 0 && <td data-l={ui.tabulka.izolacia}>{v.izolacia && <span class:list={['tv-iz', { zos: v.izolacia === 'zosilnena' }]}>{v.izolacia === 'zosilnena' ? ui.tabulka.zosilnena : ui.tabulka.standard}</span>}</td>}
            {maPrisl && <td class="tv-pr-td" data-l={v.prislusenstvo?.length ? tx.prislusenstvo : undefined}>{v.prislusenstvo?.length ? <button type="button" class="tv-pr" aria-expanded="false" aria-controls={idDetailu(v)} data-pr>{tx.dielov(v.prislusenstvo.length)} <Ikona nazov="chevron-down" velkost={16} /></button> : null}</td>}
            <td class="tv-shop"><a href={v.eshop_url} target="_blank" rel="noopener">{ui.common.doEshopu} <Ikona nazov="external-link" velkost={14} /></a></td>
          </tr>
          {v.prislusenstvo?.length ? (
            <tr class="tv-det" id={idDetailu(v)} hidden>
              <td colspan={stlpcov}>
                <ul class="tv-diely">
                  {v.prislusenstvo.map((d) => (
                    <li>
                      <span class="tv-diel-druh">{tx.druhy[d.druh]}{d.zavit && <small>{d.zavit}</small>}</span>
                      <span class="tv-diel-kod">{d.obj}<button type="button" class="kopia" data-kopia={d.obj} aria-label={`${tx.kopirovat} ${d.obj}`} title={tx.kopirovat}><Ikona nazov="copy" velkost={14} /></button></span>
                      {d.pocet === 2 && <span class="tv-diel-ks">{tx.ks2}</span>}
                      <span class="tv-diel-odkazy">
                        {d.produkt && diely[d.produkt] && <a href={kodyDielov[`${d.produkt}|${d.obj}`] ?? diely[d.produkt]}>{tx.stranaDielu}</a>}
                        <a href={ESHOP_SEARCH + encodeURIComponent(d.obj)} target="_blank" rel="noopener">{ui.common.doEshopu} <Ikona nazov="external-link" velkost={13} /></a>
                      </span>
                    </li>
                  ))}
                </ul>
              </td>
            </tr>
          ) : null}
        </>))}
      </tbody>
    </table>
  </div>

  <div class="tv-pozn">
    {maVykon && <p>{tx.vykonPozn}</p>}
    {ma('hmotnost_kg_m') && <p>{ui.tabulka.zdrojPozn}</p>}
    {primoZaklad && <p>{tx.primoPozn(primoZaklad)}</p>}
    {!ma('plast_mm') && <p>{tx.bezPlasta}</p>}
    {maPrisl && <p>{tx.prislPozn}</p>}
    <p>{zKatalogu ? tx.zdrojStrana(strany[0]) : <>{ui.common.zdroj} {datum(stiahnute, lang)}. <a href={zdroj} target="_blank" rel="noopener">{ui.common.strankaVyrobcu}</a>.</>}</p>
  </div>
</div>

<style>
  .tv-filter { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 16px 36px; padding: 22px 24px 18px; border-bottom: 1px solid rgb(10 42 94 / 0.08); }
  .tv-skupina { display: flex; flex-direction: column; gap: 8px; }
  .tv-meno { font-size: 13px; color: var(--color-ink-soft); }
  .tv-filter .chip { min-width: 44px; justify-content: center; font-variant-numeric: tabular-nums; }
  .tv-pocet { margin-left: auto; font-size: 14px; color: var(--color-ink-soft); padding-bottom: 7px; }

  .tv-obal { overflow-x: auto; scrollbar-width: thin; padding: 4px 12px 8px; }
  .tv-tab th { background: #fff; }
  .tv-tab th, .tv-tab td { padding: 13px 14px; }
  .tv-tab tbody tr[hidden] { display: none; }
  /* Riadok, na ktorý vedie odkaz (#obj. číslo): žltý pruh a jemné pozadie, pod lepkavou hlavičkou a navigáciou častí. */
  .tv-tab tbody tr[data-rury] { scroll-margin-top: 170px; }
  .tv-tab tbody tr[data-rury]:target, .tv-tab tbody tr.je-ciel { background: #fff8db; box-shadow: inset 4px 0 0 var(--color-yellow-500); }
  .tv-tab tbody tr.je-ciel + tr.tv-det > td { background: linear-gradient(180deg, #fff8db 0%, #f8fafd 100%); }
  .tv-tab td.code { padding-block: 8px; }
  .tv-kod-obal { display: flex; align-items: center; gap: 6px; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 15px; letter-spacing: 0.01em; color: var(--color-blue-900); }
  .tv-iz { display: inline-flex; align-items: center; gap: 7px; }
  .tv-iz::before { content: ""; width: 9px; height: 9px; border-radius: 50%; background: var(--color-grey-300); }
  .tv-iz.zos::before { background: var(--color-blue-700); box-shadow: 0 0 0 3px rgb(0 93 185 / 0.15); }
  .tv-pr { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 10px 0 12px; border: 1px solid rgb(10 42 94 / 0.16); border-radius: var(--radius-m); background: #fff; font: inherit; font-size: 14px; font-weight: 500; color: var(--color-ink); cursor: pointer; white-space: nowrap; transition: border-color 150ms var(--ease-soft), background-color 150ms var(--ease-soft); }
  .tv-pr:hover { border-color: var(--color-blue-700); }
  .tv-pr :global(.icon) { color: var(--color-blue-700); transition: transform 200ms var(--ease-soft); }
  .tv-pr[aria-expanded="true"] { background: var(--color-blue-50); border-color: var(--color-blue-700); }
  .tv-pr[aria-expanded="true"] :global(.icon) { transform: rotate(180deg); }
  .tv-tab tr.tv-det > td { padding: 4px 14px 18px; background: linear-gradient(180deg, #f3f7fc 0%, #f8fafd 100%); white-space: normal; }
  .tv-tab tbody tr.tv-det:hover { background: transparent; }
  .tv-diely { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 10px; }
  .tv-diely li { display: flex; flex-direction: column; gap: 3px; padding: 12px 14px; border-radius: var(--radius-l); background: #fff; box-shadow: 0 1px 0 rgb(10 42 94 / 0.05), var(--elev-1); }
  .tv-diel-druh { font-size: 13px; color: var(--color-ink-soft); }
  .tv-diel-druh small { margin-left: 8px; font-size: 13px; color: var(--color-ink); font-weight: 500; }
  .tv-diel-kod { display: flex; align-items: center; gap: 4px; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 16px; color: var(--color-blue-900); }
  .tv-diel-ks { align-self: flex-start; padding: 2px 8px; border-radius: var(--radius-s); background: #fff4cc; font-size: 13px; font-weight: 600; color: #6b4d00; }
  .tv-diel-odkazy { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 2px; font-size: 14px; font-weight: 500; }
  .tv-diel-odkazy a { display: inline-flex; align-items: center; gap: 4px; }
  .tv-shop a { display: inline-flex; align-items: center; gap: 6px; font-weight: 500; color: var(--color-blue-700); }
  .tv-shop a:hover { color: var(--color-blue-900); }

  /* Jednotka pri hodnote len v mobilnej karte; na počítači je v záhlaví stĺpca (posúdenie 29. 10.: čísla bez
     jednotky splývajú, popis s jednotkou sa zalamoval). */
  .tv-j { display: none; }
  .tv-pozn { padding: 14px 26px 22px; border-top: 1px solid rgb(10 42 94 / 0.08); font-size: 13px; line-height: 1.5; color: var(--color-ink-soft); }
  .tv-pozn p + p { margin-top: 4px; }
  /* Odkaz vo vete sa od textu líši aj inak ako farbou (prístupnosť, kontrola Lighthouse). */
  .tv-pozn a { text-decoration: underline; text-underline-offset: 2px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  /* Mobil: variant ako karta, obj. číslo a e-shop na jednom riadku, údaje v dvoch stĺpcoch. */
  @media (max-width: 760px) {
    .tv-filter { padding: 18px 18px 14px; gap: 14px; }
    /* Pri 390 px sa šesť čipov (Všetky a päť priemerov) zmestí do riadku, posledný sa nezalomí sám. */
    .tv-filter .chips { gap: 6px; }
    .tv-filter .chip { min-width: 40px; padding: 0 10px; }
    .tv-pocet { margin-left: 0; padding-bottom: 0; }
    .tv-obal { padding: 0; overflow: visible; }
    .tv-tab, .tv-tab tbody { display: block; }
    .tv-tab thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .tv-tab tbody tr { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px 12px; padding: 14px 18px 16px; border-bottom: 1px solid rgb(10 42 94 / 0.08); }
    .tv-tab tbody tr:hover { background: transparent; }
    .tv-tab tbody tr[data-rury] { scroll-margin-top: 140px; }
    .tv-tab td { display: block; padding: 0; border: 0; white-space: normal; text-align: left; font-size: 15px; }
    .tv-j { display: inline; }
    .tv-tab td[data-l]::before { content: attr(data-l); display: block; font-size: 12px; line-height: 1.3; color: var(--color-ink-soft); margin-bottom: 1px; }
    .tv-tab td:empty { display: none; }
    .tv-tab td.viac, .tv-tab td.tv-pr-td { grid-column: 1 / -1; }
    /* priemer a šírka kotúča s jednotkou sa do tretiny karty nezmestia bez zalomenia */
    .tv-tab td.tv-kotuc { grid-column: span 2; }
    .tv-tab tbody tr.tv-det { display: block; padding: 0 18px 16px; border-bottom: 1px solid rgb(10 42 94 / 0.08); }
    .tv-tab tbody tr.tv-det[hidden] { display: none; }
    .tv-tab tr.tv-det > td { display: block; padding: 12px; border-radius: var(--radius-l); }
    .tv-diely { grid-template-columns: minmax(0, 1fr); }
    .tv-tab td.code { grid-column: 1 / 3; padding: 0; }
    .tv-kod-obal { font-size: 17px; }
    .tv-tab td.tv-shop { grid-column: 3; grid-row: 1; justify-self: end; align-self: center; white-space: nowrap; }
      .tv-pozn { padding: 14px 18px 20px; }
  }
  /* Veľmi úzky telefón: údaje v dvoch stĺpcoch, obj. číslo a odkaz do e-shopu každý na vlastnom riadku. */
  @media (max-width: 359px) {
    .tv-tab tbody tr { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tv-tab td.code { grid-column: 1 / -1; }
    .tv-tab td.tv-shop { grid-column: 1 / -1; grid-row: 2; justify-self: start; }
  }
</style>

<script>
  // Poslucháče na dokumente patria stránke: pri prechode na inú stránku (ClientRouter) sa zrušia.
  let stranka: AbortController | undefined;
  document.addEventListener('astro:before-swap', () => stranka?.abort());

  function initTabulky() {
    if (!stranka || stranka.signal.aborted) stranka = new AbortController();
    const signal = stranka.signal;
    document.querySelectorAll<HTMLElement>('[data-tv]').forEach((tv) => {
      if (tv.dataset.init) return;
      tv.dataset.init = '1';
      const riadky = [...tv.querySelectorAll<HTMLTableRowElement>('tbody tr[data-rury]')];
      // Riadok s príslušenstvom je vidieť, len keď je jeho variant viditeľný a rozbalený.
      const detail = (r: HTMLTableRowElement) => {
        const b = r.querySelector<HTMLElement>('[data-pr]');
        const d = b ? document.getElementById(b.getAttribute('aria-controls')!) : null;
        if (d) d.hidden = r.hidden || b!.getAttribute('aria-expanded') !== 'true';
      };
      tv.querySelectorAll<HTMLButtonElement>('[data-pr]').forEach((b) => b.addEventListener('click', () => {
        b.setAttribute('aria-expanded', String(b.getAttribute('aria-expanded') !== 'true'));
        detail(b.closest('tr')!);
      }));
      const pocet = tv.querySelector<HTMLElement>('[data-pocet]');
      const stav = { rura: '', izolacia: '' };
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // Filter (DESIGN kap. 16.1, FLIP): riadky, ktoré ostanú, sa presunú na nové miesto, nové prídu
      // odstupňovane zdola. Pri „obmedziť pohyb“ sa len prepnú.
      const obnov = () => {
        const pred = new Map(riadky.filter((r) => !r.hidden).map((r) => [r, r.getBoundingClientRect().top]));
        let n = 0;
        for (const r of riadky) {
          const ok = (!stav.rura || (r.dataset.rury ?? '').split(' ').includes(stav.rura)) && (!stav.izolacia || r.dataset.izolacia === stav.izolacia);
          r.hidden = !ok;
          detail(r);
          if (ok) n++;
        }
        if (pocet) pocet.textContent = (pocet.dataset.sablona ?? '').replace('{n}', String(n)).replace('{z}', String(riadky.length));
        if (reduce) return;
        let i = 0;
        for (const r of riadky) {
          if (r.hidden) continue;
          const y0 = pred.get(r);
          if (y0 === undefined) {
            r.animate([{ opacity: 0, transform: 'translateY(10px)' }, { opacity: 1, transform: 'none' }], { duration: 360, delay: 40 + i++ * 24, easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)', fill: 'backwards' });
          } else {
            const dy = y0 - r.getBoundingClientRect().top;
            if (Math.abs(dy) > 1) r.animate([{ transform: `translateY(${dy}px)` }, { transform: 'none' }], { duration: 420, easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)' });
          }
        }
      };
      const nastav = (kluc: 'rura' | 'izolacia', hodnota: string) => {
        stav[kluc] = hodnota;
        tv.querySelectorAll<HTMLButtonElement>(`button[data-${kluc}]`).forEach((x) => x.setAttribute('aria-pressed', String((x.dataset[kluc] ?? '') === hodnota)));
      };
      tv.querySelectorAll<HTMLButtonElement>('button[data-rura], button[data-izolacia]').forEach((b) => {
        b.addEventListener('click', () => {
          const kluc = 'rura' in b.dataset ? 'rura' : 'izolacia';
          nastav(kluc, b.dataset[kluc] ?? '');
          obnov();
          // Živé kóty v hlave radu (VolbaDimenzie) sa nastavia podľa filtra.
          document.dispatchEvent(new CustomEvent('mfx:dimenzia', { detail: { ...stav, zdroj: 'tabulka' } }));
        });
      });
      // Výber dimenzie v hlave nastaví filter; hodnotu bez tlačidla (napr. pri dvoch rúrach v plášti) vynechá.
      document.addEventListener('mfx:dimenzia', (e) => {
        const d = (e as CustomEvent<{ rura: string; izolacia: string; zdroj: string }>).detail;
        if (d.zdroj === 'tabulka') return;
        nastav('rura', d.rura && tv.querySelector(`button[data-rura="${d.rura}"]`) ? d.rura : '');
        nastav('izolacia', d.izolacia && tv.querySelector(`button[data-izolacia="${d.izolacia}"]`) ? d.izolacia : '');
        obnov();
      }, { signal });
    });
    oznacCiel();
  }

  // Riadok z adresy (#MD12532C): zvýrazniť, zrušiť filter, ak ho skrýva, a rozbaliť príslušenstvo.
  // Trieda namiesto samotného :target, lebo prechod stránok cez ClientRouter :target neobnoví.
  function oznacCiel() {
    document.querySelectorAll('.tv-tab tr.je-ciel').forEach((r) => r.classList.remove('je-ciel'));
    const id = decodeURIComponent(location.hash.slice(1));
    const r = id ? document.getElementById(id) : null;
    if (!(r instanceof HTMLTableRowElement) || !r.dataset.rury) return;
    const tv = r.closest<HTMLElement>('[data-tv]');
    if (r.hidden) tv?.querySelectorAll<HTMLButtonElement>('button[data-rura=""], button[data-izolacia=""]').forEach((b) => b.click());
    r.classList.add('je-ciel');
    const b = r.querySelector<HTMLButtonElement>('[data-pr]');
    if (b && b.getAttribute('aria-expanded') !== 'true') b.click();
    requestAnimationFrame(() => r.scrollIntoView({ block: 'center' }));
  }
  initTabulky();
  document.addEventListener('astro:page-load', initTabulky);
  window.addEventListener('hashchange', oznacCiel);
</script>
