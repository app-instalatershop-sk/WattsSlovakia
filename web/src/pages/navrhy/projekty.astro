---
import Strana from '../../navrhy/Strana.astro';
import Navrh from '../../navrhy/Navrh.astro';
import Scena from '../../components/Scena.astro';
import { referencie } from '../../content/referencie';
import { fotkaReferencie } from '../../lib/obrazky';
import { sadzba } from '../../lib/sadzba';
import { t, route } from '../../i18n/ui';
import type { Kota } from '../../lib/koty';

const h = t('sk').home;
const po = h.projekty.orange;
const pp = h.projekty.povazska;
const refs = referencie('sk');
const sO = refs.find((r) => r.id === 'orange')!.scena!;
const sP = refs.find((r) => r.id === 'povazska-bystrica')!.scena!;
const orange = fotkaReferencie(sO.fotka)!;
const kotolna = fotkaReferencie(sP.fotka)!;
const siroka = fotkaReferencie('orange-5-siroka.jpg')!;
const stavenisko = fotkaReferencie('povazska-3.jpg')!;
// B: výrez orange-5 riadky 200 až 800 (2 : 1); body prepočítané z výrezu scény, štítky doprava od textu.
const kotySiroka: Kota[] = [
  { x: 43, y: 83, l: 8, smer: 'hore-vpravo', hodnota: 'Ø 63 až 90 mm', text: 'Microflex UNO' },
  { x: 60.5, y: 55.3, l: 8, smer: 'hore-vpravo', smerM: 'hore-vlavo', hodnota: 'asi 800 m', text: 'z kotolne do budov areálu' },
];
// C: rúra na fotke staveniska (modré pixely pri 45 % šírky ležia na 76 % výšky).
const kotyStavenisko: Kota[] = [{ x: 45, y: 76, l: 12, smer: 'hore-vpravo', hodnota: '31 budov', text: 'rozvod z jednej kotolne' }];
const ref = (id: string) => `${route('sk', 'referencie')}#${id}`;
const VARIANTY = [
  { pismeno: 'A', nazov: 'Dnes: dve scény hadovito' },
  { pismeno: 'B', nazov: 'Fotka cez celú šírku a vložená scéna' },
  { pismeno: 'C', nazov: 'Mozaika troch fotiek' },
];
---
<Strana cesta="/navrhy/projekty/" nadpis="Projekty na domove" varianty={VARIANTY}
  popis="Rozloženie fotiek zo stavieb v tmavom podzemí domova. Kóty stoja na rúre alebo v kotolni. Nad každým variantom je kúsok svetlej sekcie pokládky, aby bolo vidno prechod cez šikmú hranu."
  kde="domov SK a CS; ten istý jazyk fotiek s kótami by prevzali Referencie, Pre firmy a stránky radov">

  <Navrh pismeno="A" nazov="Dve scény hadovito" dnes
    popis="Prvá fotka vpravo vystupuje cez šikmú hranu, druhá vľavo; text pri každej. Pokojné, ale obe fotky sú stredne veľké a podobne vážne.">
    <div class="svetla"></div>
    <div class="podzemie">
      <article class="wrap proj proj-a">
        <Scena class="proj-scena" obraz={orange} alt={po.alt} koty={sO.koty} widths={[760, 1000, 1200]} sizes="(max-width: 900px) 100vw, 66vw" />
        <div class="proj-text">
          <h2>{h.projektyH2}</h2>
          <p class="proj-uvod">{sadzba(h.projektyP)}</p>
          <p class="proj-kde">{po.kde}</p>
          <h3>{sadzba(po.h3)}</h3>
          <p>{sadzba(po.p)}</p>
          <a class="proj-odkaz" href={ref('orange')}>{h.projektyViac}</a>
        </div>
      </article>
      <article class="wrap proj proj-b">
        <Scena class="proj-scena" obraz={kotolna} alt={pp.alt} koty={sP.koty} widths={[640, 895]} sizes="(max-width: 900px) 100vw, 56vw" />
        <div class="proj-text">
          <p class="proj-kde">{pp.kde}</p>
          <h3>{sadzba(pp.h3)}</h3>
          <p>{sadzba(pp.p)}</p>
          <a class="proj-odkaz" href={ref('povazska-bystrica')}>{h.projektyViac}</a>
        </div>
      </article>
    </div>
  </Navrh>

  <Navrh pismeno="B" nazov="Fotka cez celú šírku a vložená scéna" odporucam
    popis="Najväčšia stavba cez celú šírku obrazovky, nadpis priamo na fotke v tmavom prechode. Kotolňa druhého projektu je vložená do spodnej hrany ako druhý pohľad. Najviac pôsobí mierkou, ale potrebuje fotku aspoň 2 400 px široku (dnešná má 1 200 px, na veľkom monitore je mäkká)."
    inspiracia="Apple a Porsche (obraz cez celú šírku s textom v ňom), Thermaflex (prípadová štúdia s číslom v nadpise)">
    <div class="svetla"></div>
    <div class="podzemie pb">
      <div class="pb-velka">
        <Scena class="pb-scena" obraz={siroka} alt={po.alt} koty={kotySiroka} widths={[1000, 1200]} sizes="100vw" />
        <div class="pb-text wrap">
          <div class="pb-text-in">
            <h2>{h.projektyH2}</h2>
            <p class="proj-kde">{po.kde}</p>
            <h3>{sadzba(po.h3)}</h3>
            <a class="proj-odkaz" href={ref('orange')}>{h.projektyViac}</a>
          </div>
        </div>
      </div>
      <article class="wrap pb-druha">
        <div class="proj-text">
          <p class="proj-kde">{pp.kde}</p>
          <h3>{sadzba(pp.h3)}</h3>
          <p>{sadzba(pp.p)}</p>
          <a class="proj-odkaz" href={ref('povazska-bystrica')}>{h.projektyViac}</a>
        </div>
        <Scena class="pb-vlozena" obraz={kotolna} alt={pp.alt} koty={sP.koty} widths={[640, 895]} sizes="(max-width: 900px) 100vw, 44vw" />
      </article>
    </div>
  </Navrh>

  <Navrh pismeno="C" nazov="Mozaika troch fotiek"
    popis="Redakčná skladba: veľká fotka výkopu vľavo, vpravo kotolňa a stavenisko so žeriavom nad sebou, každá s jednou kótou. Pôsobí ako reportáž zo stavieb, fotky sa navzájom podporujú. Text oboch projektov ide pod mozaiku."
    inspiracia="Vipp (redakčné asymetrické skladby fotiek), Logstor (stavby v mierke)">
    <div class="svetla"></div>
    <div class="podzemie pc">
      <div class="wrap">
        <div class="pc-hlava">
          <h2>{h.projektyH2}</h2>
          <p class="proj-uvod">{sadzba(h.projektyP)}</p>
        </div>
        <div class="pc-mozaika">
          <Scena class="pc-a" obraz={orange} alt={po.alt} koty={sO.koty} widths={[760, 1000, 1200]} sizes="(max-width: 900px) 100vw, 62vw" />
          <Scena class="pc-b" obraz={kotolna} alt={pp.alt} koty={sP.koty} widths={[480, 895]} sizes="(max-width: 900px) 100vw, 36vw" />
          <Scena class="pc-c" obraz={stavenisko} alt="Stavenisko obytného súboru v Považskej Bystrici s bagrom a potrubím Microflex" koty={kotyStavenisko} widths={[480, 895]} sizes="(max-width: 900px) 100vw, 36vw" />
        </div>
        <div class="pc-texty">
          <div class="proj-text">
            <p class="proj-kde">{po.kde}</p>
            <h3>{sadzba(po.h3)}</h3>
            <p>{sadzba(po.p)}</p>
            <a class="proj-odkaz" href={ref('orange')}>{h.projektyViac}</a>
          </div>
          <div class="proj-text">
            <p class="proj-kde">{pp.kde}</p>
            <h3>{sadzba(pp.h3)}</h3>
            <p>{sadzba(pp.p)}</p>
            <a class="proj-odkaz" href={ref('povazska-bystrica')}>{h.projektyViac}</a>
          </div>
        </div>
      </div>
    </div>
  </Navrh>
</Strana>

<style>
  /* Kúsok svetlej sekcie pokládky nad podzemím. */
  .svetla { height: 200px; background: linear-gradient(180deg, var(--zem-3) 0%, var(--zem-4) 100%); }
  .podzemie { --sikmina: clamp(28px, 5vw, 96px); position: relative; overflow-x: clip; margin-top: calc(-1 * var(--sikmina)); padding: calc(var(--sikmina) + 8px) 0 112px; color: #fff; }
  .podzemie::before { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, #0e3676 0%, var(--color-blue-900) 38%, #0b2d66 78%, #0c3272 100%); clip-path: polygon(0 var(--sikmina), 100% 0, 100% 100%, 0 100%); }
  .podzemie h2, .podzemie h3 { color: #fff; }
  .podzemie a { color: #fff; }

  /* Spoločný text projektov (ako na domove). */
  .proj-text { position: relative; display: flex; flex-direction: column; align-items: flex-start; }
  .proj-text h2 { font-size: clamp(30px, 2.2vw + 14px, 46px); line-height: 1.06; letter-spacing: -0.025em; max-width: 10em; }
  .proj-uvod { margin-top: 18px; color: var(--color-on-dark-muted); font-size: 17px; line-height: 1.55; max-width: 26em; }
  .proj-kde { margin-top: 40px; font-size: 15px; font-weight: 500; color: #8fb9ec; }
  .proj-text h3 { margin-top: 8px; font-size: clamp(22px, 0.9vw + 15px, 28px); line-height: 1.15; letter-spacing: -0.015em; max-width: 14em; }
  .proj-text h3 + p { margin-top: 12px; color: var(--color-on-dark-muted); font-size: 15.5px; line-height: 1.6; max-width: 30em; }
  .proj-odkaz { margin-top: 18px; font-weight: 500; border-bottom: 1px solid rgb(255 255 255 / 0.5); padding-bottom: 2px; }

  /* ---------- A: dnes ---------- */
  .proj { position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px; align-items: end; }
  .proj + .proj { margin-top: 128px; align-items: center; }
  .proj-a :global(.proj-scena) { grid-column: 5 / 13; grid-row: 1; margin: -176px calc(-1 * var(--bleed)) 0 0; z-index: 1; }
  .proj-a .proj-text { grid-column: 1 / 5; grid-row: 1; }
  .proj-b :global(.proj-scena) { grid-column: 1 / 8; grid-row: 1; margin-left: calc(-1 * var(--bleed)); }
  .proj-b .proj-text { grid-column: 9 / 13; grid-row: 1; }
  .proj-b .proj-kde { margin-top: 0; }
  .proj :global(.scena-img) { box-shadow: 0 40px 80px -34px rgb(2 10 30 / 0.75); }
  .proj-a :global(.scena-img) { border-radius: 18px 0 0 18px; }
  .proj-b :global(.scena-img) { border-radius: 0 18px 18px 0; }

  /* ---------- B: cez celú šírku ---------- */
  .pb { padding-top: 0; }
  .pb-velka { position: relative; margin-top: calc(-1 * var(--sikmina) - 8px); }
  .pb :global(.pb-scena .scena-img) { width: 100%; }
  /* Tmavý prechod zľava a zdola, aby nadpis na fotke bol čitateľný; kóty ostávajú vpravo na svetlej časti. */
  .pb-velka::after { content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(90deg, rgb(8 30 70 / 0.92) 0%, rgb(8 30 70 / 0.7) 28%, rgb(8 30 70 / 0) 55%), linear-gradient(0deg, #0b2d66 0%, rgb(11 45 102 / 0) 30%); }
  .pb-velka :global(.koty) { z-index: 3; }
  .pb-text { position: absolute; inset: 0; z-index: 2; display: flex; align-items: center; pointer-events: none; }
  .pb-text-in { max-width: 30em; pointer-events: auto; }
  .pb-text h2 { font-size: clamp(32px, 2.6vw + 14px, 56px); line-height: 1.04; letter-spacing: -0.03em; max-width: 9em; }
  .pb-text .proj-kde { margin-top: 28px; }
  .pb-druha { position: relative; z-index: 4; display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 32px 56px; align-items: start; margin-top: -120px; }
  .pb-druha .proj-text { padding-top: 160px; }
  .pb-druha .proj-kde { margin-top: 0; }
  .pb :global(.pb-vlozena .scena-img) { border-radius: 18px; box-shadow: 0 40px 80px -30px rgb(2 10 30 / 0.85), 0 0 0 6px rgb(11 45 102 / 1); }

  /* ---------- C: mozaika ---------- */
  .pc-hlava { position: relative; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 24px 56px; align-items: end; padding-top: 24px; }
  .pc-hlava h2 { font-size: clamp(30px, 2.2vw + 14px, 46px); line-height: 1.06; letter-spacing: -0.025em; max-width: 12em; }
  .pc-hlava .proj-uvod { margin-top: 0; }
  /* Šírky stĺpcov sú vypočítané tak, aby výška veľkej fotky (3 : 2) sedela s dvomi menšími (16 : 9) nad sebou. */
  .pc-mozaika { display: grid; grid-template-columns: minmax(0, 1.765fr) minmax(0, 1fr); grid-template-rows: auto auto; gap: 24px; margin-top: 40px; }
  .pc-mozaika :global(.pc-a) { grid-row: 1 / span 2; }
  .pc-mozaika :global(.scena-img) { border-radius: 16px; box-shadow: 0 34px 70px -34px rgb(2 10 30 / 0.8); }
  .pc-texty { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 56px; margin-top: 8px; }

  @media (max-width: 900px) {
    .proj-a :global(.proj-scena), .proj-b :global(.proj-scena) { grid-column: 1 / -1; margin: 0 calc(-1 * var(--gutter)); }
    .proj-a .proj-text, .proj-b .proj-text { grid-column: 1 / -1; grid-row: 2; }
    .pb-text { position: relative; inset: auto; padding-top: 24px; }
    .pb-velka::after { display: none; }
    .pb-druha, .pc-hlava, .pc-mozaika, .pc-texty { grid-template-columns: minmax(0, 1fr); }
    .pb-druha { margin-top: 32px; }
    .pb-druha .proj-text { padding-top: 0; }
    .pc-mozaika :global(.pc-a) { grid-row: auto; }
  }
</style>
