---
/**
 * Tabuľka variantov radu: filter podľa priemeru nosnej rúry a izolácie, kopírovanie obj. čísla,
 * výkon z katalógu výrobcu. Poradie podľa rúry a plášťa, takže štandardná a zosilnená izolácia
 * tej istej rúry stoja pod sebou. Pod 760 px je každý variant karta.
 */
import Ikona from './Ikona.astro';
import { cislo, datum, priemery, ruraText, type Variant } from '../lib/katalog';
import { stranky } from '../content/stranky';
import { type Lang, t } from '../i18n/ui';

interface Props { varianty: Variant[]; zdroj: string; stiahnute: string; lang: Lang; primoZaklad?: string }
const { varianty, zdroj, stiahnute, lang, primoZaklad } = Astro.props;
const ui = t(lang);
const tx = stranky(lang).rad;
const ma = (k: keyof Variant) => varianty.some((v) => v[k] !== null && v[k] !== undefined && v[k] !== '');
const maRuru = varianty.some((v) => v.rura || v.rura_text);
const zoradene = [...varianty].sort((a, b) => (priemery(a)[0] ?? 0) - (priemery(b)[0] ?? 0) || (a.plast_mm ?? 0) - (b.plast_mm ?? 0) || a.poradie - b.poradie);
const rury = [...new Set(varianty.flatMap(priemery))].sort((a, b) => a - b);
const izolacie = new Set(varianty.map((v) => v.izolacia).filter(Boolean));
const strany = [...new Set(varianty.map((v) => v.zdroj_strana).filter((x): x is number => typeof x === 'number'))];
const zKatalogu = strany.length > 0 && varianty.every((v) => typeof v.zdroj_strana === 'number');
const maVykon = ma('vykon_kw');
---
<div class="tv" data-tv>
  {(rury.length > 2 || izolacie.size > 1) && (
    <div class="tv-filter" role="group" aria-label={tx.filterRura}>
      {rury.length > 2 && (
        <div class="tv-skupina">
          <span class="tv-meno">{tx.filterRura} Ø</span>
          <div class="chips">
            <button type="button" class="chip" aria-pressed="true" data-rura="">{tx.vsetky}</button>
            {rury.map((d) => <button type="button" class="chip" aria-pressed="false" data-rura={d}>{d}</button>)}
          </div>
        </div>
      )}
      {izolacie.size > 1 && (
        <div class="tv-skupina">
          <span class="tv-meno">{tx.filterIzolacia}</span>
          <div class="chips">
            <button type="button" class="chip" aria-pressed="true" data-izolacia="">{tx.vsetky}</button>
            <button type="button" class="chip" aria-pressed="false" data-izolacia="standard">{tx.standard}</button>
            <button type="button" class="chip" aria-pressed="false" data-izolacia="zosilnena">{tx.zosilnena}</button>
          </div>
        </div>
      )}
      <p class="tv-pocet" aria-live="polite" data-pocet data-sablona={tx.zobrazene(0, 0).replace(/\d+/, '{n}').replace(/\d+/, '{z}')}>{tx.zobrazene(varianty.length, varianty.length)}</p>
    </div>
  )}

  <div class="tv-obal">
    <table class="data tv-tab">
      <thead>
        <tr>
          <th scope="col">{ui.tabulka.obj}</th>
          {maRuru && <th scope="col" class="right">{ui.tabulka.rura}<small>mm</small></th>}
          {ma('dn') && <th scope="col">{ui.tabulka.dn}</th>}
          {ma('plast_mm') && <th scope="col" class="right">{ui.tabulka.plast}<small>mm</small></th>}
          {maVykon && <th scope="col" class="right">{tx.vykon}<small>kW</small></th>}
          {ma('tlak_bar') && <th scope="col" class="right">{ui.tabulka.tlak}<small>bar</small></th>}
          {ma('hmotnost_kg_m') && <th scope="col" class="right">{ui.tabulka.hmotnost}<small>kg/m</small></th>}
          {ma('polomer_ohybu_m') && <th scope="col" class="right">{ui.tabulka.polomer}<small>m</small></th>}
          {ma('kotuc') && <th scope="col" class="right">{ui.tabulka.kotuc}<small>m</small></th>}
          {izolacie.size > 0 && <th scope="col">{ui.tabulka.izolacia}</th>}
          <th scope="col"><span class="sr">{ui.tabulka.eshop}</span></th>
        </tr>
      </thead>
      <tbody>
        {zoradene.map((v) => (
          <tr data-rury={priemery(v).join(' ')} data-izolacia={v.izolacia ?? ''}>
            <td class="code"><span class="tv-kod-obal">
              <span class="tv-kod">{v.obj_cislo}</span>
              <button type="button" class="kopia" data-kopia={v.obj_cislo} aria-label={`${tx.kopirovat} ${v.obj_cislo}`} title={tx.kopirovat}><Ikona nazov="copy" velkost={15} /></button>
            </span></td>
            {maRuru && <td class:list={['right', { viac: ruraText(v).includes('+') }]} data-l={ui.tabulka.rura}>{ruraText(v)}</td>}
            {ma('dn') && <td data-l={ui.tabulka.dn}>{v.dn ?? ''}</td>}
            {ma('plast_mm') && <td class="right" data-l={ui.tabulka.plast}>{cislo(v.plast_mm)}</td>}
            {maVykon && <td class="right" data-l={`${tx.vykon}, kW`}>{v.vykon_kw ? `~${cislo(v.vykon_kw)}` : ''}</td>}
            {ma('tlak_bar') && <td class="right" data-l={ui.tabulka.tlak}>{cislo(v.tlak_bar)}</td>}
            {ma('hmotnost_kg_m') && <td class="right" data-l={`${ui.tabulka.hmotnost}, kg/m`}>{cislo(v.hmotnost_kg_m, 2)}</td>}
            {ma('polomer_ohybu_m') && <td class="right" data-l={`${ui.tabulka.polomer}, m`}>{cislo(v.polomer_ohybu_m, 2)}</td>}
            {ma('kotuc') && <td class="right" data-l={`${ui.tabulka.kotuc}, m`}>{v.kotuc ? `${cislo(v.kotuc.d, 2)} / ${cislo(v.kotuc.sirka, 2)}` : ''}</td>}
            {izolacie.size > 0 && <td data-l={ui.tabulka.izolacia}>{v.izolacia && <span class:list={['tv-iz', { zos: v.izolacia === 'zosilnena' }]}>{v.izolacia === 'zosilnena' ? ui.tabulka.zosilnena : ui.tabulka.standard}</span>}</td>}
            <td class="tv-shop"><a href={v.eshop_url} target="_blank" rel="noopener">{ui.common.doEshopu} <Ikona nazov="external-link" velkost={14} /></a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="tv-pozn">
    {maVykon && <p>{tx.vykonPozn}</p>}
    {ma('hmotnost_kg_m') && <p>{ui.tabulka.zdrojPozn}</p>}
    {primoZaklad && <p>{tx.primoPozn(primoZaklad)}</p>}
    {!ma('plast_mm') && <p>{tx.bezPlasta}</p>}
    <p>{zKatalogu ? tx.zdrojStrana(strany[0]) : <>{ui.common.zdroj} {datum(stiahnute, lang)}. <a href={zdroj} target="_blank" rel="noopener">{ui.common.strankaVyrobcu}</a>.</>}</p>
  </div>
</div>

<style>
  .tv-filter { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 16px 36px; padding: 22px 24px 18px; border-bottom: 1px solid rgb(10 42 94 / 0.08); }
  .tv-skupina { display: flex; flex-direction: column; gap: 8px; }
  .tv-meno { font-size: 13px; color: var(--color-ink-soft); }
  .tv-filter .chip { min-width: 44px; justify-content: center; font-variant-numeric: tabular-nums; }
  .tv-pocet { margin-left: auto; font-size: 14px; color: var(--color-ink-soft); padding-bottom: 7px; }

  .tv-obal { overflow-x: auto; scrollbar-width: thin; padding: 4px 12px 8px; }
  .tv-tab th { background: #fff; }
  .tv-tab th, .tv-tab td { padding: 13px 14px; }
  .tv-tab tbody tr[hidden] { display: none; }
  .tv-tab td.code { padding-block: 8px; }
  .tv-kod-obal { display: flex; align-items: center; gap: 6px; font-family: var(--font-display); font-stretch: 112.5%; font-weight: 600; font-size: 15px; letter-spacing: 0.01em; color: var(--color-blue-900); }
  .tv-iz { display: inline-flex; align-items: center; gap: 7px; }
  .tv-iz::before { content: ""; width: 9px; height: 9px; border-radius: 50%; background: var(--color-grey-300); }
  .tv-iz.zos::before { background: var(--color-blue-700); box-shadow: 0 0 0 3px rgb(0 93 185 / 0.15); }
  .tv-shop a { display: inline-flex; align-items: center; gap: 6px; font-weight: 500; color: var(--color-blue-700); }
  .tv-shop a:hover { color: var(--color-blue-900); }

  .tv-pozn { padding: 14px 26px 22px; border-top: 1px solid rgb(10 42 94 / 0.08); font-size: 13px; line-height: 1.5; color: var(--color-ink-soft); }
  .tv-pozn p + p { margin-top: 4px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  /* Mobil: variant ako karta, obj. číslo a e-shop na jednom riadku, údaje v dvoch stĺpcoch. */
  @media (max-width: 760px) {
    .tv-filter { padding: 18px 18px 14px; gap: 14px; }
    .tv-pocet { margin-left: 0; padding-bottom: 0; }
    .tv-obal { padding: 0; overflow: visible; }
    .tv-tab, .tv-tab tbody { display: block; }
    .tv-tab thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .tv-tab tbody tr { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px 12px; padding: 14px 18px 16px; border-bottom: 1px solid rgb(10 42 94 / 0.08); }
    .tv-tab tbody tr:hover { background: transparent; }
    .tv-tab td { display: block; padding: 0; border: 0; white-space: normal; text-align: left; font-size: 14.5px; }
    .tv-tab td[data-l]::before { content: attr(data-l); display: block; font-size: 11.5px; line-height: 1.3; color: var(--color-ink-soft); margin-bottom: 1px; }
    .tv-tab td:empty { display: none; }
    .tv-tab td.viac { grid-column: 1 / -1; }
    .tv-tab td.code { grid-column: 1 / 3; padding: 0; }
    .tv-kod-obal { font-size: 17px; }
    .tv-tab td.tv-shop { grid-column: 3; grid-row: 1; justify-self: end; align-self: center; white-space: nowrap; }
      .tv-pozn { padding: 14px 18px 20px; }
  }
</style>

<script>
  function initTabulky() {
    document.querySelectorAll<HTMLElement>('[data-tv]').forEach((tv) => {
      if (tv.dataset.init) return;
      tv.dataset.init = '1';
      const riadky = [...tv.querySelectorAll<HTMLTableRowElement>('tbody tr')];
      const pocet = tv.querySelector<HTMLElement>('[data-pocet]');
      const stav = { rura: '', izolacia: '' };
      const obnov = () => {
        let n = 0;
        for (const r of riadky) {
          const ok = (!stav.rura || (r.dataset.rury ?? '').split(' ').includes(stav.rura)) && (!stav.izolacia || r.dataset.izolacia === stav.izolacia);
          r.hidden = !ok;
          if (ok) n++;
        }
        if (pocet) pocet.textContent = (pocet.dataset.sablona ?? '').replace('{n}', String(n)).replace('{z}', String(riadky.length));
      };
      tv.querySelectorAll<HTMLButtonElement>('[data-rura], [data-izolacia]').forEach((b) => {
        b.addEventListener('click', () => {
          const kluc = 'rura' in b.dataset ? 'rura' : 'izolacia';
          stav[kluc] = b.dataset[kluc] ?? '';
          tv.querySelectorAll<HTMLButtonElement>(`[data-${kluc}]`).forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          obnov();
        });
      });
    });
  }
  initTabulky();
  document.addEventListener('astro:page-load', initTabulky);
</script>
