    .podpora-hlava, .podpora-sluzby, .istota { grid-column: 1 / -1; grid-row: auto; }
    .konfigurator { grid-column: 1 / -1; grid-row: auto; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center; }
    .konf-obraz :global(img) { aspect-ratio: auto; height: 100%; }
    .konf-obraz::after { background: linear-gradient(90deg, rgb(13 50 112 / 0) 50%, #0f3878 100%); }
