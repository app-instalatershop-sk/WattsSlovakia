---
/**
 * Kóty na obraze: bod leží na tom, čo číslo opisuje, čiara vedie k mliečnemu štítku s číslom a popisom.
 * Rovnaký jazyk ako popisy na renderi v hero domova. Rodič musí mať position: relative a
 * container-type: inline-size; súradnice bodu sú v percentách obrazu, dĺžka čiary v cqw.
 *
 *  smer   kam ide čiara od bodu: hore-vpravo, hore-vlavo, dole-vpravo, dole-vlavo
 *         (štítok visí na konci čiary a rastie doprava alebo doľava)
 *  smerM  smer na telefóne, keď by štítok pri úzkom displeji vyšiel z obrazu (inak ako smer)
 *  l      dĺžka čiary v percentách šírky obrazu (cqw), na telefóne sa skráti na tri štvrtiny
 *
 * Kóty prídu, keď je obraz v okne: bod, čiara a štítok po sebe. Bez skriptu alebo pri „obmedziť
 * pohyb“ sú hneď viditeľné.
 */
import { sadzba } from '../lib/sadzba';
import type { Kota } from '../lib/koty';

interface Props { koty: Kota[]; label?: string }
const { koty, label } = Astro.props;
---
{koty.length > 0 && (
  <ul class="koty" aria-label={label} data-koty>
    {koty.map((k, i) => (
      <li class={`kota s-${k.smer} sm-${k.smerM ?? k.smer}${k.kod ? ` k-${k.kod}` : ''}`} style={`--x: ${k.x}%; --y: ${k.y}%; --l: ${k.l}; --i: ${i}`}>
        <span class="bod" aria-hidden="true"></span>
        <span class="ciara" aria-hidden="true"></span>
        <span class="stitok"><strong>{k.hodnota}</strong><span>{sadzba(k.text)}</span></span>
      </li>
    ))}
  </ul>
)}

<style>
  /* --k skráti čiary na telefóne; dĺžka je v štýle prvku (inline), preto sa mení cez násobiteľ. */
  .koty { --k: 1; position: absolute; inset: 0; z-index: 2; margin: 0; padding: 0; pointer-events: none; }
  .kota { --dlzka: calc(var(--l) * var(--k) * 1cqw); position: absolute; left: var(--x); top: var(--y); width: 0; height: 0; }
  .bod { position: absolute; z-index: 2; left: -7px; top: -7px; width: 14px; height: 14px; border-radius: 50%; background: #fff; box-shadow: inset 0 0 0 3px var(--color-blue-900), 0 0 0 4px rgb(255 255 255 / 0.5), 0 3px 10px rgb(4 16 40 / 0.4); }
  .ciara { position: absolute; left: -0.75px; width: 1.5px; height: var(--dlzka); background: var(--color-blue-900); box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.6); }
  .stitok { position: absolute; display: flex; flex-direction: column; gap: 3px; white-space: nowrap;
    padding: clamp(6px, 0.9cqw, 11px) clamp(9px, 1.3cqw, 15px); border-radius: 12px;
    background: rgb(255 255 255 / 0.88); -webkit-backdrop-filter: blur(10px) saturate(1.4); backdrop-filter: blur(10px) saturate(1.4);
    box-shadow: inset 0 0 0 1px rgb(10 42 94 / 0.08), 0 16px 34px -16px rgb(4 16 40 / 0.55); }
  .stitok strong { font-family: var(--font-display); font-stretch: 118%; font-weight: 600; font-size: clamp(16px, 3.1cqw, 30px); line-height: 1.02; letter-spacing: -0.02em; color: var(--color-blue-900); font-variant-numeric: tabular-nums; }
  .stitok span { font-size: clamp(12px, 1.6cqw, 15px); line-height: 1.3; font-weight: 500; color: #3f4b5e; }
  /* Čiara hore: štítok nad ňou; čiara dole: štítok pod ňou. Roh pri čiare je ostrý, aby bolo vidno, kam
     patrí. Počítač berie triedu s-<smer>, telefón sm-<smer>. */
  @media (min-width: 761px) {
    .s-hore-vpravo .ciara, .s-hore-vlavo .ciara { bottom: 0; transform-origin: bottom; }
    .s-dole-vpravo .ciara, .s-dole-vlavo .ciara { top: 0; transform-origin: top; }
    .s-hore-vpravo .stitok { left: -0.75px; bottom: var(--dlzka); border-bottom-left-radius: 2px; }
    .s-hore-vlavo .stitok { right: -0.75px; bottom: var(--dlzka); border-bottom-right-radius: 2px; align-items: flex-end; text-align: right; }
    .s-dole-vpravo .stitok { left: -0.75px; top: var(--dlzka); border-top-left-radius: 2px; }
    .s-dole-vlavo .stitok { right: -0.75px; top: var(--dlzka); border-top-right-radius: 2px; align-items: flex-end; text-align: right; }
  }
  @media (max-width: 760px) {
    .koty { --k: 0.75; }
    .stitok { border-radius: 10px; }
    .sm-hore-vpravo .ciara, .sm-hore-vlavo .ciara { bottom: 0; transform-origin: bottom; }
    .sm-dole-vpravo .ciara, .sm-dole-vlavo .ciara { top: 0; transform-origin: top; }
    .sm-hore-vpravo .stitok { left: -0.75px; bottom: var(--dlzka); border-bottom-left-radius: 2px; }
    .sm-hore-vlavo .stitok { right: -0.75px; bottom: var(--dlzka); border-bottom-right-radius: 2px; align-items: flex-end; text-align: right; }
    .sm-dole-vpravo .stitok { left: -0.75px; top: var(--dlzka); border-top-left-radius: 2px; }
    .sm-dole-vlavo .stitok { right: -0.75px; top: var(--dlzka); border-top-right-radius: 2px; align-items: flex-end; text-align: right; }
  }

  .koty.is-cakaj .bod, .koty.is-cakaj .ciara, .koty.is-cakaj .stitok { opacity: 0; }
  .koty.is-on .bod { animation: kota-bod 420ms var(--ease-soft) both; animation-delay: calc(var(--i) * 200ms); }
  .koty.is-on .ciara { animation: kota-ciara 520ms var(--ease-soft) both; animation-delay: calc(120ms + var(--i) * 200ms); }
  .koty.is-on .stitok { animation: kota-stitok 520ms var(--ease-soft) both; animation-delay: calc(300ms + var(--i) * 200ms); }
  @keyframes kota-bod { from { opacity: 0; transform: scale(0.3); } to { opacity: 1; transform: none; } }
  @keyframes kota-ciara { from { opacity: 1; transform: scaleY(0); } to { opacity: 1; transform: scaleY(1); } }
  @keyframes kota-stitok { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
</style>

<script>
  function initKoty() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLElement>('[data-koty]:not([data-koty-on])').forEach((el) => {
      el.dataset.kotyOn = '1';
      if (reduce || !('IntersectionObserver' in window)) return;
      el.classList.add('is-cakaj');
      const io = new IntersectionObserver((z) => {
        if (z.some((e) => e.isIntersecting)) { el.classList.remove('is-cakaj'); el.classList.add('is-on'); io.disconnect(); }
      }, { rootMargin: '0px 0px -15% 0px' });
      io.observe(el);
    });
  }
  initKoty();
  document.addEventListener('astro:page-load', initKoty);
</script>
