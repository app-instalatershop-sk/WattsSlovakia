---
import { Image } from 'astro:assets';
import Strana from '../../navrhy/Strana.astro';
import Navrh from '../../navrhy/Navrh.astro';
import Hlava from '../../components/Hlava.astro';
import Koty from '../../components/Koty.astro';
import Ikona from '../../components/Ikona.astro';
import { radDuo } from '../../navrhy/data';
import { fotkaReferencie } from '../../lib/obrazky';
import { sadzba } from '../../lib/sadzba';
import { route } from '../../i18n/ui';

const d = await radDuo();
const stavba = fotkaReferencie('orange-5-scena.jpg')!;
const VARIANTY = [
  { pismeno: 'A', nazov: 'Dnes: text vľavo, render vpravo cez okraj' },
  { pismeno: 'B', nazov: 'Veľké štúdio pod nadpisom' },
  { pismeno: 'C', nazov: 'Tmavé štúdio' },
  { pismeno: 'D', nazov: 'Výrobok na stavbe' },
];
const alt = `${d.nazov}: rez potrubím, plášť, izolácia a nosná rúra`;
---
<Strana cesta="/navrhy/hlava/" nadpis="Hlava vnútornej stránky" varianty={VARIANTY}
  popis="Prvé, čo človek uvidí na každej stránke radu, systému, dielu aj na stránkach Referencie, Pre firmy či Poradňa. Ukážka na rade Microflex DUO, pod hlavou je začiatok tela stránky, aby bolo vidno prechod."
  kde="12 radov, 5 systémov, 41 dielov, 2 prehľady dielov, Potrubia, Referencie, Pre firmy, Kontakt, Na stiahnutie, Poradňa a 4 články, Výber, Hľadanie (SK aj CS, asi 140 stránok)">

  <Navrh pismeno="A" nazov="Text vľavo, render vpravo cez okraj" dnes
    popis="Svetlé pole ako hero domova, render s kótami vybieha za pravý okraj a cez šikmú hranu do tela stránky.">
    <Hlava lang="sk" nadpis={d.nazov} drobceky={d.drobceky} pred={d.pred} lead={d.kratky} obraz={d.pikto} obrazAlt={alt} obrazMax={640} koty={d.koty} kotyLabel="Rozmery potrubia na obrázku">
      <div class="hlava-akcie">
        <a class="btn btn-yellow" href="#v-A">Vybrať dimenziu <Ikona nazov="arrow-down" velkost={18} /></a>
        <a class="odkaz" href="#v-A">Kúpiť v e-shope <Ikona nazov="external-link" velkost={16} /></a>
      </div>
    </Hlava>
    <div class="telo-stub"><div class="wrap"><div class="s-hlava"><h2>Varianty a obj. čísla</h2><p>8 dimenzií, z toho 3 so zosilnenou izoláciou.</p></div><div class="harok stub-harok"></div></div></div>
  </Navrh>

  <Navrh pismeno="B" nazov="Veľké štúdio pod nadpisom" odporucam
    popis="Nadpis a akcie hore, výrobok pod nimi takmer cez celú šírku ako vo fotoštúdiu: mäkké svetlo, tieň na podlahe, kóty okolo. Výrobok je hrdina stránky, text ho neťahá do strany."
    inspiracia="Apple (stránky produktov: jedna veta, výrobok vo veľkej mierke), Porsche (model ako hlavný obraz)">
    <section class="vb">
      <div class="wrap vb-hore">
        <div class="vb-text">
          <ol class="crumbs"><li><a href={route('sk', 'domov')}>Domov</a></li>{d.drobceky.map((x) => (x.href ? <li><a href={x.href}>{x.text}</a></li> : <li aria-current="page">{x.text}</li>))}</ol>
          <p class="pred">{d.pred}</p>
          <h1>{sadzba(d.nazov)}</h1>
        </div>
        <div class="vb-bok">
          <p class="lead">{sadzba(d.kratky)}</p>
          <div class="akcie">
            <a class="btn btn-yellow" href="#v-B">Vybrať dimenziu <Ikona nazov="arrow-down" velkost={18} /></a>
            <a class="odkaz" href="#v-B">Kúpiť v e-shope <Ikona nazov="external-link" velkost={16} /></a>
          </div>
        </div>
      </div>
      <div class="vb-studio">
        <div class="vb-stage"><Image src={d.pikto} alt={alt} widths={[700, 1000, 1200]} sizes="(max-width: 760px) 100vw, 860px" /><Koty koty={d.koty} label="Rozmery potrubia na obrázku" /></div>
      </div>
    </section>
    <div class="telo-stub telo-stub-b"><div class="wrap"><div class="s-hlava"><h2>Varianty a obj. čísla</h2><p>8 dimenzií, z toho 3 so zosilnenou izoláciou.</p></div><div class="harok stub-harok"></div></div></div>
  </Navrh>

  <Navrh pismeno="C" nazov="Tmavé štúdio"
    popis="Rovnaké rozloženie ako dnes, ale na tmavomodrom poli so svetlom za výrobkom. Modrý plášť a žlté jadro svietia, kóty sú najčitateľnejšie. Telo stránky ostáva svetlé, prechod je šikmá hrana."
    inspiracia="Apple (výrobok na tmavom pod svetlom), tmavé podzemie z nášho domova">
    <section class="vc">
      <div class="wrap vc-in">
        <div class="vc-text">
          <ol class="crumbs"><li><a href={route('sk', 'domov')}>Domov</a></li>{d.drobceky.map((x) => (x.href ? <li><a href={x.href}>{x.text}</a></li> : <li aria-current="page">{x.text}</li>))}</ol>
          <p class="pred">{d.pred}</p>
          <h1>{sadzba(d.nazov)}</h1>
          <p class="lead">{sadzba(d.kratky)}</p>
          <div class="akcie">
            <a class="btn btn-yellow" href="#v-C">Vybrať dimenziu <Ikona nazov="arrow-down" velkost={18} /></a>
            <a class="odkaz" href="#v-C">Kúpiť v e-shope <Ikona nazov="external-link" velkost={16} /></a>
          </div>
        </div>
        <div class="vc-obraz"><div class="vc-stage"><Image src={d.pikto} alt={alt} widths={[560, 900, 1200]} sizes="(max-width: 760px) 100vw, 52vw" /><Koty koty={d.koty} label="Rozmery potrubia na obrázku" /></div></div>
      </div>
    </section>
    <div class="telo-stub"><div class="wrap"><div class="s-hlava"><h2>Varianty a obj. čísla</h2><p>8 dimenzií, z toho 3 so zosilnenou izoláciou.</p></div><div class="harok stub-harok"></div></div></div>
  </Navrh>

  <Navrh pismeno="D" nazov="Výrobok na stavbe"
    popis="Za ostrým renderom je rozostrená fotka skutočného výkopu (Orange). Výrobok stojí v prostredí, kde sa používa, ako na objektíve s malou hĺbkou ostrosti. Na stránkach bez renderu (Referencie, Pre firmy) by tu bola samotná fotka zo stavby."
    inspiracia="reklamné zábery stavebných značiek (výrobok v popredí, stavba za ním), Logstor (fotky v mierke)">
    <section class="vd">
      <div class="vd-pozadie" aria-hidden="true"><Image src={stavba} alt="" widths={[900, 1200]} sizes="100vw" /></div>
      <div class="wrap vd-in">
        <div class="vd-text">
          <ol class="crumbs"><li><a href={route('sk', 'domov')}>Domov</a></li>{d.drobceky.map((x) => (x.href ? <li><a href={x.href}>{x.text}</a></li> : <li aria-current="page">{x.text}</li>))}</ol>
          <p class="pred">{d.pred}</p>
          <h1>{sadzba(d.nazov)}</h1>
          <p class="lead">{sadzba(d.kratky)}</p>
          <div class="akcie">
            <a class="btn btn-yellow" href="#v-D">Vybrať dimenziu <Ikona nazov="arrow-down" velkost={18} /></a>
            <a class="odkaz" href="#v-D">Kúpiť v e-shope <Ikona nazov="external-link" velkost={16} /></a>
          </div>
        </div>
        <div class="vd-obraz"><div class="vd-stage"><Image src={d.pikto} alt={alt} widths={[560, 900, 1200]} sizes="(max-width: 760px) 100vw, 52vw" /><Koty koty={d.koty} label="Rozmery potrubia na obrázku" /></div></div>
      </div>
    </section>
    <div class="telo-stub"><div class="wrap"><div class="s-hlava"><h2>Varianty a obj. čísla</h2><p>8 dimenzií, z toho 3 so zosilnenou izoláciou.</p></div><div class="harok stub-harok"></div></div></div>
  </Navrh>
</Strana>

<style>
  /* Začiatok tela pod hlavou, aby bolo vidno prechod. */
  .telo-stub { background: linear-gradient(180deg, var(--zem-1) 0%, var(--zem-2) 100%); padding: 36px 0 64px; }
  .stub-harok { height: 110px; }
  .telo-stub-b { padding-top: 84px; }
  .pred { font-size: 16px; font-weight: 500; color: var(--color-blue-700); margin-bottom: 12px; }
  .crumbs { padding-block: 0 26px; }
  .akcie { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; margin-top: 28px; }
  /* Šikmá hrana dole: farba začiatku tela stránky (ako Hlava.astro). */
  .vb::after, .vc::after, .vd::after { content: ""; position: absolute; z-index: 1; left: 0; right: 0; bottom: 0; height: var(--presah-hero); background: var(--zem-1); clip-path: polygon(0 100%, 100% 0, 100% 100%); pointer-events: none; }

  /* ---------- B: veľké štúdio pod nadpisom ---------- */
  .vb { position: relative; overflow-x: clip; padding-top: 28px; color: var(--color-ink);
    background: radial-gradient(46% 52% at 58% 66%, #ffffff 0%, rgb(255 255 255 / 0.6) 45%, rgb(255 255 255 / 0) 75%), linear-gradient(180deg, #ffffff 0%, #f3f6fa 55%, #e8eef6 100%); }
  .vb-hore { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 24px 56px; align-items: end; }
  .vb h1 { font-size: clamp(34px, 3vw + 12px, 64px); line-height: 1.02; letter-spacing: -0.03em; max-width: 12em; }
  .vb-bok .lead { max-width: 30em; }
  .vb-studio { position: relative; z-index: 2; margin-top: 8px; }
  .vb-stage { position: relative; width: min(880px, 92vw); margin: 0 auto -52px; padding-left: 8%; container-type: inline-size; }
  .vb-stage :global(img) { display: block; width: 100%; height: auto; filter: drop-shadow(0 40px 46px rgb(11 27 51 / 0.22)); }
  /* Tieň na podlahe štúdia pod výrobkom. */
  .vb-stage::before { content: ""; position: absolute; left: 14%; right: 4%; bottom: 6%; height: 12%; border-radius: 50%; background: radial-gradient(closest-side, rgb(10 42 94 / 0.22), rgb(10 42 94 / 0)); z-index: -1; }

  /* ---------- C: tmavé štúdio ---------- */
  .vc { position: relative; overflow-x: clip; color: #fff; padding-bottom: calc(var(--presah-hero) * 0.55);
    background: radial-gradient(48% 62% at 74% 46%, #2160b4 0%, #123f86 34%, #0a2a5e 64%, #061a3d 100%); }
  .vc-in { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 24px 40px; align-items: center; min-height: clamp(400px, 52vh, 580px); }
  .vc-text { position: relative; z-index: 3; padding-block: 28px 40px; max-width: 640px; }
  .vc .crumbs a, .vc .crumbs li { color: #a9bedb; }
  .vc .crumbs li + li::before { color: rgb(255 255 255 / 0.3); }
  .vc .pred { color: #8fc0ff; }
  .vc h1 { color: #fff; font-size: clamp(32px, 2.4vw + 16px, 54px); line-height: 1.05; letter-spacing: -0.025em; }
  .vc .lead { color: #c3d3ea; margin-top: 20px; }
  .vc .odkaz { color: #fff; }
  .vc-obraz { position: relative; z-index: 2; align-self: end; margin-right: calc(-1 * var(--bleed)); margin-bottom: calc(var(--presah-hero) * -0.9); }
  .vc-stage { position: relative; max-width: 640px; margin-left: auto; container-type: inline-size; }
  .vc-stage :global(img) { display: block; width: 100%; height: auto; filter: drop-shadow(0 40px 50px rgb(0 0 0 / 0.45)); }

  /* ---------- D: výrobok na stavbe ---------- */
  .vd { position: relative; overflow-x: clip; color: #fff; padding-bottom: calc(var(--presah-hero) * 0.55); }
  .vd-pozadie { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .vd-pozadie :global(img) { width: 100%; height: 100%; object-fit: cover; filter: blur(7px) saturate(0.9); transform: scale(1.08); }
  .vd-pozadie::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgb(6 22 52 / 0.9) 0%, rgb(6 22 52 / 0.7) 42%, rgb(6 22 52 / 0.25) 100%), linear-gradient(0deg, rgb(6 22 52 / 0.45) 0%, rgb(6 22 52 / 0) 40%); }
  .vd-in { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 24px 40px; align-items: center; min-height: clamp(400px, 52vh, 580px); }
  .vd-text { position: relative; z-index: 3; padding-block: 28px 40px; max-width: 640px; }
  .vd .crumbs a, .vd .crumbs li { color: #c3d3ea; }
  .vd .crumbs li + li::before { color: rgb(255 255 255 / 0.35); }
  .vd .pred { color: #9cc8ff; }
  .vd h1 { color: #fff; font-size: clamp(32px, 2.4vw + 16px, 54px); line-height: 1.05; letter-spacing: -0.025em; text-shadow: 0 2px 24px rgb(0 0 0 / 0.3); }
  .vd .lead { color: #d6e2f2; margin-top: 20px; }
  .vd .odkaz { color: #fff; }
  .vd-obraz { position: relative; z-index: 2; align-self: end; margin-right: calc(-1 * var(--bleed)); margin-bottom: calc(var(--presah-hero) * -0.9); }
  .vd-stage { position: relative; max-width: 640px; margin-left: auto; container-type: inline-size; }
  .vd-stage :global(img) { display: block; width: 100%; height: auto; filter: drop-shadow(0 44px 50px rgb(0 0 0 / 0.55)); }

  @media (max-width: 900px) {
    .vb-hore, .vc-in, .vd-in { grid-template-columns: minmax(0, 1fr); }
    .vb-stage { padding-left: 0; margin-bottom: -48px; }
    .vc-obraz, .vd-obraz { margin: 0 calc(-1 * var(--gutter)) calc(var(--presah-hero) * -0.5); }
    .vc-stage, .vd-stage { margin-inline: auto; }
  }
</style>
